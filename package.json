{
  "name": "herdr-orchestra",
  "version": "6.10.0",
  "description": "Orchestrate AI coding agents (Claude Code, Codex, OpenCode, Amp, Pi) as one team: a lead plans, coders build, a reviewer checks, you get one PR. Runs in Herdr panes, or in one Pi window with subagents.",
  "license": "MIT",
  "bin": {
    "herdr-orchestra": "npm/cli.js"
  },
  "files": [
    "npm/cli.js",
    "install.sh",
    "bin",
    "skills",
    "opencode-commands",
    "claude-commands",
    "playbooks",
    "extensions",
    "pi",
    "agents.default.toml",
    "models.default.toml",
    "VERSION",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunnarangali/herdr-orchestra.git"
  },
  "homepage": "https://herdr-orchestra.vercel.app/",
  "bugs": "https://github.com/arunnarangali/herdr-orchestra/issues",
  "keywords": [
    "herdr",
    "herdr-orchestra",
    "orchestration",
    "agent-orchestration",
    "ai-agents",
    "multi-agent",
    "agentic-workflow",
    "agent-workflow",
    "coding-agents",
    "ai-coding",
    "claude-code",
    "codex",
    "opencode",
    "amp",
    "llm",
    "cli",
    "developer-tools",
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents"
  ],
  "pi": {
    "skills": [
      "./pi/skills/orch-plan",
      "./skills/orch-run",
      "./skills/orch-explain"
    ],
    "extensions": [
      "./extensions/orch-mode.ts"
    ]
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "arunnarangali (https://github.com/arunnarangali)",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
