---
import Base from '../layouts/Base.astro';
import { agents } from '../lib/repo';
import AgentIcon from '../components/AgentIcon.astro';
import AgentStrip from '../components/AgentStrip.astro';
const list = agents();
---
<Base title="Agents · herdr-orchestra" description="Every agent herdr-orchestra knows, its launch command, and how to start it as the lead.">
  <section class="first">
    <div class="wrap">
      <p class="eyebrow">Agents</p>
      <h1>Bring the agents you already use.</h1>
      <p class="lede">Any of them can be lead, coder or reviewer, and you can mix kinds in one team. These kinds ship in <code>agents.default.toml</code>. Run <code>orch agents</code> to see which are installed on your machine, and <code>orch agents sync</code> after installing a new one.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div style="margin-bottom:28px"><AgentStrip /></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Agent</th><th>Launch command</th><th>Start it as lead</th><th>Status tracking</th></tr></thead>
          <tbody>
            {list.map((a) => (
              <tr id={a.kind}>
                <td><div class="agent-cell"><span class="logo"><AgentIcon kind={a.kind} size={24} /></span><span><strong>{a.name}</strong><br /><code>{a.kind}</code></span></div></td>
                <td><code>{a.launch}</code></td>
                <td><code>{a.invoke}</code></td>
                <td>{a.herdr_detect ? 'Live (idle, working, blocked)' : 'Done file and time budget'}</td>
              </tr>
            ))}
            <tr>
              <td><div class="agent-cell"><span class="logo" aria-hidden="true">+</span><strong>Any other agent</strong></div></td>
              <td>Add it to <code>~/.config/herdr-orchestra/agents.toml</code></td>
              <td><code>Run `orch lead plan` and follow it. Feature: &lt;feature&gt;</code></td>
              <td>Set <code>herdr_detect</code></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="diagram-note">The lead is whichever agent you start the plan playbook in. It never codes or reviews in its own run. <a href="/docs/agents/">Agent setup and adding your own →</a></p>
      <p class="diagram-note" style="font-size:13px;color:var(--faint)">Agent marks are trademarks of their owners and are shown only to identify compatible tools.</p>
    </div>
  </section>
</Base>
