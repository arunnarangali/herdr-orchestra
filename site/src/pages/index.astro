---
import Base from '../layouts/Base.astro';
import Install from '../components/Install.astro';
import HerdrMock from '../components/HerdrMock.astro';
import RunFlow from '../components/RunFlow.astro';
import BranchFlow from '../components/BranchFlow.astro';
import AgentStrip from '../components/AgentStrip.astro';
import Modes from '../components/Modes.astro';
import { REPO_URL, version } from '../lib/repo';

const roles = [
  {
    c: 'var(--text)', tag: 'you', name: 'You',
    does: 'Describe the feature, edit the plan, answer questions when asked, and review one pull request.',
    never: 'Babysit agents or copy work between them.',
  },
  {
    c: 'var(--lead)', tag: 'lead · any agent', name: 'Lead',
    does: 'Researches the codebase and writes 1 to 4 milestones as issues: goal, why, acceptance criteria, interfaces, dependencies with reasons.',
    never: 'Writes code or tells coders how to build it.',
  },
  {
    c: 'var(--coder)', tag: 'coders · a pool', name: 'Coders',
    does: 'Own the how: design, code, tests, fixing failed checks and review findings, resolving conflicts. Whichever is free takes the next ready milestone.',
    never: 'Change scope or skip acceptance criteria.',
  },
  {
    c: 'var(--reviewer)', tag: 'reviewer · optional', name: 'Reviewer',
    does: 'Reads every diff and reports problems as BLOCKER: file:line — what — why.',
    never: 'Edits code or prescribes the fix.',
  },
];

const handles = [
  { trigger: 'checks fail', title: 'Sends the failure back', body: 'The last 60 lines of output go to the coder who built it.', limit: 'up to 3 rounds' },
  { trigger: 'BLOCKER', title: 'Queues a fix job', body: 'The problem, not the solution, goes to the next free coder, preferring the author.', limit: 'up to 2 rounds' },
  { trigger: 'merge conflict', title: 'Hands back the merge', body: 'A coder merges the branch in its worktree and resolves both sides.', limit: 'up to 2 rounds' },
  { trigger: 'usage limit', title: 'Benches the agent', body: 'Another coder continues with the work so far.', limit: '60 min cooldown' },
  { trigger: 'agent disappears', title: 'Moves the work on', body: 'Its task continues on another coder with the work so far; it rejoins when it is back.', limit: '10 min bench' },
  { trigger: 'permission prompt', title: 'Alerts you', body: 'A desktop notification; every other task keeps running.', limit: 'no waiting' },
  { trigger: 'QUESTION:', title: 'Waits only where needed', body: 'That task and its dependents pause. Everything else continues.', limit: 'answer in plan.md' },
  { trigger: 'coder freed', title: 'Pipelines review', body: 'Once checks pass, the coder takes the next milestone while the reviewer reads.', limit: 'worktree mode' },
];
---
<Base>
  <section class="first">
    <div class="wrap hero">
      <div>
        <a class="version-pill" href="/changelog"><b>{version()}</b> One feature branch per run, one pull request</a>
        <h1>Your AI agents, <span>working as a team.</span></h1>
        <p class="lede">A lead plans the feature. Coders build it in parallel. A reviewer checks every diff. You get one clean pull request.</p>
        <Install />
        <div class="actions">
          <a class="btn primary" href="/docs/quick-start">Quick start</a>
          <a class="btn" href="/how-it-works">See how a run works</a>
          <a class="btn" href={REPO_URL}>Star on GitHub</a>
        </div>
      </div>
      <HerdrMock />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Works with your agents</p>
        <h2>Any installed agent can play any role.</h2>
        <p class="lede">Mix them freely: a Claude lead, a Codex and a Claude coder, an Antigravity reviewer. Anything that can run shell commands can join.</p>
      </div>
      <AgentStrip />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who does what</p>
        <h2>Clear roles, and clear limits.</h2>
        <p class="lede">Each role has one job and a line it never crosses. The lead decides what and why; the coders decide how.</p>
      </div>
      <div class="grid cols-4">
        {roles.map((r) => (
          <div class="card role" style={`--c:${r.c}`}>
            <span class="tag">{r.tag}</span>
            <h3>{r.name}</h3>
            <dl>
              <dt>Does</dt><dd>{r.does}</dd>
              <dt>Never</dt><dd class="never">{r.never}</dd>
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How a run works</p>
        <h2>You touch it three times.</h2>
        <p class="lede">You describe the feature, edit the plan, and review the pull request. The team does everything in between.</p>
      </div>
      <div class="diagram reveal"><RunFlow /></div>
      <p class="diagram-note"><a href="/how-it-works">Walk through a full run, step by step →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Parallel by design, clean history</p>
        <h2>Independent work runs side by side, on one branch.</h2>
        <p class="lede">For each pair of milestones the lead asks: could B be built and pass its checks if A never existed? If yes, two coders build them at the same time in separate git worktrees.</p>
      </div>
      <div class="diagram reveal"><BranchFlow /></div>
      <div class="grid cols-3" style="margin-top:16px">
        <div class="card"><h3>Contract first</h3><p>Parallel milestones that must fit together depend on a small milestone that defines the shared types or API.</p></div>
        <div class="card"><h3>Scaffold first</h3><p>Routes, nav, <code>package.json</code> and other hotspot files change in one early milestone, so parallel work never collides.</p></div>
        <div class="card"><h3>A normal branch and PR</h3><p>One <code>feature/&lt;name&gt;</code> branch, one commit per milestone with a real message, and <code>orch finish</code> opens the pull request.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Built to keep going</p>
        <h2>It stops only when it needs you.</h2>
        <p class="lede">Failed checks, review findings, conflicts and tired agents are routed to the right place with a round limit. When a run really needs you, you get a desktop notification that says why.</p>
      </div>
      <div class="grid cols-4">
        {handles.map((h) => (
          <div class="card tile">
            <span class="trigger">{h.trigger}</span>
            <h3>{h.title}</h3>
            <p>{h.body}</p>
            <span class="limit">{h.limit}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap drive">
      <div class="section-head">
        <p class="eyebrow">Your choice of driver</p>
        <h2>Let the lead run it, or a script.</h2>
        <p class="lede">The same loop can be driven two ways. Switch any time; the run picks up where it left off.</p>
      </div>
      <div class="grid cols-2">
        <div class="card">
          <h3>The lead drives <code>/orch-run</code></h3>
          <p>Your lead agent hands out milestones, runs checks and reviews, and reads panes when something looks off.</p>
          <ul><li>Judgment on unclear failures</li><li>Works when the baseline check already fails</li></ul>
        </div>
        <div class="card">
          <h3>A script drives <code>orch autopilot</code></h3>
          <p>The same steps as a plain program in a spare terminal. Agents only spend tokens on coding and review.</p>
          <ul><li>No AI cost for scheduling</li><li>Good for long and overnight runs</li></ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Two modes</p>
        <h2>Parallel worktrees, or one folder in order.</h2>
      </div>
      <Modes />
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <p class="eyebrow">Install and go</p>
      <h2>One line to install. Three steps to a first run.</h2>
      <p class="lede">Every version stays installed side by side, so switching back is instant.</p>
      <Install />
      <p class="reqs">Runs in <a href="https://herdr.dev">Herdr</a> with git, python3 and curl. <a href="/docs/installation/">Requirements</a></p>
      <div class="first-run">
        <span><b>/orch-plan &lt;feature&gt;</b> &nbsp;# the lead plans it</span>
        <span><b>/orch-run</b> &nbsp;# the team builds it</span>
        <span><b>orch finish</b> &nbsp;# push the branch, open the PR</span>
      </div>
      <div class="actions center" style="margin-top:28px">
        <a class="btn primary" href="/docs/quick-start/">Read the quick start</a>
        <a class="btn" href={REPO_URL}>View on GitHub</a>
      </div>
    </div>
  </section>
</Base>
