---
// "How it works" in four numbered steps, a data-flow diagram that lights up the active step, and a
// terminal that replays one run with real orch commands and log lines (Play / Pause / Step / Restart).
// Without JavaScript all four steps show, the diagram is fully lit and the terminal shows the whole log.
import { simLines } from '../lib/runlog';

const steps = [
  {
    n: '01', title: 'You ask for a feature', cmd: '/orch-plan <feature>',
    body: 'Run /orch-plan <feature> in the lead\'s pane. The lead reads the codebase, finds the files and patterns involved, and writes milestones as issues, with a model tier for each one.',
  },
  {
    n: '02', title: 'You read the plan and say go', cmd: '.orchestrate/plan.md',
    body: '.orchestrate/plan.md is a normal Markdown file. Change dependencies, a tier, review yes or no, and answer open questions. Nothing starts before you say so.',
  },
  {
    n: '03', title: 'The lead dispatches. The team builds, checks and reviews.', cmd: '/orch-run',
    body: 'The lead runs orch dispatch and stops. A plain script, the event manager (orch autopilot), runs each milestone through a coder, your check command and the reviewer, and wakes the lead whenever something needs a decision.',
  },
  {
    n: '04', title: 'One branch, one pull request.', cmd: 'orch finish',
    body: 'You get a feature/<name> branch with a real commit per milestone and a summary in .orchestrate/summary.md. Run orch finish and it re-checks the branch, pushes it and opens the pull request.',
  },
];

// ---- Diagram: boxes on a 4-column grid; each node and edge lists the steps it belongs to. ----
const COL = [10, 140, 270, 400];
const W = 110, H = 42;
const ROW = [44, 150, 252];
type N = { id: string; x: number; y: number; w?: number; name: string; sub: string; on: number[] };
const nodes: N[] = [
  { id: 'you', x: COL[0], y: ROW[0], name: 'you', sub: 'set the goal', on: [0, 1] },
  { id: 'lead', x: COL[1], y: ROW[0], name: 'lead', sub: 'plans, decides', on: [0, 2] },
  { id: 'plan', x: COL[2], y: ROW[0], name: 'plan.md', sub: 'milestones, tiers', on: [0, 1] },
  { id: 'evm', x: COL[0], y: ROW[1], name: 'event mgr', sub: 'orch autopilot', on: [2] },
  { id: 'coders', x: COL[1], y: ROW[1], name: 'coders', sub: 'build in parallel', on: [2] },
  { id: 'checks', x: COL[2], y: ROW[1], name: 'checks', sub: 'your test command', on: [2] },
  { id: 'rev', x: COL[3], y: ROW[1], name: 'reviewer', sub: 'reads the diff', on: [2, 3] },
  { id: 'branch', x: COL[1], y: ROW[2], w: 240, name: 'feature/csv-import', sub: 'one commit per milestone', on: [3] },
  { id: 'pr', x: COL[3], y: ROW[2], name: 'pull request', sub: 'you merge', on: [3] },
];
const mid = ROW.map((r) => r + H / 2);
const edges: { d: string; on: number[]; label?: string; lx?: number; ly?: number; anchor?: string }[] = [
  { d: `M${COL[0] + W} ${mid[0]}H${COL[1] - 4}`, on: [0] },
  { d: `M${COL[1] + W} ${mid[0]}H${COL[2] - 4}`, on: [0] },
  { d: `M${COL[2] + W / 2} ${ROW[0]}V${ROW[0] - 18}H${COL[0] + W / 2}V${ROW[0] - 4}`, on: [1], label: 'you edit it, then say go', lx: (COL[0] + COL[2] + W) / 2, ly: ROW[0] - 24 },
  { d: `M${COL[1] + W / 2} ${ROW[0] + H}V${ROW[1] - 4}`, on: [2], label: 'orch dispatch', lx: COL[1] + W / 2 + 8, ly: (ROW[0] + H + ROW[1]) / 2 + 4, anchor: 'start' },
  { d: `M${COL[1] + W} ${mid[1]}H${COL[2] - 4}`, on: [2] },
  { d: `M${COL[2] + W} ${mid[1]}H${COL[3] - 4}`, on: [2] },
  { d: `M${COL[3] + W / 2 + 20} ${ROW[1] + H}V${ROW[1] + H + 18}H${COL[0] + W / 2}V${ROW[1] + H + 4}`, on: [2], label: 'every event is queued', lx: (COL[1] + COL[3]) / 2 + W / 2, ly: ROW[1] + H + 32 },
  { d: `M${COL[0] + W - 20} ${ROW[1]}V${ROW[0] + H + 22}H${COL[1] + 24}V${ROW[0] + H + 4}`, on: [2], label: 'wakes lead', lx: COL[0] + W - 26, ly: ROW[0] + H + 44, anchor: 'end' },
  { d: `M${COL[3] + W / 2 - 20} ${ROW[1] + H}V${ROW[2] - 4}`, on: [3], label: 'lands', lx: COL[3] + W / 2 - 26, ly: ROW[2] - 14, anchor: 'end' },
  { d: `M${COL[1] + 240} ${mid[2]}H${COL[3] - 4}`, on: [3] },
];
const tag = (on: number[]) => on.map((i) => `s${i}`).join(' ');
const label =
  'Data flow of a run. 01: you ask the lead, which writes plan.md. 02: you edit the plan and say go. ' +
  '03: the lead dispatches to the coders, checks run, the reviewer reads the diff, every event is queued for the event manager, which wakes the lead. ' +
  '04: approved milestones land on the feature branch, which becomes one pull request.';
---
<div class="rx" data-rx>
  <ol class="rx-steps">
    {steps.map((s, i) => (
      <li>
        <button type="button" class="rx-step" data-goto={i} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="rx-n">{s.n}</span>
          <span class="rx-text">
            <span class="rx-title">{s.title}</span>
            <code class="rx-cmd">{s.cmd}</code>
            <span class="rx-body">{s.body}</span>
          </span>
        </button>
      </li>
    ))}
  </ol>

  <div class="rx-side">
    <div class="rx-flow">
      <div class="rx-flow-head"><span>data flow</span><span class="rx-stage" aria-live="polite">step <b data-stage>01</b>/04</span></div>
      <svg viewBox="0 0 520 310" role="img" aria-label={label}>
        <defs>
          <marker id="rx-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="context-stroke" /></marker>
        </defs>
        {edges.map((e) => (
          <g class={`rx-edge ${tag(e.on)}`}>
            <path d={e.d} marker-end="url(#rx-arrow)" />
            {e.label && <text x={e.lx} y={e.ly} text-anchor={e.anchor ?? 'middle'}>{e.label}</text>}
          </g>
        ))}
        {nodes.map((n) => (
          <g class={`rx-node ${tag(n.on)}`}>
            <rect x={n.x} y={n.y} width={n.w ?? W} height={H} rx="2" />
            <text class="nm" x={n.x + 10} y={n.y + 18}>{n.name}</text>
            <text class="sb" x={n.x + 10} y={n.y + 33}>{n.sub}</text>
          </g>
        ))}
      </svg>
    </div>

    <div class="term rx-term">
      <div class="bar">
        <i></i><i></i><i></i><span>~/app · lead pane</span>
        <span class="rx-ctrl">
          <button type="button" data-act="play" aria-label="Play">▶ play</button>
          <button type="button" data-act="pause" aria-label="Pause">❚❚ pause</button>
          <button type="button" data-act="step" aria-label="Next line">step →</button>
          <button type="button" data-act="restart" aria-label="Restart">↺</button>
        </span>
      </div>
      <pre class="rx-screen" data-screen>{simLines.map((l) => (
        <div class={`rx-line ${l.cls ?? ''}`} data-stage={l.stage}>{l.prompt && <span class="rx-prompt">{l.prompt} </span>}<span class="rx-t">{l.text}</span>{'\n'}</div>
      ))}</pre>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rx]').forEach((root) => {
    const lines = [...root.querySelectorAll<HTMLElement>('.rx-line')];
    const screen = root.querySelector<HTMLElement>('[data-screen]')!;
    const stepBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const stageEl = root.querySelector<HTMLElement>('[data-stage]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const full = lines.map((l) => l.querySelector<HTMLElement>('.rx-t')!.textContent ?? '');
    let pos = 0;            // next line to show
    let playing = false;
    let timer = 0;
    let stage = -1;

    root.classList.add('live');
    const setStage = (s: number) => {
      if (s === stage) return;
      stage = s;
      root.dataset.active = String(s);
      stepBtns.forEach((b, i) => b.setAttribute('aria-pressed', String(i === s)));
      stageEl.textContent = String(s + 1).padStart(2, '0');
    };
    const setPlaying = (p: boolean) => {
      playing = p;
      root.classList.toggle('playing', p);
      if (!p) clearTimeout(timer);
    };
    const show = (i: number, typed: boolean) => {
      const l = lines[i];
      const t = l.querySelector<HTMLElement>('.rx-t')!;
      lines.forEach((x) => x.classList.remove('cursor'));
      l.classList.add('shown', 'cursor');
      setStage(Number(l.dataset.stage));
      screen.scrollTop = screen.scrollHeight;
      if (!typed || !l.querySelector('.rx-prompt')) { t.textContent = full[i]; return 0; }
      // Type commands a few characters at a time, like a fast typist.
      let n = 0;
      t.textContent = '';
      const step = () => {
        n = Math.min(full[i].length, n + 2);
        t.textContent = full[i].slice(0, n);
        if (n < full[i].length) timer = window.setTimeout(step, 22);
        else if (playing) timer = window.setTimeout(next, 260);
      };
      step();
      return -1;
    };
    const reset = (to: number) => {
      clearTimeout(timer);
      lines.forEach((l, i) => {
        const on = i < to;
        l.classList.toggle('shown', on);
        l.classList.remove('cursor');
        l.querySelector<HTMLElement>('.rx-t')!.textContent = full[i];
      });
      pos = to;
    };
    function next() {
      if (pos >= lines.length) { setPlaying(false); return; }
      const i = pos++;
      const r = show(i, playing && !reduce);
      if (r === 0 && playing) {
        const after = lines[pos];
        const pause = !after ? 0 : after.dataset.stage !== lines[i].dataset.stage ? 900 : after.querySelector('.rx-prompt') ? 420 : 160;
        timer = window.setTimeout(next, pause);
      }
    }
    const play = () => {
      if (pos >= lines.length) reset(0);
      setPlaying(true);
      next();
    };
    const goto = (s: number) => {
      const start = lines.findIndex((l) => Number(l.dataset.stage) === s);
      reset(start);
      setStage(s);
      // earlier steps' output stays above; the screen follows the newest line
      screen.scrollTop = screen.scrollHeight;
      play();
    };

    root.querySelector('[data-act="play"]')!.addEventListener('click', play);
    root.querySelector('[data-act="pause"]')!.addEventListener('click', () => setPlaying(false));
    root.querySelector('[data-act="step"]')!.addEventListener('click', () => {
      setPlaying(false);
      if (pos >= lines.length) reset(0);
      next();
    });
    root.querySelector('[data-act="restart"]')!.addEventListener('click', () => { reset(0); setStage(0); play(); });
    stepBtns.forEach((b, i) => b.addEventListener('click', () => goto(i)));

    reset(0);
    setStage(0);
    if (reduce) { reset(lines.length); screen.scrollTop = 0; return; }
    // Start playing the first time the explainer scrolls into view.
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); play(); }
    }, { threshold: 0.3 });
    io.observe(root);
  });
</script>

<style>
  /* Steps and diagram side by side, the terminal full width under both. */
  .rx { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: 'steps flow' 'term term'; gap: 16px; align-items: stretch; }
  .rx-steps { grid-area: steps; }
  .rx-flow { grid-area: flow; display: flex; flex-direction: column; }
  .rx-flow svg { margin: auto; max-width: 640px; }
  .rx-term { grid-area: term; min-width: 0; }
  @media (max-width: 1100px) { .rx { grid-template-columns: 1fr; grid-template-areas: 'steps' 'flow' 'term'; } }

  /* Numbered steps */
  .rx-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border: 1px solid var(--line); background: var(--bg); }
  .rx-steps li:last-child { flex: 1; }
  .rx-steps li:last-child .rx-step { height: 100%; align-content: start; }
  .rx-steps li + li { border-top: 1px solid var(--line); }
  .rx-step {
    all: unset; box-sizing: border-box; width: 100%; cursor: pointer; display: grid; grid-template-columns: 44px 1fr; gap: 14px;
    padding: 18px 18px 18px 16px; border-left: 2px solid transparent; background: var(--bg);
    transition: background var(--fast) linear, border-color var(--fast) linear;
  }
  .rx-step:hover { background: var(--surface); }
  .rx-step:focus-visible { outline: 1px solid var(--accent); outline-offset: -1px; }
  .rx-n { font: 600 13px var(--font-mono); color: var(--faint); border: 1px solid var(--line-strong); height: 26px; display: grid; place-items: center; transition: color var(--fast) linear, border-color var(--fast) linear, background var(--fast) linear; }
  .rx-title { display: block; font: 600 15px/1.35 var(--font-mono); letter-spacing: -0.02em; color: var(--text); }
  .rx-cmd { display: inline-block; margin-top: 8px; font-size: 12px; color: var(--muted); }
  .rx-body { display: block; margin-top: 8px; color: var(--muted); font-size: 15px; line-height: 1.55; }
  .rx-step[aria-pressed='true'] { border-left-color: var(--accent); background: var(--surface); }
  .rx-step[aria-pressed='true'] .rx-n { color: #0d0e11; background: var(--accent); border-color: var(--accent); }
  .rx-step[aria-pressed='true'] .rx-cmd { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
  /* Collapse the inactive explanations once the script runs, so the active one stands out. */
  .rx.live .rx-step[aria-pressed='false'] .rx-body { display: none; }

  /* Diagram */
  .rx-side { display: contents; }
  .rx-flow { border: 1px solid var(--line); background: var(--surface); }
  .rx-flow-head { display: flex; justify-content: space-between; padding: 8px 14px; border-bottom: 1px solid var(--line); font: 12px var(--font-mono); color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .rx-stage b { color: var(--accent); font-weight: 600; }
  .rx-flow svg { display: block; width: 100%; height: auto; padding: 8px 10px 4px; }
  .rx-node rect { fill: var(--surface-2); stroke: var(--line-strong); stroke-width: 1; transition: stroke var(--fast) linear, fill var(--fast) linear; }
  .rx-node text { transition: fill var(--fast) linear; }
  .rx-node .nm { font: 600 12.5px var(--font-mono); fill: var(--text); }
  .rx-node .sb { font: 10.5px var(--font-sans); fill: var(--muted); }
  .rx-edge path { fill: none; stroke: var(--line-strong); stroke-width: 1.25; transition: stroke var(--fast) linear; }
  .rx-edge text { font: 10.5px var(--font-mono); fill: var(--faint); transition: fill var(--fast) linear; }

  /* With JS: everything dims except the active step's nodes and edges. */
  .rx.live .rx-node, .rx.live .rx-edge { opacity: 0.35; transition: opacity var(--fast) linear; }
  .rx[data-active='0'] .s0, .rx[data-active='1'] .s1, .rx[data-active='2'] .s2, .rx[data-active='3'] .s3 { opacity: 1; }
  .rx[data-active='0'] .rx-node.s0 rect, .rx[data-active='1'] .rx-node.s1 rect,
  .rx[data-active='2'] .rx-node.s2 rect, .rx[data-active='3'] .rx-node.s3 rect {
    stroke: var(--accent); fill: color-mix(in srgb, var(--accent) 9%, var(--surface-2));
  }
  .rx[data-active='0'] .rx-node.s0 .nm, .rx[data-active='1'] .rx-node.s1 .nm,
  .rx[data-active='2'] .rx-node.s2 .nm, .rx[data-active='3'] .rx-node.s3 .nm { fill: var(--accent); }
  .rx[data-active='0'] .rx-edge.s0 path, .rx[data-active='1'] .rx-edge.s1 path,
  .rx[data-active='2'] .rx-edge.s2 path, .rx[data-active='3'] .rx-edge.s3 path {
    stroke: var(--accent); stroke-dasharray: 5 4; animation: rx-flow 0.6s linear infinite;
  }
  .rx[data-active='0'] .rx-edge.s0 text, .rx[data-active='1'] .rx-edge.s1 text,
  .rx[data-active='2'] .rx-edge.s2 text, .rx[data-active='3'] .rx-edge.s3 text { fill: var(--text); }
  @keyframes rx-flow { to { stroke-dashoffset: -9; } }
  @media (prefers-reduced-motion: reduce) { .rx-edge path { animation: none !important; } }

  /* Terminal simulation */
  .rx-term .bar { flex-wrap: wrap; row-gap: 6px; }
  .rx-ctrl { margin-left: auto; display: flex; gap: 4px; }
  .rx-ctrl button {
    font: 11.5px var(--font-mono); color: #b9bec8; background: transparent; border: 1px solid #343a47; border-radius: 2px;
    padding: 2px 8px; cursor: pointer; white-space: nowrap; transition: color var(--fast) linear, border-color var(--fast) linear;
  }
  .rx-ctrl button:hover { color: #e5a93b; border-color: #e5a93b; }
  .rx.playing [data-act='play'], .rx:not(.playing) [data-act='pause'] { color: #e5a93b; border-color: color-mix(in srgb, #e5a93b 50%, #343a47); }
  .rx-screen { height: 320px; overflow-y: auto !important; overflow-x: hidden !important; white-space: pre-wrap !important; word-break: break-word; }
  .rx-line { display: block; }
  .rx.live .rx-line { display: none; }
  .rx.live .rx-line.shown { display: block; animation: rx-in 0.15s linear; }
  @keyframes rx-in { from { opacity: 0; } }
  .rx-prompt { color: #e5a93b; }
  .rx-line.cursor .rx-t::after { content: ''; display: inline-block; width: 0.6em; height: 1.1em; vertical-align: -0.2em; margin-left: 2px; background: #e5a93b; animation: blink 1.1s steps(1) infinite; }
  @media (max-width: 560px) {
    /* Phone: the whole diagram fits; names get bigger and the small second lines step aside. */
    .rx-flow svg { padding: 6px 4px 2px; }
    .rx-node .nm { font-size: 12.5px; transform: translateY(7px); }
    .rx-node .sb { display: none; }
    .rx-edge text { font-size: 13px; }
    .rx-screen { height: 280px; font-size: 12px !important; }
    .rx-ctrl { margin-left: 0; width: 100%; }
    .rx-ctrl button { flex: 1; }
  }
</style>
