---
// How the lead is woken, drawn like a browser's call stack, Web APIs, callback queue and event loop.
// Event kinds and commands are the real ones (docs/contracts.md "The lead's event queue").
// Without animation it shows the moment a batch is waiting; with it, it plays the whole story once.
const agents = [
  { y: 92, name: 'claude-1', work: 'building M1', event: 'M1 checked and merged', cls: 'coder' },
  { y: 134, name: 'codex-1', work: 'building M2', event: 'M2 paused: a question', cls: 'coder' },
  { y: 176, name: 'opencode-1', work: 'building M3', event: 'M3 still failing after its rounds', cls: 'coder' },
];
const queue = [
  { x: 180, kind: 'merged', task: 'M1', cls: 'good' },
  { x: 312, kind: 'ready', task: 'M4', cls: 'auto' },
  { x: 444, kind: 'paused', task: 'M2', cls: 'lead' },
  { x: 576, kind: 'failed', task: 'M3', cls: 'bad' },
];
// The lead's frames after it is woken, bottom first.
const frames = ['orch events   → 4 events', 'orch dispatch M4', 'orch answer M2 "skip empty rows"', 'orch dispatch M3 --tier high'];
const label =
  'How the lead is woken, like a browser event loop. Agents work in the background like Web APIs: claude-1 finishes M1, codex-1 pauses M2 with a question, opencode-1 is still failing M3 after its fix rounds, and M1 landing makes M4 ready. ' +
  'Each event is stored in the event queue. While the lead is busy the events wait. When the lead is idle, the event manager, orch autopilot, wakes it once with the whole batch, ' +
  'like the event loop pushing a callback onto an empty call stack. The lead reads its events, dispatches M4 that M1 unlocked, answers M2 (the answer goes back to codex-1), and sends M3 to a stronger model.';
---
<div class="evloop">
  <svg class="dg dg-loop" viewBox="0 0 760 420" role="img" aria-label={label}>
    <defs>
      <marker id="el-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="arrowhead" d="M0 0L10 5L0 10z" /></marker>
      <marker id="el-arrow-lead" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--lead)" /></marker>
    </defs>

    <!-- Lead = call stack -->
    <rect class="panel lead" x="24" y="24" width="316" height="194" rx="12" />
    <text x="42" y="50" font-size="14" font-weight="700">Lead</text>
    <text class="quiet" x="84" y="50" font-size="11.5">like the call stack</text>
    <text class="quiet ev-busy-note" x="322" y="50" font-size="11" text-anchor="end">busy</text>
    <text class="ev-idle-note" x="322" y="50" font-size="11" text-anchor="end">woken</text>
    <g class="ev-busy">
      <rect class="frame" x="40" y="174" width="284" height="30" rx="6" />
      <text x="54" y="194" font-size="12">talking to you about the plan…</text>
    </g>
    {frames.map((f, i) => (
      <g class={`ev-frame ev-f${i}`}>
        <rect class="frame lead" x="40" y={174 - i * 36} width="284" height="30" rx="6" />
        <text x="54" y={194 - i * 36} font-size="12" style="font-family:var(--font-mono)">{f}</text>
      </g>
    ))}

    <!-- Agents = Web APIs -->
    <rect class="panel" x="420" y="24" width="316" height="194" rx="12" />
    <text x="438" y="50" font-size="14" font-weight="700">Agents</text>
    <text class="quiet" x="496" y="50" font-size="11.5">like Web APIs: work in the background</text>
    {agents.map((a, i) => (
      <g class={`ev-agent ev-a${i}`}>
        <rect class={`frame ${a.cls}`} x="436" y={a.y - 20} width="284" height="32" rx="6" />
        <text x="450" y={a.y + 1} font-size="12" font-weight="600" style="font-family:var(--font-mono)">{a.name}</text>
        <text class="quiet ev-work" x="546" y={a.y + 1} font-size="12">{a.work}</text>
        <text class="ev-event" x="546" y={a.y + 1} font-size="12">{a.event}</text>
      </g>
    ))}
    <text class="ev-reply" x="546" y="135" font-size="12" fill="var(--lead)">got the answer, building M2</text>

    <!-- answer goes back to the same coder -->
    <path class="edge ev-answer" d="M340 130H434" marker-end="url(#el-arrow)" />
    <text class="quiet" x="386" y="120" font-size="11" text-anchor="middle">answer</text>
    <text class="quiet" x="386" y="148" font-size="11" text-anchor="middle">to the</text>
    <text class="quiet" x="386" y="161" font-size="11" text-anchor="middle">same coder</text>

    <!-- agents -> queue -->
    <path class="edge" d="M578 218V262" marker-end="url(#el-arrow)" />
    <text class="quiet" x="588" y="244" font-size="11">every event is stored first</text>

    <!-- Event queue = callback queue -->
    <rect class="panel" x="160" y="266" width="576" height="84" rx="12" />
    <text x="176" y="288" font-size="14" font-weight="700">Event queue</text>
    <text class="quiet" x="270" y="288" font-size="11.5">like the callback queue · kept in state.json, so none is missed</text>
    {queue.map((q, i) => (
      <g class={`ev-card ev-c${i}`}>
        <rect class={`card-ev ${q.cls}`} x={q.x} y="302" width="120" height="36" rx="8" />
        <text x={q.x + 14} y="325" font-size="12" style="font-family:var(--font-mono)" font-weight="600">{q.kind}</text>
        <text class="quiet" x={q.x + 106} y="325" font-size="12" text-anchor="end" style="font-family:var(--font-mono)">{q.task}</text>
      </g>
    ))}

    <text class="quiet ev-empty" x="448" y="325" font-size="12" text-anchor="middle">empty: the lead read them all</text>

    <!-- Event manager = event loop -->
    <g class="ev-loop-wrap">
      <circle class="loop-ring" cx="88" cy="310" r="36" />
      <path class="ev-loop-arrow" d="M88 284A26 26 0 1 1 62 310" marker-end="url(#el-arrow-lead)" />
    </g>
    <path class="edge" d="M160 310H128" marker-end="url(#el-arrow)" />
    <path class="edge ev-wake" d="M88 272V222" marker-end="url(#el-arrow)" />
    <text class="quiet" x="98" y="244" font-size="11">wakes it once per batch,</text>
    <text class="quiet" x="98" y="258" font-size="11">only when it is idle</text>
    <text x="88" y="368" font-size="13" font-weight="700" text-anchor="middle">Event manager</text>
    <text class="quiet" x="88" y="384" font-size="11" text-anchor="middle" style="font-family:var(--font-mono)">orch autopilot</text>
    <text class="quiet" x="88" y="399" font-size="11" text-anchor="middle">like the event loop</text>

    <text class="quiet" x="160" y="380" font-size="11.5">Lead away? Nothing is lost: it is woken again after 5 minutes (3 times), then you are told,</text>
    <text class="quiet" x="160" y="396" font-size="11.5">and ready work starts by itself after 15 minutes.</text>
  </svg>
  <dl class="evmap">
    <div><dt>In a browser</dt><dd>Web APIs run a timer or a fetch in the background.</dd></div>
    <div><dt>In a run</dt><dd>Coders and the reviewer work in their own panes.</dd></div>
    <div><dt>In a browser</dt><dd>When one finishes, its callback waits in the queue.</dd></div>
    <div><dt>In a run</dt><dd>When one finishes or asks, an event waits in the queue.</dd></div>
    <div><dt>In a browser</dt><dd>The event loop runs a callback only when the call stack is empty.</dd></div>
    <div><dt>In a run</dt><dd>The event manager wakes the lead only when it is idle, with the whole batch.</dd></div>
  </dl>
</div>

<script>
  // Play the story once when it scrolls into view (CSS holds it at the start until then).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.evloop').forEach((el) => {
    if (reduce) return;
    el.classList.add('anim');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        el.classList.add('play');
      },
      { threshold: 0.4 },
    );
    io.observe(el);
  });
</script>

<style>
  .evloop .panel { fill: var(--surface-2); stroke: var(--line-strong); stroke-width: 1.25; }
  .evloop .panel.lead { stroke: var(--lead); }
  .evloop .frame { fill: var(--surface); stroke: var(--line-strong); }
  .evloop .frame.lead { fill: color-mix(in srgb, var(--lead) 12%, var(--surface)); stroke: var(--lead); }
  .evloop .frame.coder { stroke: color-mix(in srgb, var(--coder) 60%, var(--line-strong)); }
  .evloop .card-ev { fill: var(--surface); stroke-width: 1.5; }
  .evloop .card-ev.good { stroke: var(--good); }
  .evloop .card-ev.lead { stroke: var(--lead); }
  .evloop .card-ev.bad { stroke: var(--bad); }
  .evloop .card-ev.auto { stroke: var(--auto); }
  .evloop .loop-ring { fill: color-mix(in srgb, var(--lead) 10%, var(--surface-2)); stroke: var(--lead); stroke-width: 1.25; }
  .evloop .ev-loop-arrow { fill: none; stroke: var(--lead); stroke-width: 2.5; }
  .evloop .ev-idle-note { fill: var(--lead); }

  /* Still picture (no animation): a batch is waiting while the lead is busy. */
  .evloop .ev-work, .evloop .ev-frame, .evloop .ev-reply, .evloop .ev-idle-note, .evloop .ev-empty { opacity: 0; }

  .evloop svg { min-width: 640px; }
  .evmap { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; margin: 22px 0 0; }
  .evmap div { display: flex; gap: 10px; align-items: baseline; }
  .evmap dt { flex: 0 0 104px; white-space: nowrap; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--faint); }
  .evmap div:nth-child(even) dt { color: var(--lead); }
  .evmap dd { margin: 0; font-size: 14.5px; color: var(--muted); }
  @media (max-width: 720px) { .evmap { grid-template-columns: 1fr; } .evmap div:nth-child(even) { margin-bottom: 8px; } }

  /* Animated story, 10s, played once. Paused at 0% until it scrolls into view. */
  .evloop.anim .ev-work, .evloop.anim .ev-event, .evloop.anim .ev-card, .evloop.anim .ev-busy, .evloop.anim .ev-busy-note,
  .evloop.anim .ev-idle-note, .evloop.anim .ev-frame, .evloop.anim .ev-reply, .evloop.anim .ev-empty, .evloop.anim .ev-loop-arrow,
  .evloop.anim .ev-wake, .evloop.anim .ev-answer {
    animation-duration: 10s; animation-fill-mode: both; animation-timing-function: ease; animation-play-state: paused;
  }
  .evloop.anim.play * { animation-play-state: running !important; }
  .evloop.anim .ev-card, .evloop.anim .ev-loop-arrow { transform-box: fill-box; transform-origin: center; }

  .evloop.anim .ev-a0 .ev-work { animation-name: ev-out-12; }
  .evloop.anim .ev-a0 .ev-event { animation-name: ev-in-12; }
  .evloop.anim .ev-a1 .ev-work { animation-name: ev-out-22; }
  .evloop.anim .ev-a1 .ev-event { animation-name: ev-in-22-out; }
  .evloop.anim .ev-a2 .ev-work { animation-name: ev-out-32; }
  .evloop.anim .ev-a2 .ev-event { animation-name: ev-in-32; }
  .evloop.anim .ev-c0 { animation-name: ev-card-0; }
  .evloop.anim .ev-c1 { animation-name: ev-card-1; }
  .evloop.anim .ev-c2 { animation-name: ev-card-2; }
  .evloop.anim .ev-c3 { animation-name: ev-card-3; }
  .evloop.anim .ev-busy, .evloop.anim .ev-busy-note { animation-name: ev-busy; }
  .evloop.anim .ev-idle-note { animation-name: ev-in-60; }
  .evloop.anim .ev-loop-arrow { animation-name: ev-spin; }
  .evloop.anim .ev-wake { animation-name: ev-flash-60; }
  .evloop.anim .ev-f0 { animation-name: ev-in-64; }
  .evloop.anim .ev-f1 { animation-name: ev-in-72; }
  .evloop.anim .ev-f2 { animation-name: ev-in-80; }
  .evloop.anim .ev-f3 { animation-name: ev-in-88; }
  .evloop.anim .ev-answer { animation-name: ev-flash-82; }
  .evloop.anim .ev-reply { animation-name: ev-in-84; }
  .evloop.anim .ev-empty { animation-name: ev-in-72; }

  @keyframes ev-out-12 { 0%, 12% { opacity: 1; } 15%, 100% { opacity: 0; } }
  @keyframes ev-out-22 { 0%, 22% { opacity: 1; } 25%, 100% { opacity: 0; } }
  @keyframes ev-out-32 { 0%, 32% { opacity: 1; } 35%, 100% { opacity: 0; } }
  @keyframes ev-in-12 { 0%, 13% { opacity: 0; } 16%, 100% { opacity: 1; } }
  @keyframes ev-in-22-out { 0%, 23% { opacity: 0; } 26%, 82% { opacity: 1; } 84%, 100% { opacity: 0; } }
  @keyframes ev-in-32 { 0%, 33% { opacity: 0; } 36%, 100% { opacity: 1; } }
  @keyframes ev-card-0 { 0%, 14% { opacity: 0; transform: translateY(-24px); } 18%, 52% { opacity: 1; transform: none; } 60%, 100% { opacity: 0; transform: translateX(-80px); } }
  @keyframes ev-card-1 { 0%, 17% { opacity: 0; transform: translateY(-24px); } 21%, 53% { opacity: 1; transform: none; } 61%, 100% { opacity: 0; transform: translateX(-212px); } }
  @keyframes ev-card-2 { 0%, 24% { opacity: 0; transform: translateY(-24px); } 28%, 54% { opacity: 1; transform: none; } 62%, 100% { opacity: 0; transform: translateX(-344px); } }
  @keyframes ev-card-3 { 0%, 34% { opacity: 0; transform: translateY(-24px); } 38%, 56% { opacity: 1; transform: none; } 64%, 100% { opacity: 0; transform: translateX(-476px); } }
  @keyframes ev-busy { 0%, 44% { opacity: 1; } 49%, 100% { opacity: 0; } }
  @keyframes ev-spin { 0%, 50% { transform: rotate(0); } 64%, 100% { transform: rotate(720deg); } }
  @keyframes ev-flash-60 { 0%, 58% { stroke: var(--line-strong); } 62%, 70% { stroke: var(--lead); stroke-width: 2.5; } 76%, 100% { stroke: var(--line-strong); } }
  @keyframes ev-flash-82 { 0%, 80% { stroke: var(--line-strong); } 83%, 92% { stroke: var(--lead); stroke-width: 2.5; } 100% { stroke: var(--line-strong); } }
  @keyframes ev-in-60 { 0%, 58% { opacity: 0; } 62%, 100% { opacity: 1; } }
  @keyframes ev-in-64 { 0%, 63% { opacity: 0; } 67%, 100% { opacity: 1; } }
  @keyframes ev-in-72 { 0%, 71% { opacity: 0; } 75%, 100% { opacity: 1; } }
  @keyframes ev-in-80 { 0%, 79% { opacity: 0; } 83%, 100% { opacity: 1; } }
  @keyframes ev-in-84 { 0%, 84% { opacity: 0; } 88%, 100% { opacity: 1; } }
  @keyframes ev-in-88 { 0%, 87% { opacity: 0; } 91%, 100% { opacity: 1; } }
</style>
