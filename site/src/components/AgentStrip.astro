---
// Agent tiles with each agent's mark, read from agents.default.toml.
import { agents } from '../lib/repo';
import AgentIcon from './AgentIcon.astro';
---
<div class="agents">
  {agents().map((a) => (
    <a class="agent" href={`/agents#${a.kind}`}>
      <span class="logo"><AgentIcon kind={a.kind} /></span>
      <span><span class="name">{a.name}</span><span class="bin">{a.binary}</span></span>
    </a>
  ))}
  <a class="agent yours" href="/docs/agents#add-your-own-agent">
    <span class="logo" aria-hidden="true">+</span>
    <span><span class="name">Your agent</span><span class="bin">agents.toml</span></span>
  </a>
</div>
