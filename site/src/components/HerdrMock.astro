---
// A Herdr window with the four panes of a team, in two modes:
//   orch autopilot  one run: the lead plans and dispatches, two coders build in their own worktrees, the reviewer
//                   reads the diff (read-only) and the event manager merges.
//   orch resume     the computer goes off mid-milestone for 1h49m; timers stop, the worktrees keep their files,
//                   and `orch resume` names the panes again and re-sends the work (bin/orch cmd_resume).
// Play / Pause, Step and Replay drive it; nothing loops. Without JavaScript the end of the first mode shows.
type PaneKey = 'lead' | 'coder-1' | 'coder-2' | 'reviewer';
type Line = [PaneKey, string, string?];
type St = [cls: string, label: string];
type Step = { add?: Line[]; set?: Partial<Record<PaneKey, St>>; foot?: [string, string?]; meter: string };
type Mode = { id: string; tab: string; title: string; kinds: Record<PaneKey, string>; steps: Step[] };

const W: St = ['working', 'working'], I: St = ['idle', 'idle'], P: St = ['plan', 'paused'], R: St = ['review', 'reviewing'];
const OFF: St = ['off', 'off'], LOST: St = ['lost', 'no name'];
const keys: PaneKey[] = ['lead', 'coder-1', 'coder-2', 'reviewer'];

const modes: Mode[] = [
  {
    id: 'autopilot', tab: 'orch autopilot', title: 'herdr · csv-import',
    kinds: { lead: 'claude · opus', 'coder-1': 'claude · sonnet', 'coder-2': 'codex · sol', reviewer: 'claude · opus' },
    steps: [
      { add: [['lead', '› /orch-plan CSV import', 't-lead']], set: { lead: ['plan', 'planning'] }, meter: 'merged 0/2 · active 0:00:00' },
      { add: [['lead', 'plan.md: M1 endpoint ∥ M2 page', 't-dim'], ['lead', 'M1 → coder-1 · M2 → coder-2', 't-dim']], meter: 'merged 0/2 · active 0:00:00' },
      { add: [['lead', '$ orch dispatch M1 M2', 't-ok']], set: { lead: P }, foot: ['[14:02:11] autopilot started: worktree mode, max 2 parallel', 't-dim'], meter: 'merged 0/2 · active 0:00:00' },
      {
        add: [['coder-1', 'M1 POST /imports', 't-coder'], ['coder-1', '~/app-wt/coder-1', 't-dim'], ['coder-2', 'M2 import page', 't-coder'], ['coder-2', '~/app-wt/coder-2', 't-dim']],
        set: { 'coder-1': W, 'coder-2': W }, foot: ['[14:02:12] M1 -> coder-1', 't-coder'], meter: 'merged 0/2 · active 0:00:01',
      },
      { add: [['coder-1', 'edit server/imports/parse.ts'], ['coder-2', 'edit web/src/pages/Import.tsx']], foot: ['[14:02:12] M2 -> coder-2', 't-coder'], meter: 'merged 0/2 · active 0:04:30' },
      { add: [['coder-1', 'npm test … 48 passed', 't-ok'], ['coder-1', 'done-1 ✓', 't-dim']], set: { 'coder-1': I }, foot: ['[14:09:40] M1 done by coder-1 -> running checks'], meter: 'merged 0/2 · active 0:07:29' },
      { add: [['reviewer', 'M1 diff: +142 −8, 4 files', 't-rev'], ['reviewer', 'read-only: no Edit tool', 't-dim']], set: { reviewer: R }, meter: 'merged 0/2 · active 0:08:10' },
      { add: [['coder-2', 'npm test … 51 passed', 't-ok'], ['coder-2', 'done-1 ✓', 't-dim']], set: { 'coder-2': I }, foot: ['[14:11:52] M2 done by coder-2 -> running checks'], meter: 'merged 0/2 · active 0:09:41' },
      { add: [['reviewer', 'AC1–AC3 met, no blockers ✓', 't-ok']], foot: ['[14:13:05] M1 checked and merged into feature/csv-import', 't-ok'], meter: 'merged 1/2 · active 0:10:54' },
      { add: [['reviewer', 'M2 diff: +96 −3, 2 files', 't-rev'], ['reviewer', 'AC1–AC2 met, no blockers ✓', 't-ok']], set: { reviewer: I }, foot: ['[14:15:20] M2 checked and merged into feature/csv-import', 't-ok'], meter: 'merged 2/2 · active 0:13:09' },
      { add: [['lead', 'woken: merged M1, merged M2', 't-lead']], set: { lead: W }, foot: ['[14:15:21] woke the lead (lead): 2 event(s) — merged M1, merged M2', 't-lead'], meter: 'merged 2/2 · active 0:13:10' },
      { add: [['lead', 'ALL_DONE · final check PASS', 't-ok']], set: { lead: I }, foot: ['[14:15:48] ALL_DONE on feature/csv-import — final check PASS', 't-ok'], meter: 'merged 2/2 · active 0:13:37' },
    ],
  },
  {
    id: 'resume', tab: 'orch resume', title: 'herdr · csv-import · after a restart',
    kinds: { lead: 'claude · opus', 'coder-1': 'claude · sonnet', 'coder-2': 'codex · sol', reviewer: 'claude · opus' },
    steps: [
      {
        add: [['coder-1', 'M2 import endpoint', 't-coder'], ['coder-1', 'edit server/imports/parse.ts'], ['coder-2', 'M3 import page', 't-coder'], ['coder-2', 'edit web/src/pages/Import.tsx']],
        set: { lead: P, 'coder-1': W, 'coder-2': W }, foot: ['14:22 · two coders mid-milestone, lead paused', 't-dim'],
        meter: 'M2 0:18:04/0:40:00 · M3 0:12:40/0:30:00 · not counted 0:00:00',
      },
      { set: { lead: OFF, 'coder-1': OFF, 'coder-2': OFF, reviewer: OFF }, foot: ['14:22:20 · computer off: herdr and orch stop', 't-bad'], meter: 'M2 0:18:04/0:40:00 · M3 0:12:40/0:30:00 · not counted 0:00:00' },
      {
        add: [['coder-1', 'herdr pane 2: no agent name', 't-dim'], ['coder-2', 'herdr pane 3: no agent name', 't-dim']],
        set: { lead: I, 'coder-1': LOST, 'coder-2': LOST, reviewer: LOST },
        foot: ['16:11:20 · back after 1h49m. Counted, M2 would be 2:07:04/0:40:00', 't-bad'],
        meter: 'M2 0:18:04/0:40:00 · M3 0:12:40/0:30:00 · not counted 0:00:00',
      },
      { add: [['lead', '$ orch resume', 't-lead']], set: { lead: W }, meter: 'M2 0:18:04/0:40:00 · M3 0:12:40/0:30:00 · not counted 0:00:00' },
      {
        add: [['lead', 'DOWN 1h49m: not counted', 't-ok'], ['lead', 'WAS M2: coder-1 was working', 't-dim'], ['lead', 'WAS M3: coder-2 was working', 't-dim']],
        foot: ['every open wait moved forward by 1h49m: no false timeout', 't-ok'], meter: 'M2 0:18:04/0:40:00 · M3 0:12:40/0:30:00 · not counted 1:49:00',
      },
      {
        add: [['lead', 'NAMED coder-1, coder-2, reviewer', 't-ok'], ['coder-1', 'git status: 3 files, kept', 't-dim'], ['coder-2', 'git status: 2 files, kept', 't-dim']],
        set: { 'coder-1': I, 'coder-2': I, reviewer: I }, foot: ['panes found by folder: ~/app-wt/coder-1, ~/app-wt/coder-2', 't-dim'],
        meter: 'M2 0:18:04/0:40:00 · M3 0:12:40/0:30:00 · not counted 1:49:00',
      },
      {
        add: [['lead', 'RESENT M2 -> coder-1, M3 -> coder-2', 't-ok'], ['coder-1', 'task again: carry on, keep files', 't-dim'], ['coder-2', 'task again: carry on, keep files', 't-dim']],
        set: { 'coder-1': W, 'coder-2': W }, meter: 'M2 0:18:05/0:40:00 · M3 0:12:41/0:30:00 · not counted 1:49:00',
      },
      {
        add: [['lead', 'event manager started', 't-dim'], ['coder-1', 'carry on: parse.ts', 't-coder'], ['coder-2', 'carry on: Import.tsx', 't-coder']],
        set: { lead: P }, foot: ['[16:11:31] autopilot started: worktree mode, max 2 parallel', 't-dim'],
        meter: 'M2 0:18:15/0:40:00 · M3 0:12:51/0:30:00 · not counted 1:49:00',
      },
      {
        add: [['coder-1', 'npm test … 48 passed', 't-ok']], set: { 'coder-1': I }, foot: ['[16:13:00] M2 done by coder-1 -> running checks'],
        meter: 'M2 0:19:44/0:40:00 · M3 0:14:20/0:30:00 · not counted 1:49:00',
      },
    ],
  },
];

// Per step: each pane's state, and the footer (last log line and the counters).
const statesOf = (m: Mode) => {
  let cur: Record<PaneKey, St> = { lead: I, 'coder-1': I, 'coder-2': I, reviewer: I };
  return m.steps.map((s) => (cur = { ...cur, ...s.set }));
};
const footOf = (m: Mode) => {
  let cur: [string, string?] = ['', 't-dim'];
  return m.steps.map((s) => ({ log: (cur = s.foot ?? cur)[0], cls: cur[1] ?? '', meter: s.meter }));
};
const label =
  'A Herdr window with four panes and two modes. orch autopilot: the lead plans M1 and M2 and dispatches them, coder-1 and coder-2 build in their own git worktrees, the reviewer reads each diff without editing, and the event manager merges both. ' +
  'orch resume: the computer goes off for 1h49m mid-milestone; the timers stop, the worktrees keep their files, and orch resume names the panes again and re-sends the work, so no milestone times out.';
---
<div class="term hm" data-hm aria-label={label} role="region">
  <div class="bar hm-bar">
    <i></i><i></i><i></i>
    <span class="hm-tabs" role="tablist" aria-label="Mode">
      {modes.map((m, i) => (
        <button type="button" role="tab" class="hm-tab" id={`hm-tab-${m.id}`} aria-controls={`hm-${m.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-mode={m.id}>{m.tab}</button>
      ))}
    </span>
    <span class="hm-ctrl">
      <button type="button" data-hm-act="play" aria-label="Play">play</button>
      <button type="button" data-hm-act="step" aria-label="Next step">step →</button>
      <button type="button" data-hm-act="replay" aria-label="Replay from the start">replay</button>
    </span>
  </div>
  {modes.map((m, mi) => {
    const states = statesOf(m);
    const foot = footOf(m);
    const lastSt = states[states.length - 1];
    const lastFoot = foot[foot.length - 1];
    return (
      <div class="hm-mode" id={`hm-${m.id}`} role="tabpanel" aria-labelledby={`hm-tab-${m.id}`} data-hm-mode={m.id} data-steps={m.steps.length}
        data-foot={JSON.stringify(foot)} hidden={mi !== 0}>
        <div class="herdr">
          {keys.map((k) => (
            <div class="pane" data-pane={k} data-states={JSON.stringify(states.map((s) => s[k]))}>
              <div class="title"><b>{k} <span class="t-dim">({m.kinds[k]})</span></b><span class={`state ${lastSt[k][0]}`} data-state>{lastSt[k][1]}</span></div>
              {m.steps.flatMap((s, si) => (s.add ?? []).filter(([p]) => p === k).map(([, text, cls]) => (
                <div class={`line ${cls ?? ''}`} data-seq={si}>{text}</div>
              )))}
            </div>
          ))}
        </div>
        <div class="hm-foot">
          <span class={`hm-log ${lastFoot.cls}`} data-log>{lastFoot.log}</span>
          <span class="hm-meter" data-meter>{lastFoot.meter}</span>
          <span class="hm-pos"><b data-pos>{m.steps.length}</b>/{m.steps.length}</span>
        </div>
      </div>
    );
  })}
</div>

<script>
  type Foot = { log: string; cls: string; meter: string };
  document.querySelectorAll<HTMLElement>('[data-hm]').forEach((root) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.hm-tab')];
    const playBtn = root.querySelector<HTMLButtonElement>('[data-hm-act="play"]')!;
    let mode = root.querySelector<HTMLElement>('[data-hm-mode]:not([hidden])')!;
    let step = -1;
    let timer = 0;
    let playing = false;

    const total = () => Number(mode.dataset.steps);
    const render = () => {
      const foot = (JSON.parse(mode.dataset.foot!) as Foot[])[Math.max(0, step)];
      mode.querySelectorAll<HTMLElement>('.line').forEach((l) => l.classList.toggle('shown', Number(l.dataset.seq) <= step));
      mode.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => {
        const [cls, text] = (JSON.parse(p.dataset.states!) as [string, string][])[Math.max(0, step)];
        const el = p.querySelector<HTMLElement>('[data-state]')!;
        el.classList.remove('working', 'idle', 'plan', 'review', 'off', 'lost');
        el.classList.add(step < 0 ? 'idle' : cls);
        el.textContent = step < 0 ? 'idle' : text;
        p.classList.toggle('is-off', step >= 0 && cls === 'off');
      });
      const log = mode.querySelector<HTMLElement>('[data-log]')!;
      log.textContent = step < 0 ? '' : foot.log;
      log.classList.remove('t-dim', 't-ok', 't-bad', 't-lead', 't-coder', 't-rev');
      if (foot.cls) log.classList.add(foot.cls);
      mode.querySelector<HTMLElement>('[data-meter]')!.textContent = foot.meter;
      mode.querySelector<HTMLElement>('[data-pos]')!.textContent = String(step + 1);
    };
    const setPlaying = (on: boolean) => {
      playing = on;
      clearTimeout(timer);
      playBtn.textContent = on ? 'pause' : 'play';
      playBtn.setAttribute('aria-label', on ? 'Pause' : 'Play');
      root.classList.toggle('playing', on);
      if (on) timer = window.setTimeout(tick, step < 0 ? 200 : 900);
    };
    function tick() {
      if (step >= total() - 1) { setPlaying(false); return; }
      step++;
      render();
      if (playing) timer = window.setTimeout(tick, 900);
      if (step >= total() - 1) setPlaying(false);
    }
    const replay = () => { step = -1; render(); setPlaying(true); };

    playBtn.addEventListener('click', () => {
      if (playing) return setPlaying(false);
      if (step >= total() - 1) { step = -1; render(); }
      setPlaying(true);
    });
    root.querySelector('[data-hm-act="step"]')!.addEventListener('click', () => {
      setPlaying(false);
      if (step >= total() - 1) step = -1;
      step++;
      render();
    });
    root.querySelector('[data-hm-act="replay"]')!.addEventListener('click', replay);

    const choose = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${x.getAttribute('aria-controls')}`)!.hidden = !on;
      });
      if (focus) t.focus();
      mode = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!;
      if (reduce) { setPlaying(false); step = total() - 1; render(); } else replay();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { if (t.getAttribute('aria-selected') !== 'true') choose(t); });
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        choose(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });

    root.classList.add('live');
    if (reduce) { step = total() - 1; render(); return; }
    step = -1;
    render();
    // Play once, the first time it is on screen.
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); if (step < 0) setPlaying(true); }
    }, { threshold: 0.4 });
    io.observe(root);
  });
</script>

<style>
  .hm-bar { flex-wrap: wrap; row-gap: 6px; padding-top: 0 !important; padding-bottom: 0 !important; }
  .hm-bar > i { align-self: center; }
  .hm-tabs { display: flex; margin-left: 10px !important; align-self: stretch; }
  .hm-tab {
    all: unset; box-sizing: border-box; cursor: pointer; padding: 8px 12px; font: 12px var(--font-mono); color: #8e95a5;
    border-bottom: 2px solid transparent; border-left: 1px solid #22262f; transition: color var(--fast) linear, border-color var(--fast) linear;
  }
  .hm-tab:last-child { border-right: 1px solid #22262f; }
  .hm-tab:hover { color: #d8dae0; }
  .hm-tab[aria-selected='true'] { color: #e5a93b; border-bottom-color: #e5a93b; background: #0a0b0d; }
  .hm-tab:focus-visible { outline: 1px solid #e5a93b; outline-offset: -1px; }
  .hm-ctrl { margin-left: auto !important; display: flex; gap: 4px; padding: 6px 0; }
  .hm-ctrl button {
    font: 11.5px var(--font-mono); color: #b9bec8; background: transparent; border: 1px solid #343a47; border-radius: 2px;
    padding: 2px 8px; cursor: pointer; white-space: nowrap; transition: color var(--fast) linear, border-color var(--fast) linear;
  }
  .hm-ctrl button:hover { color: #e5a93b; border-color: #e5a93b; }
  .hm.playing [data-hm-act='play'] { color: #e5a93b; border-color: color-mix(in srgb, #e5a93b 50%, #343a47); }

  .hm .pane { min-height: 186px; }
  .hm .pane.is-off { background: #07080a; }
  .hm .pane.is-off .line { opacity: 0.25 !important; }
  .hm .state.off { border: 1px solid #343a47; color: #626979; }
  .hm .state.lost { border: 1px solid #e5675b; color: #e5675b; }
  .hm.live .line { opacity: 0; }
  .hm.live .line.shown { opacity: 1; transition: opacity var(--fast) linear; }

  .hm-foot {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 14px; align-items: baseline;
    border-top: 1px solid #22262f; padding: 8px 12px; font-size: 11.5px; color: #8e95a5; background: #111317;
    font-variant-numeric: tabular-nums;
  }
  .hm-log { grid-column: 1 / -1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 1.6em; }
  .hm-meter { color: #d8dae0; }
  .hm-pos b { color: #d8dae0; font-weight: 500; }
  @media (max-width: 720px) { .hm-log { white-space: normal; } }
  @media (max-width: 560px) {
    .hm .pane { min-height: 0; }
    .hm-ctrl { width: 100%; margin-left: 0 !important; }
    .hm-ctrl button { flex: 1; }
  }
</style>
