---
// Intended git flow: one feature/<name> branch per run, a commit per milestone, one PR.
const box = (cx: number, cy: number, w: number) => ({ x: cx - w / 2, y: cy - 28, width: w, height: 56, rx: 2 });
---
<div class="bf" data-bf>
<svg class="dg" viewBox="0 0 760 370" role="img" aria-label="Parallel milestones land on one feature branch, then one pull request into main.">
  <defs>
    <marker id="bf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="arrowhead" d="M0 0L10 5L0 10z" /></marker>
    <marker id="bf-arrow-lead" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--lead)" /></marker>
  </defs>
  <line class="main" x1="70" y1="40" x2="736" y2="40" />
  <text x="24" y="45" font-size="13" font-weight="600">main</text>
  <path class="branch" d="M110 40V280H690V196" marker-end="url(#bf-arrow-lead)" />
  <text class="quiet" x="102" y="160" text-anchor="end" font-size="11.5">run starts</text>
  <g data-step="1" data-m="M1" class="bf-dot"><circle class="dot" cx="200" cy="280" r="6" /><text class="quiet" x="200" y="302" text-anchor="middle" font-size="11.5">M1</text></g>
  <g data-step="3" data-m="M2" class="bf-dot"><circle class="dot" cx="350" cy="280" r="6" /><text class="quiet" x="350" y="302" text-anchor="middle" font-size="11.5">M2</text></g>
  <g data-step="2" data-m="M3" class="bf-dot"><circle class="dot" cx="390" cy="280" r="6" /><text class="quiet" x="390" y="302" text-anchor="middle" font-size="11.5">M3</text></g>
  <g data-step="4" data-m="M4" class="bf-dot"><circle class="dot" cx="545" cy="280" r="6" /><text class="quiet" x="545" y="302" text-anchor="middle" font-size="11.5">M4</text></g>
  <text x="150" y="330" font-size="13" font-weight="600">feature/&lt;name&gt;: one branch per run, a real commit per milestone</text>
  <g class="edge" marker-end="url(#bf-arrow)">
    <path data-step="2" d="M270 158H279V128H288" />
    <path data-step="2" d="M270 158H279V200H288" />
    <path data-step="4" d="M452 128H464V158H475" />
    <path data-step="4" d="M452 200H464V158H475" />
    <path data-step="5" d="M690 144V46" />
  </g>
  <text data-step="5" class="quiet" x="700" y="100" font-size="11.5">merge</text>
  <g data-step="1" data-m="M1" class="bf-box"><rect class="box" {...box(200, 158, 140)} /><text x="200" y="154" text-anchor="middle" font-size="13" font-weight="600">M1 contract</text><text class="quiet" x="200" y="170" text-anchor="middle" font-size="11.5">Shared types</text></g>
  <g data-step="2" data-m="M2" class="bf-box"><rect class="box coder" {...box(370, 128, 164)} /><text x="370" y="124" text-anchor="middle" font-size="13" font-weight="600">M2 backend</text><text class="quiet" x="370" y="140" text-anchor="middle" font-size="11.5">claude-1, own worktree</text></g>
  <g data-step="2" data-m="M3" class="bf-box"><rect class="box coder" {...box(370, 200, 164)} /><text x="370" y="196" text-anchor="middle" font-size="13" font-weight="600">M3 frontend</text><text class="quiet" x="370" y="212" text-anchor="middle" font-size="11.5">claude-2, own worktree</text></g>
  <g data-step="4" data-m="M4" class="bf-box"><rect class="box" {...box(545, 158, 140)} /><text x="545" y="154" text-anchor="middle" font-size="13" font-weight="600">M4 integration</text><text class="quiet" x="545" y="170" text-anchor="middle" font-size="11.5">Wires both sides</text></g>
  <g data-step="5" data-m="PR" class="bf-box"><rect class="accent" {...box(684, 170, 104)} /><text x="684" y="166" text-anchor="middle" font-size="13" font-weight="600">Open PR</text><text x="684" y="182" text-anchor="middle" font-size="11.5">you merge</text></g>
</svg>
<p class="bf-sync" aria-live="polite" data-bf-sync hidden>
  <span class="bf-lbl">synced with the run log above</span>
  <span class="bf-clock" data-bf-clock></span>
  {['M1', 'M2', 'M3', 'M4'].map((m) => <span class="bf-st" data-bf-st={m}><b>{m}</b> <span>—</span></span>)}
</p>
</div>

<script>
  // Follows the timeline in the run explainer (`orch:run-frame` events): each milestone shows its state, and
  // the one being built names the worktree it is built in.
  type Detail = { ms: Record<string, [string, string?] | null>; clock: string };
  const label: Record<string, string> = {
    planned: 'planned', building: 'building', checks: 'checks', fix: 'fix round', question: 'question', review: 'in review', merged: 'merged',
  };
  document.querySelectorAll<HTMLElement>('[data-bf]').forEach((bf) => {
    const sync = bf.querySelector<HTMLElement>('[data-bf-sync]')!;
    document.addEventListener('orch:run-frame', (ev) => {
      const { ms, clock } = (ev as CustomEvent<Detail>).detail;
      const on = Object.values(ms).some(Boolean);
      bf.classList.toggle('synced', on);
      sync.hidden = !on;
      if (!on) return;
      bf.querySelectorAll<SVGGElement>('[data-m]').forEach((g) => {
        const st = ms[g.dataset.m!]?.[0] ?? 'none';
        g.setAttribute('data-ms', st);
      });
      bf.querySelector<HTMLElement>('[data-bf-clock]')!.textContent = clock || '--:--:--';
      bf.querySelectorAll<HTMLElement>('[data-bf-st]').forEach((el) => {
        const v = ms[el.dataset.bfSt!];
        const where = v && (v[0] === 'building' || v[0] === 'fix') && v[1] ? ` · ~/app-wt/${v[1]}` : '';
        el.dataset.ms = v?.[0] ?? 'none';
        el.querySelector('span')!.textContent = v ? label[v[0]] + where : '—';
      });
    });
  });
</script>

<style>
  .bf-sync { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 16px 0 0; padding-top: 12px; border-top: 1px solid var(--line); font: 12px var(--font-mono); color: var(--muted); font-variant-numeric: tabular-nums; }
  .bf-sync[hidden] { display: none; }
  .bf-lbl { text-transform: uppercase; letter-spacing: 0.04em; color: var(--faint); }
  .bf-clock { color: var(--text); margin-right: auto; }
  .bf-st b { color: var(--text); font-weight: 600; }
  .bf-st[data-ms='building'] span, .bf-st[data-ms='review'] span { color: var(--text); }
  .bf-st[data-ms='fix'] span, .bf-st[data-ms='question'] span { color: var(--bad); }
  .bf-st[data-ms='merged'] span { color: var(--good); }
  .bf [data-m] rect, .bf [data-m] circle { transition: stroke var(--fast) linear, fill var(--fast) linear, opacity var(--fast) linear; }
  .bf.synced [data-ms='none'] rect, .bf.synced [data-ms='planned'] rect { stroke-dasharray: 4 4; fill: transparent; }
  .bf.synced [data-ms='none'] circle, .bf.synced [data-ms='planned'] circle { fill: transparent; stroke: var(--line-strong); stroke-width: 1.5; }
  .bf.synced [data-ms='building'] rect, .bf.synced [data-ms='checks'] rect, .bf.synced [data-ms='review'] rect { stroke: var(--accent); stroke-width: 2; }
  .bf.synced [data-ms='fix'] rect, .bf.synced [data-ms='question'] rect { stroke: var(--bad); stroke-width: 2; }
  .bf.synced [data-ms='building'] circle, .bf.synced [data-ms='checks'] circle, .bf.synced [data-ms='review'] circle,
  .bf.synced [data-ms='fix'] circle, .bf.synced [data-ms='question'] circle { fill: transparent; stroke: var(--accent); stroke-width: 1.5; }
</style>
