#!/usr/bin/env python3
"""orch — deterministic state + scheduler for a Herdr multi-agent team.

The LEAD agent (any agent kind; see `orch lead plan`) calls these subcommands; the bookkeeping
(dependencies, who is free, sentinels, worktrees, merges) lives here so the
lead model never has to track it in its head.

State:   <main-repo>/.orchestrate/state.json
Plan:    <main-repo>/.orchestrate/plan.md   (human-editable, see orch-plan skill)

Task status flow (every change goes through move(), which checks TRANSITIONS)
  pending -> coding -> verifying -> [awaiting-review -> reviewing -> reviewed] -> committed -> merged
  side states: needs-answer, paused, failed, conflict, needs-fix, held (waiting for `orch approve`), skipped
Also: .orchestrate/events.jsonl (one line per transition), driver.lock (held by autopilot while it drives).
"""
import atexit, contextlib, fcntl, fnmatch, hashlib, json, os, re, shlex, shutil, signal, socket, subprocess, sys, tempfile, textwrap, time
from pathlib import Path

HERDR = os.environ.get("HERDR", "herdr")
CODER_BUDGET_MIN = int(os.environ.get("ORCH_CODER_BUDGET_MIN", "45"))
REVIEW_BUDGET_MIN = int(os.environ.get("ORCH_REVIEW_BUDGET_MIN", "15"))
IDLE_GRACE_S = int(os.environ.get("ORCH_IDLE_GRACE_S", "120"))
POLL_STEP_S = float(os.environ.get("ORCH_POLL_STEP_S", "10"))
HERDR_TIMEOUT_S = int(os.environ.get("ORCH_HERDR_TIMEOUT_S", "30"))
SEND_RETRY_S = int(os.environ.get("ORCH_SEND_RETRY_S", "120"))      # bench an agent we could not prompt
GONE_COOLDOWN_MIN = int(os.environ.get("ORCH_GONE_COOLDOWN_MIN", "10"))  # ends early once herdr sees it again
CONFIRM_S = int(os.environ.get("ORCH_CONFIRM_S", "30"))           # a prompt not confirmed by then is re-sent
MAX_LOST = int(os.environ.get("ORCH_MAX_LOST", "4"))               # lost attempts (unreachable, gone, rate limit)
UNREACHABLE_AFTER = int(os.environ.get("ORCH_UNREACHABLE_AFTER", "3"))   # failed prompts in a row before a long bench
UNREACHABLE_MIN = int(os.environ.get("ORCH_UNREACHABLE_MIN", "30"))
LEAD_REWAKE_S = int(os.environ.get("ORCH_LEAD_REWAKE_S", "300"))     # longest wait before a wake-up is sent again
LEAD_CONFIRM_S = int(os.environ.get("ORCH_LEAD_CONFIRM_S", "30"))    # a wake-up the lead did not pick up is sent again after this (doubling)
LEAD_SETTLE_S = int(os.environ.get("ORCH_LEAD_SETTLE_S", "300"))     # at ALL_DONE, stay up this long for the lead to pick up its events
LEAD_MAX_WAKES = int(os.environ.get("ORCH_LEAD_MAX_WAKES", "3"))     # ...this many times, then tell the developer
LEAD_WAIT_S = int(os.environ.get("ORCH_LEAD_WAIT_MIN", "15")) * 60   # ready work the lead never dispatched starts by itself
LEAD_IDLE_MAX_S = int(os.environ.get("ORCH_LEAD_IDLE_MAX_MIN", "720")) * 60   # give up waiting for answers after this
DOWN_MIN_S = int(os.environ.get("ORCH_DOWN_MIN_S", "120"))   # the event manager silent for longer than this was down
STOP_WAIT_S = float(os.environ.get("ORCH_STOP_WAIT_S", "60"))   # `orch stop` waits this long for the step it is on
# a coder whose milestone is paused or moved away while it works: it gets the interrupt key, and stays busy
# ("stopping") until herdr shows it idle for this long, so nobody hands it new work while it still edits files
HALT_WAIT_S = float(os.environ.get("ORCH_HALT_WAIT_S", "5"))      # `orch set/park` waits this long for it to go idle
HALT_SETTLE_S = float(os.environ.get("ORCH_HALT_SETTLE_S", "10"))  # idle at least this long after the stop note
HALT_REPEAT_S = float(os.environ.get("ORCH_HALT_REPEAT_S", "90"))  # still working after this: interrupt it again
# a coder or reviewer whose milestone is done gets its tool's compact command (`/compact`), so its chat does not keep
# growing from milestone to milestone. It counts as busy until herdr shows it idle for COMPACT_SETTLE_S
COMPACT_SETTLE_S = float(os.environ.get("ORCH_COMPACT_SETTLE_S", "10"))
COMPACT_MAX_S = float(os.environ.get("ORCH_COMPACT_MAX_S", "300"))   # still working after this: stop waiting for it
TEAM_CONFIRM_S = float(os.environ.get("ORCH_TEAM_CONFIRM_S", "5"))   # `team up` looks again after this: still running?
LOG_MAX_B = int(float(os.environ.get("ORCH_LOG_MAX_MB", "2")) * 1024 * 1024)   # autopilot.log; one old copy is kept
CRASH_KEEP = int(os.environ.get("ORCH_CRASH_KEEP", "20"))         # saved agent screens in .orchestrate/crash/
MAX_FIX = 3
MAX_REVIEW = 2
MAX_CONFLICT = 2
TASK_DIR = ".orch-task"
REF_NS = "refs/orch"   # hidden refs hold a milestone's work in progress: not branches, never pushed
# files nearly every milestone wants to touch: editing them in parallel milestones means merge conflicts
HOTSPOT_RE = re.compile(
    r"(^|/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|pubspec\.(yaml|lock)|"
    r"go\.(mod|sum)|pom\.xml|build\.gradle(\.kts)?|settings\.gradle|Cargo\.(toml|lock)|requirements\.txt|"
    r"pyproject\.toml|poetry\.lock|uv\.lock|docker-compose\.ya?ml|compose\.ya?ml|Makefile|\.env\.example|"
    r"App\.(tsx|jsx|vue|svelte)|main\.(ts|tsx|js|dart|go)|routes?\.\w+|router\.\w+)$", re.I)          # inside each work dir, git-excluded
# dependency manifests + lockfiles: when they change, a folder's setup command has to run again
LOCKFILE_RE = re.compile(
    r"(^|/)(package\.json|package-lock\.json|npm-shrinkwrap\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|"
    r"pubspec\.(yaml|lock)|go\.(mod|sum)|pom\.xml|build\.gradle(\.kts)?|Cargo\.(toml|lock)|requirements[\w.-]*\.txt|"
    r"pyproject\.toml|poetry\.lock|uv\.lock|Pipfile(\.lock)?|Gemfile(\.lock)?|composer\.(json|lock))$", re.I)
# changes that wait for `orch approve` before they land (plan header `Risk hold: off` turns this off)
RISK_RULES = [
    (re.compile(r"(^|/)(migrations?|migrate|alembic)/", re.I), "database migration"),
    (re.compile(r"^\.github/|(^|/)\.gitlab-ci\.ya?ml$|(^|/)Jenkinsfile$|^\.circleci/|(^|/)azure-pipelines\.ya?ml$"),
     "CI configuration"),
    (re.compile(r"(^|/)\.env(\.(?!example$|sample$|template$)[^/]+)?$|(^|/)[^/]*\.(pem|key|p12)$", re.I),
     "secrets or environment file"),
]
# quick runs (`Mode: quick`): small, clear changes only. Files that always need the full process...
QUICK_NEVER = RISK_RULES + [(LOCKFILE_RE, "dependency file")]
# ...and names that usually mean auth or payment code: the lead should be sure before calling it quick
QUICK_CAREFUL_RE = re.compile(r"auth|login|logout|password|session|token|oauth|permission|rbac|acl|payment|billing|"
                              r"invoice|checkout|stripe|paypal|razorpay|subscription|schema\.(prisma|sql|rb)|models?\.py$",
                              re.I)
RISK_MAX_LINES = int(os.environ.get("ORCH_RISK_MAX_LINES", "1500"))
CHECK_TIMEOUT_S = int(os.environ.get("ORCH_CHECK_TIMEOUT_MIN", "30")) * 60
ACTIVE = {"coding", "verifying", "awaiting-review", "reviewing", "reviewed", "committed", "conflict", "needs-fix",
          "held"}
TERMINAL_OK = {"merged"}
RESTING = {"pending", "paused", "failed", "needs-fix", "conflict"}   # no agent on it; a coder takes it up again later


# ---------------------------------------------------------------- helpers
def die(msg, code=2):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def sh(args, cwd=None, check=True):
    r = subprocess.run(args, cwd=cwd, text=True, capture_output=True)
    if check and r.returncode != 0:
        die(f"{' '.join(args)} failed:\n{r.stdout}{r.stderr}")
    return r


def git(*args, cwd=None, check=True):
    return sh(["git", *args], cwd=cwd, check=check)


def main_root():
    r = git("rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
    if r.returncode != 0:
        die("not inside a git repository")
    return Path(r.stdout.strip()).parent


ROOT = None
ORCH = None
STATE = None
BG_DIR = None          # .orchestrate/bg: logs and exit files of the event manager's background checks and merges


def load():
    if not STATE.exists():
        die("no .orchestrate/state.json — run `orch sync` after writing plan.md")
    return migrate(json.loads(STATE.read_text()))


STATE_SCHEMA = 1


def migrate(st):
    """Bring a state file from an older orch up to STATE_SCHEMA (a missing `schema` key means 4.5 or older)."""
    if st.get("schema", 0) > STATE_SCHEMA:
        die(f"state.json was written by a newer orch (schema {st['schema']}) — upgrade herdr-orchestra")
    st["schema"] = STATE_SCHEMA
    st.setdefault("notified", [])
    st.setdefault("merging", None)
    st.setdefault("root_setup_hash", None)
    st.setdefault("run", {})
    st.setdefault("lead_mode", "off")
    st.setdefault("lead_events", [])
    st.setdefault("lead_seq", 0)
    for t in st.get("tasks", {}).values():
        t.setdefault("history", [])
        t.setdefault("lost", 0)
        t.setdefault("attempts", [])
    for w in st.get("workers", {}).values():
        w.setdefault("delivery_fails", 0)
    return st


_LOCK_DEPTH = 0


@contextlib.contextmanager
def state_lock():
    """Exclusive lock on .orchestrate/state.lock so two orch commands never lose each other's update."""
    global _LOCK_DEPTH
    if _LOCK_DEPTH:
        _LOCK_DEPTH += 1
        try:
            yield
        finally:
            _LOCK_DEPTH -= 1
        return
    with open(ORCH / "state.lock", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        _LOCK_DEPTH = 1
        try:
            yield
        finally:
            _LOCK_DEPTH = 0
            fcntl.flock(f, fcntl.LOCK_UN)


# usable while autopilot drives: reads, and the lead's requests (the event manager carries them out)
LEASE_FREE = {"status", "ready", "pick", "report", "approve", "autopilot", "events", "dispatch", "answer", "defer",
              "fix", "team", "resume", "bench", "stop", "doctor", "plan", "story", "check", "free", "manual", "view",
              "board"}
_LEASE = None


def driver_info():
    try:
        return json.loads((ORCH / "driver.lock").read_text() or "{}")
    except (OSError, ValueError):
        return {}


def driver_alive():
    """True while an `orch autopilot` holds the run's driver lease (the kernel drops it if autopilot dies)."""
    p = ORCH / "driver.lock"
    if not p.exists():
        return False
    with open(p, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            return True
        fcntl.flock(f, fcntl.LOCK_UN)
    return False


def driver_line(info):
    started = time.strftime("%H:%M:%S", time.localtime(info.get("started", 0)))
    return f"orch autopilot (pid {info.get('pid', '?')} on {info.get('host', '?')}, started {started})"


def require_driver():
    """Refuse to change a run another process is driving, unless we are that driver's own subcommand."""
    if not driver_alive():
        return
    info = driver_info()
    if os.environ.get("ORCH_DRIVER") and os.environ.get("ORCH_DRIVER") == info.get("token"):
        return
    die(f"this run is driven by {driver_line(info)} — wait for it to stop (or stop it) before changing the run "
        f"by hand; `orch status` and `orch approve` still work")


def take_lease():
    """Autopilot: hold .orchestrate/driver.lock for the whole run. A second driver fails here."""
    global _LEASE
    f = open(ORCH / "driver.lock", "a+")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        die(f"this run is already driven by {driver_line(driver_info())}")
    token = os.urandom(8).hex()
    f.seek(0)
    f.truncate()
    f.write(json.dumps({"pid": os.getpid(), "host": socket.gethostname(), "started": now(), "token": token}))
    f.flush()
    os.environ["ORCH_DRIVER"], os.environ["ORCH_DRIVER_PID"] = token, str(os.getpid())
    _LEASE = f
    sign_in_manager()


def task(st, tid):
    if tid not in st["tasks"]:
        die(f"unknown task {tid!r} — known: {', '.join(st['order']) or 'none'}")
    return st["tasks"][tid]


def need(args, n, usage):
    if len(args) < n:
        die(f"usage: orch {usage}")


_EVENTS = []   # transitions made by this process, appended to events.jsonl once the state that holds them is saved


def save(st):
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2))
    tmp.replace(STATE)
    if _EVENTS:
        with (ORCH / "events.jsonl").open("a") as f:
            for ev in _EVENTS:
                f.write(json.dumps(ev) + "\n")
        _EVENTS.clear()


def fault(point):
    """Test hook: ORCH_FAULT=<point> kills orch (and the autopilot driving it) right here, like a crash."""
    if os.environ.get("ORCH_FAULT") != point:
        return
    drv = os.environ.get("ORCH_DRIVER_PID")
    if drv and drv.isdigit():
        with contextlib.suppress(OSError):
            os.kill(int(drv), signal.SIGKILL)
    os._exit(99)


# ---------------------------------------------------------------- logs and crash notes
# Everything stays in this repo's own .orchestrate/, so two projects run side by side never share a log. Crash
# notes start with `[<repo> <branch>]`, and a line from the computer's own log is only blamed on this run when it
# names one of this run's own processes (recorded when the event manager starts, and every few minutes).
JOURNALCTL = os.environ.get("ORCH_JOURNALCTL", "journalctl")
COREDUMPCTL = os.environ.get("ORCH_COREDUMPCTL", "coredumpctl")
PROCS_EVERY_S = 300
VANISH_CHECK_S = float(os.environ.get("ORCH_VANISH_CHECK_S", "30"))


def _rotate(path, limit):
    """Keep a log under `limit` bytes: past it, the file becomes <name>.1 (one old copy) and a new one starts."""
    try:
        if path.exists() and path.stat().st_size > limit:
            path.replace(path.with_name(path.name + ".1"))
    except OSError:
        pass


def log_line(msg):
    """Append one timestamped line to .orchestrate/autopilot.log (size-capped)."""
    p = ORCH / "autopilot.log"
    _rotate(p, LOG_MAX_B)
    try:
        with p.open("a") as f:
            f.write(f"[{time.strftime('%H:%M:%S')}] {msg}\n")
    except OSError:
        pass


def run_tag(st=None):
    """`[<repo> <branch>]`: which project and run a crash note is about."""
    branch = None
    try:
        branch = (st or load()).get("branch")
    except (SystemExit, OSError, ValueError):
        pass
    return f"[{ROOT.name}{' ' + branch if branch else ''}]"


def save_screen(agent, why):
    """Keep the last lines an agent's pane shows, while herdr can still read them, in .orchestrate/crash/
    (only the newest CRASH_KEEP files are kept). Returns the file, or None when there was nothing to read."""
    try:
        r = subprocess.run([HERDR, "agent", "read", agent, "--source", "recent-unwrapped", "--lines", "40"],
                           text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
        text = r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        text = ""
    if not text:
        return None
    d = ORCH / "crash"
    d.mkdir(exist_ok=True)
    f = d / f"{re.sub(r'[^A-Za-z0-9_.-]', '_', agent)}-{time.strftime('%Y%m%d-%H%M%S')}.txt"
    f.write_text(f"{run_tag()} {agent}: {why}\nsaved {time.strftime('%Y-%m-%d %H:%M:%S')}\n\n"
                 + "\n".join(text.splitlines()[-40:]) + "\n")
    for old in sorted(d.glob("*.txt"), key=lambda p: p.stat().st_mtime)[:-CRASH_KEEP]:
        with contextlib.suppress(OSError):
            old.unlink()
    return f


def _cgroup(pid):
    try:
        for line in Path(f"/proc/{pid}/cgroup").read_text().splitlines():
            if line.startswith("0::"):
                return line[3:].strip() or None
    except OSError:
        pass
    return None


def run_processes(st):
    """This run's own processes: the event manager, herdr, and every process working in the run's folders (the
    agents and what they started). {pid: name} plus their cgroups. Empty where /proc does not exist."""
    procs, groups = {}, set()
    if not Path("/proc").is_dir():
        return {"procs": {}, "cgroups": []}
    folders = [str(ROOT)] + [w["dir"] for w in st.get("workers", {}).values() if w.get("dir")]
    me = os.getpid()
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            comm = (d / "comm").read_text().strip()
            if int(d.name) != me and comm != "herdr":
                cwd = os.readlink(d / "cwd")
                if not any(_inside(cwd, f) for f in folders):
                    continue
        except OSError:
            continue
        procs[d.name] = comm
        if len(procs) >= 300:
            break
    procs[str(me)] = "orch autopilot"
    for pid in procs:
        g = _cgroup(pid)
        if g:
            groups.add(g)
    return {"procs": procs, "cgroups": sorted(groups)[:60]}


def boot_time():
    if os.environ.get("ORCH_BOOT_TIME"):
        return int(os.environ["ORCH_BOOT_TIME"])
    try:
        for line in Path("/proc/stat").read_text().splitlines():
            if line.startswith("btime "):
                return int(line.split()[1])
    except (OSError, ValueError):
        pass
    return None


def _lines(cmd):
    try:
        r = subprocess.run(cmd, text=True, capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return r.stdout.splitlines()[-3000:] if r.returncode == 0 else []


OOMD_RE = re.compile(r"systemd-oomd.*?Killed (/\S+)")
KOOM_RE = re.compile(r"(?:Out of memory: Killed process|oom-kill:.*?pid=)\s*(\d+)(?:\s*\(([^)]+)\))?")
SLEEP_RE = re.compile(r"PM: suspend entry|Suspending system|The system will suspend|Entering sleep state")
DOWN_RE = re.compile(r"System is powering down|System is rebooting|The system will (?:power off|reboot)|"
                     r"Shutting down\.|Power key pressed")


def crash_reason(rec, last):
    """Why a run's processes stopped around `last` (epoch), from the computer's own logs. Returns (reason, evidence
    lines). Only kills that name one of this run's processes or cgroups count; the rest is reported as such."""
    procs = (rec or {}).get("procs") or {}
    groups = (rec or {}).get("cgroups") or []
    since, until = int(last) - 300, int(last) + 600
    bt = boot_time()
    if bt and bt > last:
        return (f"the computer was restarted (it booted at {_clock(bt)}, after orch was last alive at "
                f"{_clock(last)})", [])
    lines = _lines([JOURNALCTL, "--no-pager", "-q", "-o", "short-iso", "--since", f"@{since}", "--until", f"@{until}"])
    lines += _lines([JOURNALCTL, "--no-pager", "-q", "-o", "short-iso", "-k", "--since", f"@{since}",
                     "--until", f"@{until}"])
    other = []
    for line in lines:
        m = OOMD_RE.search(line)
        if m:
            killed = m.group(1).rstrip(".,")
            if any(g == killed or g.startswith(killed.rstrip("/") + "/") for g in groups):
                return ("the memory guard (systemd-oomd) closed the terminal or app this run was in, because the "
                        "computer was low on memory", [line.strip()[:300]])
            other.append(line.strip()[:300])
            continue
        m = KOOM_RE.search(line)
        if m:
            if m.group(1) in procs:
                name = procs[m.group(1)]
                return (f"out of memory: the system killed {name} (pid {m.group(1)})", [line.strip()[:300]])
            other.append(line.strip()[:300])
            continue
        if SLEEP_RE.search(line):
            return "the computer went to sleep", [line.strip()[:300]]
        if DOWN_RE.search(line):
            return "the computer was shut down or restarted", [line.strip()[:300]]
    for line in _lines([COREDUMPCTL, "list", "--no-pager", "-q", "--since", f"@{since}", "--until", f"@{until}"]):
        parts = line.split()
        pid = next((p for p in parts if p.isdigit() and p in procs), None)
        if pid or "herdr" in line:
            return (f"{procs.get(pid, 'herdr')} crashed (a core dump was written)", [line.strip()[:300]])
    if other:
        return (f"unknown — the system log shows {len(other)} kill(s) then, but not of this run's processes "
                f"(another project or app)", other[:3])
    if not lines:
        return "unknown — the system log could not be read (journalctl missing, or no permission)", []
    return "unknown — the system log has nothing about it at that time", []


def note_dead_manager(st, save_it=True, starting=False):
    """An event manager that died without its last line (killed: memory, a closed terminal, a crash of the whole
    app) is found here, once: the reason is looked up and written to autopilot.log. Returns the note, or None."""
    m = (st.get("run") or {}).get("manager")
    if not m or m.get("ended") or m.get("host") not in (None, socket.gethostname()):
        return None
    if starting:                     # the new manager holds the lease now: the old one is dead unless it is us
        if m.get("pid") == os.getpid():
            return None
    elif driver_alive():
        return None
    last = (st.get("run") or {}).get("beat") or m.get("started") or now()
    reason, evidence = crash_reason(m, last)
    m["ended"] = {"ts": now(), "how": "died", "reason": reason, "last_alive": last}
    note = (f"{run_tag(st)} CRASHED: the event manager (pid {m.get('pid')}) stopped without a word; last alive "
            f"{_clock(last)}. Reason: {reason}")
    log_line(note)
    for e in evidence:
        log_line(f"{run_tag(st)}   system log: {e}")
    if save_it:
        save(st)
    return note + "".join(f"\n  system log: {e}" for e in evidence)


def last_crash_lines(n=12):
    """The newest crash, stop and lost notes from autopilot.log (and its old copy)."""
    out = []
    for p in (ORCH / "autopilot.log.1", ORCH / "autopilot.log"):
        if p.exists():
            out += [l for l in p.read_text(errors="replace").splitlines()
                    if re.search(r"\] (CRASHED|STOPPED|QUIT|LOST|HERDR RESTART\?)|system log:", l)]
    return out[-n:]


# Every status change goes through move(). Statuses not listed as a key are terminal.
_PARK = {"pending", "paused", "failed"}
TRANSITIONS = {
    "pending": {"coding", "needs-answer", "skipped"} | _PARK,
    "needs-answer": {"pending", "skipped"},
    "skipped": {"pending"},
    "coding": {"verifying", "needs-fix", "conflict"} | _PARK,
    "verifying": {"coding", "awaiting-review", "reviewing", "committed", "merged", "needs-fix", "held"} | _PARK,
    "awaiting-review": {"reviewing", "needs-fix"} | _PARK,
    "reviewing": {"reviewed", "awaiting-review"} | _PARK,
    "reviewed": {"needs-fix", "committed", "merged", "held"} | _PARK,
    "needs-fix": {"coding"} | _PARK,
    "committed": {"merged", "conflict", "needs-fix", "held"} | _PARK,
    "held": {"committed"} | _PARK,
    "conflict": {"coding"} | _PARK,
    "paused": {"coding", "skipped"} | _PARK,
    "failed": {"skipped"} | _PARK,
    "merged": set(),
}
SET_OK = {"pending", "paused", "failed", "skipped"}   # what `orch set` allows without --force


def move(st, tid, to, why=None, force=False):
    """The only way a task's status changes: checks the transition, keeps a short history, logs an event."""
    t = st["tasks"][tid]
    frm = t.get("status")
    if to != frm and not force and to not in TRANSITIONS.get(frm, set()):
        die(f"{tid}: {frm} -> {to} is not an allowed transition"
            + ("" if frm != "merged" else " (merged is final)"))
    t["status"] = to
    if why is not None:
        t["reason"] = why
    elif to != frm and to in ("coding", "verifying", "reviewing"):
        t["reason"] = ""          # work goes on: an old note ("hit a usage limit") no longer describes it
    if to != frm or why:
        ev = {"ts": now(), "task": tid, "from": frm, "to": to, "why": why or "",
              "agent": t.get("worker") or t.get("last_worker"), "attempt": t.get("attempt", 0)}
        if force:
            ev["forced"] = True
        hist = t.setdefault("history", [])
        hist.append({k: ev[k] for k in ("ts", "from", "to", "why")})
        del hist[:-50]
        _EVENTS.append(ev)
        if to != frm and to in LEAD_BLOCKING | {"merged"}:
            lead_event(st, to, tid, why or t.get("reason") or "")


# ---------------------------------------------------------------- the lead's event queue
# Every event the lead should hear about is stored in state.json in the same write as the change that caused it,
# so none is lost while the lead is paused or the event manager is down. `orch events` (the lead reading them)
# is the acknowledgement. A blocking event stays open until its task leaves that status.
LEAD_BLOCKING = {"paused", "failed", "held", "needs-answer"}


def lead_on(st):
    return st.get("lead_mode") == "events" and bool(st.get("lead"))


def lead_event(st, kind, tid, text):
    if not lead_on(st):
        return
    for e in st["lead_events"]:
        if not e.get("read") and (e["kind"], e.get("task"), e.get("text")) == (kind, tid, text):
            return                                   # the same thing, not yet read: one event is enough
    st["lead_seq"] = st.get("lead_seq", 0) + 1
    st["lead_events"].append({"id": st["lead_seq"], "ts": now(), "kind": kind, "task": tid, "text": text, "read": None})
    del st["lead_events"][:-200]


def story_note(st, text, who="lead"):
    """One line for the run diary (`orch story`, .orchestrate/story.md): what the lead (or developer) did."""
    st.setdefault("story", []).append({"ts": now(), "who": who, "text": text})
    del st["story"][:-500]


def event_open(st, e):
    """A blocking event is open while its task still has that status; other events are open until read."""
    if e["kind"] in LEAD_BLOCKING:
        return st["tasks"].get(e.get("task"), {}).get("status") == e["kind"]
    if e["kind"] == "ready":          # nothing left to dispatch: the news is stale
        return not e.get("read") and any(k in undispatched(st) for k in re.findall(r"M\d+", e.get("text") or ""))
    return not e.get("read")


def unread_events(st):
    return [e for e in st.get("lead_events", []) if not e.get("read") and event_open(st, e)]


def undispatched(st):
    """Ready milestones still waiting for the lead's `orch dispatch`."""
    if not lead_on(st):
        return []
    return [tid for tid in st["order"] if st["tasks"][tid]["status"] == "pending" and not st["tasks"][tid].get("go")
            and deps_met(st, st["tasks"][tid])]


def now():
    return int(time.time())


def _find_key(obj, key):
    if isinstance(obj, dict):
        if isinstance(obj.get(key), str):
            return obj[key]
        obj = list(obj.values())
    if isinstance(obj, list):
        for v in obj:
            found = _find_key(v, key)
            if found is not None:
                return found
    return None


def _status_field(obj):
    """The agent's status from `herdr agent get` JSON: `agent_status` anywhere, else `status` anywhere."""
    found = _find_key(obj, "agent_status")
    return found if found is not None else _find_key(obj, "status")


def _shell_only(obj):
    """True when herdr knows the name but no agent runs in its pane: the JSON says `"agent": null` (or empty),
    or it has no status at all. That pane is a plain shell (the agent quit, or never started), and a prompt
    sent there would be typed into the shell."""
    if not isinstance(obj, (dict, list)):
        return False
    if _status_field(obj) is None:
        return True
    stack = [obj]
    while stack:
        o = stack.pop()
        if isinstance(o, dict):
            if "agent" in o and o["agent"] in (None, "", False):
                return True
            stack.extend(o.values())
        elif isinstance(o, list):
            stack.extend(o)
    return False


def herdr_presence(agent):
    """("agent", status) when herdr runs the agent, ("shell", None) when the name is on a pane with no agent in
    it, ("gone", None) when herdr can't find the name (or can't be reached)."""
    try:
        r = subprocess.run([HERDR, "agent", "get", agent], text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired):
        return "gone", None
    if r.returncode != 0:
        return "gone", None
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return "agent", (r.stdout + r.stderr).lower()   # not JSON: the whole text, as before
    if _shell_only(data):
        return "shell", None
    return "agent", _status_field(data).lower()


def herdr_state(agent):
    """The agent's lowercased status from `herdr agent get`, or None if herdr can't find it, or only a shell is
    left in its pane. Only the status field is matched, so a name or path containing "working" or "blocked" is
    not misread; output that isn't JSON falls back to the whole text."""
    return herdr_presence(agent)[1]


def presence_word(st, name):
    """What `orch status` says about an agent's pane: ok, detect:off, NO AGENT, SHELL ONLY, or a stale pane id."""
    info = agent_info(st, name)
    if info.get("pane"):
        ok, _, _ = _herdr_json([HERDR, "pane", "get", info["pane"]])
        return "ok" if ok else "STALE PANE"
    if not info.get("detect", True):
        return "detect:off"
    where, _ = herdr_presence(name)
    return {"agent": "ok", "shell": "SHELL ONLY", "gone": "NO AGENT"}[where]


def word(state, *words):
    return state is not None and any(re.search(rf"\b{w}\b", state) for w in words)


class DeliveryError(Exception):
    """herdr could not deliver a prompt (agent unreachable, stale pane, herdr hung)."""


def _herdr_run(cmd):
    try:
        r = subprocess.run(cmd, text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise DeliveryError(f"{' '.join(cmd[:3])} timed out after {HERDR_TIMEOUT_S}s")
    except OSError as e:
        raise DeliveryError(f"{' '.join(cmd[:3])} failed: {e}")
    if r.returncode != 0:
        raise DeliveryError(f"{' '.join(cmd[:3])} failed: {r.stdout}{r.stderr}".strip())


def herdr_prompt(agent, text):
    _herdr_run([HERDR, "agent", "prompt", agent, text])


def agent_info(st, name):
    """Registry-derived facts about a worker or the reviewer: kind, detect (herdr can watch it), pane (@pane:<id>)."""
    if name in st.get("workers", {}):
        return st["workers"][name]
    if name and name == st.get("reviewer"):
        return st.get("reviewer_info") or {}
    if name and name == (st.get("lead") or {}).get("name"):
        return st["lead"]
    return {}


def watched(st, name):
    return agent_info(st, name).get("detect", True)


def deliver(st, agent, text):
    """Send a one-line prompt: by agent name, or by typing into the pane for `name (kind @pane:<id>)` agents.
    Raises DeliveryError when herdr can't deliver it."""
    pane = agent_info(st, agent).get("pane")
    if not pane:
        herdr_prompt(agent, text)
        return
    for cmd in ([HERDR, "pane", "send-text", pane, text], [HERDR, "pane", "send-keys", pane, "enter"]):
        try:
            _herdr_run(cmd)
        except DeliveryError as e:
            raise DeliveryError(f"{e} — pane {pane} for {agent} (stale pane id? re-check with `herdr pane list` "
                                f"and fix Workers/Reviewer in plan.md)")


# ---------------------------------------------------------------- shipped files + agent registry
def asset(rel):
    """A file shipped with orch: next to this script's checkout, else the installed `current` copy."""
    for base in (Path(__file__).resolve().parent.parent, Path.home() / ".local/share/herdr-orchestra/current"):
        if (base / rel).exists():
            return base / rel
    return None


def user_agents_file():
    return Path(os.environ.get("ORCH_AGENTS_FILE") or Path.home() / ".config/herdr-orchestra/agents.toml")


def registry(required=True):
    """agents.default.toml merged with the user's agents.toml (key by key per kind). None if tomllib is missing
    and not required, so plans keep working on Python < 3.11 with v4.2 behaviour."""
    try:
        import tomllib
    except ImportError:
        if required:
            die(f"the agent registry needs Python >= 3.11 (tomllib); this is Python {sys.version.split()[0]}")
        return None
    reg = {}
    src = asset("agents.default.toml")
    try:
        if src:
            reg = tomllib.loads(src.read_text())
        uf = user_agents_file()
        if uf.exists():
            for kind, vals in tomllib.loads(uf.read_text()).items():
                if isinstance(vals, dict):
                    if "launch" in vals and "review_launch" not in vals:
                        reg.get(kind, {}).pop("review_launch", None)   # your own launch command wins for the reviewer too
                    reg.setdefault(kind, {}).update(vals)
    except tomllib.TOMLDecodeError as e:
        die(f"agent registry: {e}")
    return reg


def expand(p):
    return Path(os.path.expanduser(p))


# ---------------------------------------------------------------- model catalog: tiers, ratings, policy
TIERS = ("small", "medium", "high")
RATINGS = ("reasoning", "coding", "architecture", "instructions", "tools", "planning", "speed")
NEEDS = ("reasoning", "coding", "architecture", "long-context", "tool-use", "planning", "speed")


def user_models_file():
    return Path(os.environ.get("ORCH_MODELS_FILE") or Path.home() / ".config/herdr-orchestra/models.toml")


_CATALOG = {}


def models_catalog(required=False):
    """models.default.toml, then the models each installed tool reports itself ([discover.<kind>]), then the user's
    models.toml, merged key by key per model (policy, tiers and discover per key). None when tomllib is missing and
    the catalog isn't required: plans then run without tiers, as before 4.7."""
    try:
        import tomllib
    except ImportError:
        if required:
            die(f"the model catalog needs Python >= 3.11 (tomllib); this is Python {sys.version.split()[0]}")
        return None
    if "cat" in _CATALOG:
        return _CATALOG["cat"]
    cat = {"policy": {}, "tiers": {}, "models": {}, "discover": {}, "found": {}}
    try:
        datas = [(tomllib.loads(src.read_text()), user) for src, user in
                 ((asset("models.default.toml"), False), (user_models_file(), True)) if src and src.exists()]
    except tomllib.TOMLDecodeError as e:
        die(f"model catalog: {e}")
    for data, _ in datas:
        for sec in ("policy", "tiers"):
            cat[sec].update(data.get(sec) or {})
        for kind, d in (data.get("discover") or {}).items():
            if isinstance(d, dict):
                cat["discover"].setdefault(kind, {}).update(d)
    for phase in (False, True):          # the shipped models, then what the tools report, then the user's own
        if phase:
            discover_models(cat)
        for data, user in datas:
            if user == phase:
                for mid, vals in (data.get("models") or {}).items():
                    if isinstance(vals, dict):
                        cat["models"].setdefault(mid.lower(), {}).update(vals)
    _CATALOG["cat"] = cat
    return cat


# ---------------------------------------------------------------- model discovery: ask the tool for its models
DISCOVER_TTL_S = float(os.environ.get("ORCH_MODELS_TTL_S", str(6 * 3600)))
LEGACY_RE = re.compile(r"(?i)\blegacy\b|previous generation|deprecated")


def split_effort(mid):
    """`gpt-6.2-sol@low` -> ("gpt-6.2-sol", "low"); an id without a thinking level -> (id, None)."""
    if mid and "@" in mid:
        base, eff = mid.rsplit("@", 1)
        if base and re.fullmatch(r"[A-Za-z]+", eff):
            return base, eff.lower()
    return mid, None


def _tool_models(kind, cmd):
    """The models `cmd` lists ([{slug, description, visibility, upgrade, priority}]), or None. The answer is kept
    for DISCOVER_TTL_S in the share folder; an older answer is used when the command fails now."""
    cache = share_dir() / f"models-{kind}.json"
    try:
        old = json.loads(cache.read_text())
    except (OSError, ValueError):
        old = None
    if isinstance(old, dict) and old.get("cmd") == cmd and time.time() - old.get("ts", 0) < DISCOVER_TTL_S:
        return old.get("models")
    models = None
    try:
        r = subprocess.run(shlex.split(cmd), text=True, capture_output=True, timeout=20, stdin=subprocess.DEVNULL)
        out = r.stdout
        data = json.loads(out[out.index("{"):]) if r.returncode == 0 and "{" in out else None
        rows = data.get("models") if isinstance(data, dict) else data
        if isinstance(rows, list):
            models = [{k: m.get(k) for k in ("slug", "description", "visibility", "upgrade", "priority")}
                      for m in rows if isinstance(m, dict) and isinstance(m.get("slug"), str)]
    except (OSError, ValueError, subprocess.TimeoutExpired):
        models = None
    if not models:
        return old.get("models") if isinstance(old, dict) and old.get("cmd") == cmd else None
    with contextlib.suppress(OSError):
        cache.parent.mkdir(parents=True, exist_ok=True)
        cache.write_text(json.dumps({"ts": time.time(), "cmd": cmd, "models": models}))
    return models


def newest_of(models, family):
    """The tool's preferred current model of a family (a word in its id): not hidden, not legacy, lowest priority."""
    cands = [m for m in models if family.lower() in re.split(r"[-_.@/]", m["slug"].lower())
             and m.get("visibility") != "hide" and not m.get("upgrade")
             and not LEGACY_RE.search(m.get("description") or "")]
    prio = lambda m: m["priority"] if isinstance(m.get("priority"), (int, float)) else 1e9
    return min(cands, key=lambda m: (prio(m), m["slug"]), default=None)


def discover_models(cat):
    """For each [discover.<kind>] whose tool is installed: ask it for its models and put the newest model of each
    family into the levels it names (small / medium / high, each a family and a thinking level). The shipped
    entries of that kind are the fallback: they are replaced only when the tool answered."""
    if os.environ.get("ORCH_MODELS_DISCOVER", "1").lower() in ("0", "off", "false", "no"):
        return
    for kind, cfg in cat["discover"].items():
        cmd = cfg.get("cmd")
        try:
            exe = shlex.split(cmd)[0] if cmd else None
        except ValueError:
            exe = None
        if not exe or not shutil.which(exe):
            continue
        models = _tool_models(kind, cmd)
        if not models:
            continue
        shipped = {mid: m for mid, m in cat["models"].items() if m.get("kinds") == [kind]}
        made, used = {}, set()
        for level in TIERS:
            want = cfg.get(level)
            if not isinstance(want, dict) or not want.get("family"):
                continue
            m = newest_of(models, want["family"])
            if not m:
                continue
            mid = m["slug"].lower() + (f"@{want['effort']}" if want.get("effort") else "")
            like = next((x for x in shipped.values() if str(x.get("tier", "")).lower() == level), None) or {}
            made[mid] = dict(like, kinds=[kind], tier=level, found=True, evidence=(
                f"found by `{cmd}`: \"{(m.get('description') or '').strip()}\". {level} level = the newest "
                f"{want['family']} model" + (f" on {want['effort']} thinking" if want.get("effort") else "")
                + f" ([discover.{kind}]). Ratings copied from the shipped {level} entry; not benchmarked here."))
            used.add(m["slug"])
        if not made:
            continue
        for mid in shipped:
            cat["models"].pop(mid, None)
        cat["models"].update(made)
        cat["found"][kind] = {"cmd": cmd, "used": sorted(used),
                              "skipped": sorted(x["slug"] for x in models if x["slug"] not in used
                                                and (x.get("upgrade") or LEGACY_RE.search(x.get("description") or "")))}


def model_denied(cat, mid):
    """The policy pattern that forbids this model, or None."""
    if not cat or not mid:
        return None
    return next((pat for pat in cat["policy"].get("deny") or [] if fnmatch.fnmatch(mid.lower(), str(pat).lower())),
                None)


def model_tier(cat, mid):
    """The tier a model serves: its `tier`, capped by the reasoning floor of that tier. None = not in the catalog."""
    m = (cat or {}).get("models", {}).get((mid or "").lower())
    if not m:
        return None
    tier = str(m.get("tier", "")).lower()
    if tier not in TIERS:
        return None
    r = m.get("reasoning")
    while TIERS.index(tier) > 0 and isinstance(r, int) and r < int((cat["tiers"].get(tier) or {}).get("reasoning", 0)):
        tier = TIERS[TIERS.index(tier) - 1]
    return tier


def rank(tier):
    """0 for no tier (unrated, or a plan written before tiers), else 1..3."""
    return TIERS.index(tier) + 1 if tier in TIERS else 0


def need_rank(t):
    """What a milestone asks of its coder: its plan `Tier:`, raised by an escalation or by the lead."""
    return max(rank(t.get("tier")), rank(t.get("min_tier")))


def eligible_workers(st, t):
    """Workers allowed to take the task: its tier or higher (unrated workers count as any tier). When nobody on the
    team reaches the tier, the strongest workers the team has, so a run never waits for a model nobody started."""
    if t.get("assign") in st["workers"] and not st["workers"][t["assign"]].get("off"):
        return [t["assign"]]
    need = need_rank(t)
    ranks = {n: rank(w.get("tier")) for n, w in st["workers"].items() if not w.get("off")}   # `orch bench <w> off`
    if not ranks:
        return []
    ok = [n for n, r in ranks.items() if not need or not r or r >= need]
    if not ok:
        top = max(ranks.values())
        ok = [n for n, r in ranks.items() if r == top]
    return ok


def cmd_models(args):
    """orch models [check <id> | show <id>] -> the model catalog: tiers, ratings, evidence, and what policy forbids."""
    cat = models_catalog(required=True)
    sub = args[0] if args else ""
    if sub in ("check", "show"):
        mid = (args[1] if len(args) > 1 else die(f"usage: orch models {sub} <model id>")).lower()
        why = model_denied(cat, mid)
        if why:
            print(f"DENIED {mid}: matches policy pattern {why!r} — {cat['policy'].get('deny_why', 'not allowed in runs')}")
            sys.exit(1)
        m = cat["models"].get(mid)
        if not m:
            print(f"UNRATED {mid}: not in the catalog — allowed, but it has no tier; add it to {user_models_file()}")
            sys.exit(0 if sub == "check" else 1)
        print(f"OK {mid}: tier {model_tier(cat, mid)}")
        if sub == "show":
            for k in ("kinds", *RATINGS, "context_k", "open_weights", "evidence"):
                if k in m:
                    print(f"  {k:<13} {', '.join(m[k]) if isinstance(m[k], list) else m[k]}")
        return
    if sub:
        die("usage: orch models [check <id> | show <id>]")
    print(f"{'model':<20} {'tier':<7} {'kinds':<17} {'reas':>4} {'code':>4} {'arch':>4} {'inst':>4} {'tool':>4} "
          f"{'plan':>4} {'speed':>5} {'ctx k':>6}  open")
    for tier in reversed(TIERS):
        for mid, m in cat["models"].items():
            if model_tier(cat, mid) != tier or model_denied(cat, mid):
                continue
            print(f"{mid:<20} {tier:<7} {','.join(m.get('kinds', [])):<17} "
                  + " ".join(f"{m.get(k, '-'):>4}" for k in RATINGS[:-1])
                  + f" {m.get('speed', '-'):>5} {m.get('context_k') or '-':>6}  {'yes' if m.get('open_weights') else 'no'}")
    for kind, f in cat.get("found", {}).items():
        print(f"\n{kind} models found by `{f['cmd']}`: {', '.join(f['used'])}"
              + (f" (not used, the tool calls them legacy: {', '.join(f['skipped'])})" if f["skipped"] else ""))
        print(f"  an id ending in @<level> (e.g. @low) is that model on that thinking level")
    print("\nTiers (a model needs this reasoning rating to serve the tier):")
    for tier in TIERS:
        tv = cat["tiers"].get(tier) or {}
        print(f"  {tier:<7} reasoning >= {tv.get('reasoning', '-')}: {tv.get('use', '')}")
    deny = cat["policy"].get("deny") or []
    print(f"\nNot allowed in runs: {', '.join(deny) or 'nothing'}" + (f" — {cat['policy']['deny_why']}" if deny and cat["policy"].get("deny_why") else ""))
    print(f"Ratings are starting points (`orch models show <id>` prints the evidence). Override or add models in "
          f"{user_models_file()}")


def ensure_excluded():
    exclude = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=ROOT).stdout.strip()) / "info" / "exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    lines = exclude.read_text().splitlines() if exclude.exists() else []
    for pat in (".orchestrate/", f"{TASK_DIR}/"):
        if pat not in lines:
            lines.append(pat)
    exclude.write_text("\n".join(lines) + "\n")


# ---------------------------------------------------------------- main guard: no agent ever pushes to main
GUARD_MARK = "herdr-orchestra main guard"
GUARD_VERSION = 1
GUARD_ALWAYS = ("main", "master")
GUARD_RULE = ("No agent ever pushes to main (or master, or the repo's default branch), in any situation, even when "
              "the developer asks: work stays on the run's branch, and a person merges the PR by hand.")
GUARD_HOOK = r"""#!/bin/sh
# {mark} v{version}. Written by `orch guard` (orch start writes it too).
# Refuses any push that would change main, master, the remote's default branch or a branch in
# `git config orch.protected`: agents work on a branch and open a PR, and a person merges it.
remote="$1"
prot="main master"
d=$(git symbolic-ref --short "refs/remotes/$remote/HEAD" 2>/dev/null) && prot="$prot ${{d#*/}}"
prot="$prot $(git config --get-all orch.protected 2>/dev/null | tr '\n' ' ')"
input=$(cat)
blocked=""
while read -r lref lsha rref rsha; do
  b=${{rref#refs/heads/}}
  [ -n "$b" ] && [ "$b" != "$rref" ] || continue
  for p in $prot; do [ "$b" = "$p" ] && blocked="$blocked $b"; done
done <<EOF
$input
EOF
if [ -n "$blocked" ]; then
  echo "orch guard: REFUSED push to$blocked on $remote." >&2
  echo "orch guard: no agent pushes to main, even when asked. Push the run's branch and open a PR;" >&2
  echo "orch guard: a person merges it on GitHub (or with \`orch finish\`, which pushes the branch and opens the PR)." >&2
  exit 1
fi
here=$(dirname "$0")
if [ -x "$here/pre-push.orch-orig" ]; then
  printf '%s\n' "$input" | "$here/pre-push.orch-orig" "$@"
  exit $?
fi
exit 0
"""


def guard_root():
    """The repo the guard is for: the run's repo, or (for commands that run outside a run) the one we are in."""
    if ROOT:
        return ROOT
    r = git("rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
    return Path(r.stdout.strip()).parent if r.returncode == 0 else None


def protected_branches():
    """Branches no agent may push to: main, master, origin's default branch, and any in `git config orch.protected`
    (the same list the pre-push guard reads)."""
    names = set(GUARD_ALWAYS)
    r = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=ROOT, check=False)
    if r.returncode == 0 and "/" in r.stdout.strip():
        names.add(r.stdout.strip().split("/", 1)[1])
    names |= set(git("config", "--get-all", "orch.protected", cwd=ROOT, check=False).stdout.split())
    return names


def refuse_protected(branch, what):
    """Stop with the rule when `branch` is one nobody's agent may push to."""
    if branch in protected_branches():
        die(f"{what}: {branch} is a protected branch. {GUARD_RULE} Use `Branch: feature/<slug>` (or fix/<slug>).")


def guard_hook_path():
    hooks = Path(git("rev-parse", "--path-format=absolute", "--git-path", "hooks", cwd=guard_root()).stdout.strip())
    return hooks / "pre-push"


def guard_state():
    """(state, hook path, note): state is `on`, `old` (an older orch wrote it), `off` or `blocked` (the repo keeps
    its hooks inside the project, e.g. husky via core.hooksPath: orch doesn't write into the project's files)."""
    hook = guard_hook_path()
    root = guard_root()
    try:
        inside = hook.parent.resolve().is_relative_to(root.resolve()) and not hook.parent.resolve().is_relative_to(
            Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=root).stdout.strip()).resolve())
    except (OSError, ValueError):
        inside = False
    text = hook.read_text(errors="replace") if hook.is_file() else ""
    if GUARD_MARK in text:
        m = re.search(rf"{re.escape(GUARD_MARK)} v(\d+)", text)
        ok = m and int(m.group(1)) >= GUARD_VERSION and os.access(hook, os.X_OK)
        return ("on" if ok else "old"), hook, ""
    if inside:
        return "blocked", hook, (f"this repo keeps its git hooks in {hook.parent} (core.hooksPath), inside the "
                                 f"project, so orch does not write there")
    return "off", hook, ("another pre-push hook is there; orch keeps it and runs it after its own check"
                         if text else "")


def guard_install():
    """Write the pre-push guard into the repo's hooks folder (shared by every worktree). Keeps a pre-push hook that
    was already there: it moves to pre-push.orch-orig and runs after orch's check. Returns (state, line)."""
    state, hook, note = guard_state()
    if state == "on":
        return state, f"GUARD on: {short(hook)} refuses pushes to {', '.join(sorted(protected_branches()))}"
    if state == "blocked":
        return state, f"WARN GUARD not installed: {note}. Save the output of `orch guard --print` as the pre-push hook there yourself."
    hook.parent.mkdir(parents=True, exist_ok=True)
    if state == "off" and hook.exists():
        os.replace(hook, hook.with_name("pre-push.orch-orig"))
    hook.write_text(GUARD_HOOK.format(mark=GUARD_MARK, version=GUARD_VERSION))
    hook.chmod(0o755)
    kept = " (your own pre-push hook still runs after it)" if hook.with_name("pre-push.orch-orig").exists() else ""
    return "on", (f"GUARD {'updated' if state == 'old' else 'installed'}: {short(hook)} refuses pushes to "
                  f"{', '.join(sorted(protected_branches()))}{kept}")


def guard_ensure(say_changes=True):
    """Install or refresh the guard (never fails the caller). Prints when it could not be installed, and when it
    installed or updated it (unless say_changes is False)."""
    if not guard_root():
        return
    with contextlib.suppress(Exception, SystemExit):
        before = guard_state()[0]
        state, line = guard_install()
        if state != "on" or (say_changes and before != "on"):
            print(line)


def github_protection(branch):
    """'protected', 'open' or None (unknown: no gh, not GitHub, no network) for `branch` on origin, via gh."""
    if os.environ.get("ORCH_GUARD_GITHUB", "1") == "0" or not shutil.which("gh"):
        return None
    url = git("remote", "get-url", "origin", cwd=ROOT, check=False).stdout.strip()
    m = re.search(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", url)
    if not m:
        return None
    try:
        r = subprocess.run(["gh", "api", f"repos/{m[1]}/{m[2]}/branches/{branch}", "--jq", ".protected"],
                           cwd=ROOT, text=True, capture_output=True, timeout=15)
        if r.returncode == 0 and r.stdout.strip() == "true":
            return "protected"
        r2 = subprocess.run(["gh", "api", f"repos/{m[1]}/{m[2]}/rules/branches/{branch}", "--jq", "length"],
                            cwd=ROOT, text=True, capture_output=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r2.returncode == 0 and r2.stdout.strip().isdigit():
        return "protected" if int(r2.stdout.strip()) > 0 else "open"
    return "open" if r.returncode == 0 else None


def guard_report():
    """Lines for `orch guard status` and `orch doctor`: (ok, text) pairs."""
    state, hook, note = guard_state()
    prot = ", ".join(sorted(protected_branches()))
    out = [(state == "on", {"on": f"pre-push guard is on ({short(hook)}): pushes to {prot} are refused",
                            "old": f"pre-push guard is from an older orch ({short(hook)}): run `orch guard` to update it",
                            "off": f"pre-push guard is missing ({short(hook)}): run `orch guard` (orch start also "
                                   f"installs it)" + (f"; {note}" if note else ""),
                            "blocked": f"pre-push guard can't be installed: {note}. Save the output of "
                                       f"`orch guard --print` as the pre-push hook there yourself"}[state])]
    for b in sorted(protected_branches()):
        if not branch_exists(b):
            continue
        gh = github_protection(b)
        if gh == "open":
            out.append((False, f"GitHub does not protect {b}: a push that skips git hooks (--no-verify) would still "
                               f"land. Turn on Settings > Rules > Rulesets > New branch ruleset > target {b} > "
                               f"\"Require a pull request before merging\" and \"Block force pushes\""))
        elif gh == "protected":
            out.append((True, f"GitHub protects {b}: changes reach it only through a PR"))
    return out


def cmd_guard(args):
    """orch guard [status | --print] -> install the pre-push guard that refuses pushes to main (status: report only;
    --print: the hook script, to add to a hooks folder orch can't write)."""
    sub = args[0] if args else ""
    if sub == "--print":
        print(GUARD_HOOK.format(mark=GUARD_MARK, version=GUARD_VERSION), end="")
        return
    if sub not in ("", "status"):
        die("usage: orch guard [status | --print]")
    if not guard_root():
        die("not inside a git repository: run `orch guard` in the project's folder")
    print(GUARD_RULE)
    if sub == "":
        print(guard_install()[1])
    bad = 0
    for ok, m in guard_report():
        print(f"  {'ok ' if ok else 'BAD'} {m}")
        bad += not ok
    sys.exit(1 if bad else 0)


def is_dirty(path):
    return bool(git("status", "--porcelain", cwd=path).stdout.strip())


# ---------------------------------------------------------------- plan parsing
HEAD_RE = re.compile(r"^## \[( |x|X)\]\s*(M\d+)\s*:\s*(.+?)\s*$")
FIELD_RE = re.compile(r"^([A-Z][A-Za-z ]+):\s*(.*)$")


def parse_plan(text):
    """Header fields (before the first `## ` heading) -> cfg; `## [x] Mn: title` sections -> tasks.
    `Key: value` lines inside other sections (e.g. Global instructions) are text, never header fields."""
    cfg, tasks, cur, cur_field, in_header = {}, [], None, None, True
    for raw in text.splitlines():
        line = raw.rstrip()
        m = HEAD_RE.match(line)
        if m:
            cur = {"id": m.group(2), "enabled": m.group(1).lower() == "x", "title": m.group(3),
                   "fields": {}}
            tasks.append(cur)
            cur_field, in_header = None, False
            continue
        if line.startswith("## "):          # e.g. "## Global instructions"
            cur, cur_field, in_header = None, None, False
            continue
        fm = FIELD_RE.match(line.strip())
        if fm and not line.startswith((" ", "\t", "-")) and (cur or in_header):
            key, val = fm.group(1).strip().lower(), fm.group(2).strip()
            target = cur["fields"] if cur else cfg
            target[key] = [val] if val else []
            cur_field = (target, key)
            continue
        if fm and not cur and not in_header:
            cur_field = None
            continue
        if cur_field and line.strip():
            cur_field[0][cur_field[1]].append(line.strip())
    return cfg, tasks


DUR_RE = re.compile(r"(\d+(?:\.\d+)?)\s*(hours?|hrs|hr|h|minutes?|mins|min|m)", re.I)


def parse_dur(s):
    """`45m`, `1h30m`, `1.5h`, `90 min`, `2 hours` -> seconds; None when empty or not a duration."""
    s = (s or "").strip().lower()
    if not s or s in ("none", "-", "n/a", "unknown"):
        return None
    parts = DUR_RE.findall(s)
    if not parts or DUR_RE.sub("", s).strip(" ,+and") != "":
        return None
    return int(sum(float(n) * (3600 if u.startswith("h") else 60) for n, u in parts))


def field(t, key, default=""):
    vals = t["fields"].get(key)
    return " ".join(vals).strip() if vals else default


def split_ids(s):
    if not s or s.lower() in ("none", "-", "n/a"):
        return []
    return re.findall(r"M\d+", s)


def has_open_questions(t):
    vals = [v.lstrip("- ").strip().lower() for v in t["fields"].get("open questions", [])]
    vals = [v for v in vals if v]
    return bool(vals) and vals != ["none"]


# a model may carry a thinking level after @ (`codex: gpt-6.2-sol@low`); a pane id follows a space (` @pane:w1:p3`)
AGENT_RE = re.compile(r"([\w.-]+)\s*\(\s*([\w.-]+)(?:\s*:\s*([^\s)]+?))?(?:\s+@pane:([^\s)]+))?\s*\)")


def parse_agents(s):
    """`claude-1 (claude: sonnet), hermes-1 (hermes @pane:w1:p3)` -> {name: (kind, pane or None)}"""
    return {name: (kind.lower(), pane or None) for name, kind, _, pane in AGENT_RE.findall(s or "")}


def parse_models(s):
    """`claude-1 (claude: sonnet), codex-1 (codex)` -> {name: "sonnet" or None}: the model each pane was started with."""
    return {name: (model.lower() or None) for name, _, model, _ in AGENT_RE.findall(s or "")}


def parse_workers(s):
    return {name: kind for name, (kind, _) in parse_agents(s).items()}


# ---------------------------------------------------------------- commands
def cmd_sync(args):
    plan = ORCH / "plan.md"
    if not plan.exists():
        others = other_plan_files()
        die("missing .orchestrate/plan.md" + (
            f" (found {', '.join(others[:3])}, but orch only reads plan.md: rename or copy it to plan.md)"
            if others else ""))
    plan_text = plan.read_text()
    cfg, tasks = parse_plan(plan_text)
    errors, warns = [], []
    newer = other_plan_files(plan.stat().st_mtime)
    if newer:
        warns.append(f"{', '.join(newer[:3])} {'is' if len(newer) == 1 else 'are'} newer than plan.md, but orch only "
                     f"reads plan.md. If that is the plan you mean, copy it to plan.md and run `orch sync` again")

    get = lambda k, d="": " ".join(cfg.get(k, [])).strip() or d
    branch = get("branch").split()[0] if get("branch") else die("plan header needs `Branch: feature/<slug>`")
    if branch.startswith("orch/"):
        warns.append(f"Branch {branch}: runs now use one feature branch — prefer `Branch: feature/<slug>` "
                     f"(orch no longer makes per-milestone branches either way)")
    if git("check-ref-format", "--branch", branch, cwd=ROOT, check=False).returncode != 0:
        errors.append(f"Branch {branch!r} is not a valid git branch name")
    if branch in protected_branches():
        errors.append(f"Branch {branch} is a protected branch: a run never works on it or pushes to it. {GUARD_RULE} "
                      f"Use `Branch: feature/<slug>` (or fix/<slug>)")
    commits = get("commits", "per-milestone").split()[0].lower()
    if commits not in ("per-milestone", "single"):
        errors.append(f"Commits must be per-milestone or single, got {commits!r}")
    title_m = re.search(r"(?m)^# Plan:\s*(.+?)\s*$", plan_text)
    mode = (get("mode", "full").split() or ["full"])[0].lower()
    if mode not in ("quick", "full"):
        errors.append(f"Mode must be quick or full, got {mode!r}")
    quick = mode == "quick"
    quick_because = get("quick because")
    isolation = get("isolation", "shared" if quick else "worktree").split()[0].lower()
    if isolation not in ("worktree", "shared"):
        errors.append(f"Isolation must be worktree or shared, got {isolation!r}")
    try:
        max_par = int(re.findall(r"\d+", get("max parallel", "2"))[0])
    except IndexError:
        max_par = 2
    if isolation == "shared":
        max_par = 1
    scope = get("scope", "warn").split()[0].lower()
    if scope not in ("warn", "strict"):
        errors.append(f"Scope must be warn or strict, got {scope!r}")
    risk_hold = not get("risk hold", "on").lower().startswith("off")
    try:
        par_checks = max(1, int(re.findall(r"\d+", get("parallel checks", "1"))[0]))
    except IndexError:
        errors.append(f"Parallel checks must be a number, got {get('parallel checks')!r}")
        par_checks = 1
    if isolation == "shared":
        par_checks = 1                     # one folder: two checks in it at once would see each other's files
    early_review = not get("early review", "on").lower().startswith("off")
    branch_check = (get("branch check", "auto").split() or ["auto"])[0].lower()
    if branch_check not in ("auto", "always"):
        errors.append(f"Branch check must be auto or always, got {branch_check!r}")
    auto_dispatch = not get("auto dispatch", "on").lower().startswith("off")
    budget_s = None
    if get("budget"):
        bm = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*(h|m|min|hours?|minutes?)?\s*", get("budget"), re.I)
        if not bm:
            errors.append(f"Budget must look like `3h` or `90m`, got {get('budget')!r}")
        else:
            budget_s = max(1, int(float(bm.group(1)) * (60 if (bm.group(2) or "h").lower().startswith("m") else 3600)))
    workers = parse_agents(get("workers"))
    if not workers:
        errors.append("plan header needs `Workers: claude-1 (claude), codex-1 (codex)`")
    rev = get("reviewer", "none")
    rm = re.match(r"([\w.-]+)\s*\(", rev)
    reviewer = None if rev.lower().startswith("none") or not rm else rm.group(1)
    rev_kind, rev_pane = parse_agents(rev).get(reviewer, (None, None)) if reviewer else (None, None)
    lead = next(iter(parse_agents(get("lead")).items()), None)          # optional `Lead: lead (claude)`
    if get("lead") and not lead:
        errors.append("`Lead:` must look like `Lead: lead (claude)`")
    if lead:
        if lead[0] in workers:
            errors.append(f"lead {lead[0]!r} is also listed in Workers — the lead never codes in its own run")
        if lead[0] == reviewer:
            errors.append(f"lead {lead[0]!r} is also the Reviewer — the lead never reviews in its own run")
    reg = registry(required=False)
    cat = models_catalog()
    models = {**parse_models(get("workers")), **parse_models(rev), **parse_models(get("lead"))}
    unrated = set()
    for name, mid in models.items():
        why = model_denied(cat, mid)
        if why:
            errors.append(f"{name} runs {mid!r}, which the model policy does not allow (pattern {why!r}: "
                          f"{cat['policy'].get('deny_why', 'not allowed in runs')}) — pick another model (`orch models`)")
        elif mid and cat and model_tier(cat, mid) is None:
            unrated.add(mid)
            warns.append(f"{name} runs {mid!r}, which is not in the model catalog, so it has no tier — add it to "
                         f"{user_models_file()} (`orch models` shows the format)")
    tier_of = lambda name: model_tier(cat, models.get(name)) if models.get(name) else None
    lead_mode = get("lead mode", "events" if lead else "off").split()[0].lower()
    if lead_mode not in ("events", "off"):
        errors.append(f"Lead mode must be events or off, got {lead_mode!r}")
    if lead_mode == "events" and not lead:
        errors.append("`Lead mode: events` needs a `Lead: lead (<kind>)` header line")

    def detect(kind, pane, role):
        if pane:                       # addressed by pane id: herdr doesn't know it as an agent
            return False
        if reg is None:                # Python < 3.11: no registry, v4.2 behaviour
            return True
        if kind not in reg:
            warns.append(f"{role} kind {kind!r} is not in the agent registry (`orch agents`) — herdr may not "
                         f"watch it, so only its done file and time budget count")
            return False
        return bool(reg[kind].get("herdr_detect", True))

    ids = [t["id"] for t in tasks]
    dupes = {i for i in ids if ids.count(i) > 1}
    if dupes:
        errors.append(f"duplicate task ids: {sorted(dupes)}")
    by_id = {t["id"]: t for t in tasks}
    # "Depends on: M1 (uses the API types M1 defines), M2 (needs the table)": reasons in parentheses
    deps = {t["id"]: split_ids(re.sub(r"\([^)]*\)", "", field(t, "depends on", "none"))) for t in tasks}
    for t in tasks:
        raw = field(t, "depends on", "none")
        for d in deps[t["id"]]:
            if t["enabled"] and not re.search(rf"\b{d}\s*\(", raw):
                warns.append(f"{t['id']} depends on {d} without a reason — write `{d} (what it needs from {d})`")
    for tid, ds in deps.items():
        for d in ds:
            if d not in by_id:
                errors.append(f"{tid} depends on unknown task {d}")
            if d == tid:
                errors.append(f"{tid} depends on itself")

    # cycle detection
    color = {}
    def dfs(n, stack):
        color[n] = 1
        for d in deps.get(n, []):
            if d not in by_id:
                continue
            if color.get(d) == 1:
                errors.append("dependency cycle: " + " -> ".join(stack + [n, d]))
            elif not color.get(d):
                dfs(d, stack + [n])
        color[n] = 2
    for n in by_id:
        if not color.get(n):
            dfs(n, [])

    # transitive closure -> overlap warnings for tasks that can run in parallel
    def ancestors(n, seen=None):
        seen = set() if seen is None else seen
        for d in deps.get(n, []):
            if d in by_id and d not in seen:
                seen.add(d)
                ancestors(d, seen)
        return seen
    anc = {n: ancestors(n) for n in by_id}
    files = {n: {f.strip().strip("`") for f in re.split(r"[,\s]+", field(by_id[n], "likely files")) if f.strip()}
             for n in by_id}
    enabled = [t["id"] for t in tasks if t["enabled"]]
    parallel_pairs, hot_warned, any_parallel = [], set(), False
    for i, a in enumerate(enabled):
        for b in enabled[i + 1:]:
            if a in anc[b] or b in anc[a]:
                continue
            any_parallel = True
            common = files[a] & files[b]
            par = any(field(by_id[x], "parallel", "").lower().startswith("allow") for x in (a, b))
            if common and isolation == "worktree":
                warns.append(f"{a} and {b} both touch {sorted(common)}: " +
                             ("`Parallel: allow` runs them together — expect a merge conflict" if par else
                              "orch runs them one after the other (add `Depends on` to fix the order, or "
                              "`Parallel: allow` to run them together)"))
            if isolation == "shared":
                parallel_pairs.append((a, b))
            for x in (a, b):
                hot = sorted(f for f in files[x] if HOTSPOT_RE.search(f))
                if hot and isolation == "worktree" and x not in hot_warned:
                    hot_warned.add(x)
                    warns.append(f"{x} touches shared hotspot file(s) {hot} but can run in parallel with "
                                 f"{b if x == a else a} — move those edits into a scaffold milestone both depend on")
    # split for the team you have: idle coders on a chain, or parallel work with nobody to run it
    if len(workers) >= 2 and len(enabled) >= 2 and not any_parallel:
        warns.append(f"{len(workers)} coders but every milestone depends on the one before, so only one coder "
                     f"works at a time — if the feature spans backend and frontend, put the contract under "
                     f"Interfaces (or in a small contract milestone) so both sides can run in parallel")
    if len(workers) == 1 and any_parallel and isolation == "worktree":
        warns.append("1 coder: independent milestones will still run one at a time — "
                     "`Isolation: shared` is simpler unless you will add coders")
    if parallel_pairs:
        a, b = parallel_pairs[0]
        warns.append(f"{a} and {b} are independent — with `Isolation: worktree` they could run in parallel "
                     f"(shared mode runs one milestone at a time)")

    # the lead describes WHAT and WHY; coders decide HOW
    try:
        secs, _ = plan_sections()
    except Exception:
        secs = {}
    for tid in enabled:
        sec = secs.get(tid, "")
        if "```" in sec:
            warns.append(f"{tid} contains a code block — describe what and why; the coder decides how")
        elif re.search(r"(?im)^\s*(step\s*\d+\b|\d+\.\s*(create|add|implement|write|call|refactor|update|use|"
                       r"install|modify)\b)", sec):
            warns.append(f"{tid} reads like step-by-step implementation — state the goal and acceptance "
                         f"criteria; the coder decides how")

    for tid in enabled:
        crit = [v.lstrip("- ").strip() for v in by_id[tid]["fields"].get("acceptance criteria", [])]
        if not [c for c in crit if c and c.lower() != "none"]:
            warns.append(f"{tid} has no Acceptance criteria — the coder's result and the review check each one")

    # tiers: what each milestone asks of its coder's model, and whether the team can give it
    tiers, needs = {}, {}
    worker_ranks = [rank(tier_of(n)) for n in workers]
    for t in tasks:
        tid = t["id"]
        tv = (field(t, "tier", "any").split() or ["any"])[0].lower()
        if tv not in TIERS + ("any",):
            errors.append(f"{tid}: Tier must be small, medium or high, got {tv!r}")
            tv = "any"
        tiers[tid] = None if tv == "any" else tv
        needs[tid] = [n for n in re.split(r"[,\s]+", field(t, "needs").lower()) if n]
        bad = [n for n in needs[tid] if n not in NEEDS]
        if bad:
            warns.append(f"{tid}: Needs has unknown value(s) {bad} — use any of: {', '.join(NEEDS)}")
        if not t["enabled"] or not tiers[tid]:
            continue
        if not field(t, "model why"):
            warns.append(f"{tid} has `Tier: {tv}` but no `Model why:` — say in one line why this tier fits")
        if any(worker_ranks) and not any(r == 0 or r >= rank(tv) for r in worker_ranks):
            warns.append(f"{tid} asks for a {tv}-tier model, but no coder in Workers runs one — it will go to the "
                         f"strongest coder you have; start a coder with a {tv}-tier model (`orch models`) or lower the tier")
        elif not any(worker_ranks) and workers:
            warns.append(f"{tid} has `Tier: {tv}`, but Workers does not say which model each coder runs — write "
                         f"`name (kind: model)` so the tier can be honoured")
        if (field(t, "review", "no").lower().startswith("y") and reviewer and rank(tier_of(reviewer))
                and rank(tier_of(reviewer)) < rank(tv)):
            warns.append(f"{tid} is {tv}-tier work reviewed by a {tier_of(reviewer)}-tier model ({models[reviewer]}) — "
                         f"a reviewer weaker than the coder misses design errors")
    if lead and models.get(lead[0]) and rank(tier_of(lead[0])) not in (0, 3):
        warns.append(f"the lead runs {models[lead[0]]!r} ({tier_of(lead[0])} tier) — planning and coordination are "
                     f"high-tier work")

    # time estimates: the lead's guess per milestone and for the feature, held against the time orch measures
    estimates = {}
    for t in tasks:
        raw = field(t, "estimate")
        estimates[t["id"]] = parse_dur(raw)
        if raw and estimates[t["id"]] is None and raw.lower() not in ("none", "-", "n/a", "unknown"):
            errors.append(f"{t['id']}: Estimate must look like `40m`, `1h30m` or `2h`, got {raw!r}")
        elif not raw and t["enabled"]:
            warns.append(f"{t['id']} has no `Estimate:` — say how long it should take from dispatch to landed "
                         f"(e.g. `Estimate: 40m`), so the summary can compare it with the real time")
    feature_est = parse_dur(get("estimate"))
    if get("estimate") and feature_est is None:
        errors.append(f"Estimate must look like `2h` or `1h30m`, got {get('estimate')!r}")
    elif not get("estimate"):
        warns.append("plan header has no `Estimate:` — how long the whole feature should take, with parallel "
                     "milestones counted once (e.g. `Estimate: 2h`)")

    # the feature decides how many milestones there are: every split has to say what it buys
    if len(enabled) > 1:
        for tid in enabled:
            if not field(by_id[tid], "why separate"):
                warns.append(f"{tid} has no `Why separate:` — say why it is its own milestone (parallel work, a "
                             f"foundation others build on, too big for one sitting), or merge it into another")
    # a quick run: one small, clear milestone, the lead says why it is small, and nothing that needs the full process
    if quick:
        if not quick_because:
            errors.append("`Mode: quick` needs `Quick because: <what you found in the code that makes this small>` "
                          "— e.g. `Quick because: the column already exists, only the response changes`")
        # follow-ups added by `orch fix` after the quick milestone landed are not extra planned milestones
        try:
            fixes = {k for k, v in json.loads(STATE.read_text()).get("tasks", {}).items() if v.get("fix_of")}
        except (OSError, ValueError, AttributeError):
            fixes = set()
        planned = [tid for tid in enabled if tid not in fixes]
        if len(planned) > 1:
            errors.append(f"`Mode: quick` is one milestone, and this plan has {len(planned)} — put the small changes "
                          f"in one milestone (one acceptance criterion each), or use `Mode: full`")
        if isolation == "worktree":
            warns.append("`Mode: quick` with `Isolation: worktree`: one milestone needs no separate folder — "
                         "`Isolation: shared` skips the worktree and its setup")
        for tid in enabled:
            never = sorted({f"{what}: {f}" for f in files[tid] for rx, what in QUICK_NEVER if rx.search(f)})
            if never:
                errors.append(f"{tid} lists {', '.join(never)} — a quick run never touches these; use `Mode: full`")
            careful = sorted(f for f in files[tid] if QUICK_CAREFUL_RE.search(f))
            if careful:
                warns.append(f"{tid} lists {', '.join(careful)}, which looks like auth, payment or schema code — "
                             f"those take the full process; keep `Mode: quick` only if the change does not touch them")
            if has_open_questions(by_id[tid]):
                errors.append(f"{tid} has open questions — a quick run needs a clear change; answer them or use "
                              f"`Mode: full`")
    # hard to undo (`Door: one-way (why)`): always waits for the developer's `orch approve` before it lands
    doors = {}
    for tid in ids:
        dv = field(by_id[tid], "door")
        if not dv:
            continue
        kind_ = re.match(r"\s*(one|two)[\s-]*way", dv, re.I)
        if not kind_:
            warns.append(f"{tid}: `Door: {dv}` — write `Door: one-way (why it is hard to undo)`, or leave the line out "
                         f"(easy to undo)")
            continue
        why_ = dv[kind_.end():].strip(" \t:-—–").strip()
        why_ = why_[1:-1].strip() if why_.startswith("(") and why_.endswith(")") else why_
        if kind_.group(1).lower() == "one":
            doors[tid] = why_
            if tid in enabled and not why_:
                warns.append(f"{tid} is `Door: one-way` without a reason — say why it is hard to undo, e.g. "
                             f"`Door: one-way (rewrites the orders table, 2M rows)`")
            if tid in enabled and quick:
                errors.append(f"{tid} is `Door: one-way` (hard to undo) — a quick run never is; use `Mode: full`")
            if tid in enabled and not risk_hold:
                warns.append(f"{tid} is `Door: one-way`, but `Risk hold: off` lets it land without your `orch approve`")
    # the repo's own words: the plan should use them, and a new word or decision needs a milestone that writes it down
    dst = {"docs": (get("docs").split() or [None])[0]}
    drel = docs_root(dst)[1]
    secs_all, glob_all = plan_sections()
    gl = glossary(dst)
    for tid in [*enabled, None]:
        text = glob_all if tid is None else re.split(r"(?im)^notes from user:", secs_all.get(tid, ""))[0]
        hits = sorted({(a, g["term"]) for g in gl for a in g["avoid"] if word_in(a, text) and not word_in(g["term"], a)})
        for a, term in hits:
            warns.append(f"{tid or 'Global instructions'} says {a!r}, but {drel}/glossary.md says to use {term!r} "
                         f"instead — use the project's word, or change the glossary on purpose")
    gloss_add = glossary_additions(plan_text)
    gpath = f"{drel}/glossary.md"
    if gloss_add and not any(path_allowed(gpath, files[tid]) for tid in enabled):
        warns.append(f"`## Glossary additions` lists {len(gloss_add)} new word(s), but no milestone has {gpath} in its "
                     f"Likely files — give the milestone that brings the word an acceptance criterion like "
                     f"\"{gpath} defines <word>\" and list the file")
    for tid in enabled:
        crit = " ".join(by_id[tid]["fields"].get("acceptance criteria", []))
        named = sorted(set(re.findall(re.escape(drel) + r"/(?:adr/[\w.\-]+\.md|glossary\.md|coding-standards\.md)", crit)))
        for pth in named:
            if not path_allowed(pth, files[tid]):
                warns.append(f"{tid}'s acceptance criteria name {pth}, which is not in its Likely files — add it, so "
                             f"the coder may write it")
    max_tasks = int(os.environ.get("ORCH_MAX_TASKS", "0") or 0)     # no limit unless you set one
    if max_tasks and len(enabled) > max_tasks:
        warns.append(f"{len(enabled)} enabled milestones (> ORCH_MAX_TASKS={max_tasks}). Merge coupled milestones "
                     f"or split the feature into separate runs")

    if errors:
        for e in errors:
            print("ERROR:", e)
        sys.exit(2)

    old = json.loads(STATE.read_text()) if STATE.exists() else {}
    old_tasks = old.get("tasks", {})
    base = get("base") or old.get("base")
    if base and base.split()[0] == branch:
        errors.append(f"Base and Branch are both {branch!r}")
    if base and git("check-ref-format", "--branch", base.split()[0], cwd=ROOT, check=False).returncode != 0:
        errors.append(f"Base {base!r} is not a valid git branch name")
    if errors:
        for e in errors:
            print("ERROR:", e)
        sys.exit(2)
    st = {
        "branch": branch,
        "base": base.split()[0] if base else None,
        "title": title_m.group(1) if title_m else branch,
        "commits": commits,
        "mode": mode,
        "orch_mode": plan_orch_mode(old, branch, lead[1][0] if lead else None),   # panes, or subagent (Pi leads only)
        "quick_because": quick_because if quick else None,
        "green_tree": old.get("green_tree"),
        "integration_broken": old.get("integration_broken"),
        "schema": STATE_SCHEMA,
        "notified": old.get("notified", []),
        "merging": old.get("merging"),
        "root_setup_hash": old.get("root_setup_hash"),
        "run": old.get("run", {}),
        "isolation": isolation,
        "max_parallel": max_par,
        "setup_inputs": [p.strip("`") for p in re.split(r"[,\s]+", get("setup inputs")) if p.strip("`")],
        "scope": scope,
        "risk_hold": risk_hold,
        "docs": (get("docs").split() or [None])[0],        # where the repo keeps glossary.md, adr/, coding-standards.md
        "glossary_additions": gloss_add,
        "parallel_checks": par_checks,
        "early_review": early_review,
        "branch_check": branch_check,
        "auto_dispatch": auto_dispatch,
        "budget_s": budget_s,
        "estimate_s": feature_est,
        "check": get("check command"),
        "setup": get("setup command", "none"),
        "reviewer": reviewer,
        "reviewer_info": ({"kind": rev_kind, "pane": rev_pane, "detect": detect(rev_kind, rev_pane, "Reviewer"),
                           "model": models.get(reviewer), "tier": tier_of(reviewer),
                           **({k: v for k, v in (old.get("reviewer_info") or {}).items()
                               if k in ("cooldown_until", "cooldown_reason", "ctx", "compacting") and v is not None}
                              if old.get("reviewer") == reviewer else {})}
                          if reviewer else None),
        "reviewer_busy": old.get("reviewer_busy") if old.get("reviewer") == reviewer else None,
        "lead": ({"name": lead[0], "kind": lead[1][0],
                  **({"pane": lead[1][1]} if lead[1][1] else {}),
                  **({"model": models[lead[0]], "tier": tier_of(lead[0])} if models.get(lead[0]) else {}),
                  **({"detect": False} if lead_mode == "events" and not detect(lead[1][0], lead[1][1], "Lead") else {})}
                 if lead else None),
        "lead_mode": lead_mode,
        "lead_events": old.get("lead_events", []),
        "story": old.get("story", []),
        "lead_seq": old.get("lead_seq", 0),
        "lead_wake": old.get("lead_wake"),
        "lead_ready_told": old.get("lead_ready_told"),
        "compact_told": old.get("compact_told") or [],
        "tree_task": old.get("tree_task"),
        "workers": {},
        "order": ids,
        "tasks": {},
    }
    for name, (kind, pane) in workers.items():
        ow = old.get("workers", {}).get(name, {})
        st["workers"][name] = {"kind": kind, "task": ow.get("task"), "cooldown_until": ow.get("cooldown_until", 0),
                               "cooldown_reason": ow.get("cooldown_reason", ""),
                               **({"off": ow["off"]} if ow.get("off") else {}),     # kept until `orch bench <w> on`
                               **({"stopping": ow["stopping"]} if ow.get("stopping") else {}),   # told to stop
                               **({k: ow[k] for k in ("ctx", "compacting") if ow.get(k)}
                                  if ow.get("kind") in (None, kind) else {}),     # what its chat holds
                               "dir": ow.get("dir"), "setup_done": ow.get("setup_done", False),
                               "setup_hash": ow.get("setup_hash"), "delivery_fails": ow.get("delivery_fails", 0),
                               "pane": pane, "detect": detect(kind, pane, "Workers"),
                               "model": models.get(name), "tier": tier_of(name)}
    for t in tasks:
        tid = t["id"]
        o = old_tasks.get(tid, {})
        status = o.get("status", "pending")
        if not t["enabled"] and status not in ACTIVE | TERMINAL_OK:
            status = "skipped"
        elif t["enabled"] and status == "skipped":
            status = "pending"
        q = has_open_questions(t)
        if status == "pending" and q:
            status = "needs-answer"
        elif status == "needs-answer" and not q:
            status = "pending"
        st["tasks"][tid] = {
            **o,  # keep runtime fields (last_report, review_ok, conflicts, ...)
            "title": t["title"], "deps": deps[tid],
            "prefer": field(t, "prefer", "any").split()[0].lower() if field(t, "prefer", "any") else "any",
            "review": field(t, "review", "no").lower().startswith("y") and reviewer is not None,
            "status": o.get("status", "pending"), "reason": o.get("reason", ""),
            "worker": o.get("worker"), "dir": o.get("dir"), "attempt": o.get("attempt", 0),
            "fix": o.get("fix", 0), "review_round": o.get("review_round", 0),
            "wait": o.get("wait"),
            "files": sorted(files[tid]),
            "parallel": field(t, "parallel", "").lower().startswith("allow"),
            "tier": tiers[tid], "needs": needs[tid], "model_why": field(t, "model why"), "role": field(t, "role"),
            "estimate_s": estimates[tid],
            # for the developer (`orch plan show`): the milestone in plain words, and the plan's own reasons
            "plain": field(t, "plain"), "why_sep": field(t, "why separate"), "deps_text": field(t, "depends on"),
            # hard to undo: always held for `orch approve`, with the coder's proof (None = easy to undo)
            "door": "one-way" if tid in doors else None, "door_why": doors.get(tid) or None,
        }
        if status != st["tasks"][tid]["status"]:
            move(st, tid, status, {"skipped": "unticked in plan.md", "needs-answer": "open questions in plan.md"}
                 .get(status, ""), force=True)
    for tid, t in st["tasks"].items():
        skipped = [d for d in t["deps"] if st["tasks"][d]["status"] == "skipped"]
        if skipped and t["status"] in ("pending", "needs-answer"):
            move(st, tid, "needs-answer", f"depends on skipped {', '.join(skipped)} — ask the developer", force=True)
            warns.append(f"{tid} depends on skipped {skipped}")
    # a coder (or the reviewer) can't stay tied to a milestone that left the plan or is no longer in progress
    for name, w in st["workers"].items():
        held = st["tasks"].get(w["task"]) if w.get("task") else None
        if w.get("task") and (held is None or held["status"] not in ACTIVE or held.get("worker") != name):
            warns.append(f"{name} was holding {w['task']}, which is no longer in progress — freed")
            w["task"] = None
    rb = st["tasks"].get(st["reviewer_busy"]) if st.get("reviewer_busy") else None
    if st.get("reviewer_busy") and (rb is None or rb["status"] != "reviewing"):
        st["reviewer_busy"] = None
    # a coder works from the task.md it got; a plan.md edit made meanwhile does not reach it by itself
    secs_, glob_ = plan_sections()
    for tid, t in st["tasks"].items():
        if t.get("task_src") and holds(st, tid) and tid in secs_ and task_source(secs_[tid], glob_) != t["task_src"]:
            warns.append(f"{tid} changed in plan.md, but {t['worker']} is already working from its old task.md, which "
                         f"is not rewritten while it works. To give it the new text: `orch set {tid} paused`, then "
                         f"`orch dispatch {tid}` (its work so far is kept). Or let it finish and send the change "
                         f"after it lands: `orch fix {tid} \"<the change>\"`")
    migrate(st)
    save(st)
    for w in warns:
        print("WARN:", w)
    print(f"OK: {len(tasks)} tasks, " + ("mode=quick, " if quick else "") + f"isolation={isolation}, max_parallel={max_par}, "
          f"workers={list(workers)}, reviewer={reviewer}" + (f", lead={lead[0]}" if lead else ""))


# ---------------------------------------------------------------- git: one feature branch, hidden refs per milestone
def task_ref(st, tid):
    """Hidden ref holding Mn's work in progress (for review, parked, waiting for a fix): never a branch, never pushed."""
    return f"{REF_NS}/{st['branch'].replace('/', '-')}/{tid}"


def ref_ok(ref, cwd=None):
    return git("rev-parse", "--verify", "--quiet", ref + "^{commit}", cwd=cwd or ROOT, check=False).returncode == 0


def legacy_branch(st, tid):
    """Task branch name used before 4.5 (orch/<slug>-Mn); read once so in-flight runs keep their work."""
    return f"refs/heads/{st['branch']}-{tid}"


def work_ref(st, tid):
    """Where Mn's saved work lives: its hidden ref, else a pre-4.5 task branch, else None."""
    for ref in (task_ref(st, tid), legacy_branch(st, tid)):
        if ref_ok(ref):
            return ref
    return None


def ahead_of_branch(st, d):
    """True if HEAD in d has commits the feature branch doesn't."""
    r = git("rev-list", "--count", f"{st['branch']}..HEAD", cwd=d, check=False)
    return r.returncode == 0 and r.stdout.strip() not in ("", "0")


def wip_commit(d, msg):
    """Internal commit that only ever lands on a hidden ref (hooks skipped: it is not a real commit)."""
    git("add", "-A", cwd=d)
    r = git("commit", "-q", "--no-verify", "-m", msg, cwd=d, check=False)
    if r.returncode != 0 and "nothing to commit" not in (r.stdout + r.stderr):
        die(r.stdout + r.stderr)


def stash_to_ref(st, tid):
    """Shared mode: move the tree's uncommitted work into Mn's hidden ref and leave the tree clean."""
    if not is_dirty(ROOT):
        return False
    git("stash", "push", "--include-untracked", "-q", "-m", f"orch {tid}", cwd=ROOT)
    sha = git("rev-parse", "stash@{0}", cwd=ROOT).stdout.strip()
    git("update-ref", task_ref(st, tid), sha, cwd=ROOT)
    git("stash", "drop", "-q", cwd=ROOT)
    return True


def restore_stash(st, tid):
    """Shared mode: put Mn's parked work back into the (clean) tree and drop its ref."""
    ref = task_ref(st, tid)
    sha = git("rev-parse", ref, cwd=ROOT).stdout.strip()
    r = git("stash", "apply", "-q", sha, cwd=ROOT, check=False)
    if r.returncode != 0:
        git("reset", "--hard", "-q", "HEAD", cwd=ROOT)
        git("clean", "-fdq", cwd=ROOT)        # the tree was clean before the apply: only its leftovers go
        die(f"could not restore {tid}'s parked work: it conflicts with what landed since. It is kept in {ref} "
            f"(`git stash apply {sha}` to look at it)\n{r.stdout}{r.stderr}")
    git("update-ref", "-d", ref, cwd=ROOT)


def rescue_ref(st, who):
    """A hidden ref for unsaved files orch found and could not give to a milestone. Kept by `orch finish`."""
    ref = f"{REF_NS}/{st['branch'].replace('/', '-')}/rescue-{who}-{time.strftime('%Y%m%d-%H%M%S')}"
    n = 1
    while ref_ok(ref if n == 1 else f"{ref}-{n}"):       # never write over an earlier rescue
        n += 1
    return ref if n == 1 else f"{ref}-{n}"


def _last_task_of(st, name):
    """The milestone this coder worked on most recently (by its recorded attempts), or None."""
    best = (0, None)
    for tid in st["order"]:
        ends = [a.get("end", 0) for a in st["tasks"][tid].get("attempts") or []
                if a.get("kind") == "coder" and a.get("agent") == name]
        if ends and max(ends) > best[0]:
            best = (max(ends), tid)
    return best[1]


def save_stray(st, name, rescue=True):
    """Worktree mode: a coder that holds no milestone has uncommitted files in its folder (it kept working after
    its milestone was parked, or the machine went down). Save them into the milestone they belong to: the one
    whose saved work this folder is on, else the one this coder worked on last if nothing of it was saved yet.
    When orch can't tell whose they are, they go to a rescue ref (rescue=True) or stay where they are.
    Returns a line saying what happened, or None when there was nothing to save."""
    w = st["workers"].get(name) or {}
    d = w.get("dir")
    if st["isolation"] != "worktree" or w.get("task") or not d or not Path(d).exists() or not is_dirty(d):
        return None
    head = git("rev-parse", "HEAD", cwd=d).stdout.strip()
    owner = None
    for tid in st["order"]:
        if st["tasks"][tid]["status"] in RESTING and ref_ok(task_ref(st, tid)) and \
                git("rev-parse", task_ref(st, tid), cwd=ROOT).stdout.strip() == head:
            owner = tid
            break
    if not owner:
        last = _last_task_of(st, name)
        lt = st["tasks"].get(last) or {}
        if last and lt["status"] in RESTING and lt.get("last_worker") == name and not lt.get("worker") \
                and not work_ref(st, last) and not ahead_of_branch(st, d):
            owner = last
    if owner:
        wip_commit(d, f"orch wip {owner}: files written after it was parked")
        git("update-ref", task_ref(st, owner), "HEAD", cwd=d)
        return f"SAVED {name}'s unsaved files into {owner}'s saved work ({task_ref(st, owner)})"
    if not rescue:
        return None
    ref = rescue_ref(st, name)
    wip_commit(d, f"orch rescue: unsaved files found in {name}'s folder")
    git("update-ref", ref, "HEAD", cwd=d)
    return (f"RESCUED {name}'s unsaved files: orch can't tell which milestone they belong to, so they are kept in "
            f"{ref} (`git show --stat {ref}` to look)")


def shared_fold(st, tid):
    """Shared mode: the main folder has uncommitted files that belong to Mn (written after Mn was parked). Add
    them to Mn's saved work and leave the folder clean. If they can't be combined with what was saved before,
    the newer files are kept in a rescue ref. Returns a line saying what happened."""
    ref = task_ref(st, tid)
    if not ref_ok(ref):
        stash_to_ref(st, tid)
        return f"SAVED the unsaved files in the main folder into {tid}'s saved work ({ref})"
    old = git("rev-parse", ref, cwd=ROOT).stdout.strip()
    git("stash", "push", "--include-untracked", "-q", "-m", f"orch {tid} later", cwd=ROOT)
    new = git("rev-parse", "stash@{0}", cwd=ROOT).stdout.strip()
    keep = rescue_ref(st, tid)
    git("update-ref", keep, new, cwd=ROOT)       # safe before anything else is tried
    git("stash", "drop", "-q", cwd=ROOT)

    def wipe():
        git("reset", "--hard", "-q", "HEAD", cwd=ROOT)
        git("clean", "-fdq", cwd=ROOT)           # only what the applies below put there: both are kept in refs
    if git("stash", "apply", "-q", old, cwd=ROOT, check=False).returncode == 0 and \
            git("stash", "apply", "-q", new, cwd=ROOT, check=False).returncode == 0:
        stash_to_ref(st, tid)                    # both together are Mn's saved work now
        git("update-ref", "-d", keep, cwd=ROOT)
        return f"SAVED the unsaved files in the main folder into {tid}'s saved work ({ref})"
    wipe()
    return (f"RESCUED the unsaved files in the main folder: they don't fit on top of {tid}'s saved work, so they "
            f"are kept in {keep} (`git stash show -p {new[:12]}` to look); {tid} keeps its earlier saved work")


def interrupt_keys(kind):
    """The keys that stop the agent's current step (a registry setting per kind, `interrupt_keys`); default Esc."""
    v = (registry(required=False) or {}).get(kind) or {}
    keys = v.get("interrupt_keys")
    return [str(k) for k in keys] if isinstance(keys, list) and keys else ["esc"]


def interrupt(st, agent):
    """Press the agent's interrupt key(s) in its pane, like a person pressing Esc. A typed message is not a stop:
    an agent busy with a step only reads it after that step (agy queues it), so the key comes first.
    Returns the keys sent, or None when herdr could not send them."""
    info = agent_info(st, agent)
    keys = interrupt_keys(info.get("kind"))
    pane = info.get("pane")
    try:
        _herdr_run([HERDR, "pane", "send-keys", pane, *keys] if pane else [HERDR, "agent", "send-keys", agent, *keys])
    except DeliveryError:
        return None
    return keys


def busy_word(s):
    return word(s, "working", "blocked")


def stop_coder(st, agent, tid, status, reason):
    """Stop a coder whose milestone was just paused or failed (or moved to another coder). Only when it is (or may
    be) still working. It gets the interrupt key first, then the STOP note; whatever it writes anyway is saved the
    next time the milestone or its folder is used. Returns None (nothing to stop) or
    {"keys": [...] or None, "idle": bool, "note": bool, "watched": bool}."""
    watch = watched(st, agent)
    if watch:
        s = herdr_state(agent)
        if s is None or not busy_word(s):
            return None
    keys = interrupt(st, agent)
    idle = False
    if watch:
        end = time.time() + (0 if os.environ.get("ORCH_DRIVER") else HALT_WAIT_S)   # the event manager never waits
        while True:
            s = herdr_state(agent)
            if s is None or not busy_word(s):
                idle = True
                break
            if time.time() >= end:
                break
            time.sleep(0.5)
    why = " ".join((reason or status).split())[:160]
    try:
        deliver(st, agent, f"STOP: {tid} is {status} ({why}). orch interrupted you: stop working on it now and do "
                           f"not change any more files. What you did so far is saved. You get a new prompt if it "
                           f"continues.")
        note = True
    except DeliveryError:
        note = False
    return {"keys": keys, "idle": idle, "note": note, "watched": watch}


def still_stopping(st, name, w=None):
    """True while a coder that was told to stop may still be working: herdr shows it working (or blocked), or it
    went idle less than ORCH_HALT_SETTLE_S after the stop. Such a coder is busy: it gets no new work."""
    w = w if w is not None else st["workers"].get(name) or {}
    h = w.get("stopping")
    if not h or not w.get("detect", True):
        return False
    s = herdr_state(name)
    if s is None:                       # no agent left in herdr: nothing is running there
        return False
    if busy_word(s):
        return True
    # idle now: free once it has stayed idle long enough. The event manager records since when it has seen it idle
    # (a working reading in between starts the count again), so one idle blink between two steps does not free it
    return now() - (h.get("idle_since") or h.get("ts", 0)) < HALT_SETTLE_S


def stopping_line(st, name, w):
    h = w.get("stopping") or {}
    return (f"stopping {h.get('task') or '?'} (told to stop {_fmt_secs(now() - h.get('ts', now()))} ago; "
            f"it gets no new work until herdr shows it idle — `orch free {name}` if you checked its pane)")


# ---------------------------------------------------------------- compacting a coder's or the reviewer's chat
# Every job orch gives a coder or the reviewer is written down in files (task.md, task.json, fix and review files),
# so the chat itself only holds what the agent did on its LAST milestone. Before the agent starts a different
# milestone (and as soon as the milestone it worked on has landed) orch types its tool's compact command
# (`/compact` in Claude Code, Codex and AGY): the tool replaces the long chat with a short summary. Only when herdr
# shows the agent idle, never while it works, and never the lead. A fix or review round of the SAME milestone keeps
# the chat. `orch config compact off` (or ORCH_COMPACT=0) turns it off; `compact = ""` in agents.toml turns it off
# for one tool.

def compact_on():
    env = os.environ.get("ORCH_COMPACT")
    if env in ("0", "1"):
        return env == "1"
    return settings_load().get("compact", True) is not False


_VERSIONS = {}


def _version_of(binary):
    """The x.y.z version `<binary> --version` prints, or None (asked once per process)."""
    if binary not in _VERSIONS:
        _VERSIONS[binary] = _ask_version(binary)
    return _VERSIONS[binary]


def _ask_version(binary):
    try:
        r = subprocess.run([binary, "--version"], text=True, capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", (r.stdout or "") + (r.stderr or ""))
    return tuple(int(x) for x in m.groups()) if m else None


def compact_command(st, kind):
    """(command, None) when orch can compact this kind of agent, else (None, why). A tool whose registry entry has
    `compact_min_version` is asked its version (once per process); too old or unknown: no compacting."""
    if not compact_on():
        return None, "turned off (`orch config compact on` turns it on)"
    v = (registry(required=False) or {}).get(kind) or {}
    cmd = str(v.get("compact") or "").strip()
    if not cmd:
        return None, f"{kind} has no compact command in the agent list"
    need_v = str(v.get("compact_min_version") or "").strip()
    if need_v:
        have = _version_of(v.get("binary", kind))
        want = tuple(int(x) for x in re.findall(r"\d+", need_v)[:3])
        if not have or have < want:
            return None, (f"{kind} {'.'.join(map(str, have))} is older than {need_v}, the first version with {cmd}"
                          if have else f"could not read {kind}'s version (`{v.get('binary', kind)} --version`); "
                          f"{cmd} needs {need_v} or newer")
    return cmd, None


def compact_unsupported(st, name, kind):
    """Why this agent's chat can't be compacted although its tool has a compact command (an old version), or None."""
    v = (registry(required=False) or {}).get(kind) or {}
    if not compact_on() or not str(v.get("compact") or "").strip():
        return None
    return compact_command(st, kind)[1]


def compact_agents(st):
    """(name, info dict, holds a job) for every coder and the reviewer. The lead is never compacted."""
    out = [(n, w, bool(w.get("task"))) for n, w in st.get("workers", {}).items()]
    if st.get("reviewer") and st.get("reviewer_info") is not None:
        out.append((st["reviewer"], st["reviewer_info"], bool(st.get("reviewer_busy"))))
    return out


def still_compacting(st, name, w=None):
    """True while an agent that got the compact command may still be compacting: herdr shows it working, or it has
    been idle for less than COMPACT_SETTLE_S. Such an agent is busy: it gets no new work."""
    w = w if w is not None else agent_info(st, name)
    h = (w or {}).get("compacting")
    if not h or not w.get("detect", True):
        return False
    if now() - h.get("ts", 0) > COMPACT_MAX_S:
        return False
    s = herdr_state(name)
    if s is None:
        return False
    if busy_word(s):
        return True
    return now() - (h.get("idle_since") or h.get("ts", 0)) < COMPACT_SETTLE_S


def compact_due(st, name, w, next_tid=None):
    """The compact command to send now, or None. Due when the agent's chat holds another milestone than next_tid
    (or, with no next_tid, a milestone that has landed), it holds no job, and herdr shows it idle."""
    ctx = w.get("ctx")
    if not ctx or ctx == next_tid or w.get("compacting") or not w.get("detect", True) or w.get("off"):
        return None
    if next_tid is None and (st["tasks"].get(ctx) or {}).get("status", "merged") not in ("merged", "skipped"):
        return None
    if w.get("stopping") or cooling(name, w):
        return None
    cmd, _ = compact_command(st, w.get("kind"))
    if not cmd:
        return None
    s = herdr_state(name)
    if s is None or busy_word(s):
        return None
    return cmd


def start_compact(st, name, w, cmd, before=None):
    """Type the compact command into the agent's pane. The caller saves the state. Returns True when it was sent."""
    after = w.get("ctx")
    try:
        deliver(st, name, cmd)
    except DeliveryError:
        return False
    w["compacting"] = {"ts": now(), "after": after, "cmd": cmd, "before": before}
    story_note(st, f"{name} finished {after}: orch sent {cmd} so its chat does not keep growing"
               + (f" (before it starts {before})" if before else ""), who="event manager")
    return True


def end_compact(st, name, w, note=True):
    """The agent's compact is over: forget it, and say so once in `orch story`. Whichever step sees it first calls
    this: the event manager (herdr shows the agent idle again) or the next job sent to the agent (`orch send`,
    `orch review`), so the story line never depends on which of the two came first. Returns the record or None."""
    h = (w or {}).pop("compacting", None)
    if not h:
        return None
    w["ctx"] = None
    if note:
        story_note(st, f"{name}'s chat after {h.get('after') or 'its last milestone'} is now a short summary "
                       f"({h.get('cmd') or '/compact'})", who="event manager")
    return h


def compacting_line(st, name, w):
    h = w.get("compacting") or {}
    return (f"compacting its chat after {h.get('after') or '?'} ({h.get('cmd') or '/compact'}, sent "
            f"{_fmt_secs(now() - h.get('ts', now()))} ago; it gets new work once herdr shows it idle)")


def commit_message(st, tid):
    """Commit message for a landed milestone: the coder's `COMMIT:` line (what changed), else the title.
    The milestone id is a trailer, never the subject."""
    t = st["tasks"][tid]
    subject = (t.get("commit_msg") or "").strip() or t["title"]
    return f"{subject}\n\nMilestone: {tid}"


def report_commit_line(path):
    p = Path(path)
    if not p.exists():
        return None
    lines = [l.strip().split(":", 1)[1].strip().strip("`").strip() for l in p.read_text().splitlines()
             if l.strip().upper().startswith("COMMIT:")]
    lines = [l for l in lines if l]
    return lines[-1][:120] if lines else None


def read_json(path):
    """(data, None) or (None, "missing" | "not valid JSON: ...")."""
    try:
        return json.loads(Path(path).read_text()), None
    except FileNotFoundError:
        return None, "missing"
    except (OSError, ValueError) as e:
        return None, f"not valid JSON: {e}"


RESULT_FORMAT = {
    "status": "done | question | blocked",
    "commit": "feat(api): add the categories endpoint",
    "files_changed": ["src/routes/categories.ts", "test/categories.test.ts"],
    "check": {"ran": True, "passed": True, "summary": "lint ok, 42 tests pass"},
    "criteria": [{"id": "AC1", "met": True, "evidence": "test 'rejects a missing amount column' passes"}],
    "questions": ["only when status is question: what you need decided, with 2-3 options"],
    "usage": {"input_tokens": None, "output_tokens": None, "cost_usd": None},
    "proof": "only when task.md says the milestone is hard to undo: what you ran to show it is safe, and what it showed",
}
REVIEW_FORMAT = {
    "verdict": "approve | changes",
    "criteria": [{"id": "AC1", "met": True, "note": "covered by test_upload_rejects_missing_amount"}],
    "findings": [{"severity": "blocker | suggestion", "axis": "spec | rules", "file": "src/upload.ts", "line": 42,
                  "problem": "what is wrong", "why": "why it matters", "criterion": "AC1",
                  "rule": "only for axis rules: the written rule it breaks, e.g. ADR 0001: money is whole paise"}],
}


def read_result(path):
    """A coder's result-k.json, validated: (result, None) or (None, why it can't be used)."""
    if not path:
        return None, "missing"
    d, err = read_json(path)
    if err:
        return None, err
    if not isinstance(d, dict):
        return None, "must be a JSON object"
    if d.get("status") not in ("done", "question", "blocked"):
        return None, "`status` must be done, question or blocked"
    for k in ("files_changed", "criteria", "questions"):
        if k in d and not isinstance(d[k], list):
            return None, f"`{k}` must be a list"
    if "check" in d and not isinstance(d["check"], dict):
        return None, "`check` must be an object"
    for c in d.get("criteria", []):
        if not isinstance(c, dict) or "id" not in c or not isinstance(c.get("met"), bool):
            return None, "each entry in `criteria` needs `id` and `met` (true or false)"
    if d.get("commit") is not None and not isinstance(d["commit"], str):
        return None, "`commit` must be a string"
    return d, None


def read_usage(path):
    d, _ = read_json(path) if path else (None, None)
    u = d.get("usage") if isinstance(d, dict) else None
    return {k: v for k, v in u.items() if v is not None} or None if isinstance(u, dict) else None


def finding_axis(f):
    """Which of the reviewer's two questions a finding answers: "spec" (built what was asked?) or "rules" (follows
    the repo's written rules?); None for a review written before 6.6.0 that does not say."""
    a = str(f.get("axis") or "").strip().lower()
    return "rules" if a.startswith(("rule", "standard")) else "spec" if a.startswith("spec") else None


def review_axes(st):
    """Every finding of every review round in this run, by question: {"spec": [...], "rules": [...]}, and
    {rule: count} for the rules findings. Rounds without an `axis` (older reviews, .md reviews) are left out."""
    by, rules = {"spec": [], "rules": []}, {}
    for tid, t in st["tasks"].items():
        for k in range(1, t.get("review_round", 0) + 1):
            d, _ = read_json(ORCH / "review" / tid / f"review-{k}.json")
            for f in (d or {}).get("findings", []) if isinstance(d, dict) and isinstance(d.get("findings"), list) else []:
                ax = finding_axis(f) if isinstance(f, dict) else None
                if not ax:
                    continue
                sev = "blocker" if str(f.get("severity", "")).lower().startswith("block") else "suggestion"
                by[ax].append(f"- {tid} round {k}, {sev}: " + (f"[{f['rule']}] " if ax == "rules" and f.get("rule") else "")
                              + f"{f.get('file', '?')}:{f.get('line', '?')} — {f.get('problem', '')}")
                if ax == "rules":
                    r = str(f.get("rule") or "(rule not named)").strip()
                    rules[r] = rules.get(r, 0) + 1
    return by, rules


def review_axes_section(st):
    """The summary's review findings by question, or "" when no review said which question it answers."""
    by, rules = review_axes(st)
    if not (by["spec"] or by["rules"]):
        return ""
    return ("## Review findings: spec and rules\nEvery finding of every review round (fixed or not), by the question it "
            "answers. Spec: did it build what was asked? Rules: does it follow the repo's written rules?\n\n"
            f"Spec ({len(by['spec'])}):\n" + ("\n".join(by["spec"]) or "none") + "\n\n"
            f"Rules ({len(by['rules'])}):\n" + ("\n".join(by["rules"]) or "none") + "\n\n"
            + ("Rules broken most often: " + "; ".join(f"{r} ({n}x)" for r, n in
                                                      sorted(rules.items(), key=lambda x: (-x[1], x[0]))[:10]) + "\n\n"
               if rules else ""))


def risk_rows(st):
    """One row per landed milestone: (Mn and title, easy|hard to undo and why, could break, proof)."""
    rows = []
    for tid in st["order"]:
        t = st["tasks"][tid]
        if t.get("status") != "merged" or not (t.get("blast") or t.get("door")):
            continue
        b = t.get("blast") or {}
        hard = t.get("door") == "one-way"
        rows.append((f"{tid} {t['title']}", ("**hard**" + (f": {t['door_why']}" if t.get("door_why") else "")) if hard
                     else "easy", (f"{b['level']}: " + "; ".join(b.get("why", []))) if b else "-",
                     (t.get("proof") or "none given") if hard else "-"))
    # only worth a table when something in it is hard to undo or could break more than a little
    keep = any(st["tasks"][tid].get("door") == "one-way" or (st["tasks"][tid].get("blast") or {}).get("level") != "small"
               for tid in st["order"] if st["tasks"][tid].get("status") == "merged" and st["tasks"][tid].get("blast"))
    return rows if keep else []


def risk_section(st):
    """The summary's (and so the PR's) table: what is hard to undo and how much each milestone could break."""
    rows = risk_rows(st)
    if not rows:
        return ""
    esc = lambda x: str(x).replace("|", "\\|").replace("\n", " ")
    return ("## Undo and blast radius\nWhere to look hardest before you merge. Hard to undo = the plan says it can't "
            "simply be reverted (it waited for your `orch approve`). Could break = measured from the change: risky "
            "files, how many milestones build on it, its size.\n\n| Milestone | Undo | Could break | Proof |\n"
            "|---|---|---|---|\n" + "\n".join("| " + " | ".join(esc(c) for c in r) + " |" for r in rows) + "\n\n")


def review_findings(tid, k):
    """(blockers, suggestions, known) for review round k: review-k.json, else the BLOCKER:/SUGGESTION: lines of
    review-k.md. known=False when neither is usable."""
    rd = ORCH / "review" / tid
    d, err = read_json(rd / f"review-{k}.json")
    if isinstance(d, dict) and isinstance(d.get("findings", []), list):
        blockers, sugg = [], []
        for f in d.get("findings", []):
            if not isinstance(f, dict):
                continue
            line = f"{f.get('file', '?')}:{f.get('line', '?')} — {f.get('problem', '')} — {f.get('why', '')}"
            ax = finding_axis(f)
            if ax:
                line = (f"[rules: {f['rule']}] " if ax == "rules" and f.get("rule") else f"[{ax}] ") + line
            if f.get("criterion"):
                line += f" ({f['criterion']})"
            (blockers if str(f.get("severity", "")).lower().startswith("block") else sugg).append(line)
        try:
            dfr = deferred_of(load()["tasks"].get(tid, {}))
        except (OSError, ValueError, KeyError, SystemExit):
            dfr = {}
        for c in d.get("criteria", []) if isinstance(d.get("criteria", []), list) else []:
            if isinstance(c, dict) and c.get("met") is False and str(c.get("id")) not in dfr:
                blockers.append(f"{c.get('id', '?')} not met — {c.get('note', '')}")
        return [f"BLOCKER: {b}" for b in blockers], [f"SUGGESTION: {s}" for s in sugg], True
    rp = rd / f"review-{k}.md"
    lines = [l.strip() for l in (rp.read_text().splitlines() if rp.exists() else []) if l.strip()]
    blockers = [l for l in lines if l.upper().startswith("BLOCKER")]
    sugg = [l for l in lines if l.upper().startswith("SUGGESTION")]
    known = bool(blockers or sugg or any(l.upper().startswith("NO FINDINGS") for l in lines))
    return blockers, sugg, known


def run_check(st, cwd):
    """(passed, last 60 lines, seconds) for the plan's check command in cwd."""
    if not st.get("check"):
        return True, "", 0
    t0 = time.time()
    try:
        r = subprocess.run(st["check"], shell=True, cwd=cwd, text=True, capture_output=True, timeout=CHECK_TIMEOUT_S)
        ok, tail = r.returncode == 0, "\n".join((r.stdout + r.stderr).splitlines()[-60:])
    except subprocess.TimeoutExpired:
        ok, tail = False, f"check command timed out after {CHECK_TIMEOUT_S // 60} min"
    return ok, tail, round(time.time() - t0, 1)


def tree_of(d):
    """Hash of the files git sees in d (tracked and untracked, not ignored), without touching the real index.
    Two checks of the same tree give the same answer, so a green check on it can be reused."""
    try:
        real = Path(git("rev-parse", "--path-format=absolute", "--git-path", "index", cwd=d).stdout.strip())
        with tempfile.TemporaryDirectory() as td:
            tmp = Path(td) / "index"
            if real.exists():
                shutil.copyfile(real, tmp)
            env = {**os.environ, "GIT_INDEX_FILE": str(tmp)}
            subprocess.run(["git", "add", "-A"], cwd=d, env=env, capture_output=True, timeout=120)
            r = subprocess.run(["git", "write-tree"], cwd=d, env=env, capture_output=True, text=True, timeout=60)
            return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None
    except (OSError, subprocess.SubprocessError, SystemExit):
        return None


def note_green(st, d, ok):
    """Remember the tree a passing check ran on in the main folder (a failing one forgets it)."""
    if Path(d).resolve() != ROOT.resolve():
        return
    st["green_tree"] = tree_of(d) if ok else None


def green_still(st, d):
    """True when the main folder holds exactly the tree the last passing check ran on: no need to run it again."""
    return bool(st.get("check") and st.get("green_tree")) and tree_of(d) == st["green_tree"]


def path_allowed(path, patterns):
    return any(path == p or fnmatch.fnmatch(path, p) or path.startswith(p.rstrip("/") + "/") for p in patterns)


def setup_hash(st, d):
    """Fingerprint of the dependency files in d's index (the plan's `Setup inputs:` globs, else LOCKFILE_RE)."""
    files = [f for f in git("ls-files", cwd=d, check=False).stdout.splitlines() if f]
    pats = st.get("setup_inputs") or []
    sel = [f for f in files if (path_allowed(f, pats) if pats else LOCKFILE_RE.search(f))]
    if not sel:
        return "none"
    return hashlib.sha1(git("ls-files", "-s", "--", *sel, cwd=d).stdout.encode()).hexdigest()[:16]


def ensure_root_setup(st):
    """Run the setup command in the main folder when its dependency files changed (before checking a merge)."""
    if (st.get("setup") or "none").lower() == "none":
        return True, ""
    h = setup_hash(st, ROOT)
    if h == st.get("root_setup_hash"):
        return True, ""
    try:
        r = subprocess.run(st["setup"], shell=True, cwd=ROOT, text=True, capture_output=True, timeout=CHECK_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return False, f"setup command timed out in {ROOT}"
    if r.returncode != 0:
        return False, f"setup command failed in {ROOT}:\n" + "\n".join((r.stdout + r.stderr).splitlines()[-30:])
    st["root_setup_hash"] = h
    print(f"SETUP ran `{st['setup']}` in the main folder (dependency files changed)")
    return True, ""


def changed_files(st, t):
    """Files the milestone's coder changed in its folder (committed on its saved work or not), excluding files
    that only differ because other milestones landed meanwhile."""
    d = t.get("dir")
    if not d or not Path(d).exists():
        return []
    untracked = set(git("ls-files", "--others", "--exclude-standard", cwd=d, check=False).stdout.split())
    if st["isolation"] == "shared":
        return sorted(set(git("diff", "--name-only", "HEAD", cwd=d, check=False).stdout.split()) | untracked)
    mb = git("merge-base", st["branch"], "HEAD", cwd=d, check=False).stdout.strip() or st["branch"]
    vs_base = set(git("diff", "--name-only", mb, cwd=d, check=False).stdout.split())
    vs_tip = set(git("diff", "--name-only", st["branch"], cwd=d, check=False).stdout.split())
    return sorted((vs_base & vs_tip) | untracked)


def dependents_of(st, tid):
    """Milestones that build on Mn, directly or through another milestone (skipped ones left out)."""
    out, todo = set(), [tid]
    while todo:
        cur = todo.pop()
        for k, v in st["tasks"].items():
            if cur in v.get("deps", []) and k not in out and v.get("status") != "skipped":
                out.add(k)
                todo.append(k)
    return sorted(out, key=lambda k: st["order"].index(k) if k in st.get("order", []) else 0)


def blast_radius(st, tid, diff_args, cwd):
    """How much could break if Mn is wrong, measured (no AI) from its real change and the plan: small, medium or
    large, with the reasons in plain words. Saved on the task for the hold message, the summary and the PR."""
    names = git("diff", "--name-status", "--no-renames", *diff_args, cwd=cwd, check=False).stdout.splitlines()
    files, deleted, risky = [], [], []
    for line in names:
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        files.append(parts[-1])
        if parts[0].startswith("D"):
            deleted.append(parts[-1])
        risky += [what for rx, what in RISK_RULES if rx.search(parts[-1])]
        if LOCKFILE_RE.search(parts[-1]):
            risky.append("dependency change")
    lines = 0
    for line in git("diff", "--numstat", *diff_args, cwd=cwd, check=False).stdout.splitlines():
        a, b = (line.split("\t") + ["0", "0"])[:2]
        lines += (int(a) if a.isdigit() else 0) + (int(b) if b.isdigit() else 0)
    hot = sorted({f for f in files if HOTSPOT_RE.search(f)})
    deps = dependents_of(st, tid)
    big, mid = [], []
    if risky:
        big.append(", ".join(sorted(set(risky))))
    if len(deps) >= 2:
        big.append(f"{len(deps)} milestones build on it ({', '.join(deps)})")
    elif deps:
        mid.append(f"{deps[0]} builds on it")
    if lines > 500:
        big.append(f"{lines} lines changed")
    elif lines > 100:
        mid.append(f"{lines} lines changed")
    if deleted:
        mid.append(f"deletes {len(deleted)} file(s)")
    if hot:
        mid.append("touches shared files: " + ", ".join(hot[:3]) + (" …" if len(hot) > 3 else ""))
    if len(files) > 10:
        mid.append(f"{len(files)} files changed")
    level = "large" if big else "medium" if mid else "small"
    why = big + mid or [f"{len(files)} file(s), {lines} lines, nothing else builds on it"]
    return {"level": level, "why": why, "files": len(files), "lines": lines}


def risk_flags(st, tid, diff_args, cwd):
    """Deterministic reasons to hold a milestone for the developer's approval before it lands."""
    if not st.get("risk_hold", True):
        return []
    t = st["tasks"][tid]
    likely = t.get("files") or []
    out = [f"hard to undo: {t.get('door_why') or 'the plan says Door: one-way'}"] if t.get("door") == "one-way" else []
    for line in git("diff", "--name-status", "--no-renames", *diff_args, cwd=cwd, check=False).stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        stt, path = parts[0], parts[-1]
        if stt.startswith("D"):
            out.append(f"deletes {path}")
        out += [f"{what}: {path}" for rx, what in RISK_RULES if rx.search(path)]
        if LOCKFILE_RE.search(path) and not path_allowed(path, likely):
            out.append(f"dependency change not listed in Likely files: {path}")
    total = 0
    for line in git("diff", "--numstat", *diff_args, cwd=cwd, check=False).stdout.splitlines():
        a, b = (line.split("\t") + ["0", "0"])[:2]
        total += (int(a) if a.isdigit() else 0) + (int(b) if b.isdigit() else 0)
    if total > RISK_MAX_LINES:
        out.append(f"large change: {total} lines (limit ORCH_RISK_MAX_LINES={RISK_MAX_LINES})")
    return out[:20]


def snapshot_diff(d, base):
    """Diff of the working tree (incl. new files) vs the merge-base with `base`, using a temporary index
    so the real index and any in-progress merge are left untouched."""
    mb = git("merge-base", base, "HEAD", cwd=d, check=False).stdout.strip()
    base = mb or base
    real_index = Path(git("rev-parse", "--path-format=absolute", "--git-path", "index", cwd=d).stdout.strip())
    tmp = real_index.with_name("orch-snapshot-index")
    if real_index.exists():
        shutil.copy(real_index, tmp)
    env = dict(os.environ, GIT_INDEX_FILE=str(tmp))
    try:
        subprocess.run(["git", "add", "-A"], cwd=d, env=env, capture_output=True, text=True)
        return subprocess.run(["git", "diff", "--cached", base], cwd=d, env=env, capture_output=True,
                              text=True).stdout
    finally:
        tmp.unlink(missing_ok=True)


def task_dir(t, tid):
    if not t.get("dir"):
        die(f"{tid} has no work dir yet — run `orch prepare {tid} <worker>` first")
    return Path(t["dir"])


def wt_path(worker):
    return ROOT.parent / f"{ROOT.name}-wt" / worker


def branch_exists(name):
    return git("rev-parse", "--verify", "--quiet", f"refs/heads/{name}", cwd=ROOT, check=False).returncode == 0


def default_base(st):
    """The branch a run starts from when none was recorded: origin's default branch, else main, else master."""
    r = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=ROOT, check=False)
    candidates = ([r.stdout.strip().split("/", 1)[-1]] if r.returncode == 0 else []) + ["main", "master"]
    for b in candidates:
        if b and b != st["branch"] and branch_exists(b):
            return b
    die(f"can't tell which branch {st['branch']} starts from — add `Base: <branch>` to the plan header and run `orch sync`")


def cmd_start(args):
    st = load()
    require_lead(st, "orch start")
    refuse_protected(st["branch"], "orch start")
    ensure_excluded()
    guard_ensure()
    cur = git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip()
    if st.get("base") == st["branch"]:
        st["base"] = None                       # recorded by an older orch that started on the branch itself
    if cur != st["branch"]:
        if is_dirty(ROOT):
            die("main working tree has uncommitted changes — commit or stash first")
        if not st.get("base"):
            st["base"] = cur
        if branch_exists(st["branch"]):
            git("switch", st["branch"], cwd=ROOT)
        else:
            git("switch", "-c", st["branch"], st["base"], cwd=ROOT)
    if not st.get("base"):
        st["base"] = default_base(st)
    if st["isolation"] == "worktree":
        for name, w in st["workers"].items():
            p = wt_path(name)
            if not p.exists():
                p.parent.mkdir(parents=True, exist_ok=True)
                git("worktree", "add", "--detach", str(p), st["branch"], cwd=ROOT)
                w["setup_done"] = False
                print(f"CREATED worktree {p}")
            w["dir"] = str(p)
    else:
        for w in st["workers"].values():
            w["dir"] = str(ROOT)
    if st.get("root_setup_hash") is None and (st.get("setup") or "none").lower() != "none":
        st["root_setup_hash"] = setup_hash(st, ROOT)      # the developer's main folder is set up for this
    save(st)
    recover_merge(st)
    print(f"BRANCH {st['branch']} (base {st['base']})")
    reg = registry(required=False) if os.environ.get("ORCH_DOCTOR", "1") != "0" else None
    kinds = {w.get("kind") for w in st["workers"].values()} | ({(st.get("reviewer_info") or {}).get("kind")} - {None})
    for kind in sorted(k for k in kinds if reg and k in reg):
        for ok, m in doctor_kind(kind, reg[kind], full=False) or []:
            if not ok:
                print(f"WARN agent {kind}: {m}")
    agents = [(name, w, "WORKER") for name, w in st["workers"].items()]
    if st.get("reviewer"):
        agents.append((st["reviewer"], st.get("reviewer_info") or {}, "REVIEWER"))
    lost = False
    for name, w, label in agents:
        where = f" dir={w['dir']}" if label == "WORKER" else ""
        if w.get("pane"):
            try:
                ok = subprocess.run([HERDR, "pane", "get", w["pane"]], text=True, capture_output=True,
                                    timeout=HERDR_TIMEOUT_S).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                ok = False
            herdr = (f"pane {w['pane']} detect:off" if ok else
                     f"STALE pane {w['pane']} — find its current id with `herdr pane list` and fix plan.md, then `orch sync`")
        elif not w.get("detect", True):
            herdr = "detect:off (relying on its done file)"
        else:
            herdr = "found" if herdr_state(name) is not None else "NOT FOUND"
            lost = lost or herdr == "NOT FOUND"
        print(f"{label} {name} kind={w.get('kind')}{where} herdr={herdr}")
    if lead_on(st) and not os.environ.get("ORCH_DRIVER"):
        ld = st["lead"]                          # require_lead above made sure herdr can wake it
        print(f"LEAD {ld['name']} kind={ld.get('kind')} herdr="
              + (f"pane {ld['pane']}" if ld.get("pane") else "found" if ld.get("detect", True) else "detect:off"))
    if lost:
        print("HINT an agent herdr can't find: after a herdr or computer restart the panes come back without their "
              "names — `orch resume` names them again; `orch team up` opens the ones that are really gone")


def deps_met(st, t):
    return all(st["tasks"][d]["status"] == "merged" for d in t["deps"])


def active_count(st):
    return sum(1 for t in st["tasks"].values() if t["status"] in ACTIVE)


def holds(st, tid):
    """True if the task currently owns a coder (and, in worktree mode, that coder's folder)."""
    w = st["tasks"][tid].get("worker")
    return bool(w) and st["workers"].get(w, {}).get("task") == tid


def coders_busy(st):
    return sum(1 for w in st["workers"].values() if w.get("task"))


def free_slots(st):
    if st["isolation"] == "worktree":
        return st["max_parallel"] - coders_busy(st)
    return st["max_parallel"] - active_count(st)


def fix_jobs(st):
    """Tasks waiting for ANY free coder to fix review findings or a merge conflict (pipelined mode)."""
    return [tid for tid in st["order"]
            if st["tasks"][tid]["status"] in ("needs-fix", "conflict") and not holds(st, tid)]


def cmd_ready(args):
    st = load()
    cand = [tid for tid in st["order"] if st["tasks"][tid]["status"] == "pending" and deps_met(st, st["tasks"][tid])]
    # milestones that share Likely files run one after the other unless one says `Parallel: allow`
    busy = {}
    for tid, t in st["tasks"].items():
        if t["status"] in ACTIVE and not t.get("parallel"):
            for f in t.get("files") or []:
                busy[f] = tid
    out, waits = [], []
    for tid in cand:
        t = st["tasks"][tid]
        if lead_on(st) and not t.get("go"):
            waits.append(f"HOLD {tid} is ready and waits for the lead: orch dispatch {tid}")
            continue
        clash = sorted({busy[f] for f in t.get("files") or [] if f in busy})
        if clash and not t.get("parallel") and st["isolation"] == "worktree":
            waits.append(f"WAIT {tid} shares files with {', '.join(clash)}")
            continue
        out.append(tid)
        if not t.get("parallel"):
            for f in t.get("files") or []:
                busy[f] = tid
    slots = free_slots(st)
    if st["isolation"] == "shared" and slots <= 0 and active_count(st) == len(fix_jobs(st)) and fix_jobs(st):
        slots = 1          # shared mode: a queued fix job IS the active milestone, and it needs a coder
    # only coders herdr can see count as free: a coder with no agent can't take work, whatever its task field says
    present = [n for n, w in st["workers"].items() if not w.get("task") and not w.get("off") and not cooling(n, w)
               and not still_stopping(st, n, w) and not still_compacting(st, n, w)
               and (not w.get("detect", True) or w.get("pane") or herdr_state(n) is not None)]
    gone = [n for n, w in st["workers"].items() if not w.get("task") and not w.get("off") and w.get("detect", True)
            and not w.get("pane") and herdr_state(n) is None]
    slots = min(slots, len(present))
    print(f"SLOTS {max(slots, 0)}")
    if gone:
        print(f"NOAGENT {' '.join(gone)} (no agent in herdr: `orch team up`)")
    for tid in fix_jobs(st):  # fixes first: reviewed work merges sooner and unlocks dependents
        print(f"FIX {tid} {st['tasks'][tid]['status']} {st['tasks'][tid]['title']}")
    for tid in out:
        print(f"READY {tid} {st['tasks'][tid]['title']}")
    for line in waits:
        print(line)


def cooling(name, info):
    """True while the agent is benched. A `gone` bench ends as soon as herdr can see the agent again."""
    if (info.get("cooldown_until") or 0) <= now():
        return False
    if info.get("cooldown_reason") == "gone" and info.get("detect", True) and herdr_state(name) is not None:
        return False
    return True


def worker_free(st, name, w):
    if w.get("task") or w.get("off") or cooling(name, w) or still_stopping(st, name, w) \
            or still_compacting(st, name, w):
        return False
    if not w.get("detect", True):      # herdr can't watch it: no task + no cooldown = free
        return True
    s = herdr_state(name)
    if s is None or word(s, "blocked", "working"):
        return False
    return True


def cmd_pick(args):
    need(args, 1, "pick <Mn>")
    st = load()
    t = task(st, args[0])
    pref = t["prefer"]
    names = eligible_workers(st, t)
    last = t.get("last_worker")
    nr = need_rank(t)
    # the last coder first (its work is in its folder), then the tier asked for before a stronger (dearer) one
    names.sort(key=lambda n: (0 if n == last else 1, (rank(st["workers"][n].get("tier")) or nr) - nr
                              if nr else 0, 0 if pref in ("any", st["workers"][n]["kind"], n) else 1))
    for n in names:
        if worker_free(st, n, st["workers"][n]):
            print(n)
            return
    print("NONE")
    sys.exit(3)


def cmd_prepare(args):
    need(args, 2, "prepare <Mn> <worker>")
    tid, worker = args[0], args[1]
    st = load()
    t = task(st, tid)
    w = st["workers"].get(worker) or die(f"unknown worker {worker}")
    if t["status"] not in ("pending", "paused", "conflict", "needs-fix"):
        die(f"{tid} is {t['status']}, expected pending/paused/needs-fix/conflict")
    if w.get("task") and w["task"] != tid:
        die(f"{worker} is busy with {w['task']}")
    if still_stopping(st, worker, w):
        print(f"BUSY {worker} is still stopping {w['stopping'].get('task')}: herdr shows it working, or it stopped "
              f"less than {int(HALT_SETTLE_S)}s ago. Try again when `orch status` shows it free "
              f"(or `orch free {worker}` after you checked its pane)")
        sys.exit(3)
    w.pop("stopping", None)
    if still_compacting(st, worker, w):
        print(f"BUSY {worker} is {compacting_line(st, worker, w)}")
        sys.exit(3)
    squash = None if w.get("task") == tid else compact_due(st, worker, w, tid)
    if squash and start_compact(st, worker, w, squash, tid):
        save(st)
        print(f"BUSY {worker} is compacting its chat after {w['compacting']['after']} first ({squash}); {tid} starts "
              f"there once herdr shows it idle")
        sys.exit(3)
    if not holds(st, tid) and free_slots(st) <= 0 and not (st["isolation"] == "shared" and t["status"] in ("conflict", "needs-fix")):
        die("no free slot (max parallel reached)")
    d = Path(w["dir"] or ROOT)
    if st["isolation"] == "worktree":
        in_place = w.get("task") == tid and is_dirty(d)    # its own work in progress: it carries on right there
        if is_dirty(d) and not in_place:   # never refuse: save what is there first, then hand the folder over
            print(save_stray(st, worker))
        src = work_ref(st, tid)
        if src and src != task_ref(st, tid):       # pre-4.5 task branch: carry its work over to the hidden ref
            git("update-ref", task_ref(st, tid), src, cwd=ROOT)
            src = task_ref(st, tid)
        if not in_place:
            git("switch", "-q", "--detach", src or st["branch"], cwd=d)
    else:
        if git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip() != st["branch"]:
            die(f"main tree is not on {st['branch']}")
        mine = False
        if is_dirty(ROOT) and not holds(st, tid) and not coders_busy(st):
            # files written after a milestone was parked belong to the milestone that had the folder last
            last = st.get("tree_task")
            if last == tid:
                mine = True
                if ref_ok(task_ref(st, tid)):
                    print(shared_fold(st, tid))
            elif last in st["tasks"] and st["tasks"][last]["status"] in RESTING:
                print(shared_fold(st, last))
        if ref_ok(task_ref(st, tid)):
            if is_dirty(ROOT):
                die(f"main tree has uncommitted changes, so {tid}'s parked work ({task_ref(st, tid)}) can't be "
                    f"restored — finish or discard them first")
            restore_stash(st, tid)
        elif is_dirty(ROOT) and t["status"] == "pending" and not holds(st, tid) and not mine:
            die("main tree has uncommitted changes that no milestone owns — commit, stash or discard them first")
        st["tree_task"] = tid
    (d / TASK_DIR / tid).mkdir(parents=True, exist_ok=True)
    t.update(worker=worker, last_worker=worker, dir=str(d))
    t.pop("assign", None)          # a lead's "this coder" holds for one dispatch; later retries may move
    move(st, tid, "conflict" if t["status"] == "conflict" else "coding")
    w["task"] = tid
    save(st)
    print(f"DIR {d}")
    print(f"TASKDIR {d / TASK_DIR / tid}")
    if st["isolation"] == "worktree" and st["setup"].lower() != "none":
        h = setup_hash(st, d)
        if not w.get("setup_done") or w.get("setup_hash") != h:
            why = " (dependency files changed since its last setup)" if w.get("setup_done") else ""
            print(f"SETUP_NEEDED run `{st['setup']}` in {d}, then `orch setup-done {worker}`{why}")


def cmd_setup_done(args):
    need(args, 1, "setup-done <worker>")
    st = load()
    w = st["workers"].get(args[0]) or die(f"unknown worker {args[0]}")
    w["setup_done"] = True
    w["setup_hash"] = setup_hash(st, Path(w["dir"])) if w.get("dir") and Path(w["dir"]).exists() else None
    save(st)
    print("OK")


def sleep_meter():
    """Returns a function that tells how many seconds the computer was suspended since its last call (0 when
    less than DOWN_MIN_S). The wall clock keeps going while a laptop sleeps and the monotonic clock does not,
    so the difference is the time this process could not run. (ORCH_TEST_SLEPT_S: a test's pretend sleep.)"""
    last = [time.time(), time.monotonic()]
    fake = [float(os.environ.get("ORCH_TEST_SLEPT_S") or 0)]

    def slept():
        wall, mono = time.time(), time.monotonic()
        s = (wall - last[0]) - (mono - last[1]) + fake[0]
        last[0], last[1], fake[0] = wall, mono, 0
        return int(s) if s >= DOWN_MIN_S else 0
    return slept


def account_downtime(st, slept=0):
    """The event manager writes a heartbeat (`run.beat`) every loop. A heartbeat older than DOWN_MIN_S when it
    starts again means nothing was watching the run meanwhile (computer off, herdr closed, manager killed).
    `slept` is the same thing found while running: the computer was suspended for that many seconds until now.
    That time is nobody's working time: every open wait is moved forward by it, so no task is paused as "over
    its time budget" for time orch was not there, and the window is kept in `run.downs` for the time report.
    Returns the seconds newly taken out (0 = orch was not down, or that time was taken out already)."""
    run = st.setdefault("run", {})
    t = now()
    beat = t - slept if slept else run.get("beat")
    run["beat"] = t
    if not beat or t - beat < DOWN_MIN_S:
        return 0
    # never the same time twice: `orch poll` and the event manager both notice one sleep, seconds apart
    known = sum(max(0, min(t, d["to"]) - max(beat, d["from"])) for d in run.get("downs") or [])
    if t - beat - known < (DOWN_MIN_S if slept else 1):
        return 0
    beat += known
    run.setdefault("downs", []).append({"from": beat, "to": t})
    del run["downs"][:-100]
    for task_ in st["tasks"].values():
        w = task_.get("wait")
        if w:
            w["down_s"] = w.get("down_s", 0) + max(0, t - max(beat, w.get("started", w["since"])))
            w["since"] += max(0, t - max(beat, w["since"]))
            if w.get("blocked_since"):
                w["blocked_since"] += max(0, t - max(beat, w["blocked_since"]))
        if task_.get("ready_ts"):              # the lead could not dispatch while orch was down either
            task_["ready_ts"] += max(0, t - max(beat, task_["ready_ts"]))
    return t - beat


def needs_manager(st):
    """True when the run has work only the event manager can move on: an agent being waited on, a step in
    progress, or a milestone that is ready and released."""
    if not (st.get("run") or {}).get("started"):
        return False                           # never driven yet: `orch autopilot` (or a dispatch) starts it
    for t in st["tasks"].values():
        if t.get("wait") or (t["status"] in ACTIVE and t["status"] != "held"):
            return True
        if t["status"] == "pending" and deps_met(st, t) and (t.get("go") or not lead_on(st)):
            return True
    return False


def _clock(ts):
    """11:42 for today, else 2026-11-14 11:42."""
    lt = time.localtime(ts)
    return time.strftime("%H:%M" if lt[:3] == time.localtime()[:3] else "%Y-%m-%d %H:%M", lt)


def record_attempt(t, outcome, usage=None):
    """Close the task's current wait as one attempt in its metrics (Phase 3: orch report)."""
    w = t.get("wait")
    if not w:
        return
    start = w.get("started", w.get("since", now()))
    down = min(w.get("down_s", 0), max(0, now() - start))     # orch was not running: not the agent's time
    a = {"kind": w.get("kind"), "agent": w.get("agent"), "file": w.get("file"), "start": start, "end": now(),
         "secs": max(0, now() - start - down), "nudges": w.get("nudges", 0), "outcome": outcome}
    if down:
        a["down_s"] = down
    if w.get("model"):
        a["model"], a["tier"] = w["model"], w.get("tier")
    blocked = w.get("blocked_s", 0) + (now() - w["blocked_since"] if w.get("blocked_since") else 0)
    if blocked:
        a["blocked_s"] = min(blocked, a["secs"])      # time herdr showed the agent stopped at a prompt in its pane
    if usage:
        a["usage"] = usage
    t.setdefault("attempts", []).append(a)
    del t["attempts"][:-100]


def _delivered(st, agent):
    info = agent_info(st, agent)
    if info:
        info["delivery_fails"] = 0


def _lost(st, tid, status, reason):
    """Count a lost attempt (agent unreachable, gone, rate-limited, stopped). At MAX_LOST the task fails."""
    t = st["tasks"][tid]
    t["lost"] = t.get("lost", 0) + 1
    if t["lost"] >= MAX_LOST:
        return "failed", f"lost {t['lost']} attempts (last: {reason}) — check the agents, then `orch set {tid} pending`"
    return status, reason


def _delivery_failed(st, tid, fname, path, err):
    """The prompt never reached the coder: put the task back where it was, keep its job, bench the coder briefly."""
    t = st["tasks"][tid]
    agent = t["worker"]
    record_attempt(t, "not delivered")
    t["wait"] = None
    job = t.get("job")
    if job and job.get("file") == fname:
        status = "conflict" if fname.startswith("conflict-") else "needs-fix"
    elif fname == "task.md":
        status = "pending"
    else:                                        # e.g. fix-2.md: keep it as a job for the next free coder
        t["job"] = {"file": fname, "body": path.read_text()}
        status = "needs-fix"
    w = st["workers"].get(agent)
    if w:
        w["delivery_fails"] = w.get("delivery_fails", 0) + 1
        bench = UNREACHABLE_MIN * 60 if w["delivery_fails"] >= UNREACHABLE_AFTER else SEND_RETRY_S
        w["cooldown_until"], w["cooldown_reason"] = now() + bench, "unreachable"
        if w["delivery_fails"] >= UNREACHABLE_AFTER:
            print(f"BENCHED {agent} for {UNREACHABLE_MIN} min: {w['delivery_fails']} prompts in a row did not reach it")
    status, reason = _lost(st, tid, status, f"could not prompt {agent}: {err.splitlines()[0] if err else 'herdr failed'}")
    _park(st, tid, status, reason)
    print(f"DELIVERY_FAILED {tid} -> {agent}: {err}" + (f"\nFAILED {tid}: {reason}" if status == "failed" else ""))
    sys.exit(5)


def cmd_send(args):
    """orch send Mn <file-name-in-TASKDIR>  -> prompt the task's worker."""
    need(args, 2, "send <Mn> <file>")
    tid, fname = args[0], args[1]
    st = load()
    t = task(st, tid)
    if not t.get("worker"):
        die(f"{tid} has no worker — run `orch prepare` first")
    d = task_dir(t, tid)
    rel = f"{TASK_DIR}/{tid}"
    if not (d / rel / fname).exists():
        die(f"{d / rel / fname} does not exist — write it first")
    k = t["attempt"] + 1
    sentinel = d / rel / f"done-{k}"
    sentinel.unlink(missing_ok=True)
    if fname != "task.md":                       # fix / review-fix / conflict / integration-fix job: say which
        kind = re.sub(r"-\d+\.md$", "", fname)
        (d / rel / f"job-{k}.json").write_text(json.dumps(
            {"schema": 1, "task_id": tid, "kind": kind, "file": fname, "contract": "task.json", "attempt": k}, indent=2))
    text = (f"Read {rel}/{fname} and carry it out exactly (the milestone's contract is {rel}/task.json). When "
            f"completely finished, write {rel}/result-{k}.json in the `result_format` shape from task.json, and a "
            f"short report {rel}/report-{k}.md (max 20 lines: files changed, what you did, check result; if something "
            f"was ambiguous, status `question` in the result, a line starting QUESTION: here, and stop; last line "
            f"`COMMIT: <one-line commit message for the change>`), then create the empty file {rel}/done-{k} as your "
            f"very last action.")
    # record the intent first: after a crash, a `delivering` wait is confirmed or re-sent to the SAME agent,
    # never handed to another coder as an orphan
    t["attempt"] = k
    move(st, tid, "coding")
    t["wait"] = {"agent": t["worker"], "sentinel": str(sentinel), "report": str(d / rel / f"report-{k}.md"),
                 "result": str(d / rel / f"result-{k}.json"), "since": now(), "started": now(), "kind": "coder",
                 "prompt": text, "nudges": 0, "file": fname, "delivering": True,
                 "model": st["workers"][t["worker"]].get("model"), "tier": st["workers"][t["worker"]].get("tier")}
    end_compact(st, t["worker"], st["workers"][t["worker"]])   # compacted before this job: say so, once
    st["workers"][t["worker"]]["ctx"] = tid          # its chat now holds this milestone (compacted before another)
    save(st)
    try:
        deliver(st, t["worker"], text)
    except DeliveryError as e:
        _delivery_failed(st, tid, fname, d / rel / fname, str(e))
    _delivered(st, t["worker"])
    fault("after-deliver")
    if (t.get("job") or {}).get("file") == fname:
        t["job"] = None                          # delivered: the job is now the coder's
    t["wait"]["delivering"] = False
    save(st)
    print(f"SENT {tid} -> {t['worker']} (attempt {k})")


def cmd_send_job(args):
    """orch send-job Mn -> write the queued fix/conflict job into TASKDIR and send it to the task's coder."""
    need(args, 1, "send-job <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    job = t.get("job") or die(f"{tid} has no queued job")
    if not holds(st, tid):
        die(f"{tid} has no coder yet — `orch pick {tid}` then `orch prepare {tid} <worker>` first")
    d = task_dir(t, tid) / TASK_DIR / tid
    d.mkdir(parents=True, exist_ok=True)
    (d / job["file"]).write_text(job["body"])
    cmd_send([tid, job["file"]])                 # clears the job only once it is delivered


def cmd_handoff(args):
    """orch handoff Mn -> (worktree mode) save the milestone to its hidden ref and free the coder,
    so it can take other work while the reviewer reviews."""
    need(args, 1, "handoff <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if st["isolation"] != "worktree":
        print("SKIP shared mode keeps the coder until the task lands")
        return
    if not holds(st, tid):
        die(f"{tid} does not hold a coder")
    d = task_dir(t, tid)
    wip_commit(d, f"orch wip {tid}: for review")
    git("update-ref", task_ref(st, tid), "HEAD", cwd=d)
    st["workers"][t["worker"]]["task"] = None
    t["last_worker"], t["worker"], t["handed_off"] = t["worker"], None, True
    save(st)
    print(f"HANDED_OFF {tid}: saved to {task_ref(st, tid)}; {t['last_worker']} is free")


def cmd_needs_fix(args):
    """orch needs-fix Mn -> queue the latest review's BLOCKER lines as a fix job for any free coder."""
    need(args, 1, "needs-fix <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    k = t["review_round"]
    blockers, _, _ = review_findings(tid, k)
    if not blockers:
        die(f"no blockers in review round {k} of {tid} (.orchestrate/review/{tid}/review-{k}.json or .md)")
    t["job"] = {"file": f"review-fix-{k}.md", "body":
                f"# Review findings for {tid}: {t['title']} (round {k})\n\n"
                "The reviewer found the problems below. You own the fix: investigate each one and decide how to "
                f"solve it. Keep every acceptance criterion in {TASK_DIR}/{tid}/task.md, then run `{st['check']}`.\n"
                "If you think a finding is wrong, explain why in your report instead of changing code for it.\n\n"
                + "\n".join(blockers) + "\n"}
    move(st, tid, "needs-fix")
    t["review_ok"], t["wait"] = False, None
    save(st)
    print(f"QUEUED fix job for {tid} ({len(blockers)} blocker(s))" + ("" if holds(st, tid) else " — any free coder"))


def cmd_review_ok(args):
    """orch review-ok Mn -> record that the reviewer approved Mn (later conflict fixes won't need re-review)."""
    need(args, 1, "review-ok <Mn>")
    st = load()
    t = task(st, args[0])
    t["review_ok"] = True
    t.pop("pre_conflict", None)
    save(st)
    print(f"OK {args[0]} review approved")


def cmd_review(args):
    """orch review Mn  -> snapshot diff into main .orchestrate and prompt the reviewer."""
    need(args, 1, "review <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if not st["reviewer"]:
        die("no reviewer configured")
    ri = st.get("reviewer_info") or {}
    busy = st.get("reviewer_busy") and st["reviewer_busy"] != tid
    squash = None if busy or cooling(st["reviewer"], ri) or still_compacting(st, st["reviewer"], ri) else \
        compact_due(st, st["reviewer"], ri, tid)
    if squash and not start_compact(st, st["reviewer"], ri, squash, tid):
        squash = None
    if busy or cooling(st["reviewer"], ri) or still_compacting(st, st["reviewer"], ri):
        move(st, tid, "awaiting-review")
        save(st)
        why = (f"is on {st['reviewer_busy']}" if busy else "is benched (cooldown)" if cooling(st["reviewer"], ri)
               else compacting_line(st, st["reviewer"], ri))
        print(f"BUSY reviewer {why}; {tid} queued as awaiting-review")
        sys.exit(3)
    d = task_dir(t, tid)
    rd = ORCH / "review" / tid
    rd.mkdir(parents=True, exist_ok=True)
    if st["isolation"] == "worktree" and not holds(st, tid):
        src = work_ref(st, tid) or die(f"{tid} has no saved work ({task_ref(st, tid)}) — run `orch handoff {tid}` first")
        mb = git("merge-base", st["branch"], src, cwd=ROOT).stdout.strip()
        diff = git("diff", mb, src, cwd=ROOT).stdout
    else:
        diff = snapshot_diff(d, st["branch"] if st["isolation"] == "worktree" else "HEAD")
    (rd / "diff.patch").write_text(diff)
    resolution = ""
    if t.get("pre_conflict") and st["isolation"] == "worktree" and work_ref(st, tid):
        (rd / "resolution.patch").write_text(git("diff", t["pre_conflict"], work_ref(st, tid), cwd=ROOT).stdout)
        resolution = (f"This round reviews a MERGE-CONFLICT RESOLUTION: you approved this milestone before, then it "
                      f"conflicted with work that landed meanwhile. What the coder changed to resolve it: "
                      f"{{rel}}/resolution.patch (the whole milestone is still in diff.patch).\n\n")
    task_md = d / TASK_DIR / tid / "task.md"
    if task_md.exists():
        shutil.copy(task_md, rd / "task.md")
    task_json = d / TASK_DIR / tid / "task.json"
    if task_json.exists():
        shutil.copy(task_json, rd / "task.json")
    k = t["review_round"] + 1
    rel = f".orchestrate/review/{tid}"
    dfr = deferred_of(t)
    deferred_txt = ("DEFERRED by the developer (approved; NOT part of this milestone): "
                    + "; ".join(f"{c} \"{v.get('text', '')}\" (why: {v.get('reason', '')})" for c, v in dfr.items())
                    + ". Report each as `met: false` with a note; it is not a blocker. Don't raise a blocker for the "
                    "missing deferred part. Do review everything that WAS built, including partial work on it.\n\n"
                    ) if dfr else ""
    try:
        rules = project_rules(st, plan_sections()[0].get(tid, ""))
    except OSError:
        rules = project_rules(st, "")
    rules_txt = "\n".join(project_rules_lines(st, rules))
    scope = t.get("out_of_scope") or []
    (rd / f"review-task-{k}.md").write_text(
        f"# Review {tid}: {t['title']} (round {k})\n\n"
        f"Spec and acceptance criteria: {rel}/task.md (criteria ids AC1, AC2… in {rel}/task.json)\n"
        f"Changes: {rel}/diff.patch\n\n" + resolution.replace("{rel}", rel) + deferred_txt
        + (rules_txt + "\n" if rules_txt else "") +
        "Answer two questions, separately, and give every finding the `axis` of the one it answers:\n"
        "1. `spec`: did it build what the task asks, no more and no less? Every acceptance criterion met, nothing "
        "missing, no behaviour the task did not ask for. Correctness, API/contract consistency, UI/UX, security, "
        "edge cases and missing tests belong here."
        + (f" orch saw changes outside the milestone's Likely files: {', '.join(scope)}. Say whether each one was "
           "needed." if scope else "") + "\n"
        "2. `rules`: does it follow the project's own written rules: "
        + (f"{rules['standards']}" if rules["standards"] else "AGENTS.md / CLAUDE.md when the repo has them")
        + (", the decisions listed above" if rules["adrs"] else "")
        + (", the words listed above" if rules["glossary"] else "") +
        "? A `rules` finding names the rule it breaks in `rule`. Only written rules count: a matter of taste is at "
        "most a suggestion.\n"
        f"The check command (`{st['check']}`) runs on this work by itself: don't report what lint, type checks or "
        "tests already catch.\n"
        "Do NOT edit any code. Never commit, push or merge: no agent ever pushes to main or merges a PR, even when "
        "asked.\n"
        "Report PROBLEMS, not solutions: the coder decides how to fix. At most 15 findings. A `blocker` must be "
        "fixed before merge; a `suggestion` is optional. Say for EVERY acceptance criterion whether it is met; an "
        "unmet criterion counts as a blocker.\n"
        f"Write your review to {rel}/review-{k}.json in exactly this shape (an empty `findings` list and every "
        f"criterion met means approve):\n\n```json\n{json.dumps(REVIEW_FORMAT, indent=2)}\n```\n\n"
        f"Then create the empty file {rel}/done-{k} as your very last action.\n")
    sentinel = rd / f"done-{k}"
    sentinel.unlink(missing_ok=True)
    rtext = f"Read {rel}/review-task-{k}.md and do exactly what it says."
    t["review_round"] = k
    st["reviewer_busy"] = tid
    if st.get("reviewer_info") is not None:
        end_compact(st, st["reviewer"], st["reviewer_info"])
        st["reviewer_info"]["ctx"] = tid             # its chat now holds this milestone (compacted before another)
    move(st, tid, "reviewing")
    t["wait"] = {"agent": st["reviewer"], "sentinel": str(sentinel), "report": str(rd / f"review-{k}.md"),
                 "result": str(rd / f"review-{k}.json"), "since": now(), "started": now(), "kind": "reviewer",
                 "prompt": rtext, "nudges": 0, "delivering": True,
                 "model": (st.get("reviewer_info") or {}).get("model"), "tier": (st.get("reviewer_info") or {}).get("tier")}
    save(st)
    try:
        deliver(st, st["reviewer"], rtext)
    except DeliveryError as e:
        _review_undelivered(st, tid)
        save(st)
        print(f"DELIVERY_FAILED review {tid} -> {st['reviewer']}: {e}")
        sys.exit(5)
    _delivered(st, st["reviewer"])
    fault("after-deliver")
    t["wait"]["delivering"] = False
    save(st)
    print(f"SENT review {tid} -> {st['reviewer']} (round {k})")


def _review_undelivered(st, tid):
    """The review prompt never reached the reviewer: the same round waits for review again; bench the reviewer."""
    t = st["tasks"][tid]
    record_attempt(t, "not delivered")
    t["review_round"] = max(0, t["review_round"] - 1)
    t["wait"] = None
    if st.get("reviewer_busy") == tid:
        st["reviewer_busy"] = None
    move(st, tid, "awaiting-review")
    ri = st.get("reviewer_info")
    if ri is None:
        return
    name = st["reviewer"]
    n = ri["delivery_fails"] = ri.get("delivery_fails", 0) + 1
    # herdr can't find the name (pane closed, agent restarted in a new pane without its name): a `gone` bench, which
    # ends the moment herdr sees the name again, so a rename is picked up on the next loop instead of minutes later
    gone = ri.get("detect", True) and herdr_state(name) is None
    ri["cooldown_until"] = now() + (UNREACHABLE_MIN * 60 if n >= UNREACHABLE_AFTER else SEND_RETRY_S)
    ri["cooldown_reason"] = "gone" if gone else "unreachable"
    fix = reviewer_fix_hint(st)
    if n in (1, UNREACHABLE_AFTER):              # the lead hears of it on the first failure, and once more later
        lead_event(st, "reviewer-lost", tid, f"the review prompt could not reach {name} ({n} tries). {fix}")
    print(f"REVIEWER_LOST {name} (try {n}): {tid} waits for review, its work is kept. {fix}")


def reviewer_fix_hint(st):
    name = st["reviewer"]
    pane = (st.get("reviewer_info") or {}).get("pane")
    if pane:
        return f"Check that pane {pane} still exists (`herdr pane get {pane}`)."
    return (f"herdr has no agent named `{name}`. Find its pane with `herdr agent list`, then "
            f"`herdr agent rename <pane> {name}`, and check it with `herdr agent get {name}`.")


def cmd_resend(args):
    """orch resend Mn -> a prompt was recorded but never confirmed (crash, or herdr unsure): send it again to the
    SAME agent with the same attempt and done file. Not a nudge."""
    need(args, 1, "resend <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    w = t.get("wait") or die(f"{tid} is not waiting on anyone")
    try:
        deliver(st, w["agent"], w["prompt"])
    except DeliveryError as e:
        if w.get("kind") == "reviewer":
            _review_undelivered(st, tid)
            save(st)
            print(f"DELIVERY_FAILED review {tid} -> {w['agent']}: {e}")
            sys.exit(5)
        fname = w.get("file") or "task.md"
        _delivery_failed(st, tid, fname, task_dir(t, tid) / TASK_DIR / tid / fname, str(e))
    _delivered(st, w["agent"])
    w["delivering"], w["since"] = False, now()
    save(st)
    print(f"RESENT {tid} -> {w['agent']}")


def cmd_requeue_review(args):
    """orch requeue-review Mn -> the reviewer vanished mid-review: queue the same round again (no coder needed)."""
    need(args, 1, "requeue-review <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if t["status"] != "reviewing":
        die(f"{tid} is {t['status']}, expected reviewing")
    t["review_round"] = max(0, t["review_round"] - 1)
    move(st, tid, "awaiting-review")
    t["wait"] = None
    if st.get("reviewer_busy") == tid:
        st["reviewer_busy"] = None
    save(st)
    print(f"REQUEUED {tid} for review")


def orphaned(st, tid):
    """A task that looks in progress, but nothing is waiting on an agent and no job is queued (an interrupted send)."""
    t = st["tasks"][tid]
    if t.get("wait") or t.get("job"):
        return False
    return t["status"] in ("coding", "reviewing") or (t["status"] in ("conflict", "needs-fix") and holds(st, tid))


def cmd_poll(args):
    secs = int(args[0]) if args else 100
    start = time.time()
    end = start + secs
    slept = sleep_meter()
    while True:
        with state_lock():
            st = load()
            events, changed = [], False
            asleep = slept()
            if asleep and account_downtime(st, asleep):
                changed = True                 # the computer was asleep: that time is not on any agent's clock
            for tid in st["order"]:
                t = st["tasks"][tid]
                w = t.get("wait")
                if orphaned(st, tid):
                    events.append(f"ORPHAN {tid} status={t['status']} (no agent was prompted — re-send or park it)")
                    continue
                if t["status"] not in ("coding", "reviewing", "conflict") or not w:
                    continue
                agent, sentinel = w["agent"], Path(w["sentinel"])
                age = now() - w["since"]
                if sentinel.exists():
                    record_attempt(t, "done", read_usage(w.get("result")))
                    if w["kind"] == "coder":
                        move(st, tid, "verifying")
                        t["last_report"] = w["report"]
                        res, _ = read_result(w.get("result"))
                        t["last_result"] = w.get("result")
                        t["commit_msg"] = ((res or {}).get("commit") or "").strip()[:120] or \
                            report_commit_line(w["report"]) or t.get("commit_msg")
                        events.append(f"DONE {tid} worker={agent} dir={t['dir']} report={w['report']}")
                    else:
                        move(st, tid, "reviewed")
                        st["reviewer_busy"] = None
                        events.append(f"REVIEWED {tid} review={w['report']}")
                    t["wait"] = None
                    continue
                if w.get("delivering"):        # recorded but never confirmed (a crash between save and send)
                    if age < CONFIRM_S:
                        continue
                    s = herdr_state(agent) if watched(st, agent) else ""
                    if s is None:
                        events.append(f"GONE {tid} agent={agent}")
                    elif word(s, "working", "blocked"):
                        w["delivering"] = False
                        changed = True
                    else:
                        events.append(f"UNCONFIRMED {tid} agent={agent} (prompt recorded, not confirmed)")
                    continue
                budget = (CODER_BUDGET_MIN if w["kind"] == "coder" else REVIEW_BUDGET_MIN) * 60
                if not watched(st, agent):     # herdr can't watch it: only the done file and the time budget count
                    if age > budget:
                        events.append(f"TIMEOUT {tid} agent={agent} after {age // 60} min")
                    continue
                s = herdr_state(agent)
                if s is not None and word(s, "blocked") and not w.get("blocked_since"):
                    w["blocked_since"], changed = now(), True       # stopped at a permission prompt / question
                elif w.get("blocked_since") and not (s is not None and word(s, "blocked")):
                    w["blocked_s"] = w.get("blocked_s", 0) + now() - w.pop("blocked_since")
                    changed = True
                if s is None:
                    events.append(f"GONE {tid} agent={agent}")
                elif word(s, "blocked"):
                    events.append(f"BLOCKED {tid} agent={agent}")
                elif age > IDLE_GRACE_S and word(s, "idle", "done") and not word(s, "working"):
                    events.append(f"IDLE {tid} agent={agent} (no sentinel after {age}s)")
                elif age > budget:
                    events.append(f"TIMEOUT {tid} agent={agent} after {age // 60} min")
            if BG_DIR.is_dir() and any(BG_DIR.glob("*.exit")):
                events.append("BG_DONE - (a background check or merge of the event manager ended)")
            if events or changed:
                save(st)
            if not any(t.get("wait") for t in st["tasks"].values()):
                end = min(end, start + 5)      # nobody is working: don't sit out the whole wait (benches end sooner)
        if events:
            print("\n".join(events))
            return
        # an agent that got /compact and is idle again can take its next milestone now: back to the event manager
        squashed = [n for n, w, holding in compact_agents(st) if w.get("compacting") and not holding
                    and not still_compacting(st, n, w)]
        if squashed:
            print(f"WAITING compacted: {' '.join(squashed)} (free for new work)")
            sys.exit(10)
        if time.time() >= end:
            running = [f"{tid}:{st['tasks'][tid]['status']}" for tid in st["order"]
                       if st["tasks"][tid]["status"] in ("coding", "reviewing", "conflict")]
            print("WAITING " + (" ".join(running) if running else "(nothing running)"))
            sys.exit(10)
        time.sleep(POLL_STEP_S)


def cmd_bump(args):
    need(args, 2, "bump <Mn> fix|review")
    tid, kind = args[0], args[1]
    if kind not in ("fix", "review"):
        die("usage: orch bump <Mn> fix|review")
    st = load()
    t = task(st, tid)
    key, cap = ("fix", MAX_FIX) if kind == "fix" else ("review_round", MAX_REVIEW)
    if kind == "fix":
        t["fix"] += 1
    used = t[key] - t.get("fix_base" if kind == "fix" else "review_base", 0)   # rounds since an escalation
    over = used > cap if kind == "fix" else used >= cap
    if over:
        save(st)
        print(f"CAP {tid} {kind} rounds exceeded ({t[key]}/{cap}) — park it and ask the developer")
        sys.exit(3)
    save(st)
    print(f"OK {tid} {kind} round {t[key]}/{cap}")


def cmd_commit(args):
    need(args, 1, "commit <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if st["isolation"] == "worktree" and not holds(st, tid):
        if not work_ref(st, tid):
            die(f"{tid} has no saved work ({task_ref(st, tid)})")
        move(st, tid, "committed")
        save(st)
        print(f"COMMITTED {tid} (saved in {task_ref(st, tid)} since handoff)")
        return
    d = task_dir(t, tid)
    if st["isolation"] == "shared":
        git("add", "-A", cwd=d)
        t["blast"] = blast_radius(st, tid, ["--cached", "HEAD"], d)
        risks = [] if t.get("approved") else risk_flags(st, tid, ["--cached", "HEAD"], d)
        if risks:
            git("reset", "-q", cwd=d)                # unstage; the work stays in the tree until approved
            _hold(st, tid, risks)
        r = git("commit", "-q", "-m", commit_message(st, tid), cwd=d, check=False)
        if r.returncode != 0 and "nothing to commit" not in (r.stdout + r.stderr):
            die(r.stdout + r.stderr)
        _finish(st, tid)
        print(f"MERGED {tid} (shared mode: committed on {st['branch']})")
        return
    wip_commit(d, f"orch wip {tid}: ready to land")
    git("update-ref", task_ref(st, tid), "HEAD", cwd=d)
    move(st, tid, "committed")
    save(st)
    print(f"COMMITTED {tid} (saved in {task_ref(st, tid)})")


def _finish(st, tid):
    t = st["tasks"][tid]
    move(st, tid, "merged", "")
    t["wait"] = None
    if (st.get("merging") or {}).get("tid") == tid:
        st["merging"] = None
    if t.get("worker") and st["workers"].get(t["worker"], {}).get("task") == tid:
        st["workers"][t["worker"]]["task"] = None
    save(st)


def merge_check_needed(st, tid):
    """Whether landing Mn must run the check again on the feature branch. Not when the branch would hold exactly the
    files whose check already passed in the coder's folder: nothing else landed since the coder started (the branch
    head is part of its saved work) and its saved work is the very tree that was checked. Then a second check would
    run on the same files and can only say the same thing."""
    t = st["tasks"][tid]
    chk = t.get("chk") or {}
    if st["isolation"] != "worktree" or not st.get("check") or not chk.get("ok") or not chk.get("tree"):
        return True
    if st.get("branch_check") == "always":    # the check depends on more than the files (the folder, the branch)
        return True
    src = work_ref(st, tid)
    if not src:
        return True
    tree = git("rev-parse", f"{src}^{{tree}}", cwd=ROOT, check=False).stdout.strip()
    if tree != chk["tree"]:
        return True                       # the work changed after its check (or the check left files behind)
    return git("merge-base", "--is-ancestor", st["branch"], src, cwd=ROOT, check=False).returncode != 0


def cmd_merge(args):
    """orch merge Mn -> land a committed milestone on the feature branch, checked first so nothing red lands.
    The state lock is held only while the run's state or the main folder change, not while the check runs, so the
    event manager and the lead keep working meanwhile (the `merging` journal covers a crash in between)."""
    need(args, 1, "merge <Mn>")
    tid = args[0]
    with state_lock():
        st, need_check = _merge_start(tid)
    if need_check is None:
        return
    ok, tail = ensure_root_setup(st)
    secs = 0
    if ok:
        ok, tail, secs = run_check(st, ROOT)
    with state_lock():
        st2 = load()
        t = st2["tasks"][tid]
        if st.get("root_setup_hash") != st2.get("root_setup_hash"):
            st2["root_setup_hash"] = st["root_setup_hash"]
        t.setdefault("checks", []).append({"where": "branch", "ok": ok, "secs": secs, "ts": now()})
        fault("after-check")
        if not ok:
            git("reset", "--hard", "-q", "HEAD", cwd=ROOT)
            st2["merging"] = None
            _integration_failed(st2, tid, tail)
        git("commit", "-q", "-m", commit_message(st2, tid), cwd=ROOT)
        note_green(st2, ROOT, True)
        fault("after-merge-commit")
        git("update-ref", "-d", task_ref(st2, tid), cwd=ROOT, check=False)
        _finish(st2, tid)
        print(f"MERGED {tid} into {st2['branch']}")


def _merge_start(tid):
    """cmd_merge's first part, under the state lock: squash Mn into the main folder. Returns (state, need_check):
    need_check None means it is done already (no changes, or no second check needed: committed and merged)."""
    st = load()
    t = task(st, tid)
    if st["isolation"] == "shared":
        die("shared mode has no merge step (orch commit already landed it)")
    if t["status"] != "committed":
        die(f"{tid} is {t['status']}, expected committed")
    if git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip() != st["branch"] or is_dirty(ROOT):
        die(f"main tree must be clean and on {st['branch']}")
    src = work_ref(st, tid) or die(f"{tid} has no saved work ({task_ref(st, tid)}) — run `orch commit {tid}` first")
    src_sha = git("rev-parse", src, cwd=ROOT).stdout.strip()
    mb = git("merge-base", st["branch"], src_sha, cwd=ROOT).stdout.strip()
    t["blast"] = blast_radius(st, tid, [mb, src_sha], ROOT)
    if not t.get("approved"):
        risks = risk_flags(st, tid, [mb, src_sha], ROOT)
        if risks:
            _hold(st, tid, risks)
    head = git("rev-parse", "HEAD", cwd=ROOT).stdout.strip()
    st["merging"] = {"tid": tid, "head_before": head, "src": src_sha}   # journal: a crash from here is recoverable
    save(st)
    r = git("merge", "--squash", src, cwd=ROOT, check=False)
    fault("after-squash")
    if r.returncode != 0:
        files = git("diff", "--name-only", "--diff-filter=U", cwd=ROOT, check=False).stdout.split()
        git("reset", "--hard", "-q", "HEAD", cwd=ROOT)
        st["merging"] = None
        move(st, tid, "conflict", "merge conflict in " + (", ".join(files) or "(see git status)"))
        t["conflicts"] = t.get("conflicts", 0) + 1
        if t.get("review") and t.get("review_ok"):
            # an approved milestone changes again while its conflict is resolved: the reviewer sees the resolution
            t["review_ok"], t["pre_conflict"] = False, src_sha
        t["job"] = {"file": f"conflict-{t['conflicts']}.md", "body":
                    f"# Merge conflict for {tid}: {t['title']}\n\n"
                    f"Other milestones landed on `{st['branch']}` while you worked, and they conflict with "
                    f"yours in: {', '.join(files) or 'see git status'}.\n"
                    f"In this folder run `git merge --no-commit {st['branch']}`, resolve every conflict so BOTH "
                    f"sides keep working (you own the resolution), then run `{st['check']}`. Do not commit.\n"}
        save(st)
        who = t["worker"] if holds(st, tid) else "any free coder"
        print(f"CONFLICT {tid} files={','.join(files)} -> conflict job queued for {who} (`orch send-job {tid}`)")
        sys.exit(4)
    if git("diff", "--cached", "--quiet", cwd=ROOT, check=False).returncode == 0:
        print(f"NOTE {tid} had no changes to merge")
    elif merge_check_needed(st, tid):
        save(st)
        return st, True
    else:
        ok, tail = ensure_root_setup(st)      # keep the main folder's dependencies current all the same
        if not ok:
            print(f"WARN {tail.splitlines()[0] if tail else 'setup failed in the main folder'}")
        print(f"SKIPPED_CHECK {tid}: the branch gets exactly the files whose check passed in the coder's folder "
              f"(nothing else landed meanwhile), so the check was not run again")
        fault("after-check")
        git("commit", "-q", "-m", commit_message(st, tid), cwd=ROOT)
        note_green(st, ROOT, True)
        fault("after-merge-commit")
    git("update-ref", "-d", task_ref(st, tid), cwd=ROOT, check=False)
    _finish(st, tid)
    print(f"MERGED {tid} into {st['branch']}")
    return st, None


def _hold(st, tid, risks):
    """Stop a milestone before it lands until the developer runs `orch approve Mn` (exit 7)."""
    t = st["tasks"][tid]
    t["risks"] = risks
    if st["isolation"] == "worktree" and holds(st, tid):      # its work is saved in the hidden ref: free the coder
        st["workers"][t["worker"]]["task"] = None
        t["last_worker"], t["worker"] = t["worker"], None
    b = t.get("blast") or {}
    proof = ((t.get("proof") or ("the coder's PROOF: line, in the lead's chat" if run_mode(st) == "subagent"
                                 else "none given by the coder")) if t.get("door") == "one-way" else None)
    move(st, tid, "held", "waiting for `orch approve " + tid + "`: " + "; ".join(risks[:3])
         + (f" (+{len(risks) - 3} more)" if len(risks) > 3 else "")
         + (f" · could break: {b['level']}" if b else "") + (f" · proof: {proof[:200]}" if proof else ""))
    save(st)
    print(f"HELD {tid} for approval — " + "; ".join(risks))
    if b:
        print(f"Could break: {b['level']} ({'; '.join(b['why'])})")
    if proof:
        print(f"Proof from the coder: {proof}")
    print(f"Look at it, then run `orch approve {tid}` (or `orch set {tid} paused` to stop it)")
    sys.exit(7)


def _integration_failed(st, tid, tail):
    """The squash merged cleanly but the check fails on the feature branch: queue a fix job, commit nothing."""
    t = st["tasks"][tid]
    t["fix"] = t.get("fix", 0) + 1
    if t["fix"] > MAX_FIX:
        _park(st, tid, "failed", f"passes alone but fails the check on {st['branch']} after {MAX_FIX} fix rounds")
        print(f"CAP {tid}: still fails the check on {st['branch']} after {MAX_FIX} fix rounds\n{tail}")
        sys.exit(3)
    n = t["fix"]
    t["job"] = {"file": f"integration-fix-{n}.md", "body":
                f"# {tid} fails the check once merged onto `{st['branch']}` (round {n})\n\n"
                f"Your milestone passes `{st['check']}` on its own, but fails once it is merged with what landed on "
                f"`{st['branch']}` since you started. In this folder run `git merge --no-commit {st['branch']}`, find "
                f"the cause and fix it (you decide how, and keep both sides working), then run `{st['check']}`. "
                f"Don't commit, and don't weaken or skip tests.\n\n```\n{tail}\n```\n"}
    move(st, tid, "needs-fix", f"fails the check on {st['branch']} once merged (round {n})")
    t["wait"] = None
    save(st)
    who = t["worker"] if holds(st, tid) else "any free coder"
    print(f"CHECK_FAILED {tid} on {st['branch']} -> fix job queued for {who} (`orch send-job {tid}`); "
          f"nothing was committed\n{tail}")
    sys.exit(6)


def recover_merge(st):
    """Finish or undo a merge that a crash interrupted (see the `merging` journal in cmd_merge)."""
    m = st.get("merging")
    if not m:
        return
    tid = m["tid"]
    t = st["tasks"].get(tid)
    head = git("rev-parse", "HEAD", cwd=ROOT).stdout.strip()
    if head != m["head_before"]:
        body = git("log", "-1", "--format=%B", cwd=ROOT).stdout
        if t and t["status"] == "committed" and re.search(rf"(?m)^Milestone: {re.escape(tid)}$", body):
            git("update-ref", "-d", task_ref(st, tid), cwd=ROOT, check=False)
            _finish(st, tid)
            print(f"RECOVERED {tid}: its commit had landed before the crash")
            return
        st["merging"] = None                     # HEAD moved for another reason: leave it alone
        save(st)
        return
    if is_dirty(ROOT):
        if not ref_ok(m["src"]):
            die(f"an interrupted merge of {tid} left changes in the main folder, and its saved work {m['src']} is "
                f"gone — look at `git status` before doing anything else")
        git("reset", "--hard", "-q", m["head_before"], cwd=ROOT)
        print(f"RECOVERED {tid}: undid the half-done merge; it will be merged again from its saved work")
    st["merging"] = None
    save(st)


def cmd_approve(args):
    """orch approve Mn -> let a held milestone land (risky changes were looked at by the developer)."""
    need(args, 1, "approve <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if t["status"] != "held":
        die(f"{tid} is {t['status']}, not held")
    t["approved"] = True
    move(st, tid, "committed", "approved by the developer")
    save(st)
    print(f"APPROVED {tid}: it lands on the next autopilot step (or `orch merge {tid}`)")


def _park(st, tid, status, reason, force=False):
    """Free the task's coder (and the reviewer) and keep its work in its hidden ref."""
    t = st["tasks"][tid]
    record_attempt(t, f"parked as {status}: {reason}" if reason else f"parked as {status}")
    d, w = t.get("dir"), t.get("worker")
    wait, note_to = t.get("wait") or {}, None
    if w and holds(st, tid):
        if status in ("paused", "failed") and wait.get("kind") == "coder" and wait.get("agent") == w \
                and not Path(wait["sentinel"]).exists():
            note_to = w                        # parked under a coder that had not finished: tell it to stop
        if st["isolation"] == "worktree" and d and Path(d).exists():
            if is_dirty(d):
                wip_commit(d, f"orch wip {tid}: parked — {reason or status}")
            if ahead_of_branch(st, d):
                git("update-ref", task_ref(st, tid), "HEAD", cwd=d)
        elif st["isolation"] == "shared":
            stash_to_ref(st, tid)              # the tree is clean again, so the next milestone can start
        st["workers"][w]["task"] = None
    elif t["status"] in RESTING:
        # already parked, but its coder may have kept writing since: that work is saved too, never skipped
        saved = None
        if st["isolation"] == "worktree":
            saved = save_stray(st, w or t.get("last_worker"), rescue=False)
        elif st.get("tree_task") == tid and not coders_busy(st) and is_dirty(ROOT):
            saved = shared_fold(st, tid)
        if saved:
            print(saved)
    if w:
        t["last_worker"], t["worker"] = w, None
    if st.get("reviewer_busy") == tid:
        st["reviewer_busy"] = None
    move(st, tid, status, reason, force=force)
    t["wait"] = None
    save(st)
    if note_to:
        res = stop_coder(st, note_to, tid, status, reason)
        if res:
            keys = "+".join(res["keys"]) if res["keys"] else None
            if res["note"]:
                print(f"STOP_NOTE {tid} -> {note_to}: " + (f"interrupted ({keys}) and " if keys else "")
                      + "told to stop and not change more files")
            if res["watched"]:
                st["workers"][note_to]["stopping"] = {"task": tid, "ts": now(), "keys": res["keys"] or [],
                                                      "again": 0}
                save(st)
                print(f"STOPPING {note_to}: " + ("herdr shows it idle now; " if res["idle"] else
                      "herdr still shows it working; ") + f"it stays busy (no new work) until it has been idle "
                      f"{int(HALT_SETTLE_S)}s. `orch status` says when it is free"
                      + ("" if keys else f" — the interrupt key could not be sent: press Esc in its pane"))
            else:
                print(f"CHECK   {note_to}: herdr can't watch {agent_info(st, note_to).get('kind')}, so orch can't "
                      f"tell when it has stopped: look at its pane before you give it new work")


def cmd_park(args):
    """orch park Mn paused|failed|pending [--lost] [reason...] — free the worker, keep work in the milestone's hidden
    ref. --lost counts a lost attempt (agent gone, rate-limited, stopped); at ORCH_MAX_LOST the task fails."""
    lost = "--lost" in args
    args = [a for a in args if a != "--lost"]
    need(args, 2, "park <Mn> paused|failed|pending [--lost] [reason]")
    tid, status, reason = args[0], args[1], " ".join(args[2:])
    if status not in ("paused", "failed", "pending"):
        die("status must be paused, failed or pending")
    st = load()
    task(st, tid)
    if lost:
        status, reason = _lost(st, tid, status, reason)
    _park(st, tid, status, reason)
    print(f"PARKED {tid} as {status}: {reason}")


def cmd_cooldown(args):
    """orch cooldown <worker|reviewer> <min> [reason] — bench an agent; reason `gone` ends once herdr sees it again."""
    need(args, 2, "cooldown <agent> <minutes> [reason]")
    name, reason = args[0], (args[2] if len(args) > 2 else "")
    if not args[1].isdigit():
        die(f"cooldown minutes must be a whole number, got {args[1]!r}")
    st = load()
    info = st["workers"].get(name) or (st.get("reviewer_info") if name == st.get("reviewer") else None)
    if info is None:
        die(f"unknown agent {name!r} — workers: {', '.join(st['workers'])}; reviewer: {st.get('reviewer') or 'none'}")
    info["cooldown_until"], info["cooldown_reason"] = now() + int(args[1]) * 60, reason
    save(st)
    print(f"COOLDOWN {name} for {args[1]} min" + (f" ({reason})" if reason else ""))


def cmd_bench(args):
    """orch bench <worker> off [reason] | on -> keep a coder out of the run until the developer says otherwise.
    Unlike a cooldown it never ends by itself: not after a restart, `orch sync`, `orch resume` or `orch team up`."""
    need(args, 2, "bench <worker> off [reason] | bench <worker> on")
    name, mode, reason = args[0], args[1], " ".join(args[2:]).strip()
    if mode not in ("off", "on"):
        die("usage: orch bench <worker> off [reason] | orch bench <worker> on")
    with state_lock():
        st = load()
        if name not in st["workers"]:
            die(f"unknown worker {name!r} — workers: {', '.join(st['workers'])}"
                + (" (the reviewer can't be benched this way: change `Reviewer:` in plan.md)"
                   if name == st.get("reviewer") else ""))
        w = st["workers"][name]
        if mode == "on":
            was = w.pop("off", None)
            save(st)
            print(f"ON      {name} takes work again" if was else f"ON      {name} was not off")
            return
        w["off"] = {"ts": now(), "why": reason or "the developer said so"}
        moved = [tid for tid in st["order"] if st["tasks"][tid].get("assign") == name
                 and st["tasks"][tid]["status"] not in ("merged", "skipped")]
        for tid in moved:
            st["tasks"][tid].pop("assign", None)        # `--to <this worker>` no longer holds it back
        save(st)
        print(f"OFF     {name}: gets no new work until `orch bench {name} on` ({w['off']['why']})")
        if moved:
            print(f"        {', '.join(moved)} no longer wait for {name}: the next free coder takes them")
        if w.get("task"):
            print(f"        it still holds {w['task']}: that one finishes here. To move it now: "
                  f"`orch set {w['task']} paused`, then `orch dispatch {w['task']}`")
        if not eligible_workers(st, {"tier": None, "min_tier": None}):
            print("WARN    every coder is off now: nothing new starts until one is back on")


def cmd_free(args):
    """orch free <worker> -> you looked at its pane: the coder that was told to stop HAS stopped, so it can take work
    again now (orch otherwise waits until herdr shows it idle)."""
    need(args, 1, "free <worker>")
    name = args[0]
    with state_lock():
        st = load()
        w = st["workers"].get(name) or die(f"unknown worker {name!r} — workers: {', '.join(st['workers'])}")
        if w.get("task"):
            die(f"{name} holds {w['task']}: to take it away, `orch set {w['task']} paused` (it is then told to stop)")
        h = w.pop("stopping", None)
        save(st)
    print(f"FREE    {name}: " + (f"no longer waits to stop {h.get('task')}; it can take new work" if h else
                                 "it was not stopping anything"))


def cmd_stop(args):
    """orch stop [--now] -> stop the event manager cleanly: it finishes the step it is on (a check, a merge) and
    exits; every event and all work are kept. Then change the run (plan.md + `orch sync`, `orch team up`) and
    start it again with `orch resume`. --now also stops the step it is on."""
    if not driver_alive():
        print("the event manager is not running")
        return
    info = driver_info()
    pid = info.get("pid")
    if info.get("host") not in (None, socket.gethostname()):
        die(f"the event manager runs on {info.get('host')}: stop it there")
    if not isinstance(pid, int):
        die("can't tell the event manager's process id from .orchestrate/driver.lock")
    (ORCH / "stop.request").write_text(json.dumps({"ts": now(), "now": "--now" in args}))
    for _ in range(2 if "--now" in args else 1):
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGTERM)
        time.sleep(0.3)
    end = time.time() + STOP_WAIT_S
    while time.time() < end and driver_alive():
        time.sleep(0.25)
    if driver_alive():
        print(f"STOPPING the event manager (pid {pid}) is finishing its current step and stops right after it. "
              f"`orch status` shows when it has; `orch stop --now` stops it at once.")
        sys.exit(3)
    print(f"STOPPED the event manager (pid {pid}). Nothing is lost. Change what you need (plan.md + `orch sync`, "
          f"`orch team up`), then start it again with `orch resume`.")


STATUSES = {"pending", "coding", "verifying", "awaiting-review", "reviewing", "reviewed", "committed", "merged",
            "needs-answer", "paused", "failed", "conflict", "skipped", "needs-fix", "held"}


def cmd_set(args):
    """orch set Mn <status> [reason] [--force] — manual override. pending/paused/failed also free the coder like
    `park`. Only pending, paused, failed and skipped are allowed without --force; a forced change is logged."""
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    need(args, 2, "set <Mn> <status> [reason] [--force]")
    tid, status, reason = args[0], args[1], " ".join(args[2:])
    if status not in STATUSES:
        die(f"unknown status {status!r} — one of {', '.join(sorted(STATUSES))}")
    if status not in SET_OK and not force:
        die(f"`orch set` only moves a task to {', '.join(sorted(SET_OK))}; setting {status!r} by hand skips the "
            f"steps that make it true — add --force if you really mean it")
    st = load()
    task(st, tid)
    if force:
        reason = ("manual override: " + reason).strip()
    if status in ("pending", "paused", "failed"):
        _park(st, tid, status, reason, force=force)
    else:
        move(st, tid, status, reason, force=force)
        save(st)
    print("OK")


def cmd_status(args):
    if "--json" in args:
        print(json.dumps(view_model(load() if STATE.exists() else None), indent=2))
        return
    st = load()
    dead = None if driver_alive() else note_dead_manager(st)
    here = {n: presence_word(st, n) for n in st["workers"]}    # ask herdr first, then print in one go
    if dead:
        print("!! " + dead.replace("\n", "\n!! "))
    if driver_alive():
        print(f"driven by {driver_line(driver_info())}")
    elif needs_manager(st):
        beat = (st.get("run") or {}).get("beat")
        print("!! EVENT MANAGER NOT RUNNING"
              + (f" since {_clock(beat)} ({_dur(now() - beat)} ago)" if beat else "")
              + " — nothing is watching this run, so it will not move.\n"
              "!! Run `orch resume` (after a restart it also finds the agents again and re-sends their tasks).")
    if st.get("mode") == "quick":
        print(f"QUICK RUN because: {st.get('quick_because') or '-'}")
    print(f"branch={st['branch']} base={st.get('base')} isolation={st['isolation']} "
          f"max_parallel={st['max_parallel']} reviewer={st['reviewer']} (busy: {st.get('reviewer_busy')})"
          + (f" — reviewer {compacting_line(st, st['reviewer'], st['reviewer_info'])}"
             if st.get("reviewer") and still_compacting(st, st["reviewer"], st.get("reviewer_info") or {}) else ""))
    vu = view_url()
    print(f"live view: {vu}" if vu else "live view: off — `orch view` shows this run as a picture in your browser")
    for n in run_notices(st):
        print("note: " + n["text"])
    if st.get("integration_broken"):
        print(f"  INTEGRATION BROKEN: the check failed on {st['branch']} after merging "
              f"{st['integration_broken']} — fix it; autopilot re-checks before it continues")
    for n, w in st["workers"].items():
        cd = max(0, w.get("cooldown_until", 0) - now())
        h = here[n]
        state = ("OFF (" + (w["off"].get("why") or "developer") + ")" if w.get("off") else
                 f"coding {w['task']}" if w.get("task") else
                 stopping_line(st, n, w) if still_stopping(st, n, w) else
                 compacting_line(st, n, w) if still_compacting(st, n, w) else
                 f"benched {cd // 60}m ({w.get('cooldown_reason') or 'cooldown'})" if cd else "free")
        if state == "free" and h == "ok" and w.get("detect", True) and busy_word(herdr_state(n)):
            state = "free, but herdr shows it working: look at its pane before it gets new work"
        print(f"  worker {n:<12} {w['kind']:<8} task={w.get('task') or '-':<5} "
              + (f"model={w['model']} ({w.get('tier') or 'unrated'}) " if w.get("model") else "")
              + f"{'cooldown ' + str(cd // 60) + 'm' if cd else ''}"
              f"{'' if w.get('detect', True) else ' detect:off'}"
              + f"  herdr={h} state={state}"
              + ("  !! no agent: `orch team up` (or `orch resume` after a restart)" if h in ("NO AGENT", "SHELL ONLY")
                 else ""))
    for tid in st["order"]:
        t = st["tasks"][tid]
        print(f"  {tid:<4} {t['status']:<15} deps={','.join(t['deps']) or '-':<10} "
              f"worker={t.get('worker') or '-':<10} "
              + (f"tier={t['tier'] if rank(t.get('min_tier')) <= rank(t.get('tier')) else t['min_tier'] + '^'} "
                 if need_rank(t) else "") + t["title"]
              + (f"  [{t['reason']}]" if t.get("reason") else "")
              + (f"  [check running {_fmt_secs(now() - c['since'])} in "
                 f"{'the main folder (before landing)' if c['where'] == 'branch' else 'its folder'}]"
                 if (c := t.get("checking")) else "")
              + (f"  [waiting {_fmt_secs(now() - w['since'])} for {w.get('behind') or w['what']}]"
                 if (w := t.get("waiting")) else "")
              + (f"  !! but {t['worker']} has no agent in herdr ({here[t['worker']]}): nothing is working on it — "
                 f"`orch resume`" if t["status"] in ("coding", "conflict") and here.get(t.get("worker"))
                 in ("NO AGENT", "SHELL ONLY") else ""))
    if lead_on(st):
        ev = [e for e in st["lead_events"] if event_open(st, e)]
        hold = undispatched(st)
        gone = lead_missing(st)
        if gone:
            print(f"!! LEAD NOT FOUND: the event manager can't wake the lead `{st['lead']['name']}` ({gone}). In the "
                  f"lead's pane: herdr agent rename <its pane id> {st['lead']['name']}   (`orch lead whoami` there "
                  f"shows the id)")
        print(f"  lead {st['lead']['name']}: {len(unread_events(st))} unread event(s), {len(ev)} open"
              + ("  !! LEAD NOT FOUND" if gone else "")
              + (f"; waiting for `orch dispatch`: {', '.join(hold)}" if hold else "")
              + (f"; wake-up sent {lw['n']}x (last {_fmt_secs(now() - lw.get('ts', now()))} ago), not picked up yet"
                 if unread_events(st) and (lw := st.get("lead_wake") or {}).get("n") else "")
              + ("" if driver_alive() else "; the event manager is NOT running (`orch resume`)"))
    if all(t["status"] in ("merged", "skipped") for t in st["tasks"].values()):
        print(f"ALL_DONE — run `orch finish` to push {st['branch']} and open a PR into {st.get('base')}")
    elif lead_on(st) and (undispatched(st) or any(event_open(st, e) for e in st["lead_events"])):
        pass
    elif not any(t["status"] in ACTIVE for t in st["tasks"].values()) and not any(
            t["status"] == "pending" and deps_met(st, t) for t in st["tasks"].values()):
        print("STUCK — nothing running and nothing ready; resolve paused/needs-answer/failed tasks with the developer")
    update_notice(network=False)       # from the last daily check only: status never waits for the network


def remove_worktrees(st):
    for n in st["workers"]:
        p = wt_path(n)
        if p.exists():
            if is_dirty(p):
                print(f"SKIP {p}: has uncommitted changes")
                continue
            git("worktree", "remove", str(p), cwd=ROOT)
            print(f"REMOVED {p}")
    git("worktree", "prune", cwd=ROOT)


# files agents and orch leave in a coder's folder that are not work: settings an agent saves when a permission
# is approved, its local skills, orch's task files. `orch finish` removes a folder that holds only these.
AGENT_LEFTOVERS = (".claude/", ".codex/", ".agents/", ".opencode/", ".gemini/", ".hermes/", ".amp/", ".agy/",
                   ".orchestrate/", f"{TASK_DIR}/")


def finish_worktrees():
    """orch finish (every milestone landed): remove every coder folder under <repo>-wt, the folders of coders no
    longer in the plan too, then the empty <repo>-wt folder. A folder that holds only agent or orch files goes;
    one with real changes no milestone has is kept and named, with the command that deletes it."""
    top = ROOT.parent / f"{ROOT.name}-wt"
    git("worktree", "prune", cwd=ROOT)
    if not top.is_dir():
        return
    listed = git("worktree", "list", "--porcelain", cwd=ROOT).stdout.splitlines()
    paths = [Path(x[len("worktree "):]) for x in listed if x.startswith("worktree ")]
    for p in sorted(x for x in paths if x.resolve().parent == top.resolve()):
        lines = git("status", "--porcelain", "--untracked-files=all", cwd=p).stdout.splitlines()
        real = [x[3:] for x in lines if not (x.startswith("?? ") and x[3:].startswith(AGENT_LEFTOVERS))]
        if real:
            print(f"KEPT {p}: changes no milestone has ({', '.join(real[:5])}{', ...' if len(real) > 5 else ''}) "
                  f"— look, then delete it with `git worktree remove --force {p}`")
            continue
        git("worktree", "remove", "--force", str(p), cwd=ROOT)
        junk = sorted({x[3:].split("/", 1)[0] + "/" for x in lines})
        print(f"REMOVED {p}" + (f" (only agent files: {', '.join(junk)})" if junk else ""))
    git("worktree", "prune", cwd=ROOT)
    with contextlib.suppress(OSError):
        top.rmdir()                       # only when nothing is left in it
    if top.exists():
        print(f"KEPT {top}: still holds {', '.join(sorted(x.name for x in top.iterdir()))}")
    else:
        print(f"REMOVED {top}")


def cmd_cleanup(args):
    st = load()
    if st["isolation"] != "worktree":
        print("nothing to clean (shared mode)")
        return
    remove_worktrees(st)


def github_compare_url(remote, base, branch):
    m = re.match(r"(?:git@github\.com:|https://(?:[^@/]+@)?github\.com/)([^/]+/[^/]+?)(?:\.git)?/?$", remote)
    return f"https://github.com/{m.group(1)}/compare/{base}...{branch}?expand=1" if m else None


# AI tools sign their own commits and PRs ("Co-Authored-By: Claude ...", "Generated with Claude Code"). A run's
# commits and PR are the developer's: orch never adds such lines, and keeps them out of what it publishes.
AI_CREDIT_RE = re.compile(
    r"(?im)^[ \t]*(?:co-authored-by:[^\n]*(?:claude|anthropic|openai|codex|copilot|gemini|cursor|aider|devin|"
    r"opencode|antigravity|noreply@anthropic|noreply@openai)[^\n]*|claude-session:[^\n]*|(?:🤖\s*)?generated (?:with|by) \[?(?:claude|codex|"
    r"copilot|gemini|cursor|aider|opencode|antigravity)[^\n]*|https?://claude\.ai/code/session_\S*)[ \t]*\n?")
AI_AUTHOR_RE = re.compile(r"(?i)noreply@anthropic\.com|noreply@openai\.com|^(?:claude|copilot|codex)\s*<")


def strip_ai_credit(text):
    """The text without lines that credit an AI tool, and without the blank lines they leave at the end."""
    return AI_CREDIT_RE.sub("", text).rstrip() + "\n"


def ai_credited_commits(base):
    """Commits on the run's branch that credit an AI tool (as author, or with a Co-Authored-By line). orch never
    makes them: a coder or the lead committed by itself."""
    mb = git("merge-base", base, "HEAD", cwd=ROOT, check=False).stdout.strip()
    if not mb:
        return []
    out = git("log", "--format=%h%x1f%an <%ae>%x1f%B%x1e", f"{mb}..HEAD", cwd=ROOT, check=False).stdout
    found = []
    for rec in out.split("\x1e"):
        parts = rec.strip("\n").split("\x1f")
        if len(parts) == 3 and (AI_AUTHOR_RE.search(parts[1]) or AI_CREDIT_RE.search(parts[2] + "\n")):
            found.append(f"{parts[0]} {parts[2].strip().splitlines()[0] if parts[2].strip() else ''}")
    return found


# ---------------------------------------------------------------- manual tests: what the developer tries by hand
MANUAL_HEAD_RE = re.compile(r"^\s*(#{1,6}\s+|\*\*)\s*manual (verification checklist|tests?\b)", re.I)
MANUAL_ITEM_RE = re.compile(r"^(\s*)(?:[-*+]\s+(?:\[[ xX]\]\s*)?|\d+[.)]\s+)(.*\S)\s*$")


def manual_tests(text):
    """The summary's "Manual verification checklist" (the lead writes it at ALL_DONE): (items, note). items are
    the things to try by hand, in order (a sub-bullet or a wrapped line stays with its item); note is the lead's
    `Nothing to check by hand: ...` line when there are none. (None, None): the summary has no such section yet."""
    lines, start, level = text.splitlines(), None, 0
    for i, l in enumerate(lines):
        m = MANUAL_HEAD_RE.match(l)
        if m:
            start, level = i + 1, (len(m.group(1).strip()) if m.group(1).strip().startswith("#") else 0)
    if start is None:
        return None, None
    items, note = [], None
    for l in lines[start:]:
        h = re.match(r"^(#{1,6})\s", l)
        if (h and (not level or len(h.group(1)) <= level)) or (not level and l.startswith("**")):
            break
        m = MANUAL_ITEM_RE.match(l)
        if m and not m.group(1):
            items.append(m.group(2).strip())
        elif l.strip() and items and (m or l[:1].isspace()):
            items[-1] += ("; " + m.group(2).strip()) if m else (" " + l.strip())
        elif re.search(r"nothing to (check|test) by hand", l, re.I) and not note:
            note = l.strip().strip("-*_ ")
    return items, note


def manual_block(st=None):
    """The manual test list for a person, as printed by `orch finish` and `orch manual` (and saved in
    .orchestrate/manual-tests.md): numbered, word for word from the summary. Returns (lines, count or None)."""
    summary = ORCH / "summary.md"
    items, note = manual_tests(summary.read_text()) if summary.exists() else (None, None)
    if items:
        out = [f"MANUAL TESTS: {len(items)} to try by hand before you merge (from the summary's Manual "
               f"verification checklist):"] + [f"  {i}. {x}" for i, x in enumerate(items, 1)]
    elif items is not None:
        out = ["MANUAL TESTS: none. " + (note or "The lead's Manual verification checklist is empty.")]
    else:
        out = ["MANUAL TESTS: not written yet. .orchestrate/summary.md has no \"Manual verification checklist\": "
               "ask the lead to finish the summary (ALL_DONE), then `orch manual` prints the list."]
    with contextlib.suppress(OSError):
        if ORCH.is_dir():
            (ORCH / "manual-tests.md").write_text(
                f"# Manual tests: {(st or {}).get('title') or (st or {}).get('branch') or 'this run'}\n\n"
                "Try these by hand. They come from the Manual verification checklist in summary.md.\n\n"
                + ("".join(f"{i}. {x}\n" for i, x in enumerate(items, 1)) if items else out[0] + "\n"))
    return out, (len(items) if items is not None else None)


def cmd_manual(args):
    """orch manual -> the manual test list from the summary, numbered, for the developer (and the lead's chat)."""
    st = load() if STATE.exists() else None
    print("\n".join(manual_block(st)[0]))


def tell_lead_finished(st, outcome, count):
    """After `orch finish`: queue a FINISHED event for the lead, so it posts the manual test list in its chat. When
    the lead ran `orch finish` itself (this pane is the lead's), it has the list in front of it: no wake-up."""
    if not lead_on(st):
        if run_mode(st) == "subagent":
            print("LEAD: post the MANUAL TESTS list above in your chat, numbered, word for word.")
        return
    text = outcome + ("" if count is None else f"; {count} manual test(s) to try by hand")
    with state_lock():
        s_ = load()
        lead_event(s_, "finished", None, text)
        save(s_)
    lead = st["lead"]["name"]
    pid = os.environ.get("HERDR_PANE_ID")
    if pid and pid in (st["lead"].get("pane"), agent_pane(lead)):
        print("LEAD: you ran `orch finish` yourself: post the MANUAL TESTS list above in your chat now, numbered, "
              "word for word, then run `orch events` to mark FINISHED read.")
        return
    try:
        deliver(st, lead, f"orch: `orch finish` ran on {st['branch']}. Run `orch events` and post the manual test "
                          f"list it prints in your chat, then stop.")
        print(f"TOLD THE LEAD ({lead}): it posts the manual test list in its chat")
    except DeliveryError as e:
        print(f"NOTE could not tell the lead ({lead}): {e} — tell it: run `orch events`")


def finish_push(st, base, title, pr_body, args):
    """Push the feature branch and open the PR. Returns one line on what happened, for the lead's FINISHED event."""
    if "--no-push" in args:
        print(f"NOT PUSHED (--no-push): push {st['branch']} and open a PR into {base} when ready")
        return f"cleaned up, not pushed (--no-push): {st['branch']} still needs a push and a PR into {base}"
    remote = git("remote", "get-url", "origin", cwd=ROOT, check=False)
    if remote.returncode != 0:
        print(f"NO REMOTE: no `origin` remote — merge {st['branch']} into {base} yourself")
        return f"no `origin` remote: {st['branch']} is to be merged into {base} by hand"
    url = remote.stdout.strip()
    refuse_protected(st["branch"], "orch finish")    # never reached by a plan orch accepted: belt and braces
    git("push", "-q", "-u", "origin", st["branch"], cwd=ROOT)
    print(f"PUSHED {st['branch']} to origin")
    compare = github_compare_url(url, base, st["branch"])
    if compare and shutil.which("gh"):
        try:
            r = subprocess.run(["gh", "pr", "create", "--base", base, "--head", st["branch"], "--title", title,
                                "--body-file", str(pr_body)],
                               cwd=ROOT, text=True, capture_output=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as e:
            r = subprocess.CompletedProcess([], 1, "", str(e))
        if r.returncode == 0:
            pr = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else "created"
            print(f"PR {pr}")
            return f"pushed {st['branch']}, PR into {base}: {pr}"
        print(f"NOTE gh pr create failed: {(r.stdout + r.stderr).strip()}")
    print(f"OPEN A PR from {st['branch']} into {base}" + (f": {compare}" if compare else "")
          + f" — title: {title!r}, text: .orchestrate/pr-body.md (use them as they are: add no \"Generated with\" or "
            f"Co-Authored-By line)")
    return f"pushed {st['branch']}; the PR into {base} is still to open" + (f": {compare}" if compare else "")


def cmd_finish(args):
    """orch finish [--no-push] [--recheck] -> final check (reused when it already passed on exactly these files;
    --recheck runs it anyway), drop hidden refs and worktrees, push the feature branch, open a PR."""
    st = load()
    left = [f"{k} ({v['status']})" for k, v in st["tasks"].items() if v["status"] not in ("merged", "skipped")]
    if left:
        die("not every milestone has landed: " + ", ".join(left))
    sidebar_clear_now(st)                # the run is over: herdr's sidebar shows the agents' own names again
    if git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip() != st["branch"] or is_dirty(ROOT):
        die(f"main tree must be clean and on {st['branch']}")
    base = st.get("base") or default_base(st)
    if "--recheck" not in args and green_still(st, ROOT):
        print(f"CHECK reused: it already passed on exactly these files ({st['green_tree'][:10]}), not run again")
    elif st.get("check"):
        r = subprocess.run(st["check"], shell=True, cwd=ROOT, text=True, capture_output=True)
        if r.returncode != 0:
            die(f"the check fails on {st['branch']} — fix it before finishing:\n"
                + "\n".join((r.stdout + r.stderr).splitlines()[-30:]))
    title = st.get("title") or st["branch"]
    if st.get("commits") == "single":
        mb = git("merge-base", base, "HEAD", cwd=ROOT).stdout.strip()
        subjects = git("log", "--reverse", "--format=%s", f"{mb}..HEAD", cwd=ROOT).stdout.split("\n")
        subjects = [s for s in subjects if s]
        if len(subjects) > 1:
            landed = [k for k in st["order"] if st["tasks"][k]["status"] == "merged"]
            git("reset", "--soft", "-q", mb, cwd=ROOT)
            git("commit", "-q", "-m", f"{title}\n\n" + "\n".join(f"- {s}" for s in subjects)
                + f"\n\nMilestones: {', '.join(landed)}", cwd=ROOT)
            print(f"SQUASHED {len(subjects)} commits into one (Commits: single)")
    refs = git("for-each-ref", "--format=%(refname)", f"{REF_NS}/{st['branch'].replace('/', '-')}/",
               cwd=ROOT).stdout.split()
    finish_worktrees()                            # every milestone landed: no coder folder is needed any more
    rescued = [r for r in refs if "/rescue-" in r]
    refs = [r for r in refs if r not in rescued]
    for ref in refs:
        git("update-ref", "-d", ref, cwd=ROOT)
    for tid in st["order"]:                       # task branches left by orch < 4.5
        if branch_exists(f"{st['branch']}-{tid}"):
            git("branch", "-D", "-q", f"{st['branch']}-{tid}", cwd=ROOT, check=False)
    print(f"CLEAN {st['branch']} is the only branch this run made ({len(refs)} hidden ref(s) removed)")
    credited = ai_credited_commits(base)
    if credited:
        print(f"WARN {len(credited)} commit(s) on {st['branch']} credit an AI tool (a Claude author or a "
              f"Co-Authored-By line). orch did not make them: an agent committed by itself. They go into the PR as "
              f"they are; to drop the credit, reword them before you push: " + "; ".join(credited[:5]))
    summary = ORCH / "summary.md"
    pr_body = ORCH / "pr-body.md"                 # the PR text: the summary, without any AI tool's credit line
    pr_body.write_text(strip_ai_credit(summary.read_text()) if summary.exists() else
                       f"Built by herdr-orchestra from .orchestrate/plan.md ({len(st['order'])} milestones).\n")
    for ref in rescued:
        print(f"KEPT {ref}: unsaved files orch rescued during the run and no milestone used — look with "
              f"`git show --stat {ref}`, delete with `git update-ref -d {ref}`")
    outcome = finish_push(st, base, title, pr_body, args)
    lines, count = manual_block(st)
    print("\n".join(lines))
    tell_lead_finished(st, outcome, count)


# ---------------------------------------------------------------- v4: task files, nudge, autopilot
TASK_SRC_SKIP = ("notes from user", "plain")   # answers reach the coder by their own prompt; Plain is not in task.md


def task_source(section, glob=""):
    """A fingerprint of what task.md is written from (the milestone's plan text + Global instructions), so `orch
    sync` can tell when plan.md changed under a coder that is already working from an older task.md."""
    _, ts = parse_plan(section)
    f = {k: v for k, v in (ts[0]["fields"] if ts else {}).items() if k not in TASK_SRC_SKIP}
    title = ts[0]["title"] if ts else section.split("\n", 1)[0]
    return hashlib.sha1(json.dumps([title, f, glob.strip()], sort_keys=True).encode()).hexdigest()[:12]


def plan_sections():
    """Return ({task_id: section_text}, global_instructions_text) straight from plan.md."""
    text = (ORCH / "plan.md").read_text()
    secs, glob, cur, buf = {}, "", None, []
    def flush():
        nonlocal glob
        if cur == "__global__":
            glob = "\n".join(buf).strip()
        elif cur:
            secs[cur] = "\n".join(buf).strip()
    for line in text.splitlines():
        m = HEAD_RE.match(line)
        if m or line.startswith("## "):
            flush()
            buf = [line]
            cur = m.group(2) if m else ("__global__" if line.lower().startswith("## global") else None)
            if cur == "__global__":
                buf = []
            continue
        buf.append(line)
    flush()
    return secs, glob


# ---------------------------------------------------------------- the repo's own rules: words, decisions, coding rules
# Optional files in the repo (plan header `Docs: <folder>`, default docs/): glossary.md, adr/*.md, coding-standards.md.
# A repo without them gets nothing new. Nothing here is AI: orch reads the files and matches words.
GLOSS_BOLD_RE = re.compile(r"^\s*(?:[-*+]\s+|\d+[.)]\s+)?\*\*([^*]+?)\*\*\s*(?:[:—–-]\s*)?(.*)$")
GLOSS_HEAD_RE = re.compile(r"^#{2,4}\s+(.+?)\s*#*\s*$")
AVOID_RE = re.compile(r"\bavoid\s*:\s*([^.\n;]+)", re.I)


def glossary_additions(plan_text):
    """The `- **Word**: meaning` lines under the plan's `## Glossary additions`: new words this feature brings."""
    m = re.search(r"(?ims)^##\s+glossary additions\s*$(.*?)(?=^##\s|\Z)", plan_text or "")
    items = [re.sub(r"^[-*+]\s+", "", l.strip()).strip() for l in (m.group(1).splitlines() if m else [])]
    return [i for i in items if i and i.lower().strip("<>\"") != "none"]


def docs_root(st=None):
    """(absolute folder, folder as written) of the repo's rules files: plan header `Docs:`, default `docs`."""
    rel = str((st or {}).get("docs") or "docs").strip().strip("`").strip("/") or "docs"
    return ROOT / rel, rel


def word_in(word, text):
    """`word` (or its plural) appears in `text` as a whole word, any case."""
    word = (word or "").strip()
    return bool(word) and bool(re.search(r"(?<![\w-])" + re.escape(word) + r"(?:e?s)?(?![\w-])", text or "", re.I))


def glossary(st=None):
    """docs/glossary.md -> [{"term", "text", "avoid": [words]}]. An entry is a bold word at the start of a line
    (`- **Discount**: money taken off an order total, in paise. Avoid: coupon, promo`); a glossary with no bold
    entries uses its `##` / `###` headings as the words, with the text under each one."""
    p = docs_root(st)[0] / "glossary.md"
    try:
        lines = p.read_text(errors="replace").splitlines() if p.is_file() else []
    except OSError:
        lines = []
    bold = any(GLOSS_BOLD_RE.match(l) for l in lines)
    out, cur = [], None
    for line in lines:
        m = GLOSS_BOLD_RE.match(line) if bold else None
        h = GLOSS_HEAD_RE.match(line)
        if m:
            cur = {"term": m.group(1).strip().rstrip(":").strip(), "text": m.group(2).strip()}
            out.append(cur)
        elif h:
            cur = {"term": h.group(1).strip().rstrip(":").strip(), "text": ""} if not bold else None
            if cur:
                out.append(cur)
        elif cur is not None and line.strip() and (not bold or line[:1] in (" ", "\t")):
            cur["text"] = (cur["text"] + " " + line.strip()).strip()
        elif bold and not line.strip():
            cur = None
    for g in out:
        g["avoid"] = [w for m in AVOID_RE.findall(g["text"])
                      for w in (x.strip(" \t`'\"*") for x in re.split(r",|/|\bor\b", m)) if w]
    return [g for g in out if g["term"]]


def adrs(st=None):
    """docs/adr/*.md -> [(path as the repo writes it, title)]: the decisions already made, one line each."""
    root, rel = docs_root(st)
    out = []
    d = root / "adr"
    for p in sorted(d.glob("*.md")) if d.is_dir() else []:
        if p.name.lower() in ("readme.md", "template.md", "index.md") or "template" in p.stem.lower():
            continue
        try:
            title = next((l[2:].strip() for l in p.read_text(errors="replace").splitlines() if l.startswith("# ")), "")
        except OSError:
            title = ""
        out.append((f"{rel}/adr/{p.name}", title or p.stem))
    return out


def standards_file(st=None):
    root, rel = docs_root(st)
    return f"{rel}/coding-standards.md" if (root / "coding-standards.md").is_file() else None


def project_rules(st, text):
    """The repo's rules for one milestone: the glossary words that appear in its text (or a word the glossary says to
    avoid), every decision record's title, and the coding rules file. Empty lists / None when the repo has none."""
    words = [g for g in glossary(st) if word_in(g["term"], text) or any(word_in(a, text) for a in g["avoid"])]
    return {"glossary": words, "adrs": adrs(st), "standards": standards_file(st)}


def project_rules_lines(st, rules):
    """The `## Project rules` block of a coder's task file and of a review task, or [] when the repo has no rules."""
    if not (rules["glossary"] or rules["adrs"] or rules["standards"]):
        return []
    rel = docs_root(st)[1]
    out = ["## Project rules", "This repo's own words, decisions and coding rules. Follow them: the review checks them."]
    if rules["glossary"]:
        out.append(f"Words (from {rel}/glossary.md): use these names exactly, in code, UI text and messages.")
        out += [f"- **{g['term']}**" + (f": {g['text'][:300]}" if g["text"] else "") for g in rules["glossary"]]
    if rules["adrs"]:
        out.append(f"Decisions already made ({rel}/adr/): read the one your change touches; don't go against one "
                   f"without asking (status `question`).")
        out += [f"- {p}: {title}" for p, title in rules["adrs"]]
    if rules["standards"]:
        out.append(f"Coding rules: {rules['standards']}")
    return out + [""]


WORKER_RULES = """## Rules for you (the coder)
- You own the HOW: the approach, the design inside this milestone, the code, the tests and every fix. This file says what and why; it deliberately doesn't say how.
- Follow the repo's existing patterns (AGENTS.md / CLAUDE.md) and any Interfaces listed above exactly; other milestones rely on them.
- Change only what this task needs. No unrelated refactors.
- Do NOT commit, push, or switch branches. orch commits your work for you.
- Never push to main (or master, or the repo's default branch) and never merge a PR, in any situation, even when the developer or the lead asks you to. Say no and offer the run's branch and a PR instead; a person merges by hand. The repo's pre-push guard refuses such a push anyway: never get around it (no `--no-verify`, no editing or deleting `.git/hooks`).
- Stay inside the files listed under Likely files (`files_allowed` in task.json) unless the task can't be done otherwise; say why in your report if you leave them. orch compares your diff with that list.
- Finish with a result file (the prompt names it) in the `result_format` shape from task.json: `status` done / question / blocked, `commit`, `files_changed`, the `check` you ran, one entry per acceptance criterion (`id`, `met`, `evidence`), and `usage` if your tool shows tokens or cost. orch reads it, so keep it valid JSON.
- The commit message (`commit` in the result, and the last report line `COMMIT: <commit message>`) says what changed, in the repo's commit style (for example `feat(api): add categories endpoint`). It becomes the commit message, so describe the change, not the milestone.
- If anything is ambiguous, do not guess: set status `question`, put the question in `questions` and on a report line starting `QUESTION:`, finish the files and the done file, and stop.
- If an acceptance criterion can't be met in this repo (it needs an outside API, service or account that doesn't exist), don't keep trying: ask (status `question`), name the criterion and why, and offer to build the rest. A criterion marked DEFERRED above was approved to stay undone: don't build it, and report it `met: false`.
- Before finishing, run the check command below and record the result (pass/fail + the failing lines).
"""


# plan.md lines that are for the lead and orch, not the coder: they stay in plan.md and task.json
LEAD_ONLY_FIELDS = {"depends on", "why separate", "prefer", "tier", "needs", "model why", "estimate", "role", "door",
                    "review", "parallel", "plain"}


def coder_section(text, drop_criteria):
    """A milestone's plan section as the coder sees it: without the lead-only fields (Role is shown above as
    "Your role"), and without the plain criteria list when the criteria are listed below with their ids.
    Everything from "Notes from user" on is kept as written: that is how the developer's answers reach the coder."""
    out, drop, notes = [], False, False
    for line in text.splitlines():
        fm = FIELD_RE.match(line.strip())
        if not notes and fm and not line.startswith((" ", "\t", "-")):
            key = fm.group(1).strip().lower()
            notes = bool(NOTES_RE.match(line))
            drop = not notes and (key in LEAD_ONLY_FIELDS or (drop_criteria and key == "acceptance criteria"))
        if not (drop and not notes):
            out.append(line)
    return "\n".join(out)


def cmd_write_task(args):
    """orch write-task Mn  -> generate TASKDIR/task.md from the plan (+ dependency reports)."""
    need(args, 1, "write-task <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    d = task_dir(t, tid)
    secs, glob = plan_sections()
    if tid not in secs:
        die(f"{tid} not found in plan.md")
    parts = [f"# Task {tid}: {t['title']}", ""]
    if t.get("role"):
        parts += ["## Your role", f"For this task you are: **{t['role']}**.",
                  "Work the way that person would. Before you write anything, read the code around the change and "
                  "the patterns it already follows. Then build it to the standard that specialist would put their "
                  "name on: \"the check passes\" is the floor, not the goal. Before you finish, look at your own "
                  "result as that specialist reviewing someone else's work, and fix what they would send back.", ""]
    contract = task_contract(st, tid)
    parts += [coder_section(secs[tid].replace(f"## [x] {tid}:", "Title:", 1),
                            drop_criteria=bool(contract["acceptance_criteria"])), ""]
    if glob and glob.lower() not in ("none", "<empty — user may fill in>"):
        parts += ["## Global instructions", glob, ""]
    rules = project_rules(st, secs[tid] + "\n" + (glob or ""))
    parts += project_rules_lines(st, rules)
    if t.get("door") == "one-way":
        parts += ["## Hard to undo: show proof",
                  "This milestone is hard to undo once it runs" + (f" ({t['door_why']})" if t.get("door_why") else "")
                  + ". The check is not enough: the developer approves it before it lands, and decides from your "
                  "proof. Run something that shows it is safe, and put what you ran and what it showed in `proof` in "
                  "your result file, and on a last report line `PROOF: <the same, short>`. For example: the migration "
                  "run on a copy of the data (rows, time, no lock), a rollback test, the exact request the new API "
                  "answers, a screenshot path.", ""]
        contract["door"] = {"kind": "one-way", "why": t.get("door_why")}
    if rules["glossary"] or rules["adrs"] or rules["standards"]:
        contract["project_rules"] = {"glossary": [g["term"] for g in rules["glossary"]],
                                     "decisions": [p for p, _ in rules["adrs"]], "coding_rules": rules["standards"]}
    ctx = []
    for dep in t["deps"]:
        dd = st["tasks"][dep].get("dir")
        reps = sorted((Path(dd) / TASK_DIR / dep).glob("report-*.md"),
                      key=lambda p: int(re.sub(r"\D", "", p.stem) or 0)) if dd else []
        lines = [l for p in reps for l in p.read_text().splitlines() if l.strip()]
        if lines:
            ctx += [f"### {dep}: {st['tasks'][dep]['title']} (already merged into your branch)",
                    "\n".join(lines[:25]), ""]
    if ctx:
        parts += ["## Context: what the tasks you depend on built", *ctx]
    if contract["acceptance_criteria"]:
        parts += ["## Acceptance criteria (ids for your result file)",
                  *[f"- {c['id']}: {c['text']}" + (f" — DEFERRED by the developer: don't build it in this milestone, "
                                                    f"report it `met: false` (why: {c['deferred']['reason']})"
                                                    if c.get("deferred") else "")
                    for c in contract["acceptance_criteria"]], ""]
    if contract["previous_work"]:
        parts += ["## Earlier work", f"An earlier attempt ({contract['previous_work']['by'] or 'another coder'}) left "
                  "work in this folder. Look at it first and continue from it unless it is wrong.", ""]
    parts += [f"## Check command\n`{st['check']}`", "", WORKER_RULES]
    out = d / TASK_DIR / tid / "task.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(parts))
    (out.parent / "task.json").write_text(json.dumps(contract, indent=2))
    t["task_src"] = task_source(secs[tid], glob)
    save(st)
    print(f"WROTE {out}")
    print(f"WROTE {out.parent / 'task.json'}")


def task_contract(st, tid):
    """task.json: the milestone as data, generated from plan.md (plan.md stays the human-edited source)."""
    t = st["tasks"][tid]
    _, ptasks = parse_plan((ORCH / "plan.md").read_text())
    pt = next((x for x in ptasks if x["id"] == tid), {"fields": {}})

    def items(key):
        vals = [v.lstrip("- ").strip() for v in pt["fields"].get(key, [])]
        return [v for v in vals if v and v.lower() != "none"]
    deps = []
    for dep in t["deps"]:
        sha = git("log", "-1", "--format=%H", f"--grep=^Milestone: {dep}$", st["branch"], cwd=ROOT,
                  check=False).stdout.strip()
        deps.append({"task": dep, "title": st["tasks"][dep]["title"], "commit": sha or None})
    return {
        "schema": 1, "task_id": tid, "title": t["title"], "kind": "task",
        "goal": field(pt, "goal"), "why": field(pt, "why"),
        "acceptance_criteria": [{"id": f"AC{i}", "text": c,
                                 **({"deferred": {"approved_by": "developer",
                                                  "reason": deferred_of(t)[f"AC{i}"].get("reason", "")}}
                                    if f"AC{i}" in deferred_of(t) else {})}
                                for i, c in enumerate(items("acceptance criteria"), 1)],
        "files_allowed": t.get("files") or [], "scope": st.get("scope", "warn"),
        "tier": t.get("tier"), "needs": t.get("needs") or [], "role": t.get("role") or None,
        "interfaces": items("interfaces"), "constraints": items("constraints"), "out_of_scope": items("out of scope"),
        "depends_on": deps, "check": st["check"], "attempt": t.get("attempt", 0) + 1, "lost_attempts": t.get("lost", 0),
        "previous_work": {"by": t.get("last_worker")} if work_ref(st, tid) else None,
        "result_format": RESULT_FORMAT,
    }


def start_manager():
    """The lead's dispatch or answer needs the event manager (`orch autopilot`) to carry it out: start one,
    detached from this shell, when none is running. Says what happened."""
    if driver_alive():
        return f"the event manager is running ({driver_line(driver_info())})"
    with contextlib.suppress(OSError, ValueError):
        if STATE.exists() and run_mode(json.loads(STATE.read_text())) == "subagent":
            return "subagent mode: no event manager (the lead drives the run with `orch sub next`)"
    if os.environ.get("ORCH_NO_AUTOSTART") == "1":
        return "the event manager is NOT running — ask the developer to run `orch autopilot` in a terminal"
    _rotate(ORCH / "manager.out", LOG_MAX_B // 2)
    env = {k: v for k, v in os.environ.items() if not k.startswith("ORCH_DRIVER")}
    cmd = [sys.executable, os.path.abspath(__file__), "autopilot"]
    # In its own systemd scope the manager is not part of the terminal (or herdr pane) it was started from: when the
    # memory guard closes that terminal, or herdr restarts, the manager keeps watching and says what it saw.
    unit = f"orch-{re.sub(r'[^A-Za-z0-9]', '-', ROOT.name)[:30]}-{os.getpid()}"
    tries = []
    if os.environ.get("ORCH_NO_SCOPE") != "1" and shutil.which("systemd-run"):
        tries.append((["systemd-run", "--user", "--scope", "--quiet", "--collect", f"--unit={unit}"] + cmd,
                      {**env, "ORCH_SCOPE": unit}))
    tries.append((cmd, env))
    for argv, e in tries:
        with open(ORCH / "manager.out", "a") as out:
            p = subprocess.Popen(argv, cwd=ROOT, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                                 start_new_session=True, env=e)
        for _ in range(20):
            time.sleep(0.25)
            if driver_alive():
                return ("started the event manager (`orch autopilot`" + (f", in its own scope {unit} so a closed "
                        f"terminal does not stop it" if argv[0] == "systemd-run" else "")
                        + ", log: .orchestrate/autopilot.log)")
            if p.poll() is not None:
                break                     # systemd-run can't reach the user session: start it the plain way
    return ("could NOT start the event manager from here (see .orchestrate/manager.out) — ask the developer to run "
            "`orch autopilot` in a terminal")


def cmd_dispatch(args):
    """orch dispatch Mn [Mn...] [--to <worker>] [--tier small|medium|high]
    The lead's request to start (or restart) milestones. The event manager sends them when a coder is free."""
    opts = {}
    for flag in ("--to", "--tier"):
        if flag in args:
            i = args.index(flag)
            opts[flag] = args[i + 1] if len(args) > i + 1 else die(f"{flag} needs a value")
            del args[i:i + 2]
    need(args, 1, "dispatch <Mn> [Mn...] [--to <worker>] [--tier small|medium|high]")
    with state_lock():
        st = load()
        if run_mode(st) == "subagent":
            die("this run is in subagent mode: the lead starts milestones with `orch sub next` (no event manager); "
                "`orch mode panes` switches back while nothing is in progress")
        require_lead(st, "orch dispatch")
        if opts.get("--to") and opts["--to"] not in st["workers"]:
            die(f"unknown worker {opts['--to']!r} — workers: {', '.join(st['workers'])}")
        if opts.get("--to"):
            to = opts["--to"]
            if st["workers"][to].get("off"):
                die(f"{to} is off ({st['workers'][to]['off'].get('why')}): `orch bench {to} on` first, or pick another "
                    f"worker")
            if still_stopping(st, to):
                print(f"NOTE     {to} is still stopping {st['workers'][to]['stopping'].get('task')}: the work starts "
                      f"there once herdr shows it idle (`orch status`)")
            here = presence_word(st, to)
            if here not in ("ok", "detect:off"):
                die(f"{to} has no agent in herdr ({here}" + (": only a plain shell is left in its pane" if here ==
                    "SHELL ONLY" else "") + f"). Run `orch team up` (or `orch resume` after a restart), check that "
                    f"`orch status` shows {to} as ok, then dispatch again")
        if opts.get("--tier") and opts["--tier"] not in TIERS:
            die("--tier must be small, medium or high")
        for tid in args:
            t = task(st, tid)
            if t["status"] not in ("pending", "paused", "failed"):
                die(f"{tid} is {t['status']} — only pending, paused or failed milestones can be dispatched"
                    + (" (answer its open questions in plan.md, then `orch sync`)" if t["status"] == "needs-answer" else ""))
        for tid in args:
            t = st["tasks"][tid]
            t["go"] = True
            t["go_ts"] = now()
            rt = t.pop("ready_ts", None)
            if rt and t["status"] == "pending":         # it was ready and waited for this dispatch
                ws = t.setdefault("waits", {})
                ws["lead"] = ws.get("lead", 0) + max(0, now() - rt)
                t["lead_wait_s"] = max(0, now() - rt)
            if opts.get("--to"):
                t["assign"] = opts["--to"]
            if opts.get("--tier"):
                t["min_tier"] = opts["--tier"]
            if t["status"] in ("paused", "failed"):         # a fresh round, decided by the lead
                t["fix_base"], t["review_base"] = t.get("fix", 0), t.get("review_round", 0)
                _park(st, tid, "pending", "dispatched again by the lead")
            who = [n for n in eligible_workers(st, t)]
            waits = [d for d in t["deps"] if st["tasks"][d]["status"] != "merged"]
            print(f"DISPATCH {tid} -> {' or '.join(who) or 'nobody (every coder is off)'}"
                  + (f" (tier {TIERS[need_rank(t) - 1]})" if need_rank(t) else "")
                  + (f" — starts when {', '.join(waits)} merged" if waits else ""))
            story_note(st, f"{tid} ({t['title']}) was sent to start" + (f" on {opts['--to']}" if opts.get("--to") else "")
                       + (f", on a {opts['--tier']} model" if opts.get("--tier") else "")
                       + (f"; it starts when {', '.join(waits)} has landed" if waits else ""))
            if who and not opts.get("--to"):
                missing = [n for n in who if presence_word(st, n) not in ("ok", "detect:off")]
                if len(missing) == len(who):
                    print(f"WARN     none of them has an agent in herdr right now ({', '.join(missing)}): {tid} waits "
                          f"until one does. Run `orch team up` (or `orch resume` after a restart)")
        save(st)
    print(start_manager())
    print("You will be woken with `orch events` when something needs you. Stop here; do not poll.")


NOTES_RE = re.compile(r"(?mi)^Notes from user:[ \t]*")


def plan_criteria(tid):
    """[(AC id, text)] of a milestone's acceptance criteria in plan.md, numbered the way task.json numbers them."""
    try:
        _, ptasks = parse_plan((ORCH / "plan.md").read_text())
    except OSError:
        return []
    pt = next((x for x in ptasks if x["id"] == tid), {"fields": {}})
    vals = [v.lstrip("- ").strip() for v in pt["fields"].get("acceptance criteria", [])]
    return [(f"AC{i}", v) for i, v in enumerate([v for v in vals if v and v.lower() != "none"], 1)]


def deferred_of(t):
    """{AC id: {"text", "reason", "ts"}}: criteria the developer approved leaving undone in this milestone."""
    d = t.get("deferred")
    return d if isinstance(d, dict) else {}


def parse_defer_ids(tid, raw):
    """'AC2,AC3' (or 'ac2 3') -> ['AC2', 'AC3'], each checked against the milestone's criteria in plan.md."""
    crit = dict(plan_criteria(tid))
    ids = []
    for p in re.split(r"[,\s]+", raw.strip()):
        if not p:
            continue
        cid = "AC" + p[2:] if p.upper().startswith("AC") else "AC" + p
        if cid not in crit:
            die(f"{tid} has no acceptance criterion {p!r} — its criteria: "
                + (", ".join(f"{k} ({v[:40]})" for k, v in crit.items()) or "none in plan.md"))
        if cid not in ids:
            ids.append(cid)
    return ids or die("name the criteria to defer, for example AC2 or AC2,AC3")


def record_deferral(t, tid, ids, reason):
    """Remember, with the developer's reason, that these criteria are approved to stay undone in this milestone."""
    crit = dict(plan_criteria(tid))
    d = dict(deferred_of(t))
    for cid in ids:
        d[cid] = {"text": crit.get(cid, ""), "reason": reason, "ts": now()}
    t["deferred"] = d


def add_plan_note(tid, text):
    """Add `- text` under the milestone's "Notes from user" in plan.md (the line is created when missing)."""
    plan = ORCH / "plan.md"
    lines, out, cur, done = plan.read_text().split("\n"), [], None, False
    note = f"- {text}"
    for line in lines:
        m = HEAD_RE.match(line)
        if (m or line.startswith("## ")) and cur == tid and not done:       # section ended without a notes line
            while out and not out[-1].strip():
                out.pop()
            out += ["Notes from user:", note, ""]
            done = True
        if m or line.startswith("## "):
            cur = m.group(2) if m else None
        out.append(line)
        if cur == tid and not done and NOTES_RE.match(line):
            out.append(note)
            done = True
    if not done:
        if cur != tid:
            die(f"{tid} not found in plan.md")
        while out and not out[-1].strip():
            out.pop()
        out += ["Notes from user:", note, ""]
    plan.write_text("\n".join(out))


def defer_note(t, ids, reason):
    return ("Deferred with the developer's approval (NOT built in this milestone, a follow-up): "
            + "; ".join(f"{c} \"{deferred_of(t).get(c, {}).get('text', '')}\"" for c in ids) + f". Why: {reason}")


def cmd_defer(args):
    """orch defer Mn AC2[,AC3] <the developer's reason> -> the developer approved leaving these criteria undone in
    Mn. A coder that reports them `met: false` gets no fix round for them (so no escalation either), the reviewer
    does not block on them, and the summary lists them as NOT done, with a follow-up. Only with the developer's yes."""
    need(args, 3, "defer <Mn> <AC ids, e.g. AC2,AC3> <the developer's reason>")
    tid, raw, reason = args[0], args[1], " ".join(" ".join(args[2:]).split())
    with state_lock():
        st = load()
        t = task(st, tid)
        if t["status"] in ("merged", "skipped"):
            die(f"{tid} is {t['status']} — nothing left to defer (a later change: `orch fix {tid} \"<text>\"`)")
        ids = parse_defer_ids(tid, raw)
        record_deferral(t, tid, ids, reason)
        add_plan_note(tid, defer_note(t, ids, reason))
        story_note(st, f"{tid} ({t['title']}): {', '.join(ids)} left undone, as you approved ({reason[:200]})")
        save(st)
        print(f"DEFERRED {tid} {','.join(ids)}: no fix rounds for them; the summary lists them as not done "
              f"(follow-up). Why: {reason}")
        if t["status"] in ("paused", "failed"):
            print(f"NEXT     {tid} is {t['status']}: `orch dispatch {tid}` sends it on with the rest of its criteria")


def cmd_answer(args):
    """orch answer Mn [--defer AC2,AC3] <the developer's answer> -> write it under the milestone's "Notes from user"
    in plan.md and send the milestone back to the SAME coder, which carries on from its saved work. --defer also
    records that the developer approved leaving those criteria undone (see `orch defer`)."""
    defer = None
    if "--defer" in args:
        i = args.index("--defer")
        defer = args[i + 1] if len(args) > i + 1 else die("--defer needs criteria ids, for example AC2 or AC2,AC3")
        del args[i:i + 2]
    need(args, 2, "answer <Mn> [--defer AC2,AC3] <answer text>")
    tid, text = args[0], " ".join(args[1:]).strip()
    with state_lock():
        st = load()
        t = task(st, tid)
        if t["status"] != "paused":
            die(f"{tid} is {t['status']}, not paused" + (
                " — its questions are in plan.md: answer them under \"Notes from user\", set \"Open questions:\" to "
                "`- none`, then `orch sync`" if t["status"] == "needs-answer" else "")
                + (f" (to record the approved deferral anyway: `orch defer {tid} {defer} \"<reason>\"`)" if defer else ""))
        ids = parse_defer_ids(tid, defer) if defer else []
        add_plan_note(tid, text)
        if ids:
            record_deferral(t, tid, ids, text)
            add_plan_note(tid, defer_note(t, ids, text))
        last = t.get("last_worker")
        t["go"] = True
        t["go_ts"] = now()
        if last in st["workers"]:
            t["assign"] = last
        t.setdefault("answers", []).append({"ts": now(), "text": text, **({"deferred": ids} if ids else {})})
        story_note(st, f"{tid} ({t['title']}) got the answer \"{text[:200]}\" and goes back to "
                       f"{last or 'the next free coder'}" + (f"; {', '.join(ids)} left undone, as you approved" if ids else ""))
        _park(st, tid, "pending", f"answered: {text[:200]}")      # saves the state
        print(f"ANSWERED {tid}: written to plan.md; it goes back to {last or 'the next free coder'} with its work so far")
        if ids:
            print(f"DEFERRED {tid} {','.join(ids)}: no fix rounds for them; the summary lists them as not done (follow-up)")
    print(start_manager())
    print("You will be woken with `orch events` when something needs you. Stop here; do not poll.")


def cmd_fix(args):
    """orch fix Mn <what should change> [--to <worker>] -> a small follow-up milestone for something Mn built, sent
    straight to the coder who built Mn. No new planning round: the check, the review (when Mn had one) and the
    summary still apply. Works after ALL_DONE and while a run is going; the developer or the lead may run it."""
    to = None
    if "--to" in args:
        i = args.index("--to")
        to = args[i + 1] if len(args) > i + 1 else die("--to needs a value")
        del args[i:i + 2]
    need(args, 2, "fix <Mn> <what should change> [--to <worker>]")
    tid, text = args[0], " ".join(" ".join(args[1:]).split())
    if not text:
        die("say what should change: orch fix <Mn> \"<what should change>\"")
    with state_lock():
        st = load()
        t = task(st, tid)
        if t["status"] != "merged":
            die(f"{tid} is {t['status']}, not landed yet — `orch fix` is for work that already landed"
                + (f" (a paused milestone takes `orch answer {tid} \"<text>\"`)" if t["status"] == "paused" else ""))
        if to and to not in st["workers"]:
            die(f"unknown worker {to!r} — workers: {', '.join(st['workers'])}")
        plan = ORCH / "plan.md"
        _, ptasks = parse_plan(plan.read_text())
        src = next((x for x in ptasks if x["id"] == tid), None)
        if src is None:
            die(f"{tid} not found in plan.md")
        nums = [int(k[1:]) for k in list(st["tasks"]) + [x["id"] for x in ptasks]]
        new = f"M{max(nums) + 1}"
        built = [a.get("agent") for a in t.get("attempts") or [] if a.get("kind") == "coder" and a.get("agent")]
        who = to or next((w for w in (t.get("worker"), t.get("last_worker"), *reversed(built)) if w in st["workers"]), None)
        title = f"Fix for {tid}: {text[:60]}" + ("..." if len(text) > 60 else "")
        review = field(src, "review", "no")
        sec = [f"## [x] {new}: {title}", f"Depends on: {tid} (a fix to what {tid} built)",
               f"Why separate: a change the developer asked for after {tid} landed.", f"Review: {review}",
               "Estimate: none"]
        if field(src, "role"):
            sec.append(f"Role: {field(src, 'role')}")
        if field(src, "likely files"):
            sec.append(f"Likely files: {field(src, 'likely files')}")
        if t.get("tier"):
            sec += [f"Tier: {t['tier']}", f"Model why: a fix to {tid}, for the coder who built it."]
        sec += [f"Goal: {text}", f"Why: the developer asked for this after {tid} landed.", "Acceptance criteria:",
                f"- {text}", f"- nothing else that {tid} built changes, and the check command passes",
                "Open questions:", "- none", ""]
        body = plan.read_text()
        plan.write_text(body.rstrip("\n") + "\n\n" + "\n".join(sec))
        st["order"].append(new)
        st["tasks"][new] = {
            "title": title, "deps": [tid], "prefer": "any",
            "review": review.lower().startswith("y") and st.get("reviewer") is not None,
            "status": "pending", "reason": f"fix for {tid}", "worker": None, "dir": None, "attempt": 0, "fix": 0,
            "review_round": 0, "wait": None, "files": list(t.get("files") or []), "parallel": False,
            "tier": t.get("tier"), "needs": [], "model_why": f"a fix to {tid}, for the coder who built it." if t.get("tier") else "",
            "go": True, "fix_of": tid, "role": field(src, "role"),
        }
        if who:
            st["tasks"][new]["assign"] = who
        story_note(st, f"{new} added: a follow-up to {tid} (\"{text[:200]}\"), sent to {who or 'the next free coder'}")
        save(st)
        print(f"FIX {new} \"{title}\" -> {who or 'the next free coder (nobody on the team built ' + tid + ')'}; "
              f"added to plan.md, the check" + (" and the review" if st["tasks"][new]["review"] else "") + " still run")
    print(start_manager())
    print(f"It lands like any milestone: `orch status` shows {new}, and the summary is written again when it is in.")


EVENT_HELP = {
    "paused": "a coder's question, or an agent that stopped. A question only the developer can settle: ask them, "
              "then `orch answer {t} \"<their answer>\"`. If they approve building the rest and leaving a criterion undone, add `--defer AC<n>` so it costs no fix rounds. An agent problem: tell the developer what to look at, then "
              "`orch dispatch {t}`.",
    "failed": "still failing after its rounds. Read the last report and check or review output, add the missing "
              "FACT or constraint to the plan (never a how-to), then `orch dispatch {t}` (add `--tier high` or "
              "`--to <worker>` to give it a stronger model). If a criterion can't be met (a missing outside API) and the developer approves leaving it out: `orch defer {t} AC<n> \"<their reason>\"`, then `orch dispatch {t}`.",
    "held": "risky changes wait for the developer: show them the reasons; they run `orch approve {t}`. Never approve it yourself.",
    "needs-answer": "open questions in plan.md: ask the developer, write the answers under \"Notes from user\", set "
                    "\"Open questions:\" to `- none`, `orch sync`, then `orch dispatch {t}`.",
    "merged": "landed on the feature branch. Nothing to do unless it unlocked work listed under READY.",
    "ready": "milestones are ready for you: `orch dispatch <Mn>...`.",
    "escalated": "moved to a stronger model after its rounds ran out. Nothing to do.",
    "auto-dispatched": "already started by the event manager (the reason is on the line above). Nothing to do.",
    "reviewer-lost": "the reviewer can't be reached, so the milestone waits for review (its work is kept). Tell the "
                     "developer the fix in the event text (usually: rename the reviewer's new pane). Review resumes "
                     "by itself once herdr finds the reviewer again.",
    "worker-lost": "a coder vanished while it worked (pane closed, agent quit, herdr restarted). Its milestone "
                   "waits for the next free coder with the work so far. This is NOT routine: tell the developer at "
                   "once, with the exact fix from the event text (`orch resume` or `orch team up`). If the developer "
                   "does not want that coder any more: `orch bench <worker> off`.",
    "herdr-restart": "most agents vanished at once: herdr was probably restarted or closed. Tell the developer to "
                     "run `orch resume` (it names the panes again and re-sends the work); then `orch team up` for "
                     "any agent it reports LOST.",
    "all_done": "every milestone landed. Finish .orchestrate/summary.md: the steps (section 3, ALL_DONE) are printed below.",
    "stopped": "the event manager stopped. Tell the developer why; they run `orch resume` (or `orch autopilot`).",
    "finished": "the developer ran `orch finish`. Post the MANUAL TESTS list printed below in your chat, numbered and "
                "word for word, under \"Try these by hand before you merge\" (or say there is nothing to try by hand). "
                "Add nothing else to the run.",
}


def say_line(st, e):
    """The event in plain words, for the developer: the lead says it in its chat, and `orch story` keeps it."""
    tid, text = e.get("task"), (e.get("text") or "").strip()
    t = st["tasks"].get(tid or "", {})
    name = f"{tid} ({t.get('title', '')})" if tid else ""
    k = e["kind"]
    if k == "merged":
        how = "its check passed" + (" and the reviewer approved it" if t.get("review") else "")
        return f"{name} is done: {how}, and it is on {st['branch']}."
    if k == "ready":
        ids = re.findall(r"M\d+", text)
        return ("Ready to start: " + ", ".join(f"{i} ({st['tasks'][i]['title']})" if i in st["tasks"] else i
                                                for i in ids) + ".")
    if k == "auto-dispatched":
        m = re.search(r"as soon as (.+?) landed", text)
        return (f"{name} has started by itself, because {m.group(1)} landed." if m else
                f"{name} has started by itself: {text}.")
    if k == "paused":
        if "?" in text and not text.startswith(("orch error", "result file", "review output")):
            return f"{name} is paused: the coder asks: {text}"
        return f"{name} is paused: {text}."
    if k == "failed":
        return f"{name} failed: {text}."
    if k == "held":
        return f"{name} is finished but waits for your OK, because it has a risky change: {text}."
    if k == "needs-answer":
        return f"{name} can't start yet: the plan has open questions only you can answer."
    if k == "escalated":
        return f"{name} moved to a stronger model: {text}."
    if k == "reviewer-lost":
        return f"The reviewer can't be reached, so {name} waits for its review: {text}"
    if k == "worker-lost":
        return f"A coder disappeared while working on {name}: {text}"
    if k == "herdr-restart":
        return f"Most agents disappeared at once (herdr was probably restarted): {text}"
    if k == "all_done":
        return f"Every milestone is done: {text}."
    if k == "stopped":
        return f"The event manager stopped: {text}."
    if k == "finished":
        return f"The run is finished: {text}."
    return f"{k} {name}: {text}".strip()


def story_lines(st):
    """The run diary: every event in plain words, and what the lead did, in time order."""
    items = [(e["ts"], "event", say_line(st, e)) for e in st.get("lead_events", [])]
    items += [(n["ts"], n.get("who", "lead"), n["text"]) for n in st.get("story", [])]
    return [f"{time.strftime('%H:%M', time.localtime(ts))}  {'what happened' if who == 'event' else 'the ' + who + ' did'}: {txt}"
            for ts, who, txt in sorted(items, key=lambda x: x[0])]


def write_story(st):
    lines = story_lines(st)
    with contextlib.suppress(OSError):
        (ORCH / "story.md").write_text(f"# Run diary: {st.get('title') or st['branch']} ({st['branch']})\n\n"
                                       "What happened, in plain words, and what the lead did about it. "
                                       "`orch story` prints it; the detail is in autopilot.log.\n\n"
                                       + "".join(f"- {l}\n" for l in lines))
    return lines


def cmd_story(args):
    """orch story -> the run diary in plain words (also saved as .orchestrate/story.md)."""
    st = load()
    lines = write_story(st)
    print(f"RUN DIARY: {st.get('title') or st['branch']} ({st['branch']})")
    print("\n".join(lines) if lines else "Nothing yet: the diary fills as the run goes (events go to the lead only "
                                          "with a `Lead:` line in the plan).")


def _short_dur(s):
    s = int(s or 0)
    return (f"{s // 3600}h{s % 3600 // 60:02d}m" if s % 3600 // 60 else f"{s // 3600}h") if s >= 3600 else f"{max(1, s // 60)}m"


def plan_steps(st, tids):
    """The plan's shape for a person: which milestones start together, step by step (a milestone starts once
    everything it depends on has landed). Milestones that already landed count as done."""
    level = {}

    def lv(tid, seen=()):
        if tid not in level:
            deps = [d for d in st["tasks"][tid]["deps"] if d in tids and d not in seen]
            level[tid] = 1 + max((lv(d, seen + (tid,)) for d in deps), default=0)
        return level[tid]
    for tid in tids:
        lv(tid)
    return [[t for t in tids if level[t] == n] for n in range(1, max(level.values(), default=0) + 1)]


def cmd_plan(args):
    """orch plan show -> the plan for a person: one short card per milestone in plain words (from each milestone's
    `Plain:` line), what it waits for and why, who builds it on which model, how long it should take, and which
    milestones run together. plan.md keeps every detail; this is the part a developer reads."""
    if args[:1] != ["show"]:
        die("usage: orch plan show")
    st = load()
    tids = [t for t in st["order"] if st["tasks"][t]["status"] != "skipped"]
    print(f"PLAN in plain words: {st.get('title') or st['branch']} — {len(tids)} milestone(s) on {st['branch']}"
          + (f", about {_short_dur(st['estimate_s'])} in all" if st.get("estimate_s") else ""))
    missing = []
    for tid in tids:
        t = st["tasks"][tid]
        plain = (t.get("plain") or "").strip()
        if not plain:
            missing.append(tid)
        print(f"\n{tid} {t['title']}" + (f" — {plain}" if plain else ""))
        if t.get("why_sep") and len(tids) > 1:
            print(f"   Why its own step: {t['why_sep']}")
        deps = [d for d in t["deps"]]
        if deps:
            why = re.sub(r"^(M\d+[\s,]*)+", "", t.get("deps_text") or "").strip(" ()") if len(deps) == 1 else ""
            m = re.findall(r"M\d+\s*\(([^)]*)\)", t.get("deps_text") or "")
            why = "; ".join(m) or why
            print(f"   Waits for: {', '.join(deps)}" + (f" ({why})" if why else ""))
        else:
            print("   Waits for: nothing, it can start first")
        who = []
        for n in eligible_workers(st, t):
            w = st["workers"][n]
            who.append(f"{n} ({w['model']})" if w.get("model") else n)
        bits = [f"Built by: {' or '.join(who) if who else 'the next free coder'}"]
        if t.get("tier"):
            bits.append(f"{t['tier']} model")
        if t.get("estimate_s"):
            bits.append(f"about {_short_dur(t['estimate_s'])}")
        bits.append(f"reviewed by {st['reviewer']}" if t.get("review") and st.get("reviewer") else "no review")
        print("   " + " · ".join(bits))
        if t.get("door") == "one-way":
            print("   Hard to undo" + (f": {t['door_why']}" if t.get("door_why") else "") + ". It waits for your OK "
                  f"(`orch approve {tid}`) before it lands, with the coder's proof that it is safe.")
        if t["status"] != "pending":
            now_ = {"merged": "done, on the branch", "coding": "being built", "verifying": "being checked",
                    "awaiting-review": "waiting for the reviewer", "reviewing": "being reviewed",
                    "reviewed": "reviewed, landing next", "committed": "landing", "needs-fix": "being fixed",
                    "paused": "paused", "failed": "failed", "held": "waiting for your OK",
                    "needs-answer": "waiting for your answer"}.get(t["status"], t["status"])
            print(f"   Now: {now_}" + (f" ({t['reason']})" if t.get("reason") and t["status"] != "merged" else ""))
    steps = plan_steps(st, tids)
    if len(tids) > 1:
        print("\nOrder:")
        for i, g in enumerate(steps, 1):
            print(f"  {i}. {' and '.join(g)}" + (" at the same time" if len(g) > 1 else "")
                  + ("" if i == 1 else f" (after {' and '.join(steps[i - 2])})"))
    if st.get("glossary_additions"):
        print(f"\nNew words this feature adds to {docs_root(st)[1]}/glossary.md:")
        for g in st["glossary_additions"]:
            print(f"  - {g}")
    if missing:
        print(f"\nWARN no `Plain:` line for {', '.join(missing)}: add one sentence in plain words to each "
              f"(what the developer will get, no code words), then `orch sync`.")
    print("\nEvery detail (files, criteria, models, notes) stays in .orchestrate/plan.md.")


def cmd_events(args):
    """orch events [--peek] -> what the lead was woken for. Reading the events acknowledges them (not with --peek)."""
    peek = "--peek" in args
    with state_lock():
        st = load()
        if not lead_on(st):
            print("This run has no lead events (plan header: `Lead: lead (<kind>)`, and not `Lead mode: off`).")
            return
        new = unread_events(st)
        old = [e for e in st["lead_events"] if e.get("read") and e["kind"] in LEAD_BLOCKING and event_open(st, e)]

        def show(e):
            tt = st["tasks"].get(e.get("task") or "", {})
            head = f"#{e['id']} {e['kind'].upper()}" + (f" {e['task']} \"{tt.get('title', '')}\"" if e.get("task") else "")
            print(head + (f": {e['text']}" if e.get("text") else ""))
            print("    -> " + EVENT_HELP.get(e["kind"], "").format(t=e.get("task") or "<Mn>"))
            print("    SAY: " + say_line(st, e))
            if e.get("task") and e["kind"] in LEAD_BLOCKING and (vu := view_url(e["task"])):
                print(f"    SEE: {vu}   (give the developer this link with the SAY line)")
            if e["kind"] == "finished":
                print("\n".join("    " + x for x in manual_block(st)[0]))
        print(f"EVENTS for the lead — run {st['branch']}: {len(new)} new, {len(old)} still open")
        for e in new:
            show(e)
        if old:
            print("STILL OPEN (you have seen these; they close when the milestone moves on):")
            for e in old:
                show(e)
        hold = undispatched(st)
        if hold:
            print("READY — waiting for your dispatch:")
            for tid in hold:
                t = st["tasks"][tid]
                print(f"  {tid} \"{t['title']}\"" + (f" tier {t['tier']}" if t.get("tier") else "")
                      + f" -> {' or '.join(eligible_workers(st, t))}:  orch dispatch {tid}")
        free = [n for n, w in st["workers"].items() if not w.get("task")]
        print("WORKERS: " + ", ".join(
            f"{n} ({w['kind']}" + (f": {w['model']}, {w.get('tier') or 'unrated'}" if w.get("model") else "") + ")"
            + (" free" if n in free else f" on {w['task']}") for n, w in st["workers"].items()))
        print("event manager: " + (driver_line(driver_info()) if driver_alive() else
                                   "NOT running — your next `orch dispatch` or `orch answer` starts it"
                                   + (" (work is in progress: run `orch resume` now)" if needs_manager(st) else "")))
        if not new and not old and not hold:
            print("Nothing needs you.")
        kinds = list(dict.fromkeys([e["kind"] for e in new + old] + (["ready"] if hold else [])))
        pb = asset("playbooks/run.md") if kinds else None
        if pb:                                   # the playbook's own words for these events: a wake-up never needs
            text = pb.read_text()                # `orch lead run` again, even after the lead's context was compacted
            print("\nWHAT TO DO (from `orch lead run`; you need no other part of the playbook for these events):")
            print(run_playbook_part(text, "rules"), end="")
            rows = "".join(run_playbook_part(text, k) for k in kinds if k != "all_done")
            if rows:
                print("| Event | What you do |\n|---|---|\n" + rows, end="")
            if "all_done" in kinds:
                print("\n" + run_playbook_part(text, "ALL_DONE"), end="")
        print("Handle each event above, then STOP: you are woken again when something else happens. Never prompt a "
              "coder yourself and never poll.")
        if new or old:
            print("BEFORE YOU STOP, tell the developer in your chat, one short line per event: its SAY line, then what "
                  "you did about it (or \"nothing for me to do\"). Never end a wake-up without saying it.")
        if not peek and new:
            for e in new:
                e["read"] = now()
            if st.get("lead_wake"):
                st["lead_wake"]["read_ts"] = now()        # for the event manager's timing line
            save(st)
            write_story(st)


def cmd_escalate(args):
    """orch escalate Mn [reason] -> a milestone out of rounds gets one more go on a stronger model, if the team has
    one (exit 3: nothing stronger, or it was escalated before)."""
    need(args, 1, "escalate <Mn> [reason]")
    tid, reason = args[0], " ".join(args[1:])
    st = load()
    t = task(st, tid)
    cur = rank(st["workers"].get(t.get("worker") or t.get("last_worker") or "", {}).get("tier"))
    above = sorted({rank(w.get("tier")) for w in st["workers"].values()} - set(range(0, max(cur, need_rank(t)) + 1)))
    if t.get("escalated") or not cur or not above:
        print(f"NO_ESCALATION {tid}")
        sys.exit(3)
    tier = TIERS[above[0] - 1]
    t.update(escalated=True, min_tier=tier, fix_base=t.get("fix", 0), review_base=t.get("review_round", 0))
    t.pop("assign", None)
    why = f"escalated to a {tier}-tier model: {reason}" if reason else f"escalated to a {tier}-tier model"
    _park(st, tid, "pending", why)
    lead_event(st, "escalated", tid, why)
    save(st)
    print(f"ESCALATED {tid} -> {tier}")


def cmd_nudge(args):
    """orch nudge Mn -> re-send the current prompt once; exit 3 if already nudged."""
    need(args, 1, "nudge <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    w = t.get("wait") or die(f"{tid} is not waiting on anyone")
    if w.get("nudges", 0) >= 1:
        print(f"ALREADY_NUDGED {tid}")
        sys.exit(3)
    try:
        deliver(st, w["agent"], "You stopped before finishing. " + w["prompt"])
    except DeliveryError as e:
        die(f"could not nudge {w['agent']}: {e}")
    _delivered(st, w["agent"])
    w["nudges"] = w.get("nudges", 0) + 1
    w["since"] = now()
    save(st)
    print(f"NUDGED {tid} -> {w['agent']}")


def auto_checked(st, final_ok):
    """What the run already verified without a person, for the summary: the check command, the reviews, and each
    acceptance criterion with the coder's and the reviewer's evidence. The lead builds on this, so the manual
    checklist holds only what a person must look at. Only recorded facts; a criterion nobody gave evidence for says so."""
    try:
        _, ptasks = parse_plan((ORCH / "plan.md").read_text())
    except OSError:
        ptasks = []
    out = [f"- Check command `{st['check']}` on the finished branch: {'PASS' if final_ok else 'FAIL'}"]
    for tid in st["order"]:
        t = st["tasks"][tid]
        if t["status"] != "merged":
            continue
        pt = next((x for x in ptasks if x["id"] == tid), {"fields": {}})
        crit = [v.lstrip("- ").strip() for v in pt["fields"].get("acceptance criteria", [])]
        crit = [v for v in crit if v and v.lower() != "none"]
        res, _ = read_result(t.get("last_result"))
        coder = {str(c.get("id")): c for c in (res or {}).get("criteria", []) if isinstance(c, dict)}
        k = t.get("review_round", 0)
        rev, _ = read_json(ORCH / "review" / tid / f"review-{k}.json") if k else (None, None)
        rcrit = rev.get("criteria", []) if isinstance(rev, dict) and isinstance(rev.get("criteria", []), list) else []
        reviewer = {str(c.get("id")): c for c in rcrit if isinstance(c, dict)}
        passed = sum(1 for c in t.get("checks") or [] if c.get("ok"))
        out.append(f"- {tid} \"{t['title']}\": check command passed" + (f" {passed}x" if passed > 1 else "")
                   + (f"; review passed (round {k})" if t.get("review") and k else "; no review planned"))
        for i, text in enumerate(crit, 1):
            cid, ev = f"AC{i}", []
            c, r = coder.get(cid), reviewer.get(cid)
            if c and c.get("met") is not None:
                ev.append(f"coder: {'met' if c['met'] else 'NOT met'}" + (f" ({c['evidence']})" if c.get("evidence") else ""))
            if r and r.get("met") is not None:
                ev.append(f"reviewer: {'met' if r['met'] else 'NOT met'}" + (f" ({r['note']})" if r.get("note") else ""))
            dv = deferred_of(t).get(cid)
            if dv and not (c and c.get("met")):
                out.append(f"  - {cid} {text} — DEFERRED, NOT done (approved by the developer: {dv.get('reason', '')}). "
                           f"See \"Deferred: not done, follow-ups\"")
                continue
            out.append(f"  - {cid} {text} — " + ("; ".join(ev) if ev else "no evidence recorded: the lead checks it, "
                                                 "or it goes on the manual list"))
    return "\n".join(out)


def deferred_lines(st):
    """The summary's list of criteria the developer approved leaving undone: each is NOT done and needs a follow-up.
    A deferred criterion the coder reports as met after all is left out (it was done)."""
    out = []
    for tid in st["order"]:
        t = st["tasks"][tid]
        dfr = deferred_of(t)
        if not dfr:
            continue
        res, _ = read_result(t.get("last_result"))
        met = {str(c.get("id")) for c in (res or {}).get("criteria", []) if isinstance(c, dict) and c.get("met")}
        for cid, v in dfr.items():
            if cid in met:
                continue
            out.append(f"- {tid} {cid} \"{v.get('text', '')}\": NOT done. Approved by the developer: "
                       f"{v.get('reason', '')}. Follow-up: when it can be built, `orch fix {tid} \"{v.get('text', '')}\"`")
    return out


RATE_RE = re.compile(r"usage limit|rate.?limit|quota|too many requests|\b429\b|limit reached|try again (in|at)|out of credits",
                     re.I)


class _Stop(BaseException):
    """`orch stop` (or a closed terminal) asked the event manager to stop: unwinds to cmd_autopilot."""


_STOP = {"asked": None, "child": None}


def _on_stop_signal(signum, _frame):
    """First signal: stop at the next safe point (a running `orch poll` is ended, as it only waits). Second: now."""
    why = "terminal closed (SIGHUP)" if signum == getattr(signal, "SIGHUP", None) else "SIGTERM"
    try:
        req = json.loads((ORCH / "stop.request").read_text())
        if now() - req.get("ts", 0) < 120:
            why = "orch stop" + (" --now" if req.get("now") else "")
    except (OSError, ValueError):
        pass
    again = _STOP["asked"] is not None
    _STOP["asked"] = why
    child = _STOP["child"]
    if child is not None and child[0].poll() is None and (again or child[1] == "poll"):
        with contextlib.suppress(OSError):
            child[0].terminate()
    if again:
        raise _Stop()


def _stop_point():
    if _STOP["asked"]:
        raise _Stop()


def cmd_autopilot(args):
    """The event manager (see _autopilot). This wrapper records how it ends: every stop writes a last line to
    autopilot.log, a Python error writes the traceback, and a manager that was killed without a word (memory guard,
    a crash of the whole terminal) is found by the next one, which looks up why in the computer's own log."""
    with contextlib.suppress(OSError, ValueError):
        if STATE.exists() and run_mode(json.loads(STATE.read_text())) == "subagent":
            die("this run is in subagent mode: there is no event manager; the lead drives it with `orch sub next`")
    take_lease()
    if STATE.exists():
        manager_begin()
    tag = run_tag() if STATE.exists() else f"[{ROOT.name}]"
    with contextlib.suppress(ValueError, OSError):
        signal.signal(signal.SIGTERM, _on_stop_signal)
        signal.signal(signal.SIGHUP, _on_stop_signal)

    def ended(how, detail=""):
        nonlocal tag
        if STATE.exists():
            tag = run_tag()
        with contextlib.suppress(BaseException):
            with state_lock():
                s_ = load()
                m = s_["run"].get("manager") or {}
                if m.get("pid") == os.getpid():
                    m["ended"] = {"ts": now(), "how": how, "reason": detail[:300]}
                    s_["run"]["manager"] = m
                    save(s_)
    try:
        _autopilot(args)
        ended("finished")
        log_line(f"{tag} STOPPED: the event manager finished")
    except _Stop:
        why = _STOP["asked"] or "stop"
        ended("stopped", why)
        log_line(f"{tag} STOPPED: {why} — nothing is lost; `orch resume` starts it again")
        print(f"STOPPED ({why})", flush=True)
        with contextlib.suppress(OSError):
            (ORCH / "stop.request").unlink()
        sys.exit(0)
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
        unwoken = ""
        with contextlib.suppress(BaseException):
            unwoken = lead_unwoken(load()) if STATE.exists() else ""
        ended("exit", f"exit {code}" + (f"; {unwoken}" if unwoken else ""))
        log_line(f"{tag} STOPPED: " + ("the event manager finished the run (exit 0)" if code == 0 else
                                       f"the event manager exited (code {code}); the line above says why")
                 + (f" — but {unwoken}" if unwoken else ""))
        if unwoken and shutil.which("notify-send"):
            subprocess.run(["notify-send", "orch autopilot", f"{tag} {unwoken}"], capture_output=True)
        raise
    except KeyboardInterrupt:
        ended("stopped", "Ctrl-C")
        log_line(f"{tag} STOPPED: Ctrl-C")
        raise
    except BaseException as e:
        import traceback
        tb = traceback.format_exc()
        ended("crashed", f"{type(e).__name__}: {e}")
        log_line(f"{tag} CRASHED: {type(e).__name__}: {e}")
        for l in tb.rstrip().splitlines()[-40:]:
            log_line(f"{tag}   {l}")
        if shutil.which("notify-send"):
            subprocess.run(["notify-send", "orch autopilot", f"{tag} CRASHED: {type(e).__name__}: {e}"],
                           capture_output=True)
        raise


def lead_unwoken(st):
    """The event manager is leaving: if the lead still has unread events, one line that says so and why (it was never
    woken because herdr can't find it, or it did not read the wake-ups), with what to do. "" when all is read."""
    if not lead_on(st):
        return ""
    un = unread_events(st)
    if not un:
        return ""
    name, lw = st["lead"]["name"], st.get("lead_wake") or {}
    gone = lead_missing(st) if lw.get("gone") or not lw.get("n") else None
    what = ", ".join(dict.fromkeys(e["kind"].upper() + (f" {e['task']}" if e.get("task") else "") for e in un[:6]))
    if gone or lw.get("gone"):
        return (f"the lead `{name}` was never woken ({gone or 'herdr could not find it'}): {len(un)} event(s) wait "
                f"for it ({what}). Name the lead's pane (herdr agent rename <its pane id> {name}), then `orch resume` "
                f"wakes it; `orch events --peek` shows them")
    return (f"the lead `{name}` has not read {len(un)} event(s) ({what}) — tell it: run `orch events`")


def manager_begin():
    """The event manager starting: report a predecessor that died without a word, then record this one (pid, host,
    this run's processes) so the next one can do the same for it. Safe to call twice."""
    with state_lock():
        st = load()
        m = st["run"].get("manager") or {}
        if m.get("pid") == os.getpid():
            return
        dead = note_dead_manager(st, save_it=False, starting=True)
        if dead:
            print(dead, flush=True)
            if shutil.which("notify-send"):
                subprocess.run(["notify-send", "orch autopilot", dead.splitlines()[0]], capture_output=True)
        st["run"]["manager"] = {"pid": os.getpid(), "host": socket.gethostname(), "started": now(),
                                "scope": os.environ.get("ORCH_SCOPE") or None, **run_processes(st)}
        save(st)


def _autopilot(args):
    """The event manager: a plain script that watches the agents, runs checks, sends fixes and reviews, merges, and
    wakes the lead when something needs a decision. It is the only driver of a run: it holds the driver lease, and
    other processes can't change the run meanwhile (the lead's `orch dispatch` / `orch answer` are requests it
    carries out). Without a lead (`Lead mode: off`) it dispatches by itself and stops (exit 3) when a human is needed."""
    me = [sys.executable, os.path.abspath(__file__)]
    if os.environ.get("ORCH_FAULT") == "autopilot-error":
        raise ValueError("test crash")             # test hook: a Python error inside the event manager

    def say(msg, important=False):
        print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)
        log_line(msg)
        if important and shutil.which("notify-send"):
            subprocess.run(["notify-send", "orch autopilot", msg], capture_output=True)

    def run(*a, ok=(0,)):
        _stop_point()
        p = subprocess.Popen(me + [str(x) for x in a], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _STOP["child"] = (p, str(a[0]))
        try:
            so, se = p.communicate()
        finally:
            _STOP["child"] = None
        r = subprocess.CompletedProcess(p.args, p.returncode, so, se)
        _stop_point()                    # `orch stop` came while it ran: the step is done, stop here
        out = (r.stdout + r.stderr).strip()
        if r.returncode not in ok:
            raise RuntimeError(f"orch {' '.join(str(x) for x in a)} -> exit {r.returncode}: {out}")
        if r.returncode == 0 and a[0] in ("send", "review"):
            # a job just started: tell herdr's sidebar now, not at the next round (a short review could be missed)
            with contextlib.suppress(NameError):
                if names:
                    names.update(load())
        return r.returncode, out

    def patch_state(fn):
        with state_lock():
            s_ = load()
            fn(s_)
            save(s_)

    def check(cwd, tid=None, where="worktree"):
        ok, tail, secs = run_check(st, cwd)
        patch_state(lambda s_: note_green(s_, cwd, ok))
        if tid:
            patch_state(lambda s_: s_["tasks"][tid].setdefault("checks", []).append(
                {"where": where, "ok": ok, "secs": secs, "ts": now()}))
        return ok, tail

    def park(tid, status, reason, important=True, lost=False):
        run("park", tid, status, *(["--lost"] if lost else []), reason)
        t_ = load()["tasks"][tid]
        if t_["status"] == "failed" and status != "failed":
            say(f"{tid} failed: {t_.get('reason')}", True)
        else:
            say(f"{tid} {status}: {reason}", important)

    def fail(tid, reason):
        """Out of rounds: one more go on a stronger model when the team has one, else failed (the lead hears of it)."""
        code, out = run("escalate", tid, reason, ok=(0, 3))
        if code == 0:
            say(f"{tid}: {reason} -> {out.split('->')[-1].strip()}-tier model gets one fresh round, with the work so far", True)
        else:
            park(tid, "failed", reason)

    def wake_lead(force=False):
        """Tell the lead it has unread events, and make sure the wake-up became a turn. Sending the prompt proves
        nothing: it can sit in the pane's input box or collide with what the developer is typing. Only the lead
        reading its events (`orch events`) counts. A lead that is idle again with the events still unread did not
        pick the wake-up up, so it is sent again: after LEAD_CONFIRM_S, then twice that, and so on (never longer
        than LEAD_REWAKE_S), up to LEAD_MAX_WAKES; then the developer is told. A lead herdr can't watch is woken
        again every LEAD_REWAKE_S. The events themselves are already safe in state.json."""
        s_ = load()
        if not lead_on(s_):
            return
        un = unread_events(s_)
        lw = s_.get("lead_wake") or {}
        lead = s_["lead"]["name"]
        if not un:
            if lw.get("n") and not lw.get("ack"):
                patch_state(lambda s2: s2.update(lead_wake={**(s2.get("lead_wake") or {}), "ack": True}))
                rt, first = lw.get("read_ts"), lw.get("first_ts") or lw.get("ts")
                say(f"the lead ({lead}) picked up its events" + (
                    f" (read {max(0, rt - first)}s after the first wake-up, {max(0, rt - lw['oldest'])}s after the "
                    f"oldest event; seen here {max(0, now() - rt)}s later)" if rt and first and lw.get("oldest") else ""))
            return
        newest = max(e["id"] for e in un)
        # a wake the lead has not acted on yet covers newer events too: it reads the whole queue when it comes
        same = any(e["id"] <= lw.get("upto", 0) for e in un)
        n = lw.get("n", 0) if same else 0
        if same and now() - lw.get("ts", 0) < lw.get("wait", LEAD_REWAKE_S):
            return
        watch = watched(s_, lead)
        if watch and not force:
            hs = herdr_state(lead)
            if hs is None:
                if not lw.get("gone"):
                    patch_state(lambda s2: s2.update(lead_wake={**(s2.get("lead_wake") or {}), "gone": True}))
                    say(f"the lead ({lead}) is not in herdr — start it and name it `{lead}`; {len(un)} event(s) wait "
                        f"for it (`orch events --peek` shows them)", True)
                return
            if word(hs, "working", "blocked"):
                return                                # in a turn: the events wait in the queue, one wake when it is idle
        if n >= LEAD_MAX_WAKES:
            if not lw.get("told"):
                patch_state(lambda s2: s2["lead_wake"].update(told=True))
                say(f"the lead ({lead}) has not read its events after {LEAD_MAX_WAKES} wake-ups — look at its pane "
                    f"(if the wake-up text sits in its input box, press Enter), or tell it: run `orch events`. "
                    f"{len(un)} event(s) wait for it (`orch events --peek` shows them)", True)
            return
        text = (f"orch: {len(un)} new event(s) in the run on {s_['branch']} need the lead. Run `orch events` and "
                f"handle what it prints, then stop.")
        try:
            deliver(s_, lead, text)
        except DeliveryError as e:
            say(f"could not wake the lead ({lead}): {e} — will retry; the events are kept")
            gone = bool(lw.get("gone")) or "not_found" in str(e) or "not found" in str(e)   # herdr has no such agent
            patch_state(lambda s2: s2.update(lead_wake={"upto": newest, "ts": now(), "n": n, "wait": SEND_RETRY_S,
                                                        **({"gone": True} if gone else {})}))
            return
        wait = min(LEAD_REWAKE_S, LEAD_CONFIRM_S * 2 ** n) if watch else LEAD_REWAKE_S
        oldest = min(e["ts"] for e in un)
        first_ts = lw.get("first_ts", lw.get("ts")) if n else now()
        patch_state(lambda s2: s2.update(lead_wake={"upto": newest, "ts": now(), "n": n + 1, "wait": wait,
                                                    "first_ts": first_ts, "oldest": oldest}))
        what = ", ".join(f"{e['kind']}{' ' + e['task'] if e.get('task') else ''}" for e in un[:6])
        if n:
            say(f"the lead ({lead}) did not pick up its wake-up (" + ("idle again, " if watch else "")
                + f"events still unread after {now() - lw.get('ts', now())}s) -> sent it again "
                f"({n + 1} of {LEAD_MAX_WAKES}): {len(un)} event(s) — {what}")
        else:
            say(f"woke the lead ({lead}): {len(un)} event(s) — {what} (sent; it counts once the lead reads them; "
                f"oldest event {max(0, now() - oldest)}s old)")

    def lead_ready():
        """Ready milestones the lead has not dispatched: tell it once per set; start them ourselves after LEAD_WAIT_S."""
        s_ = load()
        hold = undispatched(s_)
        if not hold:
            return
        # `Auto dispatch: on` (the default): a milestone that a landing unlocked starts at once; the lead hears of
        # it (AUTO-DISPATCHED) instead of being asked. The plan already says what it is and who may take it.
        auto = [k for k in hold if s_.get("auto_dispatch", True) and s_["tasks"][k]["deps"]
                and s_["run"].get("started")]
        late = [k for k in hold if k not in auto and now() - s_["tasks"][k].get("ready_ts", now()) > LEAD_WAIT_S]

        def upd(s2):
            for k in hold:
                s2["tasks"][k].setdefault("ready_ts", now())
            for k in auto:
                s2["tasks"][k]["go"] = True
                lead_event(s2, "auto-dispatched", k, f"started by the event manager as soon as "
                           f"{', '.join(s2['tasks'][k]['deps'])} landed (`Auto dispatch: on` in plan.md)")
            for k in late:
                s2["tasks"][k]["go"] = True
                lead_event(s2, "auto-dispatched", k, f"not dispatched by the lead within {LEAD_WAIT_S // 60} min")
            rest = [k for k in hold if k not in late and k not in auto]
            if rest and rest != s2.get("lead_ready_told"):       # once per set, not once per loop
                lead_event(s2, "ready", None, ", ".join(rest))
            s2["lead_ready_told"] = rest
        patch_state(upd)
        for k in late:
            say(f"{k}: the lead did not dispatch it within {LEAD_WAIT_S // 60} min -> started without it", True)
        for k in auto:
            say(f"{k}: {', '.join(s_['tasks'][k]['deps'])} landed, so it starts now (auto dispatch); the lead is told")

    def guarded(tid, fn):
        """One task's orch error never stops the run: that task is paused with the error, the rest carry on."""
        try:
            fn()
        except RuntimeError as e:
            first = next((l for l in str(e).splitlines() if l.strip().startswith("ERROR")), str(e).splitlines()[0])
            try:
                park(tid, "paused", f"orch error: {first.strip()[:300]}")
            except RuntimeError as e2:
                say(f"{tid}: could not park after an error — stopping.\n{e}\n{e2}", True)
                sys.exit(3)
            say(f"{tid} details:\n{e}")

    def sent(code, out, tid, who):
        if code == 5:
            t_ = load()["tasks"][tid]
            if t_["status"] == "failed":
                say(f"{tid} failed: {t_.get('reason')}\n{out}", True)
            else:
                say(f"{tid}: could not reach {who} — it is benched and the work is queued again\n{out}",
                    "BENCHED" in out)
            return False
        return True

    def write_and_send(tid, fname, body):
        d = Path(load()["tasks"][tid]["dir"]) / TASK_DIR / tid
        (d / fname).write_text(body)
        code, out = run("send", tid, fname, ok=(0, 5))
        sent(code, out, tid, "the coder")

    def fix_round(tid, fname_prefix, body, cap_reason):
        """Count a fix round (capped by MAX_FIX), then send the coder a problem-only job."""
        code, _ = run("bump", tid, "fix", ok=(0, 3))
        if code == 3:
            fail(tid, cap_reason)
            return
        n = load()["tasks"][tid]["fix"]
        write_and_send(tid, f"{fname_prefix}-{n}.md", body(n))

    def held(tid, out):
        extra = [l.strip() for l in out.splitlines() if l.startswith(("Could break:", "Proof from the coder:"))]
        say(f"{tid} is HELD for your approval: {out.splitlines()[0].split('—', 1)[-1].strip()}. "
            + "".join(f"{l}. " for l in extra) +
            f"Look at it, then run `orch approve {tid}`; autopilot keeps going with the rest", True)

    # ---- background jobs: a check or a merge runs beside the event loop, and its end is one more event (like a
    # browser's fetch: the work happens elsewhere, the callback is queued). Nothing waits for a check to finish.
    bg = {}

    def check_slots():
        return max(1, load().get("parallel_checks", 1)) - sum(1 for j in bg.values() if j["uses_check"])

    def checking(tid):
        return any(j["tid"] == tid and j["kind"] == "check" for j in bg.values())

    def bg_start(name, tid, kind, shell_cmd, cwd, uses_check, on_done, timeout=None):
        log, ex = BG_DIR / f"{name}.log", BG_DIR / f"{name}.exit"
        ex.unlink(missing_ok=True)
        q = shlex.quote
        wrapped = (f"( {shell_cmd}\n) > {q(str(log))} 2>&1; echo $? > {q(str(ex))}.tmp; "
                   f"mv {q(str(ex))}.tmp {q(str(ex))}")
        p = subprocess.Popen(["/bin/sh", "-c", wrapped], cwd=cwd, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        bg[name] = {"p": p, "tid": tid, "kind": kind, "t0": time.time(), "log": log, "exit": ex,
                    "uses_check": uses_check, "on_done": on_done, "timeout": timeout}

    def bg_reap():
        """Collect the background jobs that ended and run what each one's end means."""
        for name, j in list(bg.items()):
            secs = round(time.time() - j["t0"], 1)
            timed_out = False
            if j["p"].poll() is None and j["exit"].exists():
                with contextlib.suppress(subprocess.TimeoutExpired):
                    j["p"].wait(timeout=5)            # it wrote its exit code: it is leaving
            if j["p"].poll() is None:
                if not (j["timeout"] and secs > j["timeout"]):
                    continue
                timed_out = True
                with contextlib.suppress(OSError):
                    os.killpg(j["p"].pid, signal.SIGTERM)
                with contextlib.suppress(subprocess.TimeoutExpired):
                    j["p"].wait(timeout=30)
            try:
                code = int(j["exit"].read_text().strip())
            except (OSError, ValueError):
                code = 124 if timed_out else (j["p"].returncode or 1)
            try:
                out = j["log"].read_text(errors="replace")
            except OSError:
                out = ""
            if timed_out:
                code, out = 124, out + f"\ncheck command timed out after {j['timeout'] // 60} min"
            del bg[name]
            for f in (j["log"], j["exit"]):
                f.unlink(missing_ok=True)
            guarded(j["tid"], lambda: j["on_done"](code, out, secs))

    def bg_stop():
        """The event manager is leaving: stop the checks it started (a merge is left to finish: it is journaled)."""
        for j in bg.values():
            if j["kind"] == "check" and j["p"].poll() is None:
                with contextlib.suppress(OSError):
                    os.killpg(j["p"].pid, signal.SIGTERM)

    # ---- waits: time a finished or ready milestone sat still because something else had to happen first
    def start_wait(tid, what, behind):
        s_ = load()
        if (s_["tasks"][tid].get("waiting") or {}).get("what") == what:
            return
        patch_state(lambda s2: s2["tasks"][tid].update(waiting={"what": what, "since": now(), "behind": behind}))

    def end_wait(tid, what):
        """Close Mn's wait for `what`: add it to the milestone's waits (summary) and log it. Returns the seconds."""
        w = load()["tasks"][tid].get("waiting") or {}
        if w.get("what") != what:
            return 0
        secs = max(0, now() - w["since"])

        def upd(s2):
            t2 = s2["tasks"][tid]
            t2.pop("waiting", None)
            ws = t2.setdefault("waits", {})
            ws[what] = ws.get(what, 0) + secs
        patch_state(upd)
        if secs and what != "reviewer":           # the reviewer wait is said with the review it waited for
            say(f"{tid} waited {_fmt_secs(secs)} for {w.get('behind') or what}")
        return secs

    def start_check(tid, d):
        """Start Mn's check in its folder, in the background. False when every check slot is busy (it waits)."""
        s_ = load()
        t_ = s_["tasks"][tid]
        k = t_["attempt"]
        if not s_.get("check"):
            check_done(tid, k, d, None, 0, "", 0)
            return True
        if check_slots() <= 0:
            busy = [j["tid"] for j in bg.values() if j["uses_check"]]
            start_wait(tid, "check slot", f"{', '.join(busy)}'s check" if busy else "a free check slot")
            return False
        end_wait(tid, "check slot")
        tree0 = tree_of(d)
        patch_state(lambda s2: s2["tasks"][tid].update(checking={"since": now(), "where": "worktree"}))
        bg_start(f"check-{tid}-{k}", tid, "check", s_["check"], d, True,
                 lambda code, out, secs: check_done(tid, k, d, tree0, code, out, secs), CHECK_TIMEOUT_S)
        return True

    def check_done(tid, k, d, tree0, code, out, secs):
        ok = code == 0
        tail = "\n".join(out.splitlines()[-60:])
        tree = tree_of(d) if ok and tree0 else None

        def upd(s2):
            t2 = s2["tasks"][tid]
            t2.pop("checking", None)
            if s2.get("check"):
                t2.setdefault("checks", []).append({"where": "worktree", "ok": ok, "secs": secs, "ts": now()})
            # the tree is kept only when the check left the files as it found them: then a branch that gets exactly
            # these files needs no second check (merge_check_needed)
            t2["chk"] = {"attempt": k, "ok": ok, "tail": tail, "tree": tree if tree and tree == tree0 else None,
                         "used": False}
            note_green(s2, d, ok)
        patch_state(upd)
        if s_check := load().get("check"):
            say(f"{tid} check {'passed' if ok else 'FAILED'} in {_fmt_secs(secs)} ({s_check})")

    def early_review_ok(tid, t):
        s_ = load()
        return (s_.get("early_review", True) and bool(s_.get("check")) and bool(s_.get("reviewer"))
                and t["review"] and not t.get("review_ok") and not t.get("pre_conflict") and holds(s_, tid))

    def check_fix(tid, tail, blockers=()):
        """The check failed: one fix round for the coder that holds Mn, with the reviewer's blockers if there are."""
        code, _ = run("bump", tid, "fix", ok=(0, 3))
        if code == 3:
            fail(tid, f"checks still failing after {MAX_FIX} fix rounds")
            return
        n = load()["tasks"][tid]["fix"]
        say(f"{tid} checks failed -> fix round {n}" + (f" (with the reviewer's {len(blockers)} blocker(s))"
                                                        if blockers else ""))
        write_and_send(tid, f"fix-{n}.md",
                       f"# Checks failing for {tid} (round {n})\n\nThe check command `{st['check']}` "
                       f"failed. Diagnose the cause and fix it; you decide how. Don't change unrelated "
                       f"code, and don't weaken or skip tests to make them pass.\n\n"
                       f"```\n{tail}\n```\n"
                       + ("\nThe reviewer also found these problems in the same version (it reviewed it while the "
                          "check ran). Investigate each one too; if you think one is wrong, say why in your report:\n"
                          + "\n".join(blockers) + "\n" if blockers else ""))

    def early_followup(tid, t):
        """Mn's review was sent alongside its check (`Early review: on`). Match the two up. True when handle()
        has nothing more to do for Mn now."""
        if t.get("early") != t.get("attempt"):
            return False
        if checking(tid):
            return t["status"] == "reviewed"      # the review is back first: it waits for the check
        chk = t.get("chk") if (t.get("chk") or {}).get("attempt") == t["attempt"] else None
        if chk is None:                           # the event manager restarted while the check ran: run it again
            start_check(tid, t["dir"])
            return t["status"] == "reviewed"
        if chk["ok"]:
            if not chk.get("used"):
                patch_state(lambda s_: s_["tasks"][tid]["chk"].update(used=True))
                if holds(load(), tid):
                    _, hout = run("handoff", tid)
                    if hout.startswith("HANDED_OFF"):
                        say(f"{tid} passed its check while being reviewed; {t['worker']} is free for other work")
            return False
        if t["status"] == "reviewing":
            return True                           # check failed: wait for the review, then one fix round for both
        blockers = []
        if t["status"] == "reviewed":
            blockers, _, _ = review_findings(tid, t["review_round"])
        why = "the check failed" + (" while it was being reviewed" if t["status"] == "reviewed" else "")

        def upd(s_):
            t2 = s_["tasks"][tid]
            t2["chk"]["used"] = True
            t2["early"] = None
            t2["review_ok"] = False
            if t["status"] == "reviewed":         # that review round looked at a version that fails its check:
                t2["review_base"] = t2.get("review_base", 0) + 1   # it does not count against the review cap
            move(s_, tid, "needs-fix", why)
        patch_state(upd)
        check_fix(tid, chk["tail"], blockers)
        return True

    def land(tid):
        """Land a milestone: commit it, then merge it onto the feature branch in the background (the merge runs the
        check there unless the files are the ones already checked). One merge at a time: they all go through the
        main folder. Waits are counted (see add_wait)."""
        st_ = load()
        t_ = st_["tasks"][tid]
        if st_["isolation"] == "shared":
            if any(j["kind"] == "check" for j in bg.values()):
                return False                      # a commit in the shared folder waits for a check running in it
            code, out = run("commit", tid, ok=(0, 7))
            if code == 7:
                held(tid, out)
                return False
            say(f"{tid} landed on {st_['branch']}")
            return True
        if any(j["kind"] == "merge" and j["tid"] == tid for j in bg.values()):
            return None                           # its merge is running
        if t_["status"] != "committed":
            code, out = run("commit", tid, ok=(0, 7))
            if code == 7:
                held(tid, out)
                return False
            st_ = load()
        uses = merge_check_needed(st_, tid)
        other = next((j["tid"] for j in bg.values() if j["kind"] == "merge"), None)
        if other or (uses and check_slots() <= 0):
            start_wait(tid, "merge", f"the merge of {other}" if other else "a free check slot")
            return None
        end_wait(tid, "merge")
        if uses:
            patch_state(lambda s_: s_["tasks"][tid].update(checking={"since": now(), "where": "branch"}))
        bg_start(f"merge-{tid}", tid, "merge", shlex.join([sys.executable, os.path.abspath(__file__), "merge", tid]),
                 ROOT, uses, lambda code, out, secs: merge_done(tid, code, out))
        return None

    def merge_done(tid, code, out):
        patch_state(lambda s_: s_["tasks"][tid].pop("checking", None))
        out = out.strip()
        for l in out.splitlines():
            if l.startswith(("SKIPPED_CHECK", "SETUP ", "WARN ")):
                say(l)
        if code == 7:
            held(tid, out)
            return
        if code == 3:
            say(f"{tid} failed: {out.splitlines()[0] if out else 'merge stopped'}", True)
            return
        if code in (4, 6):
            s_ = load()
            if code == 4 and s_["tasks"][tid].get("conflicts", 0) > MAX_CONFLICT:
                park(tid, "failed", f"merge conflict still unresolved after {MAX_CONFLICT} attempts")
                return
            what = "merge conflict" if code == 4 else f"passes alone but fails the check on {s_['branch']} (not committed)"
            if not s_["tasks"][tid].get("job"):   # the dispatch step sent its job already, while this was collected
                say(f"{tid} {what} -> sent to {s_['tasks'][tid].get('worker') or 'the next free coder'}")
            elif holds(s_, tid):
                say(f"{tid} {what} -> back to {s_['tasks'][tid]['worker']}")
                code, out = run("send-job", tid, ok=(0, 5))
                sent(code, out, tid, s_["tasks"][tid]["worker"])
            else:
                say(f"{tid} {what} -> queued for the next free coder")
            return
        if code != 0:
            raise RuntimeError(f"orch merge {tid} -> exit {code}: {out}")
        say(f"{tid} checked and merged into {load()['branch']}")

    def handle(tid, t):
        if t["status"] in ("awaiting-review", "reviewing", "reviewed") and early_followup(tid, t):
            return
        if t["status"] == "verifying":
            if checking(tid):
                return                            # its check runs in the background: its end is an event
            k = t["attempt"]
            chk = t.get("chk") if (t.get("chk") or {}).get("attempt") == k else None
            if chk is None:
                if t.get("prechecked") != k:
                    if not pre_check(tid, t):
                        return
                    patch_state(lambda s_: s_["tasks"][tid].update(prechecked=k))
                    t = load()["tasks"][tid]
                if early_review_ok(tid, t):
                    code, out = run("review", tid, ok=(0, 3, 5))
                    patch_state(lambda s_: s_["tasks"][tid].update(early=k))
                    say(out.splitlines()[-1] + (" (alongside its check: `Early review: on`)" if code == 0 else ""))
                start_check(tid, t["dir"])
                return
            post_check(tid, t, chk)
        elif t["status"] == "awaiting-review":
            code, out = run("review", tid, ok=(0, 3, 5))
            if code == 0:
                waited = end_wait(tid, "reviewer")
                say(out + (f" ({tid} waited {_fmt_secs(waited)} for the reviewer)" if waited else ""))
            elif code == 3:
                start_wait(tid, "reviewer", "the reviewer")
            elif code == 5:
                n = (load().get("reviewer_info") or {}).get("delivery_fails", 0)
                say(f"{tid}: could not reach the reviewer — retrying when herdr sees it again (or after "
                    f"{SEND_RETRY_S if n < UNREACHABLE_AFTER else UNREACHABLE_MIN * 60}s)\n{out}",
                    n in (1, UNREACHABLE_AFTER))
        else:
            handle_rest(tid, t)

    def pre_check(tid, t):
        """What a finished coder's work must pass before its check runs: a usable result file, no open question,
        its scope, its acceptance criteria. False when it went back to the coder or was parked."""
        if True:
            res, err = read_result(t.get("last_result"))
            if err and err != "missing":
                if t.get("result_fixes", 0) >= 1:
                    park(tid, "paused", f"result file still not usable ({err}): {t.get('last_result')}")
                    return False
                patch_state(lambda s_: s_["tasks"][tid].update(result_fixes=s_["tasks"][tid].get("result_fixes", 0) + 1))
                say(f"{tid}: result file not usable ({err}) -> asked the coder once to rewrite it")
                write_and_send(tid, "result-fix-1.md",
                               f"# Your result file for {tid} can't be used\n\n`{t.get('last_result')}`: {err}.\n\n"
                               "Don't change any code for this. Write the result file the prompt names, in the "
                               "`result_format` shape from task.json (valid JSON), plus the report, then the done "
                               "file.\n")
                return False
            rp = t.get("last_report")
            rtext = Path(rp).read_text() if rp and Path(rp).exists() else ""
            if res:
                if res["status"] in ("question", "blocked"):
                    qs = [str(q) for q in res.get("questions", []) if q] or ["the coder is " + res["status"]]
                    park(tid, "paused", "; ".join(qs)[:400])
                    return False
            else:
                q = [l for l in rtext.splitlines() if l.strip().upper().startswith("QUESTION:")]
                if q:
                    park(tid, "paused", q[0].strip()[9:].strip() or "worker asked a question")
                    return False
            # proof that a hard-to-undo milestone is safe: the result's `proof`, else the report's PROOF: line
            pf = (str(res.get("proof") or "").strip() if res else "") or next(
                (l.split(":", 1)[1].strip() for l in rtext.splitlines() if l.strip().upper().startswith("PROOF:")), "")
            if pf:
                patch_state(lambda s2: s2["tasks"][tid].update(proof=pf[:500]))
            # scope: the real diff against the milestone's Likely files
            s_ = load()
            allowed = s_["tasks"][tid].get("files") or []
            if allowed:
                out_ = [f for f in changed_files(s_, s_["tasks"][tid]) if not path_allowed(f, allowed)]
                new = sorted(set(out_) - set(s_["tasks"][tid].get("out_of_scope") or []))
                if out_:
                    patch_state(lambda s2: s2["tasks"][tid].update(out_of_scope=out_))
                if new and s_.get("scope") == "strict":
                    say(f"{tid} changed files outside its Likely files: {', '.join(new)} -> fix round")
                    fix_round(tid, "scope-fix", lambda n: (
                        f"# {tid} changed files outside its scope (round {n})\n\n"
                        f"This milestone may change only: {', '.join(allowed)}. It also changed: "
                        f"{', '.join(new)}.\nUndo those changes, or, if the task truly can't be done without them, "
                        f"leave them and explain why in your report. Then run `{st['check']}`.\n"),
                        f"still outside its scope after {MAX_FIX} fix rounds: {', '.join(new)}")
                    return False
                if new:
                    hot = [f for f in new if HOTSPOT_RE.search(f)]
                    say(f"{tid} changed files outside its Likely files: {', '.join(new)}" +
                        (f" (shared hotspot files: {', '.join(hot)})" if hot else ""), bool(hot))
            # a criterion the developer approved leaving undone (`orch defer`, `orch answer --defer`) is not a failure:
            # no fix round, no escalation; the summary lists it as not done, with a follow-up
            dfr = deferred_of(load()["tasks"][tid])
            unmet_all = [c for c in (res or {}).get("criteria", []) if c.get("met") is False]
            unmet = [c for c in unmet_all if str(c.get("id")) not in dfr]
            skipped = [str(c["id"]) for c in unmet_all if str(c.get("id")) in dfr]
            if skipped:
                say(f"{tid}: {', '.join(skipped)} not met, deferred with the developer's approval -> no fix round for "
                    f"{'it' if len(skipped) == 1 else 'them'} (listed as not done in the summary)")
            if unmet:
                say(f"{tid}: the coder reports {', '.join(str(c['id']) for c in unmet)} not met -> fix round")
                fix_round(tid, "criteria-fix", lambda n: (
                    f"# {tid}: acceptance criteria not met yet (round {n})\n\nYour result says these are not met:\n"
                    + "\n".join(f"- {c['id']}: {c.get('evidence', '')}" for c in unmet)
                    + (f"\n\nAlready deferred by the developer (leave them; keep them `met: false`): "
                       f"{', '.join(skipped)}." if skipped else "")
                    + f"\n\nFinish them (you decide how), run `{st['check']}`, and write a new result.\n"
                    "If one truly can't be met in this repo (for example an outside API or service it needs does not "
                    "exist), don't try again: set status `question`, say which criterion and why, and offer to "
                    "build the rest and defer that one. The developer decides.\n"),
                    f"acceptance criteria still not met after {MAX_FIX} fix rounds")
                return False
            return True

    def post_check(tid, t, chk):
        """The check of a coder's work came back (verifying): on to review or landing, or a fix round."""
        patch_state(lambda s_: s_["tasks"][tid]["chk"].update(used=True))
        ok, tail = chk["ok"], chk["tail"]
        if True:
            if ok:
                if t["review"] and not t.get("review_ok"):
                    _, hout = run("handoff", tid)
                    if hout.startswith("HANDED_OFF"):
                        say(f"{tid} saved for review; {t['worker']} is free for other work")
                    code, out = run("review", tid, ok=(0, 3, 5))
                    say(out.splitlines()[-1])
                else:
                    land(tid)
            else:
                check_fix(tid, tail)

    def handle_rest(tid, t):
        if t["status"] == "reviewed":
            k = t["review_round"]
            blockers, _, known = review_findings(tid, k)
            where = f".orchestrate/review/{tid}/review-{k}.json"
            if not known:
                park(tid, "paused", f"review output not usable (no valid {where}, no BLOCKER/SUGGESTION/NO FINDINGS "
                                    f"lines in review-{k}.md)")
            elif blockers:
                code, _ = run("bump", tid, "review", ok=(0, 3))
                if code == 3:
                    fail(tid, f"reviewer still has blockers after {MAX_REVIEW} rounds: {where}")
                else:
                    run("needs-fix", tid)
                    s_ = load()
                    if holds(s_, tid):
                        say(f"{tid} review: {len(blockers)} blocker(s) -> back to {s_['tasks'][tid]['worker']}")
                        code, out = run("send-job", tid, ok=(0, 5))
                        sent(code, out, tid, s_["tasks"][tid]["worker"])
                    else:
                        say(f"{tid} review: {len(blockers)} blocker(s) -> fix job queued (first free coder)")
            else:
                run("review-ok", tid)
                say(f"{tid} review passed")
                land(tid)
        elif t["status"] == "committed":
            land(tid)

    def tend_stops():
        """Coders told to stop: free once herdr shows them idle; interrupted again (twice at most) if they keep going."""
        st_ = load()
        for n, w in st_["workers"].items():
            h = w.get("stopping")
            if not h:
                continue
            s = herdr_state(n) if w.get("detect", True) else None
            busy = s is not None and busy_word(s)
            if busy and h.get("idle_since"):
                h["idle_since"] = None
                patch_state(lambda s_, n=n: n in s_["workers"] and s_["workers"][n].get("stopping") is not None
                            and s_["workers"][n]["stopping"].update(idle_since=None))
            elif s is not None and not busy and not h.get("idle_since"):
                h["idle_since"] = now()
                patch_state(lambda s_, n=n, t=h["idle_since"]: n in s_["workers"]
                            and s_["workers"][n].get("stopping") is not None
                            and s_["workers"][n]["stopping"].update(idle_since=t))
            if not still_stopping(st_, n, w):
                patch_state(lambda s_, n=n: n in s_["workers"] and s_["workers"][n].pop("stopping", None))
                say(f"STOPPED {n}: it is idle after the stop for {h.get('task')}, so it can take new work")
                continue
            if now() - h.get("last", h.get("ts", 0)) >= HALT_REPEAT_S and h.get("again", 0) < 2:
                keys = interrupt(st_, n)
                patch_state(lambda s_, n=n: n in s_["workers"] and s_["workers"][n].get("stopping") is not None
                            and s_["workers"][n]["stopping"].update(again=h.get("again", 0) + 1, last=now()))
                say(f"{n} is still working {_fmt_secs(now() - h.get('ts', now()))} after it was told to stop "
                    f"{h.get('task')}: " + (f"pressed {'+'.join(keys)} again" if keys else
                                             "the interrupt key could not be sent")
                    + f". It gets no new work until it is idle; look at its pane (`orch free {n}` once it has "
                    f"stopped)", h.get("again", 0) >= 1)

    def _agent_of(s_, name):
        return s_["workers"].get(name) if name in s_.get("workers", {}) else \
            (s_.get("reviewer_info") if name == s_.get("reviewer") else None)

    def tend_compacts():
        """Coders and the reviewer whose milestone landed get their tool's compact command while they are idle and
        hold no job; one that is compacting is free again once herdr shows it idle (or after COMPACT_MAX_S)."""
        st_ = load()
        for n, w, holding in compact_agents(st_):
            if holding:
                continue
            h = w.get("compacting")
            if h:
                s = herdr_state(n) if w.get("detect", True) else None
                busy = s is not None and busy_word(s)
                if busy and h.get("idle_since"):
                    h["idle_since"] = None
                elif s is not None and not busy and not h.get("idle_since"):
                    h["idle_since"] = now()
                late = now() - h.get("ts", 0) > COMPACT_MAX_S
                done = not still_compacting(st_, n, w)

                ended = {}

                def upd(s_, n=n, idle=h.get("idle_since"), done=done, late=late, busy=busy):
                    a = _agent_of(s_, n)
                    if not a or not a.get("compacting"):
                        return                   # its next job was sent first: that step already said so
                    if not done:
                        a["compacting"]["idle_since"] = idle
                        return
                    ended["yes"] = end_compact(s_, n, a, note=not (late and busy))
                    if late and busy:
                        story_note(s_, f"{n} was still busy {_fmt_secs(COMPACT_MAX_S)} after {h.get('cmd')}: orch "
                                       f"stopped waiting for it", who="event manager")
                patch_state(upd)
                if ended:
                    say(f"{n} is still working {_fmt_secs(COMPACT_MAX_S)} after {h.get('cmd')}: look at its pane"
                        if late and busy else f"COMPACTED {n}: its chat after {h.get('after')} is now a short summary",
                        late and busy)
                continue
            if not compact_due(st_, n, w):
                why = w.get("ctx") and w.get("detect", True) and compact_unsupported(st_, n, w.get("kind"))
                if why and w.get("kind") not in st_.get("compact_told", []):
                    def told(s_, n=n, k=w.get("kind"), why=why):
                        if k not in s_.setdefault("compact_told", []):
                            s_["compact_told"].append(k)
                            story_note(s_, f"{n}'s chat is not compacted: {why}", who="event manager")
                    patch_state(told)
                    say(f"{n}'s chat is not compacted: {why}")
                continue
            sent_ = {}

            def go(s_, n=n, ctx=w.get("ctx")):
                a = _agent_of(s_, n)
                holds_ = (a or {}).get("task") if n in s_.get("workers", {}) else s_.get("reviewer_busy")
                if not a or holds_ or a.get("ctx") != ctx or a.get("compacting"):
                    return
                cmd, _ = compact_command(s_, a.get("kind"))
                if cmd and start_compact(s_, n, a, cmd):
                    sent_["cmd"] = cmd
            patch_state(go)
            if sent_:
                say(f"{n} finished {w.get('ctx')} and is idle: sent {sent_['cmd']} so its chat does not keep growing")

    def dispatch(kind, tid, worker):
        code, prep = run("prepare", tid, worker, ok=(0, 3))
        if code == 3:                  # the coder is busy after all (still stopping its last milestone): next loop
            say(f"{tid}: {worker} is not free yet ({prep.splitlines()[-1][:160] if prep else 'busy'}) — tried again soon")
            return
        if "SETUP_NEEDED" in prep:
            d = load()["tasks"][tid]["dir"]
            say(f"installing dependencies in {d}" + (" (dependency files changed)" if "changed" in prep else ""))
            r = subprocess.run(st["setup"], shell=True, cwd=d, text=True, capture_output=True)
            if r.returncode != 0:
                park(tid, "pending", f"setup command failed in {d}")
                say(r.stdout[-2000:] + r.stderr[-2000:], True)
                sys.exit(3)
            run("setup-done", worker)
        run("write-task", tid)
        code, out = run("send-job" if kind == "FIX" else "send", tid, *([] if kind == "FIX" else ["task.md"]),
                        ok=(0, 5))
        if sent(code, out, tid, worker):
            t_ = load()["tasks"][tid]
            go_ts, lw = t_.get("go_ts"), t_.get("lead_wait_s")
            if go_ts or lw is not None:
                patch_state(lambda s_: [s_["tasks"][tid].pop(k, None) for k in ("go_ts", "lead_wait_s")])
            say(f"{tid} fix job -> {worker}" if kind == "FIX" else f"{tid} -> {worker}"
                + (f" ({max(0, now() - go_ts)}s after the lead's dispatch or answer)" if go_ts else "")
                + (f" — it waited {_fmt_secs(lw)} for the lead's dispatch" if lw else ""))

    def on_event(ev):
        parts = ev.split()
        if len(parts) < 2:
            return
        kind, tid = parts[0], parts[1]
        if kind == "BG_DONE":
            return                                # a background check or merge ended: the next loop collects it
        agent = (re.search(r"agent=(\S+)", ev) or re.search(r"worker=(\S+)", ev) or [None, None])[1]
        s_ = load()
        t = s_["tasks"].get(tid, {})
        w = t.get("wait") or {}
        reviewer = w.get("kind") == "reviewer"
        if kind == "DONE":
            say(f"{tid} done by {agent} -> running checks")
        elif kind == "REVIEWED":
            say(f"{tid} reviewed")
        elif kind == "UNCONFIRMED":
            code, out = run("resend", tid, ok=(0, 5))
            say(f"{tid}: the prompt to {agent} was recorded but not confirmed (interrupted run?) -> sent again to "
                f"the same agent" if code == 0 else f"{tid}: could not re-send to {agent}\n{out}")
        elif kind == "ORPHAN":
            if t.get("status") == "reviewing":
                run("requeue-review", tid)
                say(f"{tid}: the review prompt never went out -> queued for review again")
            elif t.get("status") == "coding":
                park(tid, "pending", "its prompt never went out (interrupted run) — will be sent again",
                     important=False, lost=True)
            else:
                park(tid, "paused", f"{t.get('status')} with no job and no agent working on it — check it and "
                                    f"`orch set {tid} pending`")
        elif kind == "BLOCKED":
            key = f"{tid}:{t.get('attempt')}:{w.get('kind')}"
            if key not in s_.get("notified", []):          # kept in state: a restart doesn't alert twice
                patch_state(lambda s2: s2["notified"].append(key))
                say(f"{agent} is waiting for a PERMISSION/QUESTION in its pane (task {tid}). "
                    f"Answer it there; autopilot keeps going.", True)
            time.sleep(20)
        elif kind == "IDLE":
            if (w.get("report") and Path(w["report"]).exists()) or (w.get("result") and Path(w["result"]).exists()):
                Path(w["sentinel"]).touch()
                say(f"{tid}: {agent} wrote its report but no done file — accepting it")
                return
            try:
                r = subprocess.run([HERDR, "agent", "read", agent, "--source", "recent-unwrapped", "--lines", "40"],
                                   text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
                pane = r.stdout + r.stderr
            except (OSError, subprocess.TimeoutExpired):
                pane = ""
            if RATE_RE.search(pane) and not reviewer:
                park(tid, "pending", f"{agent} hit a usage/rate limit", important=False, lost=True)
                run("cooldown", agent, os.environ.get("ORCH_COOLDOWN_MIN", "60"), "rate-limit")
                say(f"{agent} benched; {tid} will move to another coder with its work so far", True)
            else:
                code, _ = run("nudge", tid, ok=(0, 3))
                if code == 3:
                    park(tid, "paused", f"{agent} stopped twice without finishing", lost=True)
                else:
                    say(f"{tid}: {agent} went idle early -> nudged once")
        elif kind == "TIMEOUT":
            park(tid, "paused", f"{agent} over its time budget ({ev.split('after')[-1].strip()})")
        elif kind == "GONE":
            if reviewer:
                run("requeue-review", tid)
                run("cooldown", agent, GONE_COOLDOWN_MIN, "gone")
                say(f"reviewer {agent} is gone — restart it; {tid} waits for review (the coder's work is kept)", True)
            else:
                where, _ = herdr_presence(agent)
                shell = where == "shell"
                saved = save_screen(agent, f"no agent left in its pane while it worked on {tid}") if shell else None
                what = ("its pane is still there, but only a plain shell is left in it (the agent quit)" if shell
                        else "herdr can't find it (its pane was closed, or herdr restarted)")
                fix = ("run `orch team up`: it starts the agent again in that pane" if shell else
                       "run `orch resume` if herdr restarted (it finds the pane by folder and names it again), "
                       "else `orch team up` to open a new pane")
                park(tid, "pending", f"{agent} disappeared from herdr", important=False, lost=True)
                run("cooldown", agent, GONE_COOLDOWN_MIN, "gone")
                patch_state(lambda s2: lead_event(
                    s2, "worker-lost", tid, f"{agent} is gone: {what}. {tid} waits for the next free coder, with "
                                            f"its work so far. Fix: {fix}."))
                say(f"{run_tag()} LOST {agent}: {what}. {tid} goes to the next free coder. Fix: {fix}"
                    + (f" (its last screen: {short(saved)})" if saved else ""), True)

    run("sync")
    manager_begin()
    _, start_out = run("start")
    for line in start_out.splitlines():
        if line.startswith(("RECOVERED", "WARN agent")):
            say(line)
    stale = [l for l in start_out.splitlines() if "STALE pane" in l]
    if stale:
        say("A pane id in plan.md is stale. Stopping.\n" + "\n".join(stale), True)
        sys.exit(3)
    # after a gap (computer off, herdr closed, manager killed): don't count the gap, find the agents again, save
    # unsaved work and re-send what was in progress. Nothing happens when there was no gap.
    try:
        _, rout = run("resume", "--from-manager")
        if rout:
            say("back after a gap:\n" + rout, True)
    except RuntimeError as e:
        say(f"could not run the restart recovery — carrying on without it\n{e}")
    st = load()
    for name in [n for n in st["workers"] if not watched(st, n)] + (
            [st["reviewer"]] if st.get("reviewer") and not watched(st, st["reviewer"]) else []):
        say(f"can't watch {name} through herdr; relying on its done file (and its time budget)")
    if not (ORCH / "baseline.txt").exists():
        ok, tail = check(ROOT)
        (ORCH / "baseline.txt").write_text(tail)
        if not ok:
            (ORCH / "baseline.txt").unlink()
            say("Baseline check fails on the feature branch before any work. Autopilot needs a green check: fix "
                "the failures, or narrow the plan's `Check command` to what should pass (ask the lead: "
                "`orch lead run` helps with this), then run autopilot again. Stopping.\n" + tail, True)
            sys.exit(3)
    if st.get("integration_broken"):
        ok, tail = check(ROOT)
        if not ok:
            say(f"{st['branch']} still fails its check (broken since {st['integration_broken']}). "
                f"Fix it, then run autopilot again. Stopping.\n{tail}", True)
            sys.exit(3)
        patch_state(lambda s_: s_.update(integration_broken=None))
        say(f"{st['branch']} passes its check again — carrying on")
    patch_state(lambda s_: s_["run"].setdefault("started", now()))
    say(f"autopilot started: {st['isolation']} mode, max {st['max_parallel']} parallel, workers "
        + str([n + (f" ({w['model']})" if w.get("model") else "") for n, w in st["workers"].items()])
        + (f", budget {st['budget_s'] // 60} min" if st.get("budget_s") else "")
        + (f"; events go to the lead ({st['lead']['name']})" if lead_on(st) else ""))
    gone = lead_missing(st)
    if gone:
        say(f"!! LEAD NOT FOUND: the lead ({st['lead']['name']}) can't be woken ({gone}). Its events are kept and wait "
            f"for it; in the lead's pane: herdr agent rename <its pane id> {st['lead']['name']}", True)
    BG_DIR.mkdir(exist_ok=True)
    for f in BG_DIR.glob("*"):                # left by a manager that stopped: its jobs are gone
        f.unlink(missing_ok=True)
    patch_state(lambda s_: [t_.pop("checking", None) for t_ in s_["tasks"].values()])
    atexit.register(bg_stop)
    last_tick = time.time()
    slept = sleep_meter()
    waiting_since = None       # set while nothing runs and the run waits for the lead or the developer
    seen = {"procs": time.time(), "check": 0.0, "present": None, "told": False}

    def watch_herdr():
        """Every VANISH_CHECK_S: which agents herdr still runs. When most of them vanish at once, herdr itself
        restarted (or was closed): say so loudly, once, instead of one quiet GONE per agent."""
        if time.time() - seen["check"] < VANISH_CHECK_S:
            return
        seen["check"] = time.time()
        s_ = load()
        names = [n for n in list(s_["workers"]) + ([s_["reviewer"]] if s_.get("reviewer") else [])
                 + ([s_["lead"]["name"]] if s_.get("lead") else []) if watched(s_, n) and not agent_info(s_, n).get("pane")]
        present = {n for n in names if herdr_state(n) is not None}
        before = seen["present"]
        seen["present"] = present
        if before is None:
            return
        gone = sorted(before - present)
        if len(gone) >= 2 and len(gone) * 2 >= len(before) and not seen["told"]:
            seen["told"] = True
            say(f"{run_tag(s_)} HERDR RESTART? {len(gone)} of {len(before)} agents vanished at once ({', '.join(gone)}). "
                f"If herdr was restarted or closed, run `orch resume`: it finds their panes again and re-sends the work",
                True)
            patch_state(lambda s2: lead_event(s2, "herdr-restart", None,
                                              f"{len(gone)} of {len(before)} agents vanished at once: "
                                              f"{', '.join(gone)}. Tell the developer to run `orch resume`."))
        elif not gone and present == before:
            seen["told"] = False

    names = SidebarNames() if run_mode(load()) != "subagent" else None   # herdr's sidebar says what each agent does
    while True:
        _stop_point()
        st = load()
        if names:
            names.update(st)
        if time.time() - seen["procs"] > PROCS_EVERY_S:      # agents come and go: keep this run's processes current
            seen["procs"] = time.time()
            procs = run_processes(st)
            patch_state(lambda s_: (s_["run"].get("manager") or {}).update(procs))
        watch_herdr()
        tend_stops()
        tend_compacts()
        # 0. budget: driving time adds up across restarts (time spent only waiting for an answer doesn't count)
        el, last_tick = time.time() - last_tick, time.time()
        asleep = slept()
        if asleep:                             # the computer was suspended: nobody's time, not the budget's either
            patch_state(lambda s_: account_downtime(s_, asleep))
            say(f"the computer was asleep for {_dur(asleep)}: that time is not counted against any task")
            el = max(0, el - asleep)
        if waiting_since:
            el = 0
        patch_state(lambda s_: s_["run"].update(driven_s=round(s_["run"].get("driven_s", 0) + el, 1), beat=now()))
        st = load()
        if st.get("budget_s") and st["run"].get("driven_s", 0) > st["budget_s"]:
            say(f"STOPPED — the run's budget ({st['budget_s'] // 60} min of autopilot time) is used up. Raise "
                f"`Budget:` in plan.md (or remove it) and run autopilot again; work in progress is kept.", True)
            sys.exit(3)

        # 1. act on tasks waiting for us: background jobs that ended first, then reviews (so the reviewer is never
        # idle while work waits for it), then the rest in plan order
        bg_reap()
        st = load()
        first = {"reviewed": 0, "awaiting-review": 1}
        for tid in sorted(st["order"], key=lambda k: first.get(st["tasks"][k]["status"], 2)):
            t = st["tasks"][tid]
            guarded(tid, lambda: handle(tid, t))

        # 2. dispatch: queued fix/conflict jobs first, then new milestones, to free coders
        st = load()
        _, out = run("ready")
        slots = int(re.search(r"SLOTS (\d+)", out).group(1))
        jobs = [l for l in out.splitlines() if l.startswith("FIX ")] + \
               [l for l in out.splitlines() if l.startswith("READY ")]
        for line in jobs:
            if slots <= 0:
                break
            kind, tid = line.split()[0], line.split()[1]
            code, worker = run("pick", tid, ok=(0, 3))
            if code == 3:
                continue          # nobody of its tier (or its assigned coder) is free; others may still start
            guarded(tid, lambda: dispatch(kind, tid, worker))
            slots -= 1
        lead_ready()
        wake_lead()

        # 3. finished or stuck?
        st = load()
        tasks = st["tasks"]
        if all(t["status"] in ("merged", "skipped") for t in tasks.values()):
            if green_still(st, ROOT):          # the last passing check ran on exactly these files
                ok, tail = True, ""
                say("final check: the check already passed on exactly these files, not run again")
            else:
                ok, tail = check(ROOT)
            if not ok:
                patch_state(lambda s_: s_.update(integration_broken="the final check"))
            patch_state(lambda s_: s_["run"].update(ended=now()))
            base = st.get("base") or "main"
            log_ = git("log", "--oneline", f"{base}..HEAD", cwd=ROOT, check=False).stdout
            stat = git("diff", "--stat", f"{base}..HEAD", cwd=ROOT, check=False).stdout
            sugg, scope = [], []
            for k, v in tasks.items():
                for rnd in range(1, v.get("review_round", 0) + 1):
                    sugg += [f"- {k}: {s}" for s in review_findings(k, rnd)[1]]
                if v.get("out_of_scope"):
                    scope.append(f"- {k}: {', '.join(v['out_of_scope'])}")
            _, report = run("report", "--no-time", ok=(0, 1, 2))
            timing = "\n".join(time_lines(time_account(load())))
            models = []
            for k, v in tasks.items():
                used = [a for a in v.get("attempts") or [] if a.get("kind") == "coder" and a.get("model")]
                if v.get("tier") or used:
                    ran = ", ".join(dict.fromkeys(f"{a['model']} ({a.get('tier') or 'unrated'})" for a in used)) or "-"
                    models.append(f"| {k} | {v.get('tier') or 'any'} | {ran} | "
                                  f"{'yes' if v.get('escalated') else 'no'} | {v.get('model_why') or '-'} |")
            lead_ = lead_on(st)
            quick_run = st.get("mode") == "quick"
            prev = ORCH / "summary.md"
            if prev.exists():                      # a fix after ALL_DONE writes the summary again: keep the lead's notes
                shutil.copyfile(prev, ORCH / "summary.prev.md")
            (ORCH / "summary.md").write_text(
                f"# Summary: {st.get('title') or st['branch']}\n\nBranch `{st['branch']}` into `{base}`. "
                f"Final check on the branch: {'PASS' if ok else 'FAIL'}\n\n"
                + (f"Quick run because: {st.get('quick_because') or '-'}\n\n" if quick_run else "") +
                "## Tasks\n" + "\n".join(f"- {k}: {v['title']} ({v['status']}, last coder {v.get('worker') or v.get('last_worker') or '-'})"
                                         for k, v in tasks.items()) +
                f"\n\n## Commits\n```\n{log_}```\n\n## Files changed\n```\n{stat}```\n\n"
                "## Changed outside Likely files\n" + ("\n".join(scope) or "none") + "\n\n"
                "## Reviewer suggestions not applied\n" + ("\n".join(sugg) or "none") + "\n\n"
                + review_axes_section(st) + risk_section(st)
                + ("## Deferred: not done, follow-ups\nThe developer approved leaving these out of this run. They were "
                   "NOT built.\n" + "\n".join(deferred_lines(st)) + "\n\n" if deferred_lines(st) else "")
                + ("## Models: planned and actual\n| Milestone | Planned tier | Ran on | Escalated | Why this tier |\n"
                   "|---|---|---|---|---|\n" + "\n".join(models) + "\n\n" if models else "") +
                f"## Time: estimate vs actual\n{timing}\n\n"
                f"## Waiting: time milestones sat still\nA finished or ready milestone that waited for something else "
                f"first (counted in the times above).\n{wait_table(tasks)}\n\n"
                f"## Checked automatically\nAlready verified by the run; nobody needs to redo these by hand.\n"
                f"{auto_checked(st, ok)}\n\n"
                f"## Run report\n```\n{report}\n```\n\n"
                + ("## Still to write (the lead was woken to write these)\n" if lead_ else
                   "## Still to write (ask the lead: 'use the orch-run skill' to finish the summary)\n")
                + ("" if quick_run else "- Design decisions & study notes\n")
                + ("- What changed: one line per change, in the developer's words, and how it was checked\n"
                   if quick_run else
                   "- Checked by the lead: what you verified yourself by running a command or reading the code, with "
                   "the evidence\n") +
                "- Manual verification checklist: only what a person must see or do (how the UI looks and behaves, a "
                "real device, an outside account). Nothing a command or a look at the code can settle.\n"
                + ("\nThe summary before this one is in `.orchestrate/summary.prev.md`: carry its notes and checklist "
                   "over, and add what the new work changed.\n" if prev.exists() else ""))
            if lead_:
                patch_state(lambda s_: lead_event(s_, "all_done", None,
                                                  f"final check {'PASS' if ok else 'FAIL'} on {st['branch']}"))
                for _ in range(6):                    # give a busy lead a moment, then wake it anyway
                    hs = herdr_state(st["lead"]["name"]) if watched(st, st["lead"]["name"]) else ""
                    if hs is None or not word(hs, "working", "blocked"):
                        break
                    time.sleep(POLL_STEP_S)
                wake_lead(force=True)
            say(f"ALL_DONE on {st['branch']} — final check {'PASS' if ok else 'FAIL'}. See .orchestrate/summary.md, "
                f"then run `orch finish` to push {st['branch']} and open a PR into {base}", True)
            if lead_:
                # don't leave with a wake-up nobody confirmed: after this exit nothing would send it again
                end = time.time() + LEAD_SETTLE_S
                while True:
                    wake_lead()
                    s_ = load()
                    lw_ = s_.get("lead_wake") or {}
                    if not unread_events(s_) or lw_.get("told") or lw_.get("gone"):
                        break
                    if time.time() > end:
                        say(f"the lead ({st['lead']['name']}) still has not read ALL_DONE — tell it: run `orch events`",
                            True)
                        break
                    time.sleep(POLL_STEP_S)
                s_ = load()
                if unread_events(s_) and lead_missing(s_):
                    say(f"ALL_DONE, but the lead ({st['lead']['name']}) was NEVER WOKEN: herdr can't find it, so it "
                        f"does not know the run finished. Name its pane (herdr agent rename <its pane id> "
                        f"{st['lead']['name']}), then `orch resume`", True)
            sys.exit(0 if ok else 3)
        active = [k for k, v in tasks.items() if v["status"] in ACTIVE and v["status"] != "held"]
        ready = [k for k, v in tasks.items() if v["status"] == "pending" and deps_met(st, v)]
        open_ev = ([e for e in st["lead_events"] if e["kind"] in LEAD_BLOCKING and event_open(st, e)]
                   if lead_on(st) else [])
        if not active and (undispatched(st) or (not ready and open_ev)):
            # nothing is running and the next move is the lead's (or the developer's, through the lead): stay up,
            # so the answer or dispatch is carried out the moment it comes. No AI runs while we wait.
            if waiting_since is None:
                waiting_since = time.time()
                say("waiting for the lead: " + ", ".join(dict.fromkeys(
                    [f"{e['kind']} {e['task']}" for e in open_ev if e.get("task")]
                    + [f"dispatch {k}" for k in undispatched(st)])), True)
            if time.time() - waiting_since > LEAD_IDLE_MAX_S:
                say(f"STOPPED — no answer for {LEAD_IDLE_MAX_S // 60} min. Everything is kept: run `orch autopilot` "
                    f"again when you are back (`orch events --peek` shows what is open).", True)
                sys.exit(3)
            run("poll", str(int(min(30, max(1, POLL_STEP_S * 3)))), ok=(0, 10))
            continue
        waiting_since = None
        if not active and not ready:
            bg_reap()        # a background merge that just ended (held, failed) says so before we stop
            waiting = [f"  {k} {v['status']}: {v.get('reason') or ''}" for k, v in tasks.items()
                       if v["status"] in ("paused", "failed", "needs-answer", "pending", "held")]
            say("STOPPED — needs you:\n" + "\n".join(waiting) +
                "\nAnswer in plan.md 'Notes from user' (set Open questions: - none), run `orch set <Mn> pending` "
                "for paused/failed tasks, `orch approve <Mn>` for held ones, then run `orch autopilot` again "
                "(or ask the lead: `orch lead run`).", True)
            sys.exit(3)

        # 4. wait for the next event
        code, out = run("poll", "30", ok=(0, 10))
        if code == 10:
            continue
        for ev in out.splitlines():
            evtid = ev.split()[1] if len(ev.split()) > 1 else None
            if evtid:
                guarded(evtid, lambda: on_event(ev))


WAIT_NAMES = {"check slot": "a free check slot", "merge": "the merge step", "reviewer": "the reviewer",
              "lead": "the lead's dispatch"}


def wait_table(tasks):
    rows = []
    for k, v in tasks.items():
        ws = {w: s for w, s in (v.get("waits") or {}).items() if s}
        if ws:
            rows.append(f"| {k} | " + ", ".join(f"{WAIT_NAMES.get(w, w)} {_fmt_secs(s)}" for w, s in ws.items())
                        + f" | {_fmt_secs(sum(ws.values()))} |")
    return ("| Milestone | Waited for | Total |\n|---|---|---|\n" + "\n".join(rows)) if rows else \
        "No milestone waited: each one went on as soon as it could."


def _fmt_secs(s):
    s = int(s or 0)
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def run_report(st):
    """Numbers for one run, from what orch recorded (attempts, checks, rounds). No guesses: unknown stays unknown."""
    rows, tot = [], {"tasks": 0, "merged": 0, "failed": 0, "first_pass": 0, "reviewed": 0, "re_reviewed": 0,
                     "conflicts": 0, "lost": 0, "fix_rounds": 0, "agent_s": 0, "wasted_s": 0, "check_s": 0,
                     "input_tokens": 0, "output_tokens": 0, "cost_usd": 0.0, "usage_known": 0}
    for tid in st["order"]:
        t = st["tasks"][tid]
        if t["status"] == "skipped":
            continue
        at = t.get("attempts") or []
        coder = [a for a in at if a.get("kind") == "coder"]
        agent_s = sum(a.get("secs", 0) for a in at)
        wasted = sum(a.get("secs", 0) for a in at if a.get("outcome") != "done")
        check_s = sum(c.get("secs", 0) for c in t.get("checks") or [])
        first = (t["status"] == "merged" and t.get("fix", 0) == 0 and t.get("review_round", 0) <= 1
                 and not t.get("conflicts") and len([a for a in coder if a.get("outcome") == "done"]) <= 1)
        for a in at:
            u = a.get("usage") or {}
            if u:
                tot["usage_known"] += 1
            for k in ("input_tokens", "output_tokens", "cost_usd"):
                if isinstance(u.get(k), (int, float)):
                    tot[k] += u[k]
        rows.append({"task": tid, "status": t["status"], "attempts": len(coder), "fix_rounds": t.get("fix", 0),
                     "review_rounds": t.get("review_round", 0), "conflicts": t.get("conflicts", 0),
                     "lost": t.get("lost", 0), "agent_s": agent_s, "wasted_s": wasted, "check_s": check_s,
                     "first_pass": first})
        tot["tasks"] += 1
        tot["merged"] += t["status"] == "merged"
        tot["failed"] += t["status"] == "failed"
        tot["first_pass"] += first
        tot["reviewed"] += t.get("review_round", 0) >= 1
        tot["re_reviewed"] += t.get("review_round", 0) >= 2
        for k in ("conflicts", "lost"):
            tot[k] += t.get(k, 0)
        tot["fix_rounds"] += t.get("fix", 0)
        tot["agent_s"] += agent_s
        tot["wasted_s"] += wasted
        tot["check_s"] += check_s
    tot["driven_s"] = (st.get("run") or {}).get("driven_s", 0)
    # how each model really did: the numbers to hold against its catalog ratings
    by_model = {}
    for tid in st["order"]:
        t = st["tasks"][tid]
        coder = [a for a in t.get("attempts") or [] if a.get("kind") == "coder" and a.get("model")]
        for a in coder:
            m = by_model.setdefault(a["model"], {"model": a["model"], "tier": a.get("tier"), "attempts": 0, "done": 0,
                                                 "agent_s": 0, "tasks": [], "merged": 0, "first_pass": 0,
                                                 "escalated_away": 0})
            m["attempts"] += 1
            m["done"] += a.get("outcome") == "done"
            m["agent_s"] += a.get("secs", 0)
            if tid not in m["tasks"]:
                m["tasks"].append(tid)
        if coder:
            last = by_model[coder[-1]["model"]]
            last["merged"] += t["status"] == "merged"
            last["first_pass"] += bool(next((r["first_pass"] for r in rows if r["task"] == tid), False))
            if t.get("escalated") and coder[0]["model"] != coder[-1]["model"]:
                by_model[coder[0]["model"]]["escalated_away"] += 1
    for r in rows:
        t = st["tasks"][r["task"]]
        r["tier"], r["escalated"] = t.get("tier"), bool(t.get("escalated"))
    return {"branch": st["branch"], "tasks": rows, "totals": tot, "models": list(by_model.values())}


# ---------------------------------------------------------------- estimate vs actual time
CODER_JOBS = [   # prompt file -> what the coder was doing (anything but task.md is extra work)
    ("review-fix", "fixing the reviewer's blockers"),
    ("integration-fix", "fixing the check that failed once merged onto the branch"),
    ("criteria-fix", "fix rounds: acceptance criteria not met"),
    ("scope-fix", "fix rounds: changed files outside Likely files"),
    ("result-fix", "rewriting a result file orch could not read"),
    ("conflict", "resolving merge conflicts"),
    ("fix", "fix rounds: the check command failed"),
]


def _transitions(st):
    """Every status change of every milestone in this run, oldest first: events.jsonl, or the history in
    state.json when the log is missing."""
    since = (st.get("run") or {}).get("started") or 0
    by = {tid: [] for tid in st["tasks"]}
    p = ORCH / "events.jsonl"
    if p.exists():
        for line in p.read_text().splitlines():
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("task") in by and ev.get("ts", 0) >= since:
                by[ev["task"]].append(ev)
    for tid, t in st["tasks"].items():
        if not by[tid]:
            by[tid] = [dict(h, task=tid) for h in t.get("history") or []]
        by[tid].sort(key=lambda e: e.get("ts", 0))
    return by


def _wait_part(st, status, why, agent):
    """A milestone sat in `status` after it had started: what it was waiting for and on whom. None = busy."""
    why = why or ""
    if status == "awaiting-review":
        return "waiting for the reviewer (busy with other work or unreachable)", st.get("reviewer") or "reviewer"
    if status == "needs-fix":
        return "waiting for a free coder to take its fix job", "the coders (all busy)"
    if status == "paused":
        return f"paused, waiting for the lead or the developer ({why[:80]})" if why else \
            "paused, waiting for the lead or the developer", "developer / lead"
    if status == "needs-answer":
        return "open questions waiting for the developer's answer", "developer"
    if status == "held":
        return "risky change waiting for the developer's `orch approve`", "developer"
    if status == "failed":
        return "failed, waiting for the lead to dispatch it again", "lead / developer"
    if status == "pending":
        if RATE_RE.search(why):
            return "agent hit a usage limit: benched, work waited for another coder", agent or "agent"
        if "disappeared" in why or "gone" in why:
            return "agent disappeared from herdr: work waited for another coder", agent or "agent"
        if why.startswith("escalated"):
            return "waiting for a stronger coder after escalation", "the coders (all busy)"
        if why.startswith("answered"):
            return "waiting for the coder to pick up the answer", agent or "coder"
        return "waiting for a free coder" + (f" ({why[:60]})" if why else ""), "the coders (all busy)"
    return None


def _who(a):
    return f"{a.get('agent') or '?'} ({a['model']})" if a.get("model") else (a.get("agent") or "?")


def time_account(st, at=None):
    """Estimated vs actual time per milestone and for the feature, from what orch recorded: status changes,
    attempts (who, which model, which job), check times and time agents sat at a prompt. Nothing is guessed:
    time orch can't place is shown as orch's own steps, and a missing estimate stays missing."""
    at = at or now()
    trans, rows = _transitions(st), []
    downs = (st.get("run") or {}).get("downs") or []

    def down_in(a, b):
        """Seconds of [a, b] in which orch was not running (computer off, event manager stopped)."""
        return sum(max(0, min(b, d["to"]) - max(a, d["from"])) for d in downs)
    for tid in st["order"]:
        t = st["tasks"][tid]
        if t["status"] == "skipped":
            continue
        evs = trans.get(tid, [])
        first = next((i for i, e in enumerate(evs) if e.get("to") == "coding"), None)
        row = {"task": tid, "title": t.get("title", ""), "estimate_s": t.get("estimate_s"), "actual_s": None,
               "landed": t["status"] == "merged", "start": None, "end": None, "parts": [], "over_s": None,
               "down_s": 0}
        rows.append(row)
        if first is None:
            continue
        start = evs[first]["ts"]
        end = next((e["ts"] for e in evs[first:] if e.get("to") == "merged"), None)
        if end is None:
            end = at
        parts = {}

        def add(what, who, secs, extra):
            if secs <= 0:
                return
            p = parts.setdefault((what, who), {"what": what, "who": who, "secs": 0, "extra": extra})
            p["secs"] += secs
        # waiting: from the status changes
        for i in range(first, len(evs)):
            a_, b_ = max(evs[i]["ts"], start), min(evs[i + 1]["ts"] if i + 1 < len(evs) else end, end)
            w = _wait_part(st, evs[i].get("to"), evs[i].get("why"), evs[i].get("agent"))
            if w and b_ > a_:
                add(w[0], w[1], b_ - a_ - down_in(a_, b_), True)
        # working: from the attempts
        esc = next((e["ts"] for e in evs[first:] if (e.get("why") or "").startswith("escalated")), None)
        built = reviewed = False
        for a in t.get("attempts") or []:
            if a.get("start", 0) < start or a.get("start", 0) >= end:
                continue
            secs, blocked = a.get("secs", 0), a.get("blocked_s", 0)
            if blocked:
                add("stopped at a permission prompt or question in its pane", a.get("agent") or "?", blocked, True)
            secs -= blocked
            if a.get("outcome") != "done":
                why = re.sub(r"^parked as \w[\w-]*:?\s*", "", a.get("outcome") or "")
                add(f"work cut short ({why[:60] or 'stopped'}); the next attempt carried on from it", _who(a), secs, True)
            elif a.get("kind") == "reviewer":
                add("review" if not reviewed else "review again after fixes", _who(a), secs, reviewed)
                reviewed = True
            else:
                f = a.get("file") or "task.md"
                job = next((d for k, d in CODER_JOBS if f.startswith(k + "-")), None)
                if job:
                    add(job, _who(a), secs, True)
                elif esc and a["start"] >= esc:
                    add("building again on a stronger model (escalated)", _who(a), secs, True)
                else:
                    add("building it", _who(a), secs, False)
                    built = True
        seen = set()
        for c in t.get("checks") or []:
            if start <= c.get("ts", 0) <= end:
                again = c.get("where") in seen
                seen.add(c.get("where"))
                add("checks run again after fixes" if again else "checks", "check command", c.get("secs", 0), again)
        down = down_in(start, end)             # not counted: nobody could work or be watched
        total = end - start - down
        placed = sum(p["secs"] for p in parts.values())
        add("orch's own steps (setup, prompts, merge)", "orch", max(0, total - placed), False)
        row.update(start=start, end=end, actual_s=total, down_s=down,
                   parts=sorted(parts.values(), key=lambda p: (p["extra"], -p["secs"])))
        if row["estimate_s"]:
            row["over_s"] = total - row["estimate_s"]
    # the feature: from the first milestone starting to the last one landing; time after every milestone had
    # landed and before a fix asked with `orch fix` is not counted, time with nothing running is
    started = sorted((r for r in rows if r["start"]), key=lambda r: r["start"])
    feat = {"estimate_s": st.get("estimate_s"), "actual_s": None, "over_s": None, "idle_s": 0, "after_done_s": 0,
            "down_s": 0, "landed": bool(rows) and all(r["landed"] for r in rows), "why": []}
    if started:
        fstart = started[0]["start"]
        fend = max(r["end"] for r in started)
        reach, idle, after = started[0]["end"], 0, 0
        for r in started[1:]:
            if r["start"] > reach:
                gap = r["start"] - reach - down_in(reach, r["start"])
                if st["tasks"][r["task"]].get("fix_of") and all(x["landed"] and x["end"] <= reach
                                                                for x in started if x["start"] < r["start"]):
                    after += gap
                else:
                    idle += gap
            reach = max(reach, r["end"])
        fdown = down_in(fstart, fend)
        feat.update(actual_s=fend - fstart - after - fdown, idle_s=idle, after_done_s=after, down_s=fdown)
        if feat["estimate_s"]:
            feat["over_s"] = feat["actual_s"] - feat["estimate_s"]
        agg = {}
        for r in started:
            for p in r["parts"]:
                if p["extra"]:
                    k = (p["what"], p["who"])
                    g = agg.setdefault(k, {"what": p["what"], "who": p["who"], "secs": 0, "tasks": []})
                    g["secs"] += p["secs"]
                    g["tasks"].append(r["task"])
        if idle:
            agg[("idle", "")] = {"what": "no milestone was running (waiting for the lead's `orch dispatch`, or the "
                                         "event manager was stopped)", "who": "lead / event manager", "secs": idle,
                                 "tasks": []}
        feat["why"] = sorted(agg.values(), key=lambda g: -g["secs"])
    return {"feature": feat, "tasks": rows}


def _dur(s):
    """Short and readable: 45s, 40m, 1h05m."""
    if s is None:
        return "-"
    s = abs(int(s))
    if s < 60:
        return f"{s}s"
    h, m = divmod(round(s / 60), 60)
    return f"{h}h{m:02d}m" if h else f"{m}m"


def time_lines(acct):
    """Estimate vs actual as markdown: a table, then, for whatever took longer than planned, why and who."""
    f, out = acct["feature"], []
    est, act = f["estimate_s"], f["actual_s"]
    head = (f"Whole feature: estimated {_dur(est) if est else 'not given'}, actual "
            f"{_dur(act) if act is not None else 'not started'}" + ("" if f["landed"] else " so far (not all landed)"))
    if est and act is not None:
        head += (f", {_dur(f['over_s'])} longer than estimated" if f["over_s"] > 0 else
                 f", {_dur(f['over_s'])} quicker than estimated" if f["over_s"] < 0 else ", on time")
    out += [head]
    if f.get("down_s"):
        out += [f"Not counted: {_dur(f['down_s'])} while orch was not running (computer off, herdr closed or the "
                f"event manager stopped). No agent is charged for that time."]
    out += ["", "| Milestone | Estimate | Actual | Difference | Built by |", "|---|---|---|---|---|"]
    for r in acct["tasks"]:
        diff = "-" if r["over_s"] is None else ("on time" if r["over_s"] == 0 else
                                                f"{'+' if r['over_s'] > 0 else '-'}{_dur(r['over_s'])}")
        who = ", ".join(dict.fromkeys(p["who"] for p in r["parts"] if p["what"] == "building it")) or "-"
        act_ = "not started" if r["actual_s"] is None else _dur(r["actual_s"]) + ("" if r["landed"] else " so far")
        out.append(f"| {r['task']} | {_dur(r['estimate_s']) if r['estimate_s'] else 'none'} | {act_} | {diff} | {who} |")
    late = [r for r in acct["tasks"] if r["over_s"] and r["over_s"] > 0]
    if est and f["over_s"] and f["over_s"] > 0 and f["why"]:
        out += ["", f"Why the feature took {_dur(f['over_s'])} longer (time added up per milestone; milestones that "
                    "ran side by side overlap, so this can add up to more):"]
        out += [f"- {_dur(g['secs'])} {g['who']}: {g['what']}"
                + (f" ({', '.join(dict.fromkeys(g['tasks']))})" if g["tasks"] else "") for g in f["why"]]
    for r in late:
        out += ["", f"Why {r['task']} took {_dur(r['over_s'])} longer than its {_dur(r['estimate_s'])} estimate:"]
        extra = [p for p in r["parts"] if p["extra"]]
        planned = sum(p["secs"] for p in r["parts"] if not p["extra"])
        out += [f"- {_dur(p['secs'])} {p['who']}: {p['what']}" for p in extra]
        if planned > r["estimate_s"]:
            out.append(f"- the planned work alone took {_dur(planned)}: " + ", ".join(
                f"{p['what']} {_dur(p['secs'])} ({p['who']})" for p in r["parts"] if not p["extra"])
                + " (the estimate itself was too low for this work)")
    if not est and not any(r["estimate_s"] for r in acct["tasks"]):
        out += ["", "No estimates in plan.md (`Estimate:` in the header and in each milestone), so only the actual "
                    "time is shown."]
    return out


def cmd_report(args):
    """orch report [--json] [--no-time] -> estimated vs actual time (and why it took longer), rounds, first-pass
    rate and wasted work for this run."""
    st = load()
    rep_ = run_report(st)
    by_axis, rules_broken = review_axes(st)
    if "--json" in args:
        rep_["time"] = time_account(st)
        rep_["review_axes"] = {"spec": len(by_axis["spec"]), "rules": len(by_axis["rules"]), "rules_broken": rules_broken}
        rep_["risk"] = [{"task": k, "door": v.get("door") or "two-way", "door_why": v.get("door_why"),
                         "blast": v.get("blast"), "proof": v.get("proof")}
                        for k, v in st["tasks"].items() if v.get("blast") or v.get("door")]
        print(json.dumps(rep_, indent=2))
        return
    if "--no-time" not in args:
        print("Estimate vs actual\n" + "\n".join(time_lines(time_account(st))) + "\n")
    tot = rep_["totals"]
    print(f"{'task':<5} {'status':<15} {'tries':>5} {'fix':>4} {'review':>6} {'confl':>5} {'lost':>4} "
          f"{'agent time':>10} {'wasted':>8} {'checks':>8}  first pass")
    for r in rep_["tasks"]:
        print(f"{r['task']:<5} {r['status']:<15} {r['attempts']:>5} {r['fix_rounds']:>4} {r['review_rounds']:>6} "
              f"{r['conflicts']:>5} {r['lost']:>4} {_fmt_secs(r['agent_s']):>10} {_fmt_secs(r['wasted_s']):>8} "
              f"{_fmt_secs(r['check_s']):>8}  {'yes' if r['first_pass'] else 'no'}")
    n = tot["tasks"] or 1
    print(f"\nmerged {tot['merged']}/{tot['tasks']}, failed {tot['failed']}; first pass {tot['first_pass']}/"
          f"{tot['tasks']} ({100 * tot['first_pass'] // n}%); needed a 2nd review round {tot['re_reviewed']}/"
          f"{tot['reviewed']}; conflicts {tot['conflicts']}; lost attempts {tot['lost']}; fix rounds {tot['fix_rounds']}")
    print(f"agent time {_fmt_secs(tot['agent_s'])}, of which wasted {_fmt_secs(tot['wasted_s'])} (attempts that "
          f"didn't finish); checks {_fmt_secs(tot['check_s'])}; autopilot time {_fmt_secs(tot['driven_s'])}")
    if rep_["models"]:
        print(f"\n{'model':<18} {'tier':<8} {'tasks':>5} {'tries':>5} {'merged':>6} {'first pass':>10} {'moved up':>8} {'agent time':>10}")
        for m in rep_["models"]:
            print(f"{m['model']:<18} {m['tier'] or 'unrated':<8} {len(m['tasks']):>5} {m['attempts']:>5} {m['merged']:>6} "
                  f"{m['first_pass']:>10} {m['escalated_away']:>8} {_fmt_secs(m['agent_s']):>10}")
        print("(moved up = milestones this model could not finish, escalated to a stronger one; compare with "
              "`orch models`)")
    if tot["usage_known"]:
        print(f"usage reported by agents on {tot['usage_known']} attempt(s): {tot['input_tokens']} input tokens, "
              f"{tot['output_tokens']} output tokens, ${tot['cost_usd']:.2f}")
    else:
        print("tokens/cost: unknown (no agent reported `usage` in its result file)")
    if "--no-time" in args:          # the summary (its only caller) has its own sections for the lines below
        return
    rows = risk_rows(st)
    if rows:
        print("\nundo and blast radius (where to look hardest before you merge):")
        for r in rows:
            print(f"  {r[0]} — undo: {r[1].replace('**', '')} — could break: {r[2]}"
                  + (f" — proof: {r[3]}" if r[3] != "-" else ""))
    if by_axis["spec"] or by_axis["rules"]:
        print(f"review findings: {len(by_axis['spec'])} spec (built what was asked?), {len(by_axis['rules'])} rules "
              f"(followed the repo's rules?)")
        for r, n in sorted(rules_broken.items(), key=lambda x: (-x[1], x[0])):
            print(f"  rule broken {n}x: {r}")


def git_common_dir(cwd=None):
    """The absolute .git folder of the repo `cwd` is in (a worktree's main repo .git), or None outside a repo."""
    try:
        r = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], text=True,
                           capture_output=True, timeout=10, cwd=str(cwd or ROOT or Path.cwd()))
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def fill_launch(cmd, cwd=None):
    """Put the repo's .git folder where a launch command says {git_dir}. Outside a repo the option that needs it is
    left out (with the `-c` before it), so the command still starts."""
    if "{git_dir}" not in cmd:
        return cmd
    gd = git_common_dir(cwd)
    out = []
    for tok in shlex.split(cmd):
        if "{git_dir}" in tok:
            if gd:
                out.append(tok.replace("{git_dir}", gd))
            elif out and out[-1] in ("-c", "--config"):
                out.pop()
            continue
        out.append(tok)
    return shlex.join(out)


def launch_cmd(kind, v, model=None, strict=True, role=None, cwd=None):
    """The shell command that starts agent `kind` in a pane, on `model` when given. With strict=False a kind
    without a model_flag starts on its default model instead of failing (the caller says so). role="reviewer"
    uses the kind's `review_launch` when it has one: the same tool with its code-editing tools turned off.
    role="lead" adds the kind's `lead_flags` (Codex: its question picker, so /orch-plan asks in a picker).
    A model `<id>@<level>` on a kind with an `effort_flag` starts <id> with that thinking level. `cwd` is the
    folder the agent will run in ({git_dir} is filled in from it)."""
    cmd = fill_launch((v.get("review_launch") if role == "reviewer" else None) or v.get("launch")
                      or v.get("binary", kind), cwd)
    if model:
        cat = models_catalog()
        why = model_denied(cat, model)
        if why:
            die(f"{model!r} is not allowed by the model policy (pattern {why!r}) — see `orch models`")
        if not v.get("model_flag"):
            if not strict:
                return cmd
            die(f"the registry has no `model_flag` for {kind}, so orch can't build the command — choose the "
                f"model inside {kind}, or set model_flag for it in {user_agents_file()}")
        kinds = ((cat or {}).get("models", {}).get(model.lower()) or {}).get("kinds")
        if kinds and kind not in kinds:
            print(f"WARN: the catalog lists {model} for {', '.join(kinds)}, not {kind}", file=sys.stderr)
        base, effort = split_effort(model) if v.get("effort_flag") else (model, None)
        cmd += f" {v['model_flag']} {shlex.quote(base)}"
        if effort:
            cmd += " " + v["effort_flag"].replace("{effort}", shlex.quote(effort))
    if role == "lead" and v.get("lead_flags"):
        cmd += " " + v["lead_flags"]
    return cmd


# ---------------------------------------------------------------- team: the whole team from one installed tool
TEAM_WAIT_S = float(os.environ.get("ORCH_TEAM_WAIT_S", "90"))


def team_models(cat, kind):
    """Catalog models this kind can run, allowed by policy and rated, weakest first: [(id, tier)]."""
    out = [(mid, model_tier(cat, mid)) for mid, m in ((cat or {}).get("models") or {}).items()
           if kind in (m.get("kinds") or []) and not model_denied(cat, mid)]
    return sorted(((mid, t) for mid, t in out if t), key=lambda x: (rank(x[1]), x[0]))


def team_pick(cands, n):
    """n coder models spread over the tiers on offer: always the strongest, then the weakest, then the middle."""
    if not cands:
        return [None] * n
    if n == 1:
        return [cands[-1][0]]
    idx = [round(i * (len(cands) - 1) / (n - 1)) for i in range(n)]
    return [cands[i][0] for i in idx]


def cmd_team(args):
    """orch team <kind> [--coders N] [--models a,b] [--no-reviewer] -> the plan's team built from one tool.
    orch team up [--dry-run] -> open a herdr pane for every agent in the plan that herdr cannot find."""
    if args and args[0] == "up":
        return team_up(args[1:])
    usage = "usage: orch team <kind> [--coders N] [--models a,b] [--no-reviewer]  |  orch team up [--dry-run]"
    rest, coders, models, reviewer = list(args), None, None, True
    if "--no-reviewer" in rest:
        rest.remove("--no-reviewer")
        reviewer = False
    for flag in ("--coders", "--models"):
        if flag in rest:
            i = rest.index(flag)
            val = rest[i + 1] if len(rest) > i + 1 else die(usage)
            del rest[i:i + 2]
            if flag == "--coders":
                coders = int(val) if val.isdigit() and int(val) >= 1 else die("--coders needs a number from 1")
            else:
                models = [m.strip().lower() for m in val.split(",") if m.strip()]
    if len(rest) != 1 or rest[0].startswith("-"):
        die(usage)
    kind = rest[0].lower()
    reg = registry()
    v = reg.get(kind) or die(f"unknown agent kind {kind!r} — known: {', '.join(reg)} (add it in {user_agents_file()})")
    if not shutil.which(v.get("binary", kind)):
        print(f"WARN: `{v.get('binary', kind)}` is not on PATH here, so {kind} panes would not start", file=sys.stderr)
    roles = v.get("roles", ["lead", "coder", "reviewer"])
    if "coder" not in roles:
        die(f"{kind} does not have the coder role in the agent registry")
    cat = models_catalog()
    cands = team_models(cat, kind)
    if models:
        for m in models:
            why = model_denied(cat, m)
            if why:
                die(f"{m!r} is not allowed by the model policy (pattern {why!r}) — see `orch models`")
        picked = models if coders is None else (models * coders)[:coders]
    else:
        picked = team_pick(cands, coders or 2)
    top = cands[-1][0] if cands else None
    no_flag = not v.get("model_flag")
    fmt = lambda name, m: f"{name} ({kind}: {m})" if m and not no_flag else f"{name} ({kind})"
    workers = [fmt(f"{kind}-{i + 1}", m) for i, m in enumerate(picked)]
    tier = {mid: t for mid, t in cands}
    print(f"TEAM from {kind}: {len(workers)} coder(s)" + (", 1 reviewer" if reviewer and "reviewer" in roles else ""))
    for i, m in enumerate(picked):
        print(f"  {kind + '-' + str(i + 1):<12} {m or 'its default model'}" + (f"  ({tier[m]} tier)" if m in tier else ""))
    if reviewer and "reviewer" in roles:
        print(f"  {'reviewer':<12} {top or 'its default model'}" + (f"  ({tier[top]} tier)" if top in tier else ""))
    print("\nPlan header lines:")
    print(f"Lead: lead ({kind}: <the model your own pane runs>)")
    print("Workers: " + ", ".join(workers))
    print("Reviewer: " + (fmt("reviewer", top) if reviewer and "reviewer" in roles else "none"))
    if not cands and not models:
        print(f"\nNOTE: the model catalog has no allowed model for {kind}, so every pane starts on its default model "
              f"(add models in {user_models_file()} to get tiers)")
    if no_flag:
        print(f"\nNOTE: {kind} has no model option in the registry: pick each pane's model inside {kind}")
    if top and tier.get(top) != "high":
        print(f"\nNOTE: the strongest allowed {kind} model is {top} ({tier.get(top)} tier): high-tier milestones go to "
              f"it, and `orch sync` will say so")
    if top and v.get("model_flag") and "lead" in roles:
        print(f"\nYour own lead pane on the strongest level (start it like this, then write `Lead: lead ({kind}: {top})`):"
              f"\n  {launch_cmd(kind, v, top, strict=False, role='lead')}")
    print(f"\nCheck these are models your {kind} really reaches (`--models a,b` to choose others).")
    print("\nThese panes don't exist yet. After `orch sync` and `orch start`, `orch team up` opens each one in its "
          "own folder, on its model, and names it.")


def _herdr_json(cmd):
    """Run a herdr command; (ok, parsed JSON or None, text)."""
    try:
        r = subprocess.run(cmd, text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, None, str(e)
    out = (r.stdout + r.stderr).strip()
    try:
        data = json.loads(r.stdout)
    except ValueError:
        data = None
    return r.returncode == 0, data, out


def team_up(args):
    """Open a pane for every worker and the reviewer in the plan that herdr can't find: split from this pane, cd
    into the agent's folder (its worktree, or the repo), start it on its plan model, and give it its plan name."""
    args = list(args)
    flag = mode_flag(args, "usage: orch team up [--dry-run] [--mode panes|subagent]")
    dry = "--dry-run" in args
    if flag and not dry:
        set_mode(flag, hint=False, agent=mode_target(flag, "usage: orch team up [--dry-run] [--mode panes|subagent]"))
    st = load()
    if (flag or run_mode(st)) == "subagent":
        print("mode subagent: no panes to open; the coder and the reviewer are Pi subagents")
        if dry:
            return
        sys.exit(1 if pi_setup() else 0)
    reg = registry(required=False) or {}
    agents = [(n, w, w.get("dir")) for n, w in st["workers"].items()]
    if st.get("reviewer"):
        agents.append((st["reviewer"], st.get("reviewer_info") or {}, str(ROOT)))
    missing_dirs = [n for n, w, d in agents if n in st["workers"] and not d]
    if missing_dirs:
        die(f"run `orch start` first: it makes each coder's folder ({', '.join(missing_dirs)} have none yet)")
    # after a restart: panes that only lost their name get it back, and a coder's own pane that came back as a
    # plain shell gets its agent started again, instead of a second pane next to it
    lead_pane = agent_pane(st["lead"]["name"]) if (st.get("lead") or {}).get("name") else None
    empty = {} if dry else rename_lost(dict(st, lead=None), hints=False, keep_out=[lead_pane] if lead_pane else [])
    todo = []
    for name, w, d in agents:
        if w.get("pane"):
            ok, _, _ = _herdr_json([HERDR, "pane", "get", w["pane"]])
            print(f"ok      {name}: pane {w['pane']}" if ok else
                  f"STALE   {name}: pane {w['pane']} is gone — remove `@pane:` from plan.md, `orch sync`, then "
                  f"`orch team up` again")
            continue
        if herdr_state(name) is not None:
            print(f"ok      {name}: already running")
            continue
        todo.append((name, w, d))
    if not todo:
        print("TEAM UP: every agent in the plan is running")
        return
    failed, last, opened = 0, None, []
    for name, w, d in todo:
        kind, model = w.get("kind"), w.get("model")
        v = reg.get(kind)
        if not v:
            print(f"SKIP    {name}: kind {kind!r} is not in the agent registry — start it yourself in {d}")
            failed += 1
            continue
        cmd = launch_cmd(kind, v, model, strict=False, role="reviewer" if name == st.get("reviewer") else None, cwd=d)
        split = [HERDR, "pane", "split"] + ([last] if last else []) + \
                ["--direction", "down" if last else "right", "--cwd", d, "--no-focus"]
        if dry:
            print(f"WOULD   {name}: {' '.join(shlex.quote(x) for x in split)}  then  herdr pane run <new pane> "
                  f"{shlex.quote(cmd)}  then  herdr agent rename <new pane> {name}")
            continue
        pid = empty.get(name)
        if not pid:
            ok, data, out = _herdr_json(split)
            try:
                pid = data["result"]["pane"]["pane_id"] if ok else None
            except (TypeError, KeyError):
                pid = (re.search(r'"pane_id"\s*:\s*"([\w:.-]+)"', out) or [None, None])[1]
            if not pid:
                print(f"FAILED  {name}: herdr could not open a pane ({out.splitlines()[-1] if out else 'no output'})")
                failed += 1
                continue
            last = pid
        # `cd` first: a split can start in the folder of the pane it splits from (herdr's new-pane folder setting),
        # and the reviewer must sit in the repo, not in a coder's worktree
        ok, _, out = _herdr_json([HERDR, "pane", "run", pid, f"cd {shlex.quote(str(d))} && {cmd}"])
        if not ok:
            print(f"FAILED  {name}: pane {pid} is there, but `herdr pane run` failed ({out[-120:]})")
            failed += 1
            continue
        if model and not v.get("model_flag"):
            print(f"NOTE    {name}: {kind} has no model option — switch pane {pid} to {model} inside {kind}")
        if not v.get("herdr_detect", True):
            _herdr_json([HERDR, "pane", "rename", pid, name])
            print(f"OPENED  {name}: pane {pid} in {short(d)} — herdr can't watch {kind}: write it as "
                  f"`{name} ({kind} @pane:{pid})` in plan.md, then `orch sync`")
            continue
        deadline, named = time.time() + TEAM_WAIT_S, False
        while True:          # herdr names an agent only once it has detected it in the pane
            ok, _, out = _herdr_json([HERDR, "agent", "rename", pid, name])
            if ok or time.time() >= deadline:
                named = ok
                break
            time.sleep(min(2.0, max(0.2, TEAM_WAIT_S / 30)))
        if named:
            print(f"OPENED  {name}: pane {pid} in {short(d)} running `{cmd}`")
            opened.append((name, w, pid, cmd))
        else:
            print(f"WAITING {name}: pane {pid} runs `{cmd}`, but herdr has not seen the agent start yet — if it "
                  f"shows a first-run question (trust this folder, sign in), answer it, then: herdr agent rename {pid} {name}")
            failed += 1
    if dry:
        return
    if opened:              # an agent can start, get its name, and quit a second later (a bad flag, a missing login)
        time.sleep(TEAM_CONFIRM_S)
        for name, w, pid, cmd in opened:
            where, _ = herdr_presence(name)
            if where == "agent":
                continue
            failed += 1
            saved = save_screen(name, f"{w.get('kind')} quit right after `orch team up` started it")
            print(f"QUIT    {name}: {w.get('kind')} exited right after it started — only a plain shell is left in "
                  f"pane {pid}, so nothing will be sent there. Run `{cmd}` in that pane yourself to see why"
                  + (f" (its last screen is in {short(saved)})" if saved else "") + ", then `orch team up` again")
            log_line(f"{run_tag(st)} QUIT {name}: {w.get('kind')} exited right after `orch team up` started it "
                     f"in pane {pid}")
    print("TEAM UP: done — run `orch start` again; every agent should show herdr=found" if not failed else
          f"TEAM UP: {failed} agent(s) not ready — see above, then `orch team up` again")
    if failed:
        sys.exit(3)


# ---------------------------------------------------------------- resume: carry on after a restart
def _dicts_with(obj, key, parent=None):
    """Every dict (with its parent dict) anywhere in a JSON value that has a string under `key`."""
    out = []
    if isinstance(obj, dict):
        if isinstance(obj.get(key), str):
            out.append((obj, parent))
        for v in obj.values():
            out += _dicts_with(v, key, obj)
    elif isinstance(obj, list):
        for v in obj:
            out += _dicts_with(v, key, parent)
    return out


def herdr_panes():
    """{pane id: {"cwds": [...], "kind": str or None}} from `herdr pane list` and `herdr agent list`, or None
    when herdr can't list panes. Read loosely: any object with a `pane_id`, its `cwd` / `foreground_cwd`, and the
    agent kind where herdr gives one, so a changed JSON layout still yields the ids and folders."""
    panes, listed = {}, False
    for sub in ("pane", "agent"):
        ok, data, _ = _herdr_json([HERDR, sub, "list"])
        if not ok or data is None:
            continue
        listed = True
        for d, parent in _dicts_with(data, "pane_id"):
            p = panes.setdefault(d["pane_id"], {"cwds": [], "kind": None})
            srcs = [d] + [x for x in (d.get("agent"), parent if sub == "agent" else None) if isinstance(x, dict)]
            for src in srcs:
                for k in ("foreground_cwd", "cwd"):
                    if isinstance(src.get(k), str) and src[k] and src[k] not in p["cwds"]:
                        p["cwds"].append(src[k])
                for k in ("agent_kind", "kind", "agent"):
                    if isinstance(src.get(k), str) and src[k] and not p["kind"]:
                        p["kind"] = src[k].lower()
    return panes if listed else None


def agent_pane(name):
    """The pane id herdr reports for a live agent name, or None."""
    ok, data, _ = _herdr_json([HERDR, "agent", "get", name])
    return _find_key(data, "pane_id") if ok and data is not None else None


def _inside(path, folder):
    a, b = os.path.realpath(path), os.path.realpath(folder)
    return a == b or a.startswith(b.rstrip("/") + "/")


def rename_lost(st, hints=True, keep_out=()):
    """herdr brings panes back after a restart, but not the agents' names, and orch reaches agents by name. For
    every agent in the plan that herdr can't find, look for its pane by folder and give the name back. A coder's
    worktree is its own folder, so one pane there is its pane. The reviewer and the lead sit in the main folder,
    next to the developer's own panes, so there the pane must also show the agent's kind. Where that can't be
    decided, print the exact command (hints=False: only say what was named).
    Never gives a coder's or the reviewer's name to the pane this command runs in (that is the developer's or the
    lead's own pane), nor to a pane in keep_out (the lead's, when the lead is not renamed here).
    Returns {name: pane id or None} for the agents still not found; a pane id means "its pane is there (a
    coder's own folder), but no agent runs in it"."""
    plan = [(n, w, w.get("dir") or str(ROOT), st["isolation"] == "worktree" and bool(w.get("dir")))
            for n, w in st["workers"].items()]
    if st.get("reviewer"):
        plan.append((st["reviewer"], st.get("reviewer_info") or {}, str(ROOT), False))
    if st.get("lead"):
        plan.append((st["lead"]["name"], st["lead"], str(ROOT), False))
    plan = [x for x in plan if not x[1].get("pane") and x[1].get("detect", True)]
    lost = [x for x in plan if herdr_state(x[0]) is None]
    if not lost:
        return {}
    say = print if hints else (lambda *_: None)
    panes = herdr_panes()
    if panes is None:
        for n, _, d, _ in lost:
            say(f"LOST    {n}: herdr has no agent with this name, and `herdr pane list` did not answer (is herdr "
                f"open?). Find its pane with `herdr agent list` (folder {short(d)}), then: herdr agent rename <pane> {n}")
        return {x[0]: None for x in lost}
    found = {x[0] for x in plan} - {x[0] for x in lost}
    taken = ({agent_pane(n) for n in found} | set(keep_out)) - {None}
    me = os.environ.get("HERDR_PANE_ID")
    lead_name = (st.get("lead") or {}).get("name")
    reg = registry(required=False) or {}
    still, pending, progress, cands = {}, list(lost), True, {}
    while pending and progress:                # a pane given to one agent can settle who gets another
        progress = False
        for item in list(pending):
            n, w, d, own = item
            kind = (w.get("kind") or "").lower()
            here = [pid for pid, p in panes.items() if pid not in taken and any(_inside(x, d) for x in p["cwds"])
                    and not (me and pid == me and n != lead_name)]
            same = [pid for pid in here if kind and panes[pid]["kind"]
                    and (kind in panes[pid]["kind"] or panes[pid]["kind"] in kind)]
            cands[n] = here
            pick = here[0] if own and len(here) == 1 else same[0] if len(same) == 1 else None
            if not pick:
                continue
            pending.remove(item)
            taken.add(pick)
            progress = True
            ok, _, _ = _herdr_json([HERDR, "agent", "rename", pick, n])
            if ok:
                print(f"NAMED   {n}: pane {pick} (in {short(d)}) has its name back")
                continue
            still[n] = pick if own else None
            v = reg.get(w.get("kind"))
            cmd = (launch_cmd(w.get("kind"), v, w.get("model"), strict=False,
                              role="reviewer" if n == st.get("reviewer") else None, cwd=d)
                   if v else (w.get("kind") or "<its agent>"))
            say(f"LOST    {n}: pane {pick} is in its folder ({short(d)}), but herdr sees no agent running in it. "
                + (f"`orch team up` starts it there; or start it yourself (`{cmd}`)" if own else
                   f"Start it there (`{cmd}`)") + f", then: herdr agent rename {pick} {n}")
    for n, w, d, own in pending:
        still[n] = None
        if cands.get(n):
            say(f"LOST    {n}: can't tell which pane is {n} ({', '.join(cands[n])} "
                f"{'is' if len(cands[n]) == 1 else 'are'} in {short(d)}). Look, then: herdr agent rename <pane> {n}")
        else:
            say(f"LOST    {n}: no pane is left in its folder ({short(d)}). `orch team up` opens one, or start it "
                f"yourself there and: herdr agent rename <pane> {n}")
    return still


RESUME_CODER = ("orch was restarted (the computer or herdr was off), so here is your task again. The changes you "
                "made before are still in this folder: look at them first (`git status`, `git diff`), keep what is "
                "right and carry on from there. Do not start over. ")
RESUME_REVIEWER = "orch was restarted (the computer or herdr was off), so here is your review task again. "


def cmd_resume(args):
    """orch resume -> carry on after a restart (the computer was off, herdr was closed, the event manager died).
    1. says how long orch was down, and does not count that time against any task;
    2. gives the agents' panes their names back (found by folder), or prints the exact rename command;
    3. saves unsaved files left in the coders' folders;
    4. sends each task that was in progress to its agent again (a fresh conversation carries on from the files);
    5. starts the event manager, which wakes the lead if events wait for it.
    Safe to run at any time and more than once. Exit 3: an agent with work in progress is still not found.
    (`--from-manager`: the event manager's own call when it starts; it does 1-4 only after a real gap.)"""
    from_manager = "--from-manager" in args
    waiting = []
    with state_lock():
        st = load()
        info = driver_info()
        mine = from_manager and bool(os.environ.get("ORCH_DRIVER")) and os.environ.get("ORCH_DRIVER") == info.get("token")
        if driver_alive() and not mine:
            print(f"The event manager is running ({driver_line(info)}), so the run is being watched.")
            if rename_lost(st):
                print("Fix the agents above; the event manager carries on by itself once herdr finds them.")
            else:
                print("Every agent in the plan is found. Nothing to resume.")
            return
        if not from_manager:
            dead = note_dead_manager(st)
            if dead:
                print(dead)
        beat = st["run"].get("beat")
        busy = [(tid, st["tasks"][tid]["wait"]) for tid in st["order"] if st["tasks"][tid].get("wait")]
        gap = account_downtime(st)
        save(st)
        if from_manager and not gap:
            return
        if gap and (busy or not from_manager):
            print(f"DOWN    orch was not running from {_clock(beat)} to {_clock(now())} ({_dur(gap)}). That time is "
                  f"not counted against any task or agent.")
        elif not from_manager:
            print("RESUME  the event manager is not running" + (f" (last seen {_clock(beat)})" if beat else "") + ".")
        for tid, w in busy:
            print(f"WAS     {tid} \"{st['tasks'][tid]['title']}\": {w['agent']} was "
                  + ("reviewing it" if w.get("kind") == "reviewer" else "working on it"))
        rename_lost(st)
        for name, w in st["workers"].items():
            saved = save_stray(st, name)
            if saved:
                print(saved)
        for tid, w in busy:
            agent = w["agent"]
            if any(w.get(k) and Path(w[k]).exists() for k in ("sentinel", "report", "result")):
                print(f"DONE    {tid}: {agent} had finished; the event manager takes it from here")
                continue
            if watched(st, agent):
                hs = herdr_state(agent)
                if hs is None:
                    waiting.append((tid, agent))
                    print(f"NOT SENT {tid}: {agent} is not found in herdr (see above)")
                    continue
                if word(hs, "working", "blocked"):
                    print(f"OK      {tid}: {agent} is already "
                          + ("at a question in its pane" if word(hs, "blocked") else "working"))
                    continue
            w["delivering"], w["since"] = True, now()   # recorded first, like every send: confirmed or sent again
            save(st)
            try:
                deliver(st, agent, (RESUME_REVIEWER if w.get("kind") == "reviewer" else RESUME_CODER) + w["prompt"])
            except DeliveryError as e:
                print(f"NOT SENT {tid} -> {agent}: {e} — the event manager sends it again")
                continue
            _delivered(st, agent)
            w["delivering"] = False
            save(st)
            print(f"RESENT  {tid} -> {agent}: it carries on from the files in its folder")
    if from_manager:
        return
    if waiting:
        print("NOT STARTED: " + ", ".join(f"{a} ({t})" for t, a in waiting) + " must be running first. Do what the "
              "LOST lines say, then run `orch resume` again. (To go on without them, run `orch autopilot`: their "
              "milestones then move to another coder with the work so far.)")
        sys.exit(3)
    print(start_manager())
    if lead_on(st):
        print("The lead is woken with `orch events` when something needs it.")


# ---------------------------------------------------------------- views: run summary, `orch view`, `orch board`
# Both views (and anything else) read one small, stable summary of the run: view_model(). It is built from state.json
# and events.jsonl only, never asks herdr, never takes the state lock and never writes, so a view can't slow or break
# a run. `orch status --json` prints it; `orch view` serves it to a browser page; `orch board` draws it as text.
VIEW_SCHEMA = 1
VIEW_GROUPS = {"pending": "waiting", "coding": "building", "needs-fix": "building", "conflict": "building",
               "verifying": "checking", "awaiting-review": "review", "reviewing": "review", "reviewed": "review",
               "committed": "landing", "held": "needs_you", "paused": "needs_you", "needs-answer": "needs_you",
               "failed": "needs_you", "merged": "landed", "skipped": "skipped"}
VIEW_WORDS = {"pending": "waiting", "coding": "building", "needs-fix": "fix round", "conflict": "fixing a conflict",
              "verifying": "checks running", "awaiting-review": "waiting for review", "reviewing": "in review",
              "reviewed": "reviewed", "committed": "landing", "held": "waits for your OK", "paused": "paused",
              "needs-answer": "needs your answer", "failed": "failed", "merged": "landed", "skipped": "skipped"}
VIEW_PORT = int(os.environ.get("ORCH_VIEW_PORT", "47231"))


def _usage_sum(rows):
    tok = cost = 0
    known = False
    for u in rows:
        if not isinstance(u, dict):
            continue
        known = True
        tok += int(u.get("input_tokens") or 0) + int(u.get("output_tokens") or 0)
        cost += float(u.get("cost_usd") or 0)
    return {"tokens": tok, "cost_usd": round(cost, 2)} if known else None


def view_events(limit=None):
    """events.jsonl as a list (oldest first); the last `limit` lines when given. Bad lines are skipped."""
    p = ORCH / "events.jsonl"
    try:
        lines = p.read_text().splitlines()
    except OSError:
        return []
    out = []
    for ln in (lines[-limit:] if limit else lines):
        with contextlib.suppress(ValueError):
            e = json.loads(ln)
            if isinstance(e, dict) and e.get("task"):
                out.append({k: e.get(k) for k in ("ts", "task", "from", "to", "why", "agent", "attempt")})
    return out


ORCH_OWN_MD = {"plan.md", "summary.md", "summary.prev.md", "story.md", "pr-body.md", "manual-tests.md",
               "questions.md"}   # questions.md: the lead writes it, orch reads it (asked_before_plan)


def other_plan_files(newer_than=0):
    """.orchestrate/*.md files that orch does not write itself and does not read (it reads plan.md only)."""
    out = []
    try:
        for f in sorted(ORCH.glob("*.md")):
            if f.name not in ORCH_OWN_MD and f.stat().st_mtime > newer_than:
                out.append(f.name)
    except OSError:
        pass
    return out


def _ago(secs):
    secs = max(0, int(secs))
    return ("less than a minute" if secs < 60 else f"{secs // 60} min" if secs < 3600 else
            f"{secs // 3600} h" if secs < 86400 else f"{secs // 86400} d")


def run_notices(st):
    """Plain-words notes for the views and `orch status` when what they show is not a run that is going now:
    the last run finished long ago, or a plan was written that orch will not read. Never fails."""
    try:
        try:
            state_t = STATE.stat().st_mtime
        except OSError:
            state_t = 0
        out = []
        if st is not None:
            tasks = st.get("tasks", {})
            active = any((tasks.get(t) or {}).get("status") in ACTIVE for t in st.get("order", []))
            done = bool(st.get("order")) and (
                all((tasks.get(t) or {}).get("status") in ("merged", "skipped") for t in st["order"])
                or any(e.get("kind") == "finished" for e in st.get("lead_events", [])))
            if active or driver_alive() or not done:
                return out                      # a run is going (or stopped half way): nothing to add
            out.append({"kind": "old_run", "text": (
                f"This is the last run ({st.get('title') or st.get('branch')}): all its milestones landed "
                f"{_ago(now() - state_t)} ago. No run is going now. For a new run, put the plan in "
                f".orchestrate/plan.md and run `orch sync`.")})
            try:
                if (ORCH / "plan.md").stat().st_mtime > state_t:
                    out.append({"kind": "plan_unsynced", "text": (
                        ".orchestrate/plan.md was changed after this run. Run `orch sync` to load it.")})
            except OSError:
                pass
        others = other_plan_files(state_t)
        if others:
            out.append({"kind": "other_plan", "text": (
                f"{', '.join('.orchestrate/' + o for o in others[:3])} "
                f"{'is' if len(others) == 1 else 'are'} not used: orch only reads .orchestrate/plan.md. "
                f"Rename or copy it to plan.md, then run `orch sync`.")})
        return out
    except Exception:
        return []


def view_model(st=None, recent=40):
    """The run in one stable shape ("view": 1). Adding fields is fine; renaming one needs "view": 2."""
    if st is None:
        try:
            st = json.loads(STATE.read_text())
        except (OSError, ValueError):
            return {"view": VIEW_SCHEMA, "empty": True, "repo": ROOT.name,
                    "text": "No run in this repo yet: the lead writes the plan, then `orch sync` / `orch start`.",
                    "notices": run_notices(None)}
    tasks, t_now = st.get("tasks", {}), now()
    ms, by_model = [], {}
    for tid in st.get("order", []):
        t = tasks.get(tid) or {}
        w = t.get("wait") or {}
        atts = [a for a in t.get("attempts", []) if isinstance(a, dict)]
        cur = max(0, t_now - w.get("started", w.get("since", t_now))) if w and t.get("status") in ACTIVE else 0
        for a in atts:
            if a.get("usage") and a.get("model"):
                by_model.setdefault(a["model"], []).append(a["usage"])
        open_ev = [e for e in st.get("lead_events", []) if e.get("task") == tid and e["kind"] in LEAD_BLOCKING
                   and event_open(st, e)]
        ms.append({
            "id": tid, "title": t.get("title", tid), "plain": t.get("plain") or "",
            "desc": (t.get("plain") or t.get("title") or tid).strip(),
            "status": t.get("status", "pending"), "group": VIEW_GROUPS.get(t.get("status"), "waiting"),
            "word": VIEW_WORDS.get(t.get("status"), t.get("status")),
            "deps": list(t.get("deps", [])), "worker": t.get("worker"), "tier": t.get("min_tier") or t.get("tier"),
            "role": t.get("role") or "", "attempt": t.get("attempt", 0), "fix": t.get("fix", 0),
            "review_round": t.get("review_round", 0), "reason": t.get("reason") or "",
            "question": (open_ev[-1].get("text") or "") if open_ev else "",
            "door": t.get("door"), "door_why": t.get("door_why"),
            "estimate_s": t.get("estimate_s"), "started": (w.get("started") or w.get("since")) if cur else None,
            "spent_s": int(sum(a.get("secs", 0) for a in atts) + cur),
            "usage": _usage_sum([a.get("usage") for a in atts if a.get("usage")]),
            "attempts": [{"kind": a.get("kind"), "agent": a.get("agent"), "model": a.get("model"),
                          "tier": a.get("tier"), "secs": a.get("secs"), "outcome": a.get("outcome")}
                         for a in atts[-12:]],
            "files": t.get("files", [])[:20],
        })
    agents = []
    if st.get("lead"):
        ld = st["lead"]
        ev_open = [e for e in st.get("lead_events", []) if event_open(st, e)]
        agents.append({"name": ld["name"], "role": "lead", "kind": ld.get("kind"), "model": ld.get("model"),
                       "tier": ld.get("tier"), "task": None,
                       "state": (f"{len(unread_events(st))} event(s) to read" if unread_events(st) else
                                 f"waiting ({len(ev_open)} open)" if ev_open else "waiting")})
    for n, w in st.get("workers", {}).items():
        cd = max(0, w.get("cooldown_until", 0) - t_now)
        state = ("off" if w.get("off") else "stopping" if w.get("stopping") else
                 "compacting" if w.get("compacting") and not w.get("task") else
                 (VIEW_WORDS.get(tasks.get(w["task"], {}).get("status"), "working") if w.get("task") else
                  f"benched {cd // 60}m" if cd else "free"))
        agents.append({"name": n, "role": "coder", "kind": w.get("kind"), "model": w.get("model"),
                       "tier": w.get("tier"), "task": w.get("task"), "state": state})
    if st.get("reviewer"):
        ri = st.get("reviewer_info") or {}
        busy = st.get("reviewer_busy")
        agents.append({"name": st["reviewer"], "role": "reviewer", "kind": ri.get("kind"), "model": ri.get("model"),
                       "tier": ri.get("tier"), "task": busy, "state": "reviewing" if busy else
                       "compacting" if ri.get("compacting") else "free"})
    groups = [m["group"] for m in ms]
    run = st.get("run") or {}
    return {
        "view": VIEW_SCHEMA, "repo": ROOT.name, "title": st.get("title") or st.get("branch"),
        "branch": st.get("branch"), "base": st.get("base"), "mode": st.get("mode") or "full",
        "orch_mode": st.get("orch_mode") or "panes", "updated": t_now,
        "manager": {"running": driver_alive(), "beat": run.get("beat"),
                    "applies": (st.get("orch_mode") or "panes") != "subagent"},   # subagent mode has no event manager
        "counts": {"total": len([g for g in groups if g != "skipped"]), "landed": groups.count("landed"),
                   "needs_you": groups.count("needs_you"),
                   "active": len([g for g in groups if g in ("building", "checking", "review", "landing")]),
                   "waiting": groups.count("waiting")},
        "time": {"driven_s": int(run.get("driven_s", 0)), "estimate_s": st.get("estimate_s")},
        "usage": {"total": _usage_sum([u for v in by_model.values() for u in v]),
                  "by_model": {k: _usage_sum(v) for k, v in by_model.items()}},
        "milestones": ms, "agents": agents,
        "lead": ({"name": st["lead"]["name"], "unread": len(unread_events(st)),
                  "open": len([e for e in st.get("lead_events", []) if event_open(st, e)])} if st.get("lead") else None),
        "recent": view_events(recent)[::-1],
        "all_done": bool(ms) and all(m["status"] in ("merged", "skipped") for m in ms),
        "notices": run_notices(st),
    }


def view_info():
    """The running `orch view` of this repo ({pid, port, url, ...}), or None."""
    try:
        v = json.loads((ORCH / "view.json").read_text())
        os.kill(int(v["pid"]), 0)
        return v
    except (OSError, ValueError, KeyError, TypeError):
        return None


def view_url(tid=None):
    v = view_info()
    return (v["url"] + (f"#{tid}" if tid else "")) if v else None


def _lan_ip():
    with contextlib.suppress(OSError):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            s.connect(("10.255.255.255", 1))          # no packet is sent: this only picks the outgoing address
            return s.getsockname()[0]
        finally:
            s.close()
    return None


def _view_snapshot_key():
    k = []
    for f in ("state.json", "events.jsonl"):
        with contextlib.suppress(OSError):
            s = (ORCH / f).stat()
            k.append((s.st_mtime_ns, s.st_size))
    return tuple(k)


def serve_view(port, lan, token, opened):
    """The `orch view` web server (Python's own library). Read-only: GET only, never writes the run."""
    import http.server
    import urllib.parse
    page = asset("view/index.html")
    if not page:
        die("view/index.html not found next to orch or in the install — reinstall herdr-orchestra")

    class H(http.server.BaseHTTPRequestHandler):
        server_version = "orch-view"

        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype):
            b = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(b)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(b)

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(u.query)
            host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]").lower()
            if not lan and host not in ("127.0.0.1", "localhost", "::1"):
                # another web page can't reach this one through a name it controls (DNS rebinding)
                return self._send(403, "orch view: open it as http://127.0.0.1:<port>/\n", "text/plain; charset=utf-8")
            if token and q.get("t", [""])[0] != token:
                return self._send(403, "orch view: this page needs the link with its token (printed by `orch view "
                                       "--lan`).\n", "text/plain; charset=utf-8")
            if u.path in ("/", "/index.html"):
                return self._send(200, page.read_text(), "text/html; charset=utf-8")
            if u.path == "/api/state":
                return self._send(200, json.dumps(view_model()), "application/json")
            if u.path == "/api/history":
                return self._send(200, json.dumps({"events": view_events()}), "application/json")
            if u.path == "/api/stream":
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                last, beat = None, time.time()
                try:
                    while True:
                        k = _view_snapshot_key()
                        if k != last:
                            last = k
                            self.wfile.write(f"event: state\ndata: {json.dumps(view_model())}\n\n".encode())
                            self.wfile.flush()
                            beat = time.time()
                        elif time.time() - beat > 15:
                            self.wfile.write(b": keep-alive\n\n")
                            self.wfile.flush()
                            beat = time.time()
                        time.sleep(0.5)
                except (OSError, ValueError):
                    return
            return self._send(404, "not found\n", "text/plain")

    class S(http.server.ThreadingHTTPServer):
        daemon_threads = True
        allow_reuse_address = True

    host = "0.0.0.0" if lan else "127.0.0.1"
    srv = None
    for p in ([port] if port else [*range(VIEW_PORT, VIEW_PORT + 20), 0]):
        try:
            srv = S((host, p), H)
            break
        except OSError:
            if port:
                die(f"port {port} is in use — try `orch view --port <another>` (or leave --port out)")
    real = srv.server_address[1]
    q = f"?t={token}" if token else ""
    url = f"http://127.0.0.1:{real}/{q}"
    info = {"pid": os.getpid(), "port": real, "url": url, "lan": bool(lan), "started": now()}
    if lan:
        info["lan_url"] = f"http://{_lan_ip() or '<this-computer-ip>'}:{real}/{q}"
    tmp = ORCH / "view.json.tmp"
    tmp.write_text(json.dumps(info))
    tmp.replace(ORCH / "view.json")
    print(f"orch view: {url}   (Ctrl-C to stop)")
    if lan:
        print(f"  from your phone (same Wi-Fi): {info['lan_url']}\n  anyone with this link and on your network can "
              f"see the run (not change it). Stop with Ctrl-C when done.")
    else:
        print(f"  over SSH: ssh -L {real}:127.0.0.1:{real} <this-computer>, then open the link on your own computer")
    sys.stdout.flush()
    if opened and os.environ.get("ORCH_VIEW_NO_OPEN") != "1" and (os.environ.get("DISPLAY") or
                                                                  os.environ.get("WAYLAND_DISPLAY") or sys.platform == "darwin"):
        import webbrowser
        with contextlib.suppress(Exception):
            webbrowser.open(url)

    def bye(*_):
        raise KeyboardInterrupt
    with contextlib.suppress(ValueError, OSError):
        signal.signal(signal.SIGTERM, bye)
    try:
        srv.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        with contextlib.suppress(OSError):
            v = json.loads((ORCH / "view.json").read_text())
            if v.get("pid") == os.getpid():
                (ORCH / "view.json").unlink()
        srv.server_close()


VIEW_PLUGIN_ID = "herdr-orchestra.board"
SIDEBAR_CONFIG = """# Add to herdr's config (~/.config/herdr/config.toml), then reload config in herdr.
# orch already renames each agent in herdr's normal sidebar during a run (e.g. "codex-1 · M2 building").
# These rows add one more line per agent (what its milestone is) and a run line on the Space:
[ui.sidebar.agents]
rows = [
  ["state_icon", "agent"],
  [{ token = "$orch_desc", dim = true }],
  ["workspace", "tab"],
]

[ui.sidebar.spaces]
rows = [
  ["state_icon", "workspace"],
  ["branch", "git_status"],
  [{ token = "$orch", fg = "#e5a93b", rules = [{ contains = "needs you", fg = "#e5675b", bold = true }] }],
]

# Optional: open the run board as a popup with one key (after `orch view plugin link`):
[[keys.command]]
key = "prefix+a"
type = "plugin_action"
command = "herdr-orchestra.board.open"
description = "orch run board"
"""


def cmd_view(args):
    """orch view [--lan] [--port N] [--no-open] [--bg] -> the run as a live picture in your browser (view only).
    orch view stop | status | herdr-config | plugin link|unlink"""
    sub = args[0] if args and not args[0].startswith("-") else None
    if sub == "status":
        v = view_info()
        print(f"orch view is running: {v['url']}" + (f"  (phone: {v['lan_url']})" if v.get("lan_url") else "")
              if v else "orch view is not running. Start it with `orch view` (or `orch view --bg`).")
        return
    if sub == "stop":
        v = view_info()
        if not v:
            print("orch view is not running.")
            return
        os.kill(int(v["pid"]), signal.SIGTERM)
        for _ in range(30):
            if not view_info():
                break
            time.sleep(0.1)
        print(f"stopped orch view ({v['url']})")
        return
    if sub == "herdr-config":
        print(SIDEBAR_CONFIG, end="")
        return
    if sub == "plugin":
        act = args[1] if len(args) > 1 else ""
        d = asset("view/herdr-plugin")
        if act == "link":
            if not d:
                die("view/herdr-plugin not found next to orch or in the install")
            r = subprocess.run([HERDR, "plugin", "link", str(d)], text=True, capture_output=True)
            print((r.stdout + r.stderr).strip() or f"linked {d}")
            if r.returncode == 0:
                print("To open the board with a key, add this to herdr's config.toml and restart herdr "
                      "(`orch view herdr-config` prints it too). prefix+a is free in herdr's defaults; "
                      "`prefix+?` shows every key in use. If the key is taken, herdr keeps its own and ignores this one.\n\n"
                      "[[keys.command]]\nkey = \"prefix+a\"\ntype = \"plugin_action\"\n"
                      "command = \"herdr-orchestra.board.open\"\ndescription = \"orch run board\"\n\n"
                      "Undo with `orch view plugin unlink`.")
            sys.exit(r.returncode)
        if act == "unlink":
            r = subprocess.run([HERDR, "plugin", "unlink", VIEW_PLUGIN_ID], text=True, capture_output=True)
            print((r.stdout + r.stderr).strip() or f"unlinked {VIEW_PLUGIN_ID}")
            sys.exit(r.returncode)
        die("usage: orch view plugin link|unlink   (herdr 0.7.4 or newer)")
    if sub:
        die(f"unknown `orch view {sub}` — use: orch view [--lan] [--port N] [--no-open] [--bg] | stop | status | "
            f"herdr-config | plugin link|unlink")
    lan = "--lan" in args
    port = 0
    if "--port" in args:
        i = args.index("--port")
        try:
            port = int(args[i + 1])
        except (IndexError, ValueError):
            die("usage: orch view --port <number>")
    v = view_info()
    if v and not ("--lan" in args and not v.get("lan")):
        print(f"orch view is already running: {v['url']}" + (f"\n  from your phone: {v['lan_url']}"
                                                              if v.get("lan_url") else ""))
        return
    if v:
        die("orch view is already running without --lan: `orch view stop`, then `orch view --lan`")
    if "--bg" in args:
        rest = [a for a in args if a != "--bg"]
        log = ORCH / "view.log"
        with open(log, "w") as f:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "view", "--no-open", *rest], cwd=ROOT,
                             stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
        for _ in range(50):
            v = view_info()
            if v:
                break
            time.sleep(0.1)
        if not v:
            die(f"orch view did not start — see {short(log)}")
        print(f"orch view: {v['url']}" + (f"\n  from your phone: {v['lan_url']}" if v.get("lan_url") else "")
              + "\n  stop it with `orch view stop`")
        return
    token = hashlib.sha256(os.urandom(32)).hexdigest()[:24] if lan else None
    serve_view(port, lan, token, "--no-open" not in args)


# ---- the event manager names each agent in herdr's sidebar (display only; herdr 0.6.3+, tokens 0.7.4+)
class SidebarNames:
    """Tells herdr, on a background thread, what each agent of the run is doing, so herdr's own sidebar says it:
    `codex-1 · M2 building`. Only changes are sent; nothing here can block or fail the event manager. Display only:
    herdr still finds agents by their real name. Off with ORCH_SIDEBAR=0."""
    TTL_MS = 3600000          # names fade out by themselves an hour after the last change (e.g. after a crash)
    REFRESH_S = 1200          # ...so a quiet name is sent again every 20 minutes

    def __init__(self):
        import queue
        import threading
        self.on = os.environ.get("ORCH_SIDEBAR", "1") != "0"
        self.sent, self.ws, self.panes, self.version, self.told, self.cleared = {}, None, {}, None, False, False
        self.q = queue.Queue()
        if self.on:
            threading.Thread(target=self._loop, daemon=True, name="orch-sidebar").start()
            atexit.register(self._final)

    def _final(self, wait_s=3):
        """The event manager is ending (stopped for the developer, done, Ctrl-C): send the last state it left."""
        if self.cleared:
            return
        with contextlib.suppress(Exception):
            self.update(json.loads(STATE.read_text()))
            end = time.time() + wait_s
            while self.q.unfinished_tasks and time.time() < end:
                time.sleep(0.05)

    def _herdr_version(self):
        try:
            r = subprocess.run([HERDR, "--version"], text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
            m = re.search(r"(\d+)\.(\d+)\.(\d+)", r.stdout + r.stderr)
            return tuple(int(x) for x in m.groups()) if m else None
        except (OSError, subprocess.TimeoutExpired):
            return None

    def _run(self, cmd):
        try:
            r = subprocess.run(cmd, text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
            ok = r.returncode == 0
            err = (r.stdout + r.stderr).strip()
        except (OSError, subprocess.TimeoutExpired) as e:
            ok, err = False, str(e)
        if not ok and not self.told:
            self.told = True
            with contextlib.suppress(Exception):
                log_line(f"sidebar names: herdr refused `{' '.join(cmd[1:4])}` ({err.splitlines()[-1] if err else 'no answer'})"
                         " — the run is not affected; agent names in herdr's sidebar may not show what they do")
        return ok

    def _pane(self, name, pane):
        if pane:
            return pane
        if name in self.panes:
            return self.panes[name]
        ok, data, _ = _herdr_json([HERDR, "agent", "get", name])
        pid = _find_key(data, "pane_id") if ok and data is not None else None
        if pid and not self.ws:
            self.ws = _find_key(data, "workspace_id")
        if pid:
            self.panes[name] = pid
        return pid

    def _loop(self):
        self.version = self._herdr_version()
        while True:
            job = self.q.get()
            with contextlib.suppress(Exception):
                if job[0] == "agent":
                    _, name, pane, disp, toks, clear = job
                    pid = self._pane(name, pane)
                    if not pid:
                        self.sent.pop(name, None)          # try again on the next change
                        continue
                    cmd = [HERDR, "pane", "report-metadata", pid, "--source", "orch"]
                    tokens_ok = self.version is None or self.version >= (0, 7, 4)
                    if clear:
                        cmd += ["--clear-display-agent"] + (sum((["--clear-token", k] for k in toks), [])
                                                            if tokens_ok else [])
                    else:
                        cmd += ["--display-agent", disp[:80]]
                        if tokens_ok:
                            for k, v in toks.items():
                                cmd += ["--token", f"{k}={v[:80]}"] if v else ["--clear-token", k]
                        cmd += ["--ttl-ms", str(self.TTL_MS)]
                    if not self._run(cmd):
                        self.panes.pop(name, None)
                elif job[0] == "space" and self.ws and (self.version is None or self.version >= (0, 7, 4)):
                    _, text = job
                    self._run([HERDR, "workspace", "report-metadata", self.ws, "--source", "orch"]
                              + (["--token", f"orch={text[:80]}", "--ttl-ms", str(self.TTL_MS)] if text
                                 else ["--clear-token", "orch"]))
            self.q.task_done()

    @staticmethod
    def labels(st):
        """{agent: (pane or None, display name, tokens)} for every agent of the run, and the Space line."""
        tasks, out = st.get("tasks", {}), {}

        def task_bits(tid):
            t = tasks.get(tid) or {}
            word = VIEW_WORDS.get(t.get("status"), t.get("status") or "")
            if t.get("status") == "coding" and t.get("attempt", 0) > 1:
                word += f" (try {t['attempt']})"
            if t.get("status") == "needs-fix" and t.get("fix"):
                word = f"fix round {t['fix']}"
            return word, {"orch_task": f"{tid} {t.get('title', '')}".strip(),
                          "orch_desc": (t.get("plain") or t.get("title") or "").strip()}
        for n, w in st.get("workers", {}).items():
            if w.get("off"):
                out[n] = (w.get("pane"), f"{n} · off", {"orch_task": "", "orch_desc": ""})
            elif w.get("task"):
                word, toks = task_bits(w["task"])
                out[n] = (w.get("pane"), f"{n} · {w['task']} {word}", toks)
            else:
                out[n] = (w.get("pane"), f"{n} · free", {"orch_task": "", "orch_desc": ""})
        if st.get("reviewer"):
            ri, busy = st.get("reviewer_info") or {}, st.get("reviewer_busy")
            if busy:
                _, toks = task_bits(busy)
                rr = (tasks.get(busy) or {}).get("review_round") or 1
                out[st["reviewer"]] = (ri.get("pane"), f"{st['reviewer']} · reviewing {busy} (round {rr})", toks)
            else:
                out[st["reviewer"]] = (ri.get("pane"), f"{st['reviewer']} · free", {"orch_task": "", "orch_desc": ""})
        if st.get("lead") and lead_on(st):
            ld = st["lead"]
            un = len(unread_events(st))
            out[ld["name"]] = (ld.get("pane"), f"{ld['name']} · " + (f"{un} event(s) to read" if un else "waiting"),
                               {"orch_task": "", "orch_desc": ""})
        groups = [VIEW_GROUPS.get(t.get("status"), "waiting") for t in tasks.values()]
        total = len([g for g in groups if g != "skipped"])
        need = groups.count("needs_you")
        space = f"orch: {groups.count('landed')}/{total} landed" + (f" · {need} needs you" if need else "")
        return out, space

    def update(self, st):
        if not self.on:
            return
        with contextlib.suppress(Exception):
            agents, space = self.labels(st)
            t = time.time()
            for n, (pane, disp, toks) in agents.items():
                key = (disp, tuple(sorted(toks.items())))
                old = self.sent.get(n)
                if old and old[0] == key and t - old[1] < self.REFRESH_S:
                    continue
                self.sent[n] = (key, t)
                self.q.put(("agent", n, pane, disp, toks, False))
            old = self.sent.get("\0space")
            if not old or old[0] != space or t - old[1] >= self.REFRESH_S:
                self.sent["\0space"] = (space, t)
                self.q.put(("space", space))

    def clear(self, st, wait_s=5):
        """Back to herdr's own names (end of the run). Waits a little for the queue, never long."""
        if not self.on:
            return
        self.cleared = True
        with contextlib.suppress(Exception):
            agents, _ = self.labels(st)
            for n, (pane, _, toks) in agents.items():
                self.q.put(("agent", n, pane, "", {"orch_task": "", "orch_desc": ""}, True))
            self.q.put(("space", ""))
            self.sent.clear()
            end = time.time() + wait_s
            while self.q.unfinished_tasks and time.time() < end:
                time.sleep(0.05)


def sidebar_clear_now(st):
    """`orch finish`: give every agent its own name back in herdr's sidebar (best effort, a few seconds at most)."""
    if os.environ.get("ORCH_SIDEBAR", "1") == "0" or run_mode(st) == "subagent":
        return
    SidebarNames().clear(st)


# ---- `orch board`: the run as text, for a herdr pane (or any terminal)
_C = {"g": "32", "b": "34", "t": "36", "p": "35", "r": "31", "a": "33", "d": "2", "B": "1"}
_GROUP_C = {"landed": "g", "building": "b", "checking": "t", "review": "p", "landing": "a", "needs_you": "r",
            "waiting": "d", "skipped": "d"}
_GROUP_ICON = {"landed": "✔", "building": "●", "checking": "●", "review": "●", "landing": "●", "needs_you": "■",
               "waiting": "○", "skipped": "-"}


def _fmt_min(s):
    if s is None:
        return "?"
    s = int(s)
    return f"{s // 3600}h {s % 3600 // 60}m" if s >= 3600 else f"{max(0, s) // 60}m"


def render_board(vm, width=100, color=True, sel=None, note=""):
    def c(k, s):
        return f"\x1b[{_C[k]}m{s}\x1b[0m" if color and k else s

    def cut(s, n):
        return s if len(s) <= n else s[:max(0, n - 1)] + "…"
    notes = [c("a", ln) for n in vm.get("notices", [])
             for ln in textwrap.wrap("! " + n["text"], max(30, width - 2), subsequent_indent="  ")]
    if vm.get("empty"):
        return [c("a", "orch board"), "", vm.get("text", "No run yet.")] + ([""] + notes if notes else [])
    cn = vm["counts"]
    out = [c("a", f"orch board · {vm.get('branch')}") + c("d", f"   {time.strftime('%H:%M')} · live"),
           c("B", f"{cn['landed']} of {cn['total']} landed")
           + (" · " + c("r", f"{cn['needs_you']} needs you") if cn["needs_you"] else "")
           + c("d", f" · {_fmt_min(vm['time']['driven_s'])} so far"
                    + (f" of ~{_fmt_min(vm['time']['estimate_s'])}" if vm["time"].get("estimate_s") else ""))]
    u = (vm.get("usage") or {}).get("total")
    if u:
        out.append(c("d", f"tokens {u['tokens'] / 1e6:.1f}M · cost ~${u['cost_usd']:.2f}"))
    if vm.get("all_done"):
        out.append(c("g", "ALL DONE — `orch finish` pushes the branch and opens the PR"))
    out += notes
    out += ["", c("d", "MILESTONES")]
    ms = {m["id"]: m for m in vm["milestones"]}
    kids = {}
    for m in vm["milestones"]:
        for d in m["deps"][:1]:
            kids.setdefault(d, []).append(m["id"])
    shown = set()
    name_w = max(18, min(34, width - 52))

    def line(m, pre, sub):
        g = m["group"]
        word = m["word"] + (f" {m['fix']}" if m["status"] == "needs-fix" and m.get("fix") else "")
        who = m.get("worker") or ""
        extra = (f"{_fmt_min(m['spent_s'])} of ~{_fmt_min(m['estimate_s'])}" if m.get("started")
                 and m.get("estimate_s") else f"{_fmt_min(m['spent_s'])}" if m["spent_s"] else "")
        if g == "waiting" and m["deps"]:
            word = "waits for " + ",".join(d for d in m["deps"] if ms.get(d, {}).get("group") != "landed") \
                if any(ms.get(d, {}).get("group") != "landed" for d in m["deps"]) else "ready"
        head = cut(f"{pre}{_GROUP_ICON[g]} {m['id']} {m['title']}", name_w + 8)
        out.append(head.ljust(name_w + 9).replace(_GROUP_ICON[g], c(_GROUP_C[g], _GROUP_ICON[g]), 1)
                   + c(_GROUP_C[g], word.ljust(16) if g != "needs_you" else "NEEDS YOU".ljust(16))
                   + c("d", f"{who}  {extra}".rstrip()))
        if m["desc"] and m["desc"] != m["title"]:
            out.append(sub + c("d", cut(m["desc"], width - len(sub) - 1)))
        if m["group"] == "needs_you" and (m.get("question") or m.get("reason")):
            out.append(sub + c("r", cut(f"\"{m.get('question') or m.get('reason')}\"", width - len(sub) - 1)))

    def walk(tid, prefix, last, depth):
        if tid in shown:
            return
        shown.add(tid)
        conn = "" if depth == 0 else ("└─ " if last else "├─ ")
        cont = prefix + ("" if depth == 0 else ("   " if last else "│  "))
        line(ms[tid], prefix + conn, cont + "   ")
        ch = [k for k in kids.get(tid, []) if k not in shown]
        for i, k in enumerate(ch):
            walk(k, cont, i == len(ch) - 1, depth + 1)
    for m in vm["milestones"]:
        if not any(d in ms for d in m["deps"][:1]):
            walk(m["id"], "", True, 0)
    for m in vm["milestones"]:
        walk(m["id"], "", True, 0)
    out += ["", c("d", "AGENTS")]
    for i, a in enumerate(vm["agents"]):
        busy = a.get("task") or a["role"] == "lead"
        col = "a" if a["role"] == "lead" else ("p" if a["role"] == "reviewer" else "b") if a.get("task") else "d"
        mark = "›" if sel == i else " "
        out.append(f"{mark}{c(col, '◆' if a['role'] == 'lead' else '●' if busy else '○')} "
                   f"{a['name']:<12} {str(a.get('kind') or ''):<8} {str(a.get('tier') or ''):<7} "
                   + c(col if busy else "d", (f"{a['task']} · " if a.get("task") else "") + a["state"]))
    if vm.get("recent"):
        out += ["", c("d", "LAST EVENTS")]
        for e in vm["recent"][:6]:
            out.append(c("d", time.strftime("%H:%M", time.localtime(e["ts"] or 0))) + f" {e['task']} {e['from']} → {e['to']}"
                       + (c("d", f"  {cut(e.get('why') or '', 50)}") if e.get("why") else ""))
    if note:
        out += ["", c("a", note)]
    out += ["", c("d", "[↑↓] pick agent  [enter] jump to it  [w] web view  [q] close")]
    return out


def cmd_board(args):
    """orch board [--once] [--no-color] -> the run as text, redrawn when it changes (for a herdr pane or popup)."""
    once = "--once" in args or not sys.stdout.isatty()
    color = "--no-color" not in args and sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    if once:
        print("\n".join(render_board(view_model(), shutil.get_terminal_size((100, 40)).columns, color)))
        return
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sel, note, last, drawn = None, "", None, 0.0
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\x1b[?1049h\x1b[?25l")
        while True:
            k = _view_snapshot_key()
            if k != last or time.time() - drawn > 30:
                last, drawn = k, time.time()
                vm = view_model()
                size = shutil.get_terminal_size((100, 40))
                lines = render_board(vm, size.columns, color, sel, note)[:size.lines]
                sys.stdout.write("\x1b[H\x1b[2J" + "\n".join(lines))
                sys.stdout.flush()
            r, _, _ = select.select([sys.stdin], [], [], 0.5)
            if not r:
                continue
            ch = os.read(fd, 8).decode(errors="ignore")
            n = len(vm.get("agents", []))
            if ch in ("q", "Q", "\x1b"):
                break
            if ch in ("\x1b[A", "k"):
                sel = (n - 1 if sel is None else max(0, sel - 1)) if n else None
            elif ch in ("\x1b[B", "j"):
                sel = (0 if sel is None else min(n - 1, sel + 1)) if n else None
            elif ch in ("\r", "\n") and sel is not None and n:
                a = vm["agents"][sel]
                r2 = subprocess.run([HERDR, "agent", "focus", a["name"]], text=True, capture_output=True)
                note = f"jumped to {a['name']}" if r2.returncode == 0 else f"herdr could not focus {a['name']}"
            elif ch in ("w", "W"):
                r2 = subprocess.run([sys.executable, os.path.abspath(__file__), "view", "--bg"], text=True,
                                    capture_output=True, cwd=ROOT)
                note = (r2.stdout.strip().splitlines() or ["orch view: could not start"])[0]
            last = None
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


