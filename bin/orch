#!/usr/bin/env python3
"""orch — deterministic state + scheduler for a Herdr multi-agent team.

The LEAD agent (any agent kind; see `orch lead plan`) calls these subcommands; the bookkeeping
(dependencies, who is free, sentinels, worktrees, merges) lives here so the
lead model never has to track it in its head.

State:   <main-repo>/.orchestrate/state.json
Plan:    <main-repo>/.orchestrate/plan.md   (human-editable, see orch-plan skill)

Task status flow (every change goes through move(), which checks TRANSITIONS)
  pending -> coding -> verifying -> [awaiting-review -> reviewing -> reviewed] -> committed -> merged
  side states: needs-answer, paused, failed, conflict, needs-fix, held (waiting for `orch approve`), skipped
Also: .orchestrate/events.jsonl (one line per transition), driver.lock (held by autopilot while it drives).
"""
import contextlib, fcntl, fnmatch, hashlib, json, os, re, shlex, shutil, signal, socket, subprocess, sys, time
from pathlib import Path

HERDR = os.environ.get("HERDR", "herdr")
CODER_BUDGET_MIN = int(os.environ.get("ORCH_CODER_BUDGET_MIN", "45"))
REVIEW_BUDGET_MIN = int(os.environ.get("ORCH_REVIEW_BUDGET_MIN", "15"))
IDLE_GRACE_S = int(os.environ.get("ORCH_IDLE_GRACE_S", "120"))
POLL_STEP_S = float(os.environ.get("ORCH_POLL_STEP_S", "10"))
HERDR_TIMEOUT_S = int(os.environ.get("ORCH_HERDR_TIMEOUT_S", "30"))
SEND_RETRY_S = int(os.environ.get("ORCH_SEND_RETRY_S", "120"))      # bench an agent we could not prompt
GONE_COOLDOWN_MIN = int(os.environ.get("ORCH_GONE_COOLDOWN_MIN", "10"))  # ends early once herdr sees it again
CONFIRM_S = int(os.environ.get("ORCH_CONFIRM_S", "30"))           # a prompt not confirmed by then is re-sent
MAX_LOST = int(os.environ.get("ORCH_MAX_LOST", "4"))               # lost attempts (unreachable, gone, rate limit)
UNREACHABLE_AFTER = int(os.environ.get("ORCH_UNREACHABLE_AFTER", "3"))   # failed prompts in a row before a long bench
UNREACHABLE_MIN = int(os.environ.get("ORCH_UNREACHABLE_MIN", "30"))
LEAD_REWAKE_S = int(os.environ.get("ORCH_LEAD_REWAKE_S", "300"))     # wake the lead again if it never read its events
LEAD_MAX_WAKES = int(os.environ.get("ORCH_LEAD_MAX_WAKES", "3"))     # ...this many times, then tell the developer
LEAD_WAIT_S = int(os.environ.get("ORCH_LEAD_WAIT_MIN", "15")) * 60   # ready work the lead never dispatched starts by itself
LEAD_IDLE_MAX_S = int(os.environ.get("ORCH_LEAD_IDLE_MAX_MIN", "720")) * 60   # give up waiting for answers after this
MAX_FIX = 3
MAX_REVIEW = 2
MAX_CONFLICT = 2
TASK_DIR = ".orch-task"
REF_NS = "refs/orch"   # hidden refs hold a milestone's work in progress: not branches, never pushed
# files nearly every milestone wants to touch: editing them in parallel milestones means merge conflicts
HOTSPOT_RE = re.compile(
    r"(^|/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|pubspec\.(yaml|lock)|"
    r"go\.(mod|sum)|pom\.xml|build\.gradle(\.kts)?|settings\.gradle|Cargo\.(toml|lock)|requirements\.txt|"
    r"pyproject\.toml|poetry\.lock|uv\.lock|docker-compose\.ya?ml|compose\.ya?ml|Makefile|\.env\.example|"
    r"App\.(tsx|jsx|vue|svelte)|main\.(ts|tsx|js|dart|go)|routes?\.\w+|router\.\w+)$", re.I)          # inside each work dir, git-excluded
# dependency manifests + lockfiles: when they change, a folder's setup command has to run again
LOCKFILE_RE = re.compile(
    r"(^|/)(package\.json|package-lock\.json|npm-shrinkwrap\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|"
    r"pubspec\.(yaml|lock)|go\.(mod|sum)|pom\.xml|build\.gradle(\.kts)?|Cargo\.(toml|lock)|requirements[\w.-]*\.txt|"
    r"pyproject\.toml|poetry\.lock|uv\.lock|Pipfile(\.lock)?|Gemfile(\.lock)?|composer\.(json|lock))$", re.I)
# changes that wait for `orch approve` before they land (plan header `Risk hold: off` turns this off)
RISK_RULES = [
    (re.compile(r"(^|/)(migrations?|migrate|alembic)/", re.I), "database migration"),
    (re.compile(r"^\.github/|(^|/)\.gitlab-ci\.ya?ml$|(^|/)Jenkinsfile$|^\.circleci/|(^|/)azure-pipelines\.ya?ml$"),
     "CI configuration"),
    (re.compile(r"(^|/)\.env(\.(?!example$|sample$|template$)[^/]+)?$|(^|/)[^/]*\.(pem|key|p12)$", re.I),
     "secrets or environment file"),
]
RISK_MAX_LINES = int(os.environ.get("ORCH_RISK_MAX_LINES", "1500"))
CHECK_TIMEOUT_S = int(os.environ.get("ORCH_CHECK_TIMEOUT_MIN", "30")) * 60
ACTIVE = {"coding", "verifying", "awaiting-review", "reviewing", "reviewed", "committed", "conflict", "needs-fix",
          "held"}
TERMINAL_OK = {"merged"}


# ---------------------------------------------------------------- helpers
def die(msg, code=2):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def sh(args, cwd=None, check=True):
    r = subprocess.run(args, cwd=cwd, text=True, capture_output=True)
    if check and r.returncode != 0:
        die(f"{' '.join(args)} failed:\n{r.stdout}{r.stderr}")
    return r


def git(*args, cwd=None, check=True):
    return sh(["git", *args], cwd=cwd, check=check)


def main_root():
    r = git("rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
    if r.returncode != 0:
        die("not inside a git repository")
    return Path(r.stdout.strip()).parent


ROOT = None
ORCH = None
STATE = None


def load():
    if not STATE.exists():
        die("no .orchestrate/state.json — run `orch sync` after writing plan.md")
    return migrate(json.loads(STATE.read_text()))


STATE_SCHEMA = 1


def migrate(st):
    """Bring a state file from an older orch up to STATE_SCHEMA (a missing `schema` key means 4.5 or older)."""
    if st.get("schema", 0) > STATE_SCHEMA:
        die(f"state.json was written by a newer orch (schema {st['schema']}) — upgrade herdr-orchestra")
    st["schema"] = STATE_SCHEMA
    st.setdefault("notified", [])
    st.setdefault("merging", None)
    st.setdefault("root_setup_hash", None)
    st.setdefault("run", {})
    st.setdefault("lead_mode", "off")
    st.setdefault("lead_events", [])
    st.setdefault("lead_seq", 0)
    for t in st.get("tasks", {}).values():
        t.setdefault("history", [])
        t.setdefault("lost", 0)
        t.setdefault("attempts", [])
    for w in st.get("workers", {}).values():
        w.setdefault("delivery_fails", 0)
    return st


_LOCK_DEPTH = 0


@contextlib.contextmanager
def state_lock():
    """Exclusive lock on .orchestrate/state.lock so two orch commands never lose each other's update."""
    global _LOCK_DEPTH
    if _LOCK_DEPTH:
        _LOCK_DEPTH += 1
        try:
            yield
        finally:
            _LOCK_DEPTH -= 1
        return
    with open(ORCH / "state.lock", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        _LOCK_DEPTH = 1
        try:
            yield
        finally:
            _LOCK_DEPTH = 0
            fcntl.flock(f, fcntl.LOCK_UN)


# usable while autopilot drives: reads, and the lead's requests (the event manager carries them out)
LEASE_FREE = {"status", "ready", "pick", "report", "approve", "autopilot", "events", "dispatch", "answer", "fix",
              "team"}
_LEASE = None


def driver_info():
    try:
        return json.loads((ORCH / "driver.lock").read_text() or "{}")
    except (OSError, ValueError):
        return {}


def driver_alive():
    """True while an `orch autopilot` holds the run's driver lease (the kernel drops it if autopilot dies)."""
    p = ORCH / "driver.lock"
    if not p.exists():
        return False
    with open(p, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            return True
        fcntl.flock(f, fcntl.LOCK_UN)
    return False


def driver_line(info):
    started = time.strftime("%H:%M:%S", time.localtime(info.get("started", 0)))
    return f"orch autopilot (pid {info.get('pid', '?')} on {info.get('host', '?')}, started {started})"


def require_driver():
    """Refuse to change a run another process is driving, unless we are that driver's own subcommand."""
    if not driver_alive():
        return
    info = driver_info()
    if os.environ.get("ORCH_DRIVER") and os.environ.get("ORCH_DRIVER") == info.get("token"):
        return
    die(f"this run is driven by {driver_line(info)} — wait for it to stop (or stop it) before changing the run "
        f"by hand; `orch status` and `orch approve` still work")


def take_lease():
    """Autopilot: hold .orchestrate/driver.lock for the whole run. A second driver fails here."""
    global _LEASE
    f = open(ORCH / "driver.lock", "a+")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        die(f"this run is already driven by {driver_line(driver_info())}")
    token = os.urandom(8).hex()
    f.seek(0)
    f.truncate()
    f.write(json.dumps({"pid": os.getpid(), "host": socket.gethostname(), "started": now(), "token": token}))
    f.flush()
    os.environ["ORCH_DRIVER"], os.environ["ORCH_DRIVER_PID"] = token, str(os.getpid())
    _LEASE = f


def task(st, tid):
    if tid not in st["tasks"]:
        die(f"unknown task {tid!r} — known: {', '.join(st['order']) or 'none'}")
    return st["tasks"][tid]


def need(args, n, usage):
    if len(args) < n:
        die(f"usage: orch {usage}")


_EVENTS = []   # transitions made by this process, appended to events.jsonl once the state that holds them is saved


def save(st):
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2))
    tmp.replace(STATE)
    if _EVENTS:
        with (ORCH / "events.jsonl").open("a") as f:
            for ev in _EVENTS:
                f.write(json.dumps(ev) + "\n")
        _EVENTS.clear()


def fault(point):
    """Test hook: ORCH_FAULT=<point> kills orch (and the autopilot driving it) right here, like a crash."""
    if os.environ.get("ORCH_FAULT") != point:
        return
    drv = os.environ.get("ORCH_DRIVER_PID")
    if drv and drv.isdigit():
        with contextlib.suppress(OSError):
            os.kill(int(drv), signal.SIGKILL)
    os._exit(99)


# Every status change goes through move(). Statuses not listed as a key are terminal.
_PARK = {"pending", "paused", "failed"}
TRANSITIONS = {
    "pending": {"coding", "needs-answer", "skipped"} | _PARK,
    "needs-answer": {"pending", "skipped"},
    "skipped": {"pending"},
    "coding": {"verifying", "needs-fix", "conflict"} | _PARK,
    "verifying": {"coding", "awaiting-review", "reviewing", "committed", "merged", "needs-fix", "held"} | _PARK,
    "awaiting-review": {"reviewing"} | _PARK,
    "reviewing": {"reviewed", "awaiting-review"} | _PARK,
    "reviewed": {"needs-fix", "committed", "merged", "held"} | _PARK,
    "needs-fix": {"coding"} | _PARK,
    "committed": {"merged", "conflict", "needs-fix", "held"} | _PARK,
    "held": {"committed"} | _PARK,
    "conflict": {"coding"} | _PARK,
    "paused": {"coding", "skipped"} | _PARK,
    "failed": {"skipped"} | _PARK,
    "merged": set(),
}
SET_OK = {"pending", "paused", "failed", "skipped"}   # what `orch set` allows without --force


def move(st, tid, to, why=None, force=False):
    """The only way a task's status changes: checks the transition, keeps a short history, logs an event."""
    t = st["tasks"][tid]
    frm = t.get("status")
    if to != frm and not force and to not in TRANSITIONS.get(frm, set()):
        die(f"{tid}: {frm} -> {to} is not an allowed transition"
            + ("" if frm != "merged" else " (merged is final)"))
    t["status"] = to
    if why is not None:
        t["reason"] = why
    if to != frm or why:
        ev = {"ts": now(), "task": tid, "from": frm, "to": to, "why": why or "",
              "agent": t.get("worker") or t.get("last_worker"), "attempt": t.get("attempt", 0)}
        if force:
            ev["forced"] = True
        hist = t.setdefault("history", [])
        hist.append({k: ev[k] for k in ("ts", "from", "to", "why")})
        del hist[:-50]
        _EVENTS.append(ev)
        if to != frm and to in LEAD_BLOCKING | {"merged"}:
            lead_event(st, to, tid, why or t.get("reason") or "")


# ---------------------------------------------------------------- the lead's event queue
# Every event the lead should hear about is stored in state.json in the same write as the change that caused it,
# so none is lost while the lead is paused or the event manager is down. `orch events` (the lead reading them)
# is the acknowledgement. A blocking event stays open until its task leaves that status.
LEAD_BLOCKING = {"paused", "failed", "held", "needs-answer"}


def lead_on(st):
    return st.get("lead_mode") == "events" and bool(st.get("lead"))


def lead_event(st, kind, tid, text):
    if not lead_on(st):
        return
    for e in st["lead_events"]:
        if not e.get("read") and (e["kind"], e.get("task"), e.get("text")) == (kind, tid, text):
            return                                   # the same thing, not yet read: one event is enough
    st["lead_seq"] = st.get("lead_seq", 0) + 1
    st["lead_events"].append({"id": st["lead_seq"], "ts": now(), "kind": kind, "task": tid, "text": text, "read": None})
    del st["lead_events"][:-200]


def event_open(st, e):
    """A blocking event is open while its task still has that status; other events are open until read."""
    if e["kind"] in LEAD_BLOCKING:
        return st["tasks"].get(e.get("task"), {}).get("status") == e["kind"]
    if e["kind"] == "ready":          # nothing left to dispatch: the news is stale
        return not e.get("read") and any(k in undispatched(st) for k in re.findall(r"M\d+", e.get("text") or ""))
    return not e.get("read")


def unread_events(st):
    return [e for e in st.get("lead_events", []) if not e.get("read") and event_open(st, e)]


def undispatched(st):
    """Ready milestones still waiting for the lead's `orch dispatch`."""
    if not lead_on(st):
        return []
    return [tid for tid in st["order"] if st["tasks"][tid]["status"] == "pending" and not st["tasks"][tid].get("go")
            and deps_met(st, st["tasks"][tid])]


def now():
    return int(time.time())


def _find_key(obj, key):
    if isinstance(obj, dict):
        if isinstance(obj.get(key), str):
            return obj[key]
        obj = list(obj.values())
    if isinstance(obj, list):
        for v in obj:
            found = _find_key(v, key)
            if found is not None:
                return found
    return None


def _status_field(obj):
    """The agent's status from `herdr agent get` JSON: `agent_status` anywhere, else `status` anywhere."""
    found = _find_key(obj, "agent_status")
    return found if found is not None else _find_key(obj, "status")


def herdr_state(agent):
    """The agent's lowercased status from `herdr agent get`, or None if herdr can't find it.
    Only the status field is matched, so a name or path containing "working" or "blocked" is not misread;
    output that isn't JSON falls back to the whole text."""
    try:
        r = subprocess.run([HERDR, "agent", "get", agent], text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    try:
        status = _status_field(json.loads(r.stdout))
    except ValueError:
        status = None
    return (status if status is not None else r.stdout + r.stderr).lower()


def word(state, *words):
    return state is not None and any(re.search(rf"\b{w}\b", state) for w in words)


class DeliveryError(Exception):
    """herdr could not deliver a prompt (agent unreachable, stale pane, herdr hung)."""


def _herdr_run(cmd):
    try:
        r = subprocess.run(cmd, text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise DeliveryError(f"{' '.join(cmd[:3])} timed out after {HERDR_TIMEOUT_S}s")
    except OSError as e:
        raise DeliveryError(f"{' '.join(cmd[:3])} failed: {e}")
    if r.returncode != 0:
        raise DeliveryError(f"{' '.join(cmd[:3])} failed: {r.stdout}{r.stderr}".strip())


def herdr_prompt(agent, text):
    _herdr_run([HERDR, "agent", "prompt", agent, text])


def agent_info(st, name):
    """Registry-derived facts about a worker or the reviewer: kind, detect (herdr can watch it), pane (@pane:<id>)."""
    if name in st.get("workers", {}):
        return st["workers"][name]
    if name and name == st.get("reviewer"):
        return st.get("reviewer_info") or {}
    if name and name == (st.get("lead") or {}).get("name"):
        return st["lead"]
    return {}


def watched(st, name):
    return agent_info(st, name).get("detect", True)


def deliver(st, agent, text):
    """Send a one-line prompt: by agent name, or by typing into the pane for `name (kind @pane:<id>)` agents.
    Raises DeliveryError when herdr can't deliver it."""
    pane = agent_info(st, agent).get("pane")
    if not pane:
        herdr_prompt(agent, text)
        return
    for cmd in ([HERDR, "pane", "send-text", pane, text], [HERDR, "pane", "send-keys", pane, "enter"]):
        try:
            _herdr_run(cmd)
        except DeliveryError as e:
            raise DeliveryError(f"{e} — pane {pane} for {agent} (stale pane id? re-check with `herdr pane list` "
                                f"and fix Workers/Reviewer in plan.md)")


# ---------------------------------------------------------------- shipped files + agent registry
def asset(rel):
    """A file shipped with orch: next to this script's checkout, else the installed `current` copy."""
    for base in (Path(__file__).resolve().parent.parent, Path.home() / ".local/share/herdr-orchestra/current"):
        if (base / rel).exists():
            return base / rel
    return None


def user_agents_file():
    return Path(os.environ.get("ORCH_AGENTS_FILE") or Path.home() / ".config/herdr-orchestra/agents.toml")


def registry(required=True):
    """agents.default.toml merged with the user's agents.toml (key by key per kind). None if tomllib is missing
    and not required, so plans keep working on Python < 3.11 with v4.2 behaviour."""
    try:
        import tomllib
    except ImportError:
        if required:
            die(f"the agent registry needs Python >= 3.11 (tomllib); this is Python {sys.version.split()[0]}")
        return None
    reg = {}
    src = asset("agents.default.toml")
    try:
        if src:
            reg = tomllib.loads(src.read_text())
        uf = user_agents_file()
        if uf.exists():
            for kind, vals in tomllib.loads(uf.read_text()).items():
                if isinstance(vals, dict):
                    reg.setdefault(kind, {}).update(vals)
    except tomllib.TOMLDecodeError as e:
        die(f"agent registry: {e}")
    return reg


def expand(p):
    return Path(os.path.expanduser(p))


# ---------------------------------------------------------------- model catalog: tiers, ratings, policy
TIERS = ("small", "medium", "high")
RATINGS = ("reasoning", "coding", "architecture", "instructions", "tools", "planning", "speed")
NEEDS = ("reasoning", "coding", "architecture", "long-context", "tool-use", "planning", "speed")


def user_models_file():
    return Path(os.environ.get("ORCH_MODELS_FILE") or Path.home() / ".config/herdr-orchestra/models.toml")


def models_catalog(required=False):
    """models.default.toml merged with the user's models.toml (key by key per model; policy and tiers per key).
    None when tomllib is missing and the catalog isn't required: plans then run without tiers, as before 4.7."""
    try:
        import tomllib
    except ImportError:
        if required:
            die(f"the model catalog needs Python >= 3.11 (tomllib); this is Python {sys.version.split()[0]}")
        return None
    cat = {"policy": {}, "tiers": {}, "models": {}}
    try:
        for src in (asset("models.default.toml"), user_models_file()):
            if not src or not src.exists():
                continue
            data = tomllib.loads(src.read_text())
            for sec in ("policy", "tiers"):
                cat[sec].update(data.get(sec) or {})
            for mid, vals in (data.get("models") or {}).items():
                if isinstance(vals, dict):
                    cat["models"].setdefault(mid.lower(), {}).update(vals)
    except tomllib.TOMLDecodeError as e:
        die(f"model catalog: {e}")
    return cat


def model_denied(cat, mid):
    """The policy pattern that forbids this model, or None."""
    if not cat or not mid:
        return None
    return next((pat for pat in cat["policy"].get("deny") or [] if fnmatch.fnmatch(mid.lower(), str(pat).lower())),
                None)


def model_tier(cat, mid):
    """The tier a model serves: its `tier`, capped by the reasoning floor of that tier. None = not in the catalog."""
    m = (cat or {}).get("models", {}).get((mid or "").lower())
    if not m:
        return None
    tier = str(m.get("tier", "")).lower()
    if tier not in TIERS:
        return None
    r = m.get("reasoning")
    while TIERS.index(tier) > 0 and isinstance(r, int) and r < int((cat["tiers"].get(tier) or {}).get("reasoning", 0)):
        tier = TIERS[TIERS.index(tier) - 1]
    return tier


def rank(tier):
    """0 for no tier (unrated, or a plan written before tiers), else 1..3."""
    return TIERS.index(tier) + 1 if tier in TIERS else 0


def need_rank(t):
    """What a milestone asks of its coder: its plan `Tier:`, raised by an escalation or by the lead."""
    return max(rank(t.get("tier")), rank(t.get("min_tier")))


def eligible_workers(st, t):
    """Workers allowed to take the task: its tier or higher (unrated workers count as any tier). When nobody on the
    team reaches the tier, the strongest workers the team has, so a run never waits for a model nobody started."""
    if t.get("assign") in st["workers"]:
        return [t["assign"]]
    need = need_rank(t)
    ranks = {n: rank(w.get("tier")) for n, w in st["workers"].items()}
    ok = [n for n, r in ranks.items() if not need or not r or r >= need]
    if not ok:
        top = max(ranks.values())
        ok = [n for n, r in ranks.items() if r == top]
    return ok


def cmd_models(args):
    """orch models [check <id> | show <id>] -> the model catalog: tiers, ratings, evidence, and what policy forbids."""
    cat = models_catalog(required=True)
    sub = args[0] if args else ""
    if sub in ("check", "show"):
        mid = (args[1] if len(args) > 1 else die(f"usage: orch models {sub} <model id>")).lower()
        why = model_denied(cat, mid)
        if why:
            print(f"DENIED {mid}: matches policy pattern {why!r} — {cat['policy'].get('deny_why', 'not allowed in runs')}")
            sys.exit(1)
        m = cat["models"].get(mid)
        if not m:
            print(f"UNRATED {mid}: not in the catalog — allowed, but it has no tier; add it to {user_models_file()}")
            sys.exit(0 if sub == "check" else 1)
        print(f"OK {mid}: tier {model_tier(cat, mid)}")
        if sub == "show":
            for k in ("kinds", *RATINGS, "context_k", "open_weights", "evidence"):
                if k in m:
                    print(f"  {k:<13} {', '.join(m[k]) if isinstance(m[k], list) else m[k]}")
        return
    if sub:
        die("usage: orch models [check <id> | show <id>]")
    print(f"{'model':<18} {'tier':<7} {'kinds':<17} {'reas':>4} {'code':>4} {'arch':>4} {'inst':>4} {'tool':>4} "
          f"{'plan':>4} {'speed':>5} {'ctx k':>6}  open")
    for tier in reversed(TIERS):
        for mid, m in cat["models"].items():
            if model_tier(cat, mid) != tier or model_denied(cat, mid):
                continue
            print(f"{mid:<18} {tier:<7} {','.join(m.get('kinds', [])):<17} "
                  + " ".join(f"{m.get(k, '-'):>4}" for k in RATINGS[:-1])
                  + f" {m.get('speed', '-'):>5} {m.get('context_k') or '-':>6}  {'yes' if m.get('open_weights') else 'no'}")
    print("\nTiers (a model needs this reasoning rating to serve the tier):")
    for tier in TIERS:
        tv = cat["tiers"].get(tier) or {}
        print(f"  {tier:<7} reasoning >= {tv.get('reasoning', '-')}: {tv.get('use', '')}")
    deny = cat["policy"].get("deny") or []
    print(f"\nNot allowed in runs: {', '.join(deny) or 'nothing'}" + (f" — {cat['policy']['deny_why']}" if deny and cat["policy"].get("deny_why") else ""))
    print(f"Ratings are starting points (`orch models show <id>` prints the evidence). Override or add models in "
          f"{user_models_file()}")


def ensure_excluded():
    exclude = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=ROOT).stdout.strip()) / "info" / "exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    lines = exclude.read_text().splitlines() if exclude.exists() else []
    for pat in (".orchestrate/", f"{TASK_DIR}/"):
        if pat not in lines:
            lines.append(pat)
    exclude.write_text("\n".join(lines) + "\n")


def is_dirty(path):
    return bool(git("status", "--porcelain", cwd=path).stdout.strip())


# ---------------------------------------------------------------- plan parsing
HEAD_RE = re.compile(r"^## \[( |x|X)\]\s*(M\d+)\s*:\s*(.+?)\s*$")
FIELD_RE = re.compile(r"^([A-Z][A-Za-z ]+):\s*(.*)$")


def parse_plan(text):
    """Header fields (before the first `## ` heading) -> cfg; `## [x] Mn: title` sections -> tasks.
    `Key: value` lines inside other sections (e.g. Global instructions) are text, never header fields."""
    cfg, tasks, cur, cur_field, in_header = {}, [], None, None, True
    for raw in text.splitlines():
        line = raw.rstrip()
        m = HEAD_RE.match(line)
        if m:
            cur = {"id": m.group(2), "enabled": m.group(1).lower() == "x", "title": m.group(3),
                   "fields": {}}
            tasks.append(cur)
            cur_field, in_header = None, False
            continue
        if line.startswith("## "):          # e.g. "## Global instructions"
            cur, cur_field, in_header = None, None, False
            continue
        fm = FIELD_RE.match(line.strip())
        if fm and not line.startswith((" ", "\t", "-")) and (cur or in_header):
            key, val = fm.group(1).strip().lower(), fm.group(2).strip()
            target = cur["fields"] if cur else cfg
            target[key] = [val] if val else []
            cur_field = (target, key)
            continue
        if fm and not cur and not in_header:
            cur_field = None
            continue
        if cur_field and line.strip():
            cur_field[0][cur_field[1]].append(line.strip())
    return cfg, tasks


DUR_RE = re.compile(r"(\d+(?:\.\d+)?)\s*(hours?|hrs|hr|h|minutes?|mins|min|m)", re.I)


def parse_dur(s):
    """`45m`, `1h30m`, `1.5h`, `90 min`, `2 hours` -> seconds; None when empty or not a duration."""
    s = (s or "").strip().lower()
    if not s or s in ("none", "-", "n/a", "unknown"):
        return None
    parts = DUR_RE.findall(s)
    if not parts or DUR_RE.sub("", s).strip(" ,+and") != "":
        return None
    return int(sum(float(n) * (3600 if u.startswith("h") else 60) for n, u in parts))


def field(t, key, default=""):
    vals = t["fields"].get(key)
    return " ".join(vals).strip() if vals else default


def split_ids(s):
    if not s or s.lower() in ("none", "-", "n/a"):
        return []
    return re.findall(r"M\d+", s)


def has_open_questions(t):
    vals = [v.lstrip("- ").strip().lower() for v in t["fields"].get("open questions", [])]
    vals = [v for v in vals if v]
    return bool(vals) and vals != ["none"]


AGENT_RE = re.compile(r"([\w.-]+)\s*\(\s*([\w.-]+)(?:\s*:\s*([^\s@)]+))?(?:\s+@pane:([^\s)]+))?\s*\)")


def parse_agents(s):
    """`claude-1 (claude: sonnet), hermes-1 (hermes @pane:w1:p3)` -> {name: (kind, pane or None)}"""
    return {name: (kind.lower(), pane or None) for name, kind, _, pane in AGENT_RE.findall(s or "")}


def parse_models(s):
    """`claude-1 (claude: sonnet), codex-1 (codex)` -> {name: "sonnet" or None}: the model each pane was started with."""
    return {name: (model.lower() or None) for name, _, model, _ in AGENT_RE.findall(s or "")}


def parse_workers(s):
    return {name: kind for name, (kind, _) in parse_agents(s).items()}


# ---------------------------------------------------------------- commands
def cmd_sync(args):
    plan = ORCH / "plan.md"
    if not plan.exists():
        die("missing .orchestrate/plan.md")
    plan_text = plan.read_text()
    cfg, tasks = parse_plan(plan_text)
    errors, warns = [], []

    get = lambda k, d="": " ".join(cfg.get(k, [])).strip() or d
    branch = get("branch").split()[0] if get("branch") else die("plan header needs `Branch: feature/<slug>`")
    if branch.startswith("orch/"):
        warns.append(f"Branch {branch}: runs now use one feature branch — prefer `Branch: feature/<slug>` "
                     f"(orch no longer makes per-milestone branches either way)")
    if git("check-ref-format", "--branch", branch, cwd=ROOT, check=False).returncode != 0:
        errors.append(f"Branch {branch!r} is not a valid git branch name")
    commits = get("commits", "per-milestone").split()[0].lower()
    if commits not in ("per-milestone", "single"):
        errors.append(f"Commits must be per-milestone or single, got {commits!r}")
    title_m = re.search(r"(?m)^# Plan:\s*(.+?)\s*$", plan_text)
    isolation = get("isolation", "worktree").split()[0].lower()
    if isolation not in ("worktree", "shared"):
        errors.append(f"Isolation must be worktree or shared, got {isolation!r}")
    try:
        max_par = int(re.findall(r"\d+", get("max parallel", "2"))[0])
    except IndexError:
        max_par = 2
    if isolation == "shared":
        max_par = 1
    scope = get("scope", "warn").split()[0].lower()
    if scope not in ("warn", "strict"):
        errors.append(f"Scope must be warn or strict, got {scope!r}")
    risk_hold = not get("risk hold", "on").lower().startswith("off")
    budget_s = None
    if get("budget"):
        bm = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*(h|m|min|hours?|minutes?)?\s*", get("budget"), re.I)
        if not bm:
            errors.append(f"Budget must look like `3h` or `90m`, got {get('budget')!r}")
        else:
            budget_s = max(1, int(float(bm.group(1)) * (60 if (bm.group(2) or "h").lower().startswith("m") else 3600)))
    workers = parse_agents(get("workers"))
    if not workers:
        errors.append("plan header needs `Workers: claude-1 (claude), codex-1 (codex)`")
    rev = get("reviewer", "none")
    rm = re.match(r"([\w.-]+)\s*\(", rev)
    reviewer = None if rev.lower().startswith("none") or not rm else rm.group(1)
    rev_kind, rev_pane = parse_agents(rev).get(reviewer, (None, None)) if reviewer else (None, None)
    lead = next(iter(parse_agents(get("lead")).items()), None)          # optional `Lead: lead (claude)`
    if get("lead") and not lead:
        errors.append("`Lead:` must look like `Lead: lead (claude)`")
    if lead:
        if lead[0] in workers:
            errors.append(f"lead {lead[0]!r} is also listed in Workers — the lead never codes in its own run")
        if lead[0] == reviewer:
            errors.append(f"lead {lead[0]!r} is also the Reviewer — the lead never reviews in its own run")
    reg = registry(required=False)
    cat = models_catalog()
    models = {**parse_models(get("workers")), **parse_models(rev), **parse_models(get("lead"))}
    unrated = set()
    for name, mid in models.items():
        why = model_denied(cat, mid)
        if why:
            errors.append(f"{name} runs {mid!r}, which the model policy does not allow (pattern {why!r}: "
                          f"{cat['policy'].get('deny_why', 'not allowed in runs')}) — pick another model (`orch models`)")
        elif mid and cat and model_tier(cat, mid) is None:
            unrated.add(mid)
            warns.append(f"{name} runs {mid!r}, which is not in the model catalog, so it has no tier — add it to "
                         f"{user_models_file()} (`orch models` shows the format)")
    tier_of = lambda name: model_tier(cat, models.get(name)) if models.get(name) else None
    lead_mode = get("lead mode", "events" if lead else "off").split()[0].lower()
    if lead_mode not in ("events", "off"):
        errors.append(f"Lead mode must be events or off, got {lead_mode!r}")
    if lead_mode == "events" and not lead:
        errors.append("`Lead mode: events` needs a `Lead: lead (<kind>)` header line")

    def detect(kind, pane, role):
        if pane:                       # addressed by pane id: herdr doesn't know it as an agent
            return False
        if reg is None:                # Python < 3.11: no registry, v4.2 behaviour
            return True
        if kind not in reg:
            warns.append(f"{role} kind {kind!r} is not in the agent registry (`orch agents`) — herdr may not "
                         f"watch it, so only its done file and time budget count")
            return False
        return bool(reg[kind].get("herdr_detect", True))

    ids = [t["id"] for t in tasks]
    dupes = {i for i in ids if ids.count(i) > 1}
    if dupes:
        errors.append(f"duplicate task ids: {sorted(dupes)}")
    by_id = {t["id"]: t for t in tasks}
    # "Depends on: M1 (uses the API types M1 defines), M2 (needs the table)": reasons in parentheses
    deps = {t["id"]: split_ids(re.sub(r"\([^)]*\)", "", field(t, "depends on", "none"))) for t in tasks}
    for t in tasks:
        raw = field(t, "depends on", "none")
        for d in deps[t["id"]]:
            if t["enabled"] and not re.search(rf"\b{d}\s*\(", raw):
                warns.append(f"{t['id']} depends on {d} without a reason — write `{d} (what it needs from {d})`")
    for tid, ds in deps.items():
        for d in ds:
            if d not in by_id:
                errors.append(f"{tid} depends on unknown task {d}")
            if d == tid:
                errors.append(f"{tid} depends on itself")

    # cycle detection
    color = {}
    def dfs(n, stack):
        color[n] = 1
        for d in deps.get(n, []):
            if d not in by_id:
                continue
            if color.get(d) == 1:
                errors.append("dependency cycle: " + " -> ".join(stack + [n, d]))
            elif not color.get(d):
                dfs(d, stack + [n])
        color[n] = 2
    for n in by_id:
        if not color.get(n):
            dfs(n, [])

    # transitive closure -> overlap warnings for tasks that can run in parallel
    def ancestors(n, seen=None):
        seen = set() if seen is None else seen
        for d in deps.get(n, []):
            if d in by_id and d not in seen:
                seen.add(d)
                ancestors(d, seen)
        return seen
    anc = {n: ancestors(n) for n in by_id}
    files = {n: {f.strip().strip("`") for f in re.split(r"[,\s]+", field(by_id[n], "likely files")) if f.strip()}
             for n in by_id}
    enabled = [t["id"] for t in tasks if t["enabled"]]
    parallel_pairs, hot_warned, any_parallel = [], set(), False
    for i, a in enumerate(enabled):
        for b in enabled[i + 1:]:
            if a in anc[b] or b in anc[a]:
                continue
            any_parallel = True
            common = files[a] & files[b]
            par = any(field(by_id[x], "parallel", "").lower().startswith("allow") for x in (a, b))
            if common and isolation == "worktree":
                warns.append(f"{a} and {b} both touch {sorted(common)}: " +
                             ("`Parallel: allow` runs them together — expect a merge conflict" if par else
                              "orch runs them one after the other (add `Depends on` to fix the order, or "
                              "`Parallel: allow` to run them together)"))
            if isolation == "shared":
                parallel_pairs.append((a, b))
            for x in (a, b):
                hot = sorted(f for f in files[x] if HOTSPOT_RE.search(f))
                if hot and isolation == "worktree" and x not in hot_warned:
                    hot_warned.add(x)
                    warns.append(f"{x} touches shared hotspot file(s) {hot} but can run in parallel with "
                                 f"{b if x == a else a} — move those edits into a scaffold milestone both depend on")
    # split for the team you have: idle coders on a chain, or parallel work with nobody to run it
    if len(workers) >= 2 and len(enabled) >= 2 and not any_parallel:
        warns.append(f"{len(workers)} coders but every milestone depends on the one before, so only one coder "
                     f"works at a time — if the feature spans backend and frontend, put the contract under "
                     f"Interfaces (or in a small contract milestone) so both sides can run in parallel")
    if len(workers) == 1 and any_parallel and isolation == "worktree":
        warns.append("1 coder: independent milestones will still run one at a time — "
                     "`Isolation: shared` is simpler unless you will add coders")
    if parallel_pairs:
        a, b = parallel_pairs[0]
        warns.append(f"{a} and {b} are independent — with `Isolation: worktree` they could run in parallel "
                     f"(shared mode runs one milestone at a time)")

    # the lead describes WHAT and WHY; coders decide HOW
    try:
        secs, _ = plan_sections()
    except Exception:
        secs = {}
    for tid in enabled:
        sec = secs.get(tid, "")
        if "```" in sec:
            warns.append(f"{tid} contains a code block — describe what and why; the coder decides how")
        elif re.search(r"(?im)^\s*(step\s*\d+\b|\d+\.\s*(create|add|implement|write|call|refactor|update|use|"
                       r"install|modify)\b)", sec):
            warns.append(f"{tid} reads like step-by-step implementation — state the goal and acceptance "
                         f"criteria; the coder decides how")

    for tid in enabled:
        crit = [v.lstrip("- ").strip() for v in by_id[tid]["fields"].get("acceptance criteria", [])]
        if not [c for c in crit if c and c.lower() != "none"]:
            warns.append(f"{tid} has no Acceptance criteria — the coder's result and the review check each one")

    # tiers: what each milestone asks of its coder's model, and whether the team can give it
    tiers, needs = {}, {}
    worker_ranks = [rank(tier_of(n)) for n in workers]
    for t in tasks:
        tid = t["id"]
        tv = (field(t, "tier", "any").split() or ["any"])[0].lower()
        if tv not in TIERS + ("any",):
            errors.append(f"{tid}: Tier must be small, medium or high, got {tv!r}")
            tv = "any"
        tiers[tid] = None if tv == "any" else tv
        needs[tid] = [n for n in re.split(r"[,\s]+", field(t, "needs").lower()) if n]
        bad = [n for n in needs[tid] if n not in NEEDS]
        if bad:
            warns.append(f"{tid}: Needs has unknown value(s) {bad} — use any of: {', '.join(NEEDS)}")
        if not t["enabled"] or not tiers[tid]:
            continue
        if not field(t, "model why"):
            warns.append(f"{tid} has `Tier: {tv}` but no `Model why:` — say in one line why this tier fits")
        if any(worker_ranks) and not any(r == 0 or r >= rank(tv) for r in worker_ranks):
            warns.append(f"{tid} asks for a {tv}-tier model, but no coder in Workers runs one — it will go to the "
                         f"strongest coder you have; start a coder with a {tv}-tier model (`orch models`) or lower the tier")
        elif not any(worker_ranks) and workers:
            warns.append(f"{tid} has `Tier: {tv}`, but Workers does not say which model each coder runs — write "
                         f"`name (kind: model)` so the tier can be honoured")
        if (field(t, "review", "no").lower().startswith("y") and reviewer and rank(tier_of(reviewer))
                and rank(tier_of(reviewer)) < rank(tv)):
            warns.append(f"{tid} is {tv}-tier work reviewed by a {tier_of(reviewer)}-tier model ({models[reviewer]}) — "
                         f"a reviewer weaker than the coder misses design errors")
    if lead and models.get(lead[0]) and rank(tier_of(lead[0])) not in (0, 3):
        warns.append(f"the lead runs {models[lead[0]]!r} ({tier_of(lead[0])} tier) — planning and coordination are "
                     f"high-tier work")

    # time estimates: the lead's guess per milestone and for the feature, held against the time orch measures
    estimates = {}
    for t in tasks:
        raw = field(t, "estimate")
        estimates[t["id"]] = parse_dur(raw)
        if raw and estimates[t["id"]] is None and raw.lower() not in ("none", "-", "n/a", "unknown"):
            errors.append(f"{t['id']}: Estimate must look like `40m`, `1h30m` or `2h`, got {raw!r}")
        elif not raw and t["enabled"]:
            warns.append(f"{t['id']} has no `Estimate:` — say how long it should take from dispatch to landed "
                         f"(e.g. `Estimate: 40m`), so the summary can compare it with the real time")
    feature_est = parse_dur(get("estimate"))
    if get("estimate") and feature_est is None:
        errors.append(f"Estimate must look like `2h` or `1h30m`, got {get('estimate')!r}")
    elif not get("estimate"):
        warns.append("plan header has no `Estimate:` — how long the whole feature should take, with parallel "
                     "milestones counted once (e.g. `Estimate: 2h`)")

    # the feature decides how many milestones there are: every split has to say what it buys
    if len(enabled) > 1:
        for tid in enabled:
            if not field(by_id[tid], "why separate"):
                warns.append(f"{tid} has no `Why separate:` — say why it is its own milestone (parallel work, a "
                             f"foundation others build on, too big for one sitting), or merge it into another")
    max_tasks = int(os.environ.get("ORCH_MAX_TASKS", "0") or 0)     # no limit unless you set one
    if max_tasks and len(enabled) > max_tasks:
        warns.append(f"{len(enabled)} enabled milestones (> ORCH_MAX_TASKS={max_tasks}). Merge coupled milestones "
                     f"or split the feature into separate runs")

    if errors:
        for e in errors:
            print("ERROR:", e)
        sys.exit(2)

    old = json.loads(STATE.read_text()) if STATE.exists() else {}
    old_tasks = old.get("tasks", {})
    base = get("base") or old.get("base")
    if base and base.split()[0] == branch:
        errors.append(f"Base and Branch are both {branch!r}")
    if base and git("check-ref-format", "--branch", base.split()[0], cwd=ROOT, check=False).returncode != 0:
        errors.append(f"Base {base!r} is not a valid git branch name")
    if errors:
        for e in errors:
            print("ERROR:", e)
        sys.exit(2)
    st = {
        "branch": branch,
        "base": base.split()[0] if base else None,
        "title": title_m.group(1) if title_m else branch,
        "commits": commits,
        "integration_broken": old.get("integration_broken"),
        "schema": STATE_SCHEMA,
        "notified": old.get("notified", []),
        "merging": old.get("merging"),
        "root_setup_hash": old.get("root_setup_hash"),
        "run": old.get("run", {}),
        "isolation": isolation,
        "max_parallel": max_par,
        "setup_inputs": [p.strip("`") for p in re.split(r"[,\s]+", get("setup inputs")) if p.strip("`")],
        "scope": scope,
        "risk_hold": risk_hold,
        "budget_s": budget_s,
        "estimate_s": feature_est,
        "check": get("check command"),
        "setup": get("setup command", "none"),
        "reviewer": reviewer,
        "reviewer_info": ({"kind": rev_kind, "pane": rev_pane, "detect": detect(rev_kind, rev_pane, "Reviewer"),
                           "model": models.get(reviewer), "tier": tier_of(reviewer),
                           **({k: v for k, v in (old.get("reviewer_info") or {}).items()
                               if k in ("cooldown_until", "cooldown_reason") and v is not None}
                              if old.get("reviewer") == reviewer else {})}
                          if reviewer else None),
        "reviewer_busy": old.get("reviewer_busy") if old.get("reviewer") == reviewer else None,
        "lead": ({"name": lead[0], "kind": lead[1][0],
                  **({"pane": lead[1][1]} if lead[1][1] else {}),
                  **({"model": models[lead[0]], "tier": tier_of(lead[0])} if models.get(lead[0]) else {}),
                  **({"detect": False} if lead_mode == "events" and not detect(lead[1][0], lead[1][1], "Lead") else {})}
                 if lead else None),
        "lead_mode": lead_mode,
        "lead_events": old.get("lead_events", []),
        "lead_seq": old.get("lead_seq", 0),
        "lead_wake": old.get("lead_wake"),
        "lead_ready_told": old.get("lead_ready_told"),
        "workers": {},
        "order": ids,
        "tasks": {},
    }
    for name, (kind, pane) in workers.items():
        ow = old.get("workers", {}).get(name, {})
        st["workers"][name] = {"kind": kind, "task": ow.get("task"), "cooldown_until": ow.get("cooldown_until", 0),
                               "cooldown_reason": ow.get("cooldown_reason", ""),
                               "dir": ow.get("dir"), "setup_done": ow.get("setup_done", False),
                               "setup_hash": ow.get("setup_hash"), "delivery_fails": ow.get("delivery_fails", 0),
                               "pane": pane, "detect": detect(kind, pane, "Workers"),
                               "model": models.get(name), "tier": tier_of(name)}
    for t in tasks:
        tid = t["id"]
        o = old_tasks.get(tid, {})
        status = o.get("status", "pending")
        if not t["enabled"] and status not in ACTIVE | TERMINAL_OK:
            status = "skipped"
        elif t["enabled"] and status == "skipped":
            status = "pending"
        q = has_open_questions(t)
        if status == "pending" and q:
            status = "needs-answer"
        elif status == "needs-answer" and not q:
            status = "pending"
        st["tasks"][tid] = {
            **o,  # keep runtime fields (last_report, review_ok, conflicts, ...)
            "title": t["title"], "deps": deps[tid],
            "prefer": field(t, "prefer", "any").split()[0].lower() if field(t, "prefer", "any") else "any",
            "review": field(t, "review", "no").lower().startswith("y") and reviewer is not None,
            "status": o.get("status", "pending"), "reason": o.get("reason", ""),
            "worker": o.get("worker"), "dir": o.get("dir"), "attempt": o.get("attempt", 0),
            "fix": o.get("fix", 0), "review_round": o.get("review_round", 0),
            "wait": o.get("wait"),
            "files": sorted(files[tid]),
            "parallel": field(t, "parallel", "").lower().startswith("allow"),
            "tier": tiers[tid], "needs": needs[tid], "model_why": field(t, "model why"),
            "estimate_s": estimates[tid],
        }
        if status != st["tasks"][tid]["status"]:
            move(st, tid, status, {"skipped": "unticked in plan.md", "needs-answer": "open questions in plan.md"}
                 .get(status, ""), force=True)
    for tid, t in st["tasks"].items():
        skipped = [d for d in t["deps"] if st["tasks"][d]["status"] == "skipped"]
        if skipped and t["status"] in ("pending", "needs-answer"):
            move(st, tid, "needs-answer", f"depends on skipped {', '.join(skipped)} — ask the developer", force=True)
            warns.append(f"{tid} depends on skipped {skipped}")
    # a coder (or the reviewer) can't stay tied to a milestone that left the plan or is no longer in progress
    for name, w in st["workers"].items():
        held = st["tasks"].get(w["task"]) if w.get("task") else None
        if w.get("task") and (held is None or held["status"] not in ACTIVE or held.get("worker") != name):
            warns.append(f"{name} was holding {w['task']}, which is no longer in progress — freed")
            w["task"] = None
    rb = st["tasks"].get(st["reviewer_busy"]) if st.get("reviewer_busy") else None
    if st.get("reviewer_busy") and (rb is None or rb["status"] != "reviewing"):
        st["reviewer_busy"] = None
    migrate(st)
    save(st)
    for w in warns:
        print("WARN:", w)
    print(f"OK: {len(tasks)} tasks, isolation={isolation}, max_parallel={max_par}, "
          f"workers={list(workers)}, reviewer={reviewer}" + (f", lead={lead[0]}" if lead else ""))


# ---------------------------------------------------------------- git: one feature branch, hidden refs per milestone
def task_ref(st, tid):
    """Hidden ref holding Mn's work in progress (for review, parked, waiting for a fix): never a branch, never pushed."""
    return f"{REF_NS}/{st['branch'].replace('/', '-')}/{tid}"


def ref_ok(ref, cwd=None):
    return git("rev-parse", "--verify", "--quiet", ref + "^{commit}", cwd=cwd or ROOT, check=False).returncode == 0


def legacy_branch(st, tid):
    """Task branch name used before 4.5 (orch/<slug>-Mn); read once so in-flight runs keep their work."""
    return f"refs/heads/{st['branch']}-{tid}"


def work_ref(st, tid):
    """Where Mn's saved work lives: its hidden ref, else a pre-4.5 task branch, else None."""
    for ref in (task_ref(st, tid), legacy_branch(st, tid)):
        if ref_ok(ref):
            return ref
    return None


def ahead_of_branch(st, d):
    """True if HEAD in d has commits the feature branch doesn't."""
    r = git("rev-list", "--count", f"{st['branch']}..HEAD", cwd=d, check=False)
    return r.returncode == 0 and r.stdout.strip() not in ("", "0")


def wip_commit(d, msg):
    """Internal commit that only ever lands on a hidden ref (hooks skipped: it is not a real commit)."""
    git("add", "-A", cwd=d)
    r = git("commit", "-q", "--no-verify", "-m", msg, cwd=d, check=False)
    if r.returncode != 0 and "nothing to commit" not in (r.stdout + r.stderr):
        die(r.stdout + r.stderr)


def stash_to_ref(st, tid):
    """Shared mode: move the tree's uncommitted work into Mn's hidden ref and leave the tree clean."""
    if not is_dirty(ROOT):
        return False
    git("stash", "push", "--include-untracked", "-q", "-m", f"orch {tid}", cwd=ROOT)
    sha = git("rev-parse", "stash@{0}", cwd=ROOT).stdout.strip()
    git("update-ref", task_ref(st, tid), sha, cwd=ROOT)
    git("stash", "drop", "-q", cwd=ROOT)
    return True


def restore_stash(st, tid):
    """Shared mode: put Mn's parked work back into the (clean) tree and drop its ref."""
    ref = task_ref(st, tid)
    sha = git("rev-parse", ref, cwd=ROOT).stdout.strip()
    r = git("stash", "apply", "-q", sha, cwd=ROOT, check=False)
    if r.returncode != 0:
        git("reset", "--hard", "-q", "HEAD", cwd=ROOT)
        git("clean", "-fdq", cwd=ROOT)        # the tree was clean before the apply: only its leftovers go
        die(f"could not restore {tid}'s parked work: it conflicts with what landed since. It is kept in {ref} "
            f"(`git stash apply {sha}` to look at it)\n{r.stdout}{r.stderr}")
    git("update-ref", "-d", ref, cwd=ROOT)


def commit_message(st, tid):
    """Commit message for a landed milestone: the coder's `COMMIT:` line (what changed), else the title.
    The milestone id is a trailer, never the subject."""
    t = st["tasks"][tid]
    subject = (t.get("commit_msg") or "").strip() or t["title"]
    return f"{subject}\n\nMilestone: {tid}"


def report_commit_line(path):
    p = Path(path)
    if not p.exists():
        return None
    lines = [l.strip().split(":", 1)[1].strip().strip("`").strip() for l in p.read_text().splitlines()
             if l.strip().upper().startswith("COMMIT:")]
    lines = [l for l in lines if l]
    return lines[-1][:120] if lines else None


def read_json(path):
    """(data, None) or (None, "missing" | "not valid JSON: ...")."""
    try:
        return json.loads(Path(path).read_text()), None
    except FileNotFoundError:
        return None, "missing"
    except (OSError, ValueError) as e:
        return None, f"not valid JSON: {e}"


RESULT_FORMAT = {
    "status": "done | question | blocked",
    "commit": "feat(api): add the categories endpoint",
    "files_changed": ["src/routes/categories.ts", "test/categories.test.ts"],
    "check": {"ran": True, "passed": True, "summary": "lint ok, 42 tests pass"},
    "criteria": [{"id": "AC1", "met": True, "evidence": "test 'rejects a missing amount column' passes"}],
    "questions": ["only when status is question: what you need decided, with 2-3 options"],
    "usage": {"input_tokens": None, "output_tokens": None, "cost_usd": None},
}
REVIEW_FORMAT = {
    "verdict": "approve | changes",
    "criteria": [{"id": "AC1", "met": True, "note": "covered by test_upload_rejects_missing_amount"}],
    "findings": [{"severity": "blocker | suggestion", "file": "src/upload.ts", "line": 42,
                  "problem": "what is wrong", "why": "why it matters", "criterion": "AC1"}],
}


def read_result(path):
    """A coder's result-k.json, validated: (result, None) or (None, why it can't be used)."""
    if not path:
        return None, "missing"
    d, err = read_json(path)
    if err:
        return None, err
    if not isinstance(d, dict):
        return None, "must be a JSON object"
    if d.get("status") not in ("done", "question", "blocked"):
        return None, "`status` must be done, question or blocked"
    for k in ("files_changed", "criteria", "questions"):
        if k in d and not isinstance(d[k], list):
            return None, f"`{k}` must be a list"
    if "check" in d and not isinstance(d["check"], dict):
        return None, "`check` must be an object"
    for c in d.get("criteria", []):
        if not isinstance(c, dict) or "id" not in c or not isinstance(c.get("met"), bool):
            return None, "each entry in `criteria` needs `id` and `met` (true or false)"
    if d.get("commit") is not None and not isinstance(d["commit"], str):
        return None, "`commit` must be a string"
    return d, None


def read_usage(path):
    d, _ = read_json(path) if path else (None, None)
    u = d.get("usage") if isinstance(d, dict) else None
    return {k: v for k, v in u.items() if v is not None} or None if isinstance(u, dict) else None


def review_findings(tid, k):
    """(blockers, suggestions, known) for review round k: review-k.json, else the BLOCKER:/SUGGESTION: lines of
    review-k.md. known=False when neither is usable."""
    rd = ORCH / "review" / tid
    d, err = read_json(rd / f"review-{k}.json")
    if isinstance(d, dict) and isinstance(d.get("findings", []), list):
        blockers, sugg = [], []
        for f in d.get("findings", []):
            if not isinstance(f, dict):
                continue
            line = f"{f.get('file', '?')}:{f.get('line', '?')} — {f.get('problem', '')} — {f.get('why', '')}"
            if f.get("criterion"):
                line += f" ({f['criterion']})"
            (blockers if str(f.get("severity", "")).lower().startswith("block") else sugg).append(line)
        for c in d.get("criteria", []) if isinstance(d.get("criteria", []), list) else []:
            if isinstance(c, dict) and c.get("met") is False:
                blockers.append(f"{c.get('id', '?')} not met — {c.get('note', '')}")
        return [f"BLOCKER: {b}" for b in blockers], [f"SUGGESTION: {s}" for s in sugg], True
    rp = rd / f"review-{k}.md"
    lines = [l.strip() for l in (rp.read_text().splitlines() if rp.exists() else []) if l.strip()]
    blockers = [l for l in lines if l.upper().startswith("BLOCKER")]
    sugg = [l for l in lines if l.upper().startswith("SUGGESTION")]
    known = bool(blockers or sugg or any(l.upper().startswith("NO FINDINGS") for l in lines))
    return blockers, sugg, known


def run_check(st, cwd):
    """(passed, last 60 lines, seconds) for the plan's check command in cwd."""
    if not st.get("check"):
        return True, "", 0
    t0 = time.time()
    try:
        r = subprocess.run(st["check"], shell=True, cwd=cwd, text=True, capture_output=True, timeout=CHECK_TIMEOUT_S)
        ok, tail = r.returncode == 0, "\n".join((r.stdout + r.stderr).splitlines()[-60:])
    except subprocess.TimeoutExpired:
        ok, tail = False, f"check command timed out after {CHECK_TIMEOUT_S // 60} min"
    return ok, tail, round(time.time() - t0, 1)


def path_allowed(path, patterns):
    return any(path == p or fnmatch.fnmatch(path, p) or path.startswith(p.rstrip("/") + "/") for p in patterns)


def setup_hash(st, d):
    """Fingerprint of the dependency files in d's index (the plan's `Setup inputs:` globs, else LOCKFILE_RE)."""
    files = [f for f in git("ls-files", cwd=d, check=False).stdout.splitlines() if f]
    pats = st.get("setup_inputs") or []
    sel = [f for f in files if (path_allowed(f, pats) if pats else LOCKFILE_RE.search(f))]
    if not sel:
        return "none"
    return hashlib.sha1(git("ls-files", "-s", "--", *sel, cwd=d).stdout.encode()).hexdigest()[:16]


def ensure_root_setup(st):
    """Run the setup command in the main folder when its dependency files changed (before checking a merge)."""
    if (st.get("setup") or "none").lower() == "none":
        return True, ""
    h = setup_hash(st, ROOT)
    if h == st.get("root_setup_hash"):
        return True, ""
    try:
        r = subprocess.run(st["setup"], shell=True, cwd=ROOT, text=True, capture_output=True, timeout=CHECK_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return False, f"setup command timed out in {ROOT}"
    if r.returncode != 0:
        return False, f"setup command failed in {ROOT}:\n" + "\n".join((r.stdout + r.stderr).splitlines()[-30:])
    st["root_setup_hash"] = h
    print(f"SETUP ran `{st['setup']}` in the main folder (dependency files changed)")
    return True, ""


def changed_files(st, t):
    """Files the milestone's coder changed in its folder (committed on its saved work or not), excluding files
    that only differ because other milestones landed meanwhile."""
    d = t.get("dir")
    if not d or not Path(d).exists():
        return []
    untracked = set(git("ls-files", "--others", "--exclude-standard", cwd=d, check=False).stdout.split())
    if st["isolation"] == "shared":
        return sorted(set(git("diff", "--name-only", "HEAD", cwd=d, check=False).stdout.split()) | untracked)
    mb = git("merge-base", st["branch"], "HEAD", cwd=d, check=False).stdout.strip() or st["branch"]
    vs_base = set(git("diff", "--name-only", mb, cwd=d, check=False).stdout.split())
    vs_tip = set(git("diff", "--name-only", st["branch"], cwd=d, check=False).stdout.split())
    return sorted((vs_base & vs_tip) | untracked)


def risk_flags(st, tid, diff_args, cwd):
    """Deterministic reasons to hold a milestone for the developer's approval before it lands."""
    if not st.get("risk_hold", True):
        return []
    t = st["tasks"][tid]
    likely = t.get("files") or []
    out = []
    for line in git("diff", "--name-status", "--no-renames", *diff_args, cwd=cwd, check=False).stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        stt, path = parts[0], parts[-1]
        if stt.startswith("D"):
            out.append(f"deletes {path}")
        out += [f"{what}: {path}" for rx, what in RISK_RULES if rx.search(path)]
        if LOCKFILE_RE.search(path) and not path_allowed(path, likely):
            out.append(f"dependency change not listed in Likely files: {path}")
    total = 0
    for line in git("diff", "--numstat", *diff_args, cwd=cwd, check=False).stdout.splitlines():
        a, b = (line.split("\t") + ["0", "0"])[:2]
        total += (int(a) if a.isdigit() else 0) + (int(b) if b.isdigit() else 0)
    if total > RISK_MAX_LINES:
        out.append(f"large change: {total} lines (limit ORCH_RISK_MAX_LINES={RISK_MAX_LINES})")
    return out[:20]


def snapshot_diff(d, base):
    """Diff of the working tree (incl. new files) vs the merge-base with `base`, using a temporary index
    so the real index and any in-progress merge are left untouched."""
    mb = git("merge-base", base, "HEAD", cwd=d, check=False).stdout.strip()
    base = mb or base
    real_index = Path(git("rev-parse", "--path-format=absolute", "--git-path", "index", cwd=d).stdout.strip())
    tmp = real_index.with_name("orch-snapshot-index")
    if real_index.exists():
        shutil.copy(real_index, tmp)
    env = dict(os.environ, GIT_INDEX_FILE=str(tmp))
    try:
        subprocess.run(["git", "add", "-A"], cwd=d, env=env, capture_output=True, text=True)
        return subprocess.run(["git", "diff", "--cached", base], cwd=d, env=env, capture_output=True,
                              text=True).stdout
    finally:
        tmp.unlink(missing_ok=True)


def task_dir(t, tid):
    if not t.get("dir"):
        die(f"{tid} has no work dir yet — run `orch prepare {tid} <worker>` first")
    return Path(t["dir"])


def wt_path(worker):
    return ROOT.parent / f"{ROOT.name}-wt" / worker


def branch_exists(name):
    return git("rev-parse", "--verify", "--quiet", f"refs/heads/{name}", cwd=ROOT, check=False).returncode == 0


def default_base(st):
    """The branch a run starts from when none was recorded: origin's default branch, else main, else master."""
    r = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=ROOT, check=False)
    candidates = ([r.stdout.strip().split("/", 1)[-1]] if r.returncode == 0 else []) + ["main", "master"]
    for b in candidates:
        if b and b != st["branch"] and branch_exists(b):
            return b
    die(f"can't tell which branch {st['branch']} starts from — add `Base: <branch>` to the plan header and run `orch sync`")


def cmd_start(args):
    st = load()
    ensure_excluded()
    cur = git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip()
    if st.get("base") == st["branch"]:
        st["base"] = None                       # recorded by an older orch that started on the branch itself
    if cur != st["branch"]:
        if is_dirty(ROOT):
            die("main working tree has uncommitted changes — commit or stash first")
        if not st.get("base"):
            st["base"] = cur
        if branch_exists(st["branch"]):
            git("switch", st["branch"], cwd=ROOT)
        else:
            git("switch", "-c", st["branch"], st["base"], cwd=ROOT)
    if not st.get("base"):
        st["base"] = default_base(st)
    if st["isolation"] == "worktree":
        for name, w in st["workers"].items():
            p = wt_path(name)
            if not p.exists():
                p.parent.mkdir(parents=True, exist_ok=True)
                git("worktree", "add", "--detach", str(p), st["branch"], cwd=ROOT)
                w["setup_done"] = False
                print(f"CREATED worktree {p}")
            w["dir"] = str(p)
    else:
        for w in st["workers"].values():
            w["dir"] = str(ROOT)
    if st.get("root_setup_hash") is None and (st.get("setup") or "none").lower() != "none":
        st["root_setup_hash"] = setup_hash(st, ROOT)      # the developer's main folder is set up for this
    save(st)
    recover_merge(st)
    print(f"BRANCH {st['branch']} (base {st['base']})")
    reg = registry(required=False) if os.environ.get("ORCH_DOCTOR", "1") != "0" else None
    kinds = {w.get("kind") for w in st["workers"].values()} | ({(st.get("reviewer_info") or {}).get("kind")} - {None})
    for kind in sorted(k for k in kinds if reg and k in reg):
        for ok, m in doctor_kind(kind, reg[kind], full=False) or []:
            if not ok:
                print(f"WARN agent {kind}: {m}")
    agents = [(name, w, "WORKER") for name, w in st["workers"].items()]
    if st.get("reviewer"):
        agents.append((st["reviewer"], st.get("reviewer_info") or {}, "REVIEWER"))
    for name, w, label in agents:
        where = f" dir={w['dir']}" if label == "WORKER" else ""
        if w.get("pane"):
            try:
                ok = subprocess.run([HERDR, "pane", "get", w["pane"]], text=True, capture_output=True,
                                    timeout=HERDR_TIMEOUT_S).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                ok = False
            herdr = (f"pane {w['pane']} detect:off" if ok else
                     f"STALE pane {w['pane']} — find its current id with `herdr pane list` and fix plan.md, then `orch sync`")
        elif not w.get("detect", True):
            herdr = "detect:off (relying on its done file)"
        else:
            herdr = "found" if herdr_state(name) is not None else "NOT FOUND"
        print(f"{label} {name} kind={w.get('kind')}{where} herdr={herdr}")


def deps_met(st, t):
    return all(st["tasks"][d]["status"] == "merged" for d in t["deps"])


def active_count(st):
    return sum(1 for t in st["tasks"].values() if t["status"] in ACTIVE)


def holds(st, tid):
    """True if the task currently owns a coder (and, in worktree mode, that coder's folder)."""
    w = st["tasks"][tid].get("worker")
    return bool(w) and st["workers"].get(w, {}).get("task") == tid


def coders_busy(st):
    return sum(1 for w in st["workers"].values() if w.get("task"))


def free_slots(st):
    if st["isolation"] == "worktree":
        return st["max_parallel"] - coders_busy(st)
    return st["max_parallel"] - active_count(st)


def fix_jobs(st):
    """Tasks waiting for ANY free coder to fix review findings or a merge conflict (pipelined mode)."""
    return [tid for tid in st["order"]
            if st["tasks"][tid]["status"] in ("needs-fix", "conflict") and not holds(st, tid)]


def cmd_ready(args):
    st = load()
    cand = [tid for tid in st["order"] if st["tasks"][tid]["status"] == "pending" and deps_met(st, st["tasks"][tid])]
    # milestones that share Likely files run one after the other unless one says `Parallel: allow`
    busy = {}
    for tid, t in st["tasks"].items():
        if t["status"] in ACTIVE and not t.get("parallel"):
            for f in t.get("files") or []:
                busy[f] = tid
    out, waits = [], []
    for tid in cand:
        t = st["tasks"][tid]
        if lead_on(st) and not t.get("go"):
            waits.append(f"HOLD {tid} is ready and waits for the lead: orch dispatch {tid}")
            continue
        clash = sorted({busy[f] for f in t.get("files") or [] if f in busy})
        if clash and not t.get("parallel") and st["isolation"] == "worktree":
            waits.append(f"WAIT {tid} shares files with {', '.join(clash)}")
            continue
        out.append(tid)
        if not t.get("parallel"):
            for f in t.get("files") or []:
                busy[f] = tid
    slots = free_slots(st)
    if st["isolation"] == "shared" and slots <= 0 and active_count(st) == len(fix_jobs(st)) and fix_jobs(st):
        slots = 1          # shared mode: a queued fix job IS the active milestone, and it needs a coder
    print(f"SLOTS {max(slots, 0)}")
    for tid in fix_jobs(st):  # fixes first: reviewed work merges sooner and unlocks dependents
        print(f"FIX {tid} {st['tasks'][tid]['status']} {st['tasks'][tid]['title']}")
    for tid in out:
        print(f"READY {tid} {st['tasks'][tid]['title']}")
    for line in waits:
        print(line)


def cooling(name, info):
    """True while the agent is benched. A `gone` bench ends as soon as herdr can see the agent again."""
    if (info.get("cooldown_until") or 0) <= now():
        return False
    if info.get("cooldown_reason") == "gone" and info.get("detect", True) and herdr_state(name) is not None:
        return False
    return True


def worker_free(st, name, w):
    if w.get("task") or cooling(name, w):
        return False
    if not w.get("detect", True):      # herdr can't watch it: no task + no cooldown = free
        return True
    s = herdr_state(name)
    if s is None or word(s, "blocked", "working"):
        return False
    return True


def cmd_pick(args):
    need(args, 1, "pick <Mn>")
    st = load()
    t = task(st, args[0])
    pref = t["prefer"]
    names = eligible_workers(st, t)
    last = t.get("last_worker")
    nr = need_rank(t)
    # the last coder first (its work is in its folder), then the tier asked for before a stronger (dearer) one
    names.sort(key=lambda n: (0 if n == last else 1, (rank(st["workers"][n].get("tier")) or nr) - nr
                              if nr else 0, 0 if pref in ("any", st["workers"][n]["kind"], n) else 1))
    for n in names:
        if worker_free(st, n, st["workers"][n]):
            print(n)
            return
    print("NONE")
    sys.exit(3)


def cmd_prepare(args):
    need(args, 2, "prepare <Mn> <worker>")
    tid, worker = args[0], args[1]
    st = load()
    t = task(st, tid)
    w = st["workers"].get(worker) or die(f"unknown worker {worker}")
    if t["status"] not in ("pending", "paused", "conflict", "needs-fix"):
        die(f"{tid} is {t['status']}, expected pending/paused/needs-fix/conflict")
    if w.get("task") and w["task"] != tid:
        die(f"{worker} is busy with {w['task']}")
    if not holds(st, tid) and free_slots(st) <= 0 and not (st["isolation"] == "shared" and t["status"] in ("conflict", "needs-fix")):
        die("no free slot (max parallel reached)")
    d = Path(w["dir"] or ROOT)
    if st["isolation"] == "worktree":
        if is_dirty(d):
            die(f"{d} has uncommitted changes — park or clean that worker first")
        src = work_ref(st, tid)
        if src and src != task_ref(st, tid):       # pre-4.5 task branch: carry its work over to the hidden ref
            git("update-ref", task_ref(st, tid), src, cwd=ROOT)
            src = task_ref(st, tid)
        git("switch", "-q", "--detach", src or st["branch"], cwd=d)
    else:
        if git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip() != st["branch"]:
            die(f"main tree is not on {st['branch']}")
        if ref_ok(task_ref(st, tid)):
            if is_dirty(ROOT):
                die(f"main tree has uncommitted changes, so {tid}'s parked work ({task_ref(st, tid)}) can't be "
                    f"restored — finish or discard them first")
            restore_stash(st, tid)
        elif is_dirty(ROOT) and t["status"] == "pending" and not holds(st, tid):
            die("main tree has uncommitted changes that no milestone owns — commit, stash or discard them first")
    (d / TASK_DIR / tid).mkdir(parents=True, exist_ok=True)
    t.update(worker=worker, last_worker=worker, dir=str(d))
    t.pop("assign", None)          # a lead's "this coder" holds for one dispatch; later retries may move
    move(st, tid, "conflict" if t["status"] == "conflict" else "coding")
    w["task"] = tid
    save(st)
    print(f"DIR {d}")
    print(f"TASKDIR {d / TASK_DIR / tid}")
    if st["isolation"] == "worktree" and st["setup"].lower() != "none":
        h = setup_hash(st, d)
        if not w.get("setup_done") or w.get("setup_hash") != h:
            why = " (dependency files changed since its last setup)" if w.get("setup_done") else ""
            print(f"SETUP_NEEDED run `{st['setup']}` in {d}, then `orch setup-done {worker}`{why}")


def cmd_setup_done(args):
    need(args, 1, "setup-done <worker>")
    st = load()
    w = st["workers"].get(args[0]) or die(f"unknown worker {args[0]}")
    w["setup_done"] = True
    w["setup_hash"] = setup_hash(st, Path(w["dir"])) if w.get("dir") and Path(w["dir"]).exists() else None
    save(st)
    print("OK")


def record_attempt(t, outcome, usage=None):
    """Close the task's current wait as one attempt in its metrics (Phase 3: orch report)."""
    w = t.get("wait")
    if not w:
        return
    start = w.get("started", w.get("since", now()))
    a = {"kind": w.get("kind"), "agent": w.get("agent"), "file": w.get("file"), "start": start, "end": now(),
         "secs": max(0, now() - start), "nudges": w.get("nudges", 0), "outcome": outcome}
    if w.get("model"):
        a["model"], a["tier"] = w["model"], w.get("tier")
    blocked = w.get("blocked_s", 0) + (now() - w["blocked_since"] if w.get("blocked_since") else 0)
    if blocked:
        a["blocked_s"] = min(blocked, a["secs"])      # time herdr showed the agent stopped at a prompt in its pane
    if usage:
        a["usage"] = usage
    t.setdefault("attempts", []).append(a)
    del t["attempts"][:-100]


def _delivered(st, agent):
    info = agent_info(st, agent)
    if info:
        info["delivery_fails"] = 0


def _lost(st, tid, status, reason):
    """Count a lost attempt (agent unreachable, gone, rate-limited, stopped). At MAX_LOST the task fails."""
    t = st["tasks"][tid]
    t["lost"] = t.get("lost", 0) + 1
    if t["lost"] >= MAX_LOST:
        return "failed", f"lost {t['lost']} attempts (last: {reason}) — check the agents, then `orch set {tid} pending`"
    return status, reason


def _delivery_failed(st, tid, fname, path, err):
    """The prompt never reached the coder: put the task back where it was, keep its job, bench the coder briefly."""
    t = st["tasks"][tid]
    agent = t["worker"]
    record_attempt(t, "not delivered")
    t["wait"] = None
    job = t.get("job")
    if job and job.get("file") == fname:
        status = "conflict" if fname.startswith("conflict-") else "needs-fix"
    elif fname == "task.md":
        status = "pending"
    else:                                        # e.g. fix-2.md: keep it as a job for the next free coder
        t["job"] = {"file": fname, "body": path.read_text()}
        status = "needs-fix"
    w = st["workers"].get(agent)
    if w:
        w["delivery_fails"] = w.get("delivery_fails", 0) + 1
        bench = UNREACHABLE_MIN * 60 if w["delivery_fails"] >= UNREACHABLE_AFTER else SEND_RETRY_S
        w["cooldown_until"], w["cooldown_reason"] = now() + bench, "unreachable"
        if w["delivery_fails"] >= UNREACHABLE_AFTER:
            print(f"BENCHED {agent} for {UNREACHABLE_MIN} min: {w['delivery_fails']} prompts in a row did not reach it")
    status, reason = _lost(st, tid, status, f"could not prompt {agent}: {err.splitlines()[0] if err else 'herdr failed'}")
    _park(st, tid, status, reason)
    print(f"DELIVERY_FAILED {tid} -> {agent}: {err}" + (f"\nFAILED {tid}: {reason}" if status == "failed" else ""))
    sys.exit(5)


def cmd_send(args):
    """orch send Mn <file-name-in-TASKDIR>  -> prompt the task's worker."""
    need(args, 2, "send <Mn> <file>")
    tid, fname = args[0], args[1]
    st = load()
    t = task(st, tid)
    if not t.get("worker"):
        die(f"{tid} has no worker — run `orch prepare` first")
    d = task_dir(t, tid)
    rel = f"{TASK_DIR}/{tid}"
    if not (d / rel / fname).exists():
        die(f"{d / rel / fname} does not exist — write it first")
    k = t["attempt"] + 1
    sentinel = d / rel / f"done-{k}"
    sentinel.unlink(missing_ok=True)
    if fname != "task.md":                       # fix / review-fix / conflict / integration-fix job: say which
        kind = re.sub(r"-\d+\.md$", "", fname)
        (d / rel / f"job-{k}.json").write_text(json.dumps(
            {"schema": 1, "task_id": tid, "kind": kind, "file": fname, "contract": "task.json", "attempt": k}, indent=2))
    text = (f"Read {rel}/{fname} and carry it out exactly (the milestone's contract is {rel}/task.json). When "
            f"completely finished, write {rel}/result-{k}.json in the `result_format` shape from task.json, and a "
            f"short report {rel}/report-{k}.md (max 20 lines: files changed, what you did, check result; if something "
            f"was ambiguous, status `question` in the result, a line starting QUESTION: here, and stop; last line "
            f"`COMMIT: <one-line commit message for the change>`), then create the empty file {rel}/done-{k} as your "
            f"very last action.")
    # record the intent first: after a crash, a `delivering` wait is confirmed or re-sent to the SAME agent,
    # never handed to another coder as an orphan
    t["attempt"] = k
    move(st, tid, "coding")
    t["wait"] = {"agent": t["worker"], "sentinel": str(sentinel), "report": str(d / rel / f"report-{k}.md"),
                 "result": str(d / rel / f"result-{k}.json"), "since": now(), "started": now(), "kind": "coder",
                 "prompt": text, "nudges": 0, "file": fname, "delivering": True,
                 "model": st["workers"][t["worker"]].get("model"), "tier": st["workers"][t["worker"]].get("tier")}
    save(st)
    try:
        deliver(st, t["worker"], text)
    except DeliveryError as e:
        _delivery_failed(st, tid, fname, d / rel / fname, str(e))
    _delivered(st, t["worker"])
    fault("after-deliver")
    if (t.get("job") or {}).get("file") == fname:
        t["job"] = None                          # delivered: the job is now the coder's
    t["wait"]["delivering"] = False
    save(st)
    print(f"SENT {tid} -> {t['worker']} (attempt {k})")


def cmd_send_job(args):
    """orch send-job Mn -> write the queued fix/conflict job into TASKDIR and send it to the task's coder."""
    need(args, 1, "send-job <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    job = t.get("job") or die(f"{tid} has no queued job")
    if not holds(st, tid):
        die(f"{tid} has no coder yet — `orch pick {tid}` then `orch prepare {tid} <worker>` first")
    d = task_dir(t, tid) / TASK_DIR / tid
    d.mkdir(parents=True, exist_ok=True)
    (d / job["file"]).write_text(job["body"])
    cmd_send([tid, job["file"]])                 # clears the job only once it is delivered


def cmd_handoff(args):
    """orch handoff Mn -> (worktree mode) save the milestone to its hidden ref and free the coder,
    so it can take other work while the reviewer reviews."""
    need(args, 1, "handoff <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if st["isolation"] != "worktree":
        print("SKIP shared mode keeps the coder until the task lands")
        return
    if not holds(st, tid):
        die(f"{tid} does not hold a coder")
    d = task_dir(t, tid)
    wip_commit(d, f"orch wip {tid}: for review")
    git("update-ref", task_ref(st, tid), "HEAD", cwd=d)
    st["workers"][t["worker"]]["task"] = None
    t["last_worker"], t["worker"], t["handed_off"] = t["worker"], None, True
    save(st)
    print(f"HANDED_OFF {tid}: saved to {task_ref(st, tid)}; {t['last_worker']} is free")


def cmd_needs_fix(args):
    """orch needs-fix Mn -> queue the latest review's BLOCKER lines as a fix job for any free coder."""
    need(args, 1, "needs-fix <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    k = t["review_round"]
    blockers, _, _ = review_findings(tid, k)
    if not blockers:
        die(f"no blockers in review round {k} of {tid} (.orchestrate/review/{tid}/review-{k}.json or .md)")
    t["job"] = {"file": f"review-fix-{k}.md", "body":
                f"# Review findings for {tid}: {t['title']} (round {k})\n\n"
                "The reviewer found the problems below. You own the fix: investigate each one and decide how to "
                f"solve it. Keep every acceptance criterion in {TASK_DIR}/{tid}/task.md, then run `{st['check']}`.\n"
                "If you think a finding is wrong, explain why in your report instead of changing code for it.\n\n"
                + "\n".join(blockers) + "\n"}
    move(st, tid, "needs-fix")
    t["review_ok"], t["wait"] = False, None
    save(st)
    print(f"QUEUED fix job for {tid} ({len(blockers)} blocker(s))" + ("" if holds(st, tid) else " — any free coder"))


def cmd_review_ok(args):
    """orch review-ok Mn -> record that the reviewer approved Mn (later conflict fixes won't need re-review)."""
    need(args, 1, "review-ok <Mn>")
    st = load()
    t = task(st, args[0])
    t["review_ok"] = True
    t.pop("pre_conflict", None)
    save(st)
    print(f"OK {args[0]} review approved")


def cmd_review(args):
    """orch review Mn  -> snapshot diff into main .orchestrate and prompt the reviewer."""
    need(args, 1, "review <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if not st["reviewer"]:
        die("no reviewer configured")
    ri = st.get("reviewer_info") or {}
    busy = st.get("reviewer_busy") and st["reviewer_busy"] != tid
    if busy or cooling(st["reviewer"], ri):
        move(st, tid, "awaiting-review")
        save(st)
        why = f"is on {st['reviewer_busy']}" if busy else "is benched (cooldown)"
        print(f"BUSY reviewer {why}; {tid} queued as awaiting-review")
        sys.exit(3)
    d = task_dir(t, tid)
    rd = ORCH / "review" / tid
    rd.mkdir(parents=True, exist_ok=True)
    if st["isolation"] == "worktree" and not holds(st, tid):
        src = work_ref(st, tid) or die(f"{tid} has no saved work ({task_ref(st, tid)}) — run `orch handoff {tid}` first")
        mb = git("merge-base", st["branch"], src, cwd=ROOT).stdout.strip()
        diff = git("diff", mb, src, cwd=ROOT).stdout
    else:
        diff = snapshot_diff(d, st["branch"] if st["isolation"] == "worktree" else "HEAD")
    (rd / "diff.patch").write_text(diff)
    resolution = ""
    if t.get("pre_conflict") and st["isolation"] == "worktree" and work_ref(st, tid):
        (rd / "resolution.patch").write_text(git("diff", t["pre_conflict"], work_ref(st, tid), cwd=ROOT).stdout)
        resolution = (f"This round reviews a MERGE-CONFLICT RESOLUTION: you approved this milestone before, then it "
                      f"conflicted with work that landed meanwhile. What the coder changed to resolve it: "
                      f"{{rel}}/resolution.patch (the whole milestone is still in diff.patch).\n\n")
    task_md = d / TASK_DIR / tid / "task.md"
    if task_md.exists():
        shutil.copy(task_md, rd / "task.md")
    task_json = d / TASK_DIR / tid / "task.json"
    if task_json.exists():
        shutil.copy(task_json, rd / "task.json")
    k = t["review_round"] + 1
    rel = f".orchestrate/review/{tid}"
    (rd / f"review-task-{k}.md").write_text(
        f"# Review {tid}: {t['title']} (round {k})\n\n"
        f"Spec and acceptance criteria: {rel}/task.md (criteria ids AC1, AC2… in {rel}/task.json)\n"
        f"Changes: {rel}/diff.patch\n\n" + resolution.replace("{rel}", rel) +
        "Review for correctness against the acceptance criteria, API/contract consistency, UI/UX, security, "
        "edge cases and missing tests. Do NOT edit any code.\n"
        "Report PROBLEMS, not solutions: the coder decides how to fix. At most 15 findings. A `blocker` must be "
        "fixed before merge; a `suggestion` is optional. Say for EVERY acceptance criterion whether it is met; an "
        "unmet criterion counts as a blocker.\n"
        f"Write your review to {rel}/review-{k}.json in exactly this shape (an empty `findings` list and every "
        f"criterion met means approve):\n\n```json\n{json.dumps(REVIEW_FORMAT, indent=2)}\n```\n\n"
        f"Then create the empty file {rel}/done-{k} as your very last action.\n")
    sentinel = rd / f"done-{k}"
    sentinel.unlink(missing_ok=True)
    rtext = f"Read {rel}/review-task-{k}.md and do exactly what it says."
    t["review_round"] = k
    st["reviewer_busy"] = tid
    move(st, tid, "reviewing")
    t["wait"] = {"agent": st["reviewer"], "sentinel": str(sentinel), "report": str(rd / f"review-{k}.md"),
                 "result": str(rd / f"review-{k}.json"), "since": now(), "started": now(), "kind": "reviewer",
                 "prompt": rtext, "nudges": 0, "delivering": True,
                 "model": (st.get("reviewer_info") or {}).get("model"), "tier": (st.get("reviewer_info") or {}).get("tier")}
    save(st)
    try:
        deliver(st, st["reviewer"], rtext)
    except DeliveryError as e:
        _review_undelivered(st, tid)
        save(st)
        print(f"DELIVERY_FAILED review {tid} -> {st['reviewer']}: {e}")
        sys.exit(5)
    _delivered(st, st["reviewer"])
    fault("after-deliver")
    t["wait"]["delivering"] = False
    save(st)
    print(f"SENT review {tid} -> {st['reviewer']} (round {k})")


def _review_undelivered(st, tid):
    """The review prompt never reached the reviewer: the same round waits for review again; bench the reviewer."""
    t = st["tasks"][tid]
    record_attempt(t, "not delivered")
    t["review_round"] = max(0, t["review_round"] - 1)
    t["wait"] = None
    if st.get("reviewer_busy") == tid:
        st["reviewer_busy"] = None
    move(st, tid, "awaiting-review")
    ri = st.get("reviewer_info")
    if ri is None:
        return
    name = st["reviewer"]
    n = ri["delivery_fails"] = ri.get("delivery_fails", 0) + 1
    # herdr can't find the name (pane closed, agent restarted in a new pane without its name): a `gone` bench, which
    # ends the moment herdr sees the name again, so a rename is picked up on the next loop instead of minutes later
    gone = ri.get("detect", True) and herdr_state(name) is None
    ri["cooldown_until"] = now() + (UNREACHABLE_MIN * 60 if n >= UNREACHABLE_AFTER else SEND_RETRY_S)
    ri["cooldown_reason"] = "gone" if gone else "unreachable"
    fix = reviewer_fix_hint(st)
    if n in (1, UNREACHABLE_AFTER):              # the lead hears of it on the first failure, and once more later
        lead_event(st, "reviewer-lost", tid, f"the review prompt could not reach {name} ({n} tries). {fix}")
    print(f"REVIEWER_LOST {name} (try {n}): {tid} waits for review, its work is kept. {fix}")


def reviewer_fix_hint(st):
    name = st["reviewer"]
    pane = (st.get("reviewer_info") or {}).get("pane")
    if pane:
        return f"Check that pane {pane} still exists (`herdr pane get {pane}`)."
    return (f"herdr has no agent named `{name}`. Find its pane with `herdr agent list`, then "
            f"`herdr agent rename <pane> {name}`, and check it with `herdr agent get {name}`.")


def cmd_resend(args):
    """orch resend Mn -> a prompt was recorded but never confirmed (crash, or herdr unsure): send it again to the
    SAME agent with the same attempt and done file. Not a nudge."""
    need(args, 1, "resend <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    w = t.get("wait") or die(f"{tid} is not waiting on anyone")
    try:
        deliver(st, w["agent"], w["prompt"])
    except DeliveryError as e:
        if w.get("kind") == "reviewer":
            _review_undelivered(st, tid)
            save(st)
            print(f"DELIVERY_FAILED review {tid} -> {w['agent']}: {e}")
            sys.exit(5)
        fname = w.get("file") or "task.md"
        _delivery_failed(st, tid, fname, task_dir(t, tid) / TASK_DIR / tid / fname, str(e))
    _delivered(st, w["agent"])
    w["delivering"], w["since"] = False, now()
    save(st)
    print(f"RESENT {tid} -> {w['agent']}")


def cmd_requeue_review(args):
    """orch requeue-review Mn -> the reviewer vanished mid-review: queue the same round again (no coder needed)."""
    need(args, 1, "requeue-review <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if t["status"] != "reviewing":
        die(f"{tid} is {t['status']}, expected reviewing")
    t["review_round"] = max(0, t["review_round"] - 1)
    move(st, tid, "awaiting-review")
    t["wait"] = None
    if st.get("reviewer_busy") == tid:
        st["reviewer_busy"] = None
    save(st)
    print(f"REQUEUED {tid} for review")


def orphaned(st, tid):
    """A task that looks in progress, but nothing is waiting on an agent and no job is queued (an interrupted send)."""
    t = st["tasks"][tid]
    if t.get("wait") or t.get("job"):
        return False
    return t["status"] in ("coding", "reviewing") or (t["status"] in ("conflict", "needs-fix") and holds(st, tid))


def cmd_poll(args):
    secs = int(args[0]) if args else 100
    start = time.time()
    end = start + secs
    while True:
        with state_lock():
            st = load()
            events, changed = [], False
            for tid in st["order"]:
                t = st["tasks"][tid]
                w = t.get("wait")
                if orphaned(st, tid):
                    events.append(f"ORPHAN {tid} status={t['status']} (no agent was prompted — re-send or park it)")
                    continue
                if t["status"] not in ("coding", "reviewing", "conflict") or not w:
                    continue
                agent, sentinel = w["agent"], Path(w["sentinel"])
                age = now() - w["since"]
                if sentinel.exists():
                    record_attempt(t, "done", read_usage(w.get("result")))
                    if w["kind"] == "coder":
                        move(st, tid, "verifying")
                        t["last_report"] = w["report"]
                        res, _ = read_result(w.get("result"))
                        t["last_result"] = w.get("result")
                        t["commit_msg"] = ((res or {}).get("commit") or "").strip()[:120] or \
                            report_commit_line(w["report"]) or t.get("commit_msg")
                        events.append(f"DONE {tid} worker={agent} dir={t['dir']} report={w['report']}")
                    else:
                        move(st, tid, "reviewed")
                        st["reviewer_busy"] = None
                        events.append(f"REVIEWED {tid} review={w['report']}")
                    t["wait"] = None
                    continue
                if w.get("delivering"):        # recorded but never confirmed (a crash between save and send)
                    if age < CONFIRM_S:
                        continue
                    s = herdr_state(agent) if watched(st, agent) else ""
                    if s is None:
                        events.append(f"GONE {tid} agent={agent}")
                    elif word(s, "working", "blocked"):
                        w["delivering"] = False
                        changed = True
                    else:
                        events.append(f"UNCONFIRMED {tid} agent={agent} (prompt recorded, not confirmed)")
                    continue
                budget = (CODER_BUDGET_MIN if w["kind"] == "coder" else REVIEW_BUDGET_MIN) * 60
                if not watched(st, agent):     # herdr can't watch it: only the done file and the time budget count
                    if age > budget:
                        events.append(f"TIMEOUT {tid} agent={agent} after {age // 60} min")
                    continue
                s = herdr_state(agent)
                if s is not None and word(s, "blocked") and not w.get("blocked_since"):
                    w["blocked_since"], changed = now(), True       # stopped at a permission prompt / question
                elif w.get("blocked_since") and not (s is not None and word(s, "blocked")):
                    w["blocked_s"] = w.get("blocked_s", 0) + now() - w.pop("blocked_since")
                    changed = True
                if s is None:
                    events.append(f"GONE {tid} agent={agent}")
                elif word(s, "blocked"):
                    events.append(f"BLOCKED {tid} agent={agent}")
                elif age > IDLE_GRACE_S and word(s, "idle", "done") and not word(s, "working"):
                    events.append(f"IDLE {tid} agent={agent} (no sentinel after {age}s)")
                elif age > budget:
                    events.append(f"TIMEOUT {tid} agent={agent} after {age // 60} min")
            if events or changed:
                save(st)
            if not any(t.get("wait") for t in st["tasks"].values()):
                end = min(end, start + 5)      # nobody is working: don't sit out the whole wait (benches end sooner)
        if events:
            print("\n".join(events))
            return
        if time.time() >= end:
            running = [f"{tid}:{st['tasks'][tid]['status']}" for tid in st["order"]
                       if st["tasks"][tid]["status"] in ("coding", "reviewing", "conflict")]
            print("WAITING " + (" ".join(running) if running else "(nothing running)"))
            sys.exit(10)
        time.sleep(POLL_STEP_S)


def cmd_bump(args):
    need(args, 2, "bump <Mn> fix|review")
    tid, kind = args[0], args[1]
    if kind not in ("fix", "review"):
        die("usage: orch bump <Mn> fix|review")
    st = load()
    t = task(st, tid)
    key, cap = ("fix", MAX_FIX) if kind == "fix" else ("review_round", MAX_REVIEW)
    if kind == "fix":
        t["fix"] += 1
    used = t[key] - t.get("fix_base" if kind == "fix" else "review_base", 0)   # rounds since an escalation
    over = used > cap if kind == "fix" else used >= cap
    if over:
        save(st)
        print(f"CAP {tid} {kind} rounds exceeded ({t[key]}/{cap}) — park it and ask the developer")
        sys.exit(3)
    save(st)
    print(f"OK {tid} {kind} round {t[key]}/{cap}")


def cmd_commit(args):
    need(args, 1, "commit <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if st["isolation"] == "worktree" and not holds(st, tid):
        if not work_ref(st, tid):
            die(f"{tid} has no saved work ({task_ref(st, tid)})")
        move(st, tid, "committed")
        save(st)
        print(f"COMMITTED {tid} (saved in {task_ref(st, tid)} since handoff)")
        return
    d = task_dir(t, tid)
    if st["isolation"] == "shared":
        git("add", "-A", cwd=d)
        risks = [] if t.get("approved") else risk_flags(st, tid, ["--cached", "HEAD"], d)
        if risks:
            git("reset", "-q", cwd=d)                # unstage; the work stays in the tree until approved
            _hold(st, tid, risks)
        r = git("commit", "-q", "-m", commit_message(st, tid), cwd=d, check=False)
        if r.returncode != 0 and "nothing to commit" not in (r.stdout + r.stderr):
            die(r.stdout + r.stderr)
        _finish(st, tid)
        print(f"MERGED {tid} (shared mode: committed on {st['branch']})")
        return
    wip_commit(d, f"orch wip {tid}: ready to land")
    git("update-ref", task_ref(st, tid), "HEAD", cwd=d)
    move(st, tid, "committed")
    save(st)
    print(f"COMMITTED {tid} (saved in {task_ref(st, tid)})")


def _finish(st, tid):
    t = st["tasks"][tid]
    move(st, tid, "merged", "")
    t["wait"] = None
    if (st.get("merging") or {}).get("tid") == tid:
        st["merging"] = None
    if t.get("worker") and st["workers"].get(t["worker"], {}).get("task") == tid:
        st["workers"][t["worker"]]["task"] = None
    save(st)


def cmd_merge(args):
    need(args, 1, "merge <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if st["isolation"] == "shared":
        die("shared mode has no merge step (orch commit already landed it)")
    if t["status"] != "committed":
        die(f"{tid} is {t['status']}, expected committed")
    if git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip() != st["branch"] or is_dirty(ROOT):
        die(f"main tree must be clean and on {st['branch']}")
    src = work_ref(st, tid) or die(f"{tid} has no saved work ({task_ref(st, tid)}) — run `orch commit {tid}` first")
    src_sha = git("rev-parse", src, cwd=ROOT).stdout.strip()
    if not t.get("approved"):
        mb = git("merge-base", st["branch"], src_sha, cwd=ROOT).stdout.strip()
        risks = risk_flags(st, tid, [mb, src_sha], ROOT)
        if risks:
            _hold(st, tid, risks)
    head = git("rev-parse", "HEAD", cwd=ROOT).stdout.strip()
    st["merging"] = {"tid": tid, "head_before": head, "src": src_sha}   # journal: a crash from here is recoverable
    save(st)
    r = git("merge", "--squash", src, cwd=ROOT, check=False)
    fault("after-squash")
    if r.returncode != 0:
        files = git("diff", "--name-only", "--diff-filter=U", cwd=ROOT, check=False).stdout.split()
        git("reset", "--hard", "-q", "HEAD", cwd=ROOT)
        st["merging"] = None
        move(st, tid, "conflict", "merge conflict in " + (", ".join(files) or "(see git status)"))
        t["conflicts"] = t.get("conflicts", 0) + 1
        if t.get("review") and t.get("review_ok"):
            # an approved milestone changes again while its conflict is resolved: the reviewer sees the resolution
            t["review_ok"], t["pre_conflict"] = False, src_sha
        t["job"] = {"file": f"conflict-{t['conflicts']}.md", "body":
                    f"# Merge conflict for {tid}: {t['title']}\n\n"
                    f"Other milestones landed on `{st['branch']}` while you worked, and they conflict with "
                    f"yours in: {', '.join(files) or 'see git status'}.\n"
                    f"In this folder run `git merge --no-commit {st['branch']}`, resolve every conflict so BOTH "
                    f"sides keep working (you own the resolution), then run `{st['check']}`. Do not commit.\n"}
        save(st)
        who = t["worker"] if holds(st, tid) else "any free coder"
        print(f"CONFLICT {tid} files={','.join(files)} -> conflict job queued for {who} (`orch send-job {tid}`)")
        sys.exit(4)
    if git("diff", "--cached", "--quiet", cwd=ROOT, check=False).returncode == 0:
        print(f"NOTE {tid} had no changes to merge")
    else:
        # check BEFORE committing: nothing red ever lands on the feature branch
        ok, tail = ensure_root_setup(st)
        if ok:
            ok, tail, secs = run_check(st, ROOT)
            t.setdefault("checks", []).append({"where": "branch", "ok": ok, "secs": secs, "ts": now()})
        fault("after-check")
        if not ok:
            git("reset", "--hard", "-q", "HEAD", cwd=ROOT)
            st["merging"] = None
            _integration_failed(st, tid, tail)
        git("commit", "-q", "-m", commit_message(st, tid), cwd=ROOT)
        fault("after-merge-commit")
    git("update-ref", "-d", task_ref(st, tid), cwd=ROOT, check=False)
    _finish(st, tid)
    print(f"MERGED {tid} into {st['branch']}")


def _hold(st, tid, risks):
    """Stop a milestone before it lands until the developer runs `orch approve Mn` (exit 7)."""
    t = st["tasks"][tid]
    t["risks"] = risks
    if st["isolation"] == "worktree" and holds(st, tid):      # its work is saved in the hidden ref: free the coder
        st["workers"][t["worker"]]["task"] = None
        t["last_worker"], t["worker"] = t["worker"], None
    move(st, tid, "held", "waiting for `orch approve " + tid + "`: " + "; ".join(risks[:3])
         + (f" (+{len(risks) - 3} more)" if len(risks) > 3 else ""))
    save(st)
    print(f"HELD {tid} for approval — " + "; ".join(risks))
    print(f"Look at it, then run `orch approve {tid}` (or `orch set {tid} paused` to stop it)")
    sys.exit(7)


def _integration_failed(st, tid, tail):
    """The squash merged cleanly but the check fails on the feature branch: queue a fix job, commit nothing."""
    t = st["tasks"][tid]
    t["fix"] = t.get("fix", 0) + 1
    if t["fix"] > MAX_FIX:
        _park(st, tid, "failed", f"passes alone but fails the check on {st['branch']} after {MAX_FIX} fix rounds")
        print(f"CAP {tid}: still fails the check on {st['branch']} after {MAX_FIX} fix rounds\n{tail}")
        sys.exit(3)
    n = t["fix"]
    t["job"] = {"file": f"integration-fix-{n}.md", "body":
                f"# {tid} fails the check once merged onto `{st['branch']}` (round {n})\n\n"
                f"Your milestone passes `{st['check']}` on its own, but fails once it is merged with what landed on "
                f"`{st['branch']}` since you started. In this folder run `git merge --no-commit {st['branch']}`, find "
                f"the cause and fix it (you decide how, and keep both sides working), then run `{st['check']}`. "
                f"Don't commit, and don't weaken or skip tests.\n\n```\n{tail}\n```\n"}
    move(st, tid, "needs-fix", f"fails the check on {st['branch']} once merged (round {n})")
    t["wait"] = None
    save(st)
    who = t["worker"] if holds(st, tid) else "any free coder"
    print(f"CHECK_FAILED {tid} on {st['branch']} -> fix job queued for {who} (`orch send-job {tid}`); "
          f"nothing was committed\n{tail}")
    sys.exit(6)


def recover_merge(st):
    """Finish or undo a merge that a crash interrupted (see the `merging` journal in cmd_merge)."""
    m = st.get("merging")
    if not m:
        return
    tid = m["tid"]
    t = st["tasks"].get(tid)
    head = git("rev-parse", "HEAD", cwd=ROOT).stdout.strip()
    if head != m["head_before"]:
        body = git("log", "-1", "--format=%B", cwd=ROOT).stdout
        if t and t["status"] == "committed" and re.search(rf"(?m)^Milestone: {re.escape(tid)}$", body):
            git("update-ref", "-d", task_ref(st, tid), cwd=ROOT, check=False)
            _finish(st, tid)
            print(f"RECOVERED {tid}: its commit had landed before the crash")
            return
        st["merging"] = None                     # HEAD moved for another reason: leave it alone
        save(st)
        return
    if is_dirty(ROOT):
        if not ref_ok(m["src"]):
            die(f"an interrupted merge of {tid} left changes in the main folder, and its saved work {m['src']} is "
                f"gone — look at `git status` before doing anything else")
        git("reset", "--hard", "-q", m["head_before"], cwd=ROOT)
        print(f"RECOVERED {tid}: undid the half-done merge; it will be merged again from its saved work")
    st["merging"] = None
    save(st)


def cmd_approve(args):
    """orch approve Mn -> let a held milestone land (risky changes were looked at by the developer)."""
    need(args, 1, "approve <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    if t["status"] != "held":
        die(f"{tid} is {t['status']}, not held")
    t["approved"] = True
    move(st, tid, "committed", "approved by the developer")
    save(st)
    print(f"APPROVED {tid}: it lands on the next autopilot step (or `orch merge {tid}`)")


def _park(st, tid, status, reason, force=False):
    """Free the task's coder (and the reviewer) and keep its work in its hidden ref."""
    t = st["tasks"][tid]
    record_attempt(t, f"parked as {status}: {reason}" if reason else f"parked as {status}")
    d, w = t.get("dir"), t.get("worker")
    if w and holds(st, tid):
        if st["isolation"] == "worktree" and d and Path(d).exists():
            if is_dirty(d):
                wip_commit(d, f"orch wip {tid}: parked — {reason or status}")
            if ahead_of_branch(st, d):
                git("update-ref", task_ref(st, tid), "HEAD", cwd=d)
        elif st["isolation"] == "shared":
            stash_to_ref(st, tid)              # the tree is clean again, so the next milestone can start
        st["workers"][w]["task"] = None
    if w:
        t["last_worker"], t["worker"] = w, None
    if st.get("reviewer_busy") == tid:
        st["reviewer_busy"] = None
    move(st, tid, status, reason, force=force)
    t["wait"] = None
    save(st)


def cmd_park(args):
    """orch park Mn paused|failed|pending [--lost] [reason...] — free the worker, keep work in the milestone's hidden
    ref. --lost counts a lost attempt (agent gone, rate-limited, stopped); at ORCH_MAX_LOST the task fails."""
    lost = "--lost" in args
    args = [a for a in args if a != "--lost"]
    need(args, 2, "park <Mn> paused|failed|pending [--lost] [reason]")
    tid, status, reason = args[0], args[1], " ".join(args[2:])
    if status not in ("paused", "failed", "pending"):
        die("status must be paused, failed or pending")
    st = load()
    task(st, tid)
    if lost:
        status, reason = _lost(st, tid, status, reason)
    _park(st, tid, status, reason)
    print(f"PARKED {tid} as {status}: {reason}")


def cmd_cooldown(args):
    """orch cooldown <worker|reviewer> <min> [reason] — bench an agent; reason `gone` ends once herdr sees it again."""
    need(args, 2, "cooldown <agent> <minutes> [reason]")
    name, reason = args[0], (args[2] if len(args) > 2 else "")
    if not args[1].isdigit():
        die(f"cooldown minutes must be a whole number, got {args[1]!r}")
    st = load()
    info = st["workers"].get(name) or (st.get("reviewer_info") if name == st.get("reviewer") else None)
    if info is None:
        die(f"unknown agent {name!r} — workers: {', '.join(st['workers'])}; reviewer: {st.get('reviewer') or 'none'}")
    info["cooldown_until"], info["cooldown_reason"] = now() + int(args[1]) * 60, reason
    save(st)
    print(f"COOLDOWN {name} for {args[1]} min" + (f" ({reason})" if reason else ""))


STATUSES = {"pending", "coding", "verifying", "awaiting-review", "reviewing", "reviewed", "committed", "merged",
            "needs-answer", "paused", "failed", "conflict", "skipped", "needs-fix", "held"}


def cmd_set(args):
    """orch set Mn <status> [reason] [--force] — manual override. pending/paused/failed also free the coder like
    `park`. Only pending, paused, failed and skipped are allowed without --force; a forced change is logged."""
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    need(args, 2, "set <Mn> <status> [reason] [--force]")
    tid, status, reason = args[0], args[1], " ".join(args[2:])
    if status not in STATUSES:
        die(f"unknown status {status!r} — one of {', '.join(sorted(STATUSES))}")
    if status not in SET_OK and not force:
        die(f"`orch set` only moves a task to {', '.join(sorted(SET_OK))}; setting {status!r} by hand skips the "
            f"steps that make it true — add --force if you really mean it")
    st = load()
    task(st, tid)
    if force:
        reason = ("manual override: " + reason).strip()
    if status in ("pending", "paused", "failed"):
        _park(st, tid, status, reason, force=force)
    else:
        move(st, tid, status, reason, force=force)
        save(st)
    print("OK")


def cmd_status(args):
    st = load()
    if driver_alive():
        print(f"driven by {driver_line(driver_info())}")
    print(f"branch={st['branch']} base={st.get('base')} isolation={st['isolation']} "
          f"max_parallel={st['max_parallel']} reviewer={st['reviewer']} (busy: {st.get('reviewer_busy')})")
    if st.get("integration_broken"):
        print(f"  INTEGRATION BROKEN: the check failed on {st['branch']} after merging "
              f"{st['integration_broken']} — fix it; autopilot re-checks before it continues")
    for n, w in st["workers"].items():
        cd = max(0, w.get("cooldown_until", 0) - now())
        print(f"  worker {n:<12} {w['kind']:<8} task={w.get('task') or '-':<5} "
              + (f"model={w['model']} ({w.get('tier') or 'unrated'}) " if w.get("model") else "")
              + f"{'cooldown ' + str(cd // 60) + 'm' if cd else ''}"
              f"{'' if w.get('detect', True) else ' detect:off'}")
    for tid in st["order"]:
        t = st["tasks"][tid]
        print(f"  {tid:<4} {t['status']:<15} deps={','.join(t['deps']) or '-':<10} "
              f"worker={t.get('worker') or '-':<10} "
              + (f"tier={t['tier'] if rank(t.get('min_tier')) <= rank(t.get('tier')) else t['min_tier'] + '^'} "
                 if need_rank(t) else "") + t["title"]
              + (f"  [{t['reason']}]" if t.get("reason") else ""))
    if lead_on(st):
        ev = [e for e in st["lead_events"] if event_open(st, e)]
        hold = undispatched(st)
        print(f"  lead {st['lead']['name']}: {len(unread_events(st))} unread event(s), {len(ev)} open"
              + (f"; waiting for `orch dispatch`: {', '.join(hold)}" if hold else "")
              + ("" if driver_alive() else "; the event manager is NOT running (`orch autopilot`)"))
    if all(t["status"] in ("merged", "skipped") for t in st["tasks"].values()):
        print(f"ALL_DONE — run `orch finish` to push {st['branch']} and open a PR into {st.get('base')}")
    elif lead_on(st) and (undispatched(st) or any(event_open(st, e) for e in st["lead_events"])):
        pass
    elif not any(t["status"] in ACTIVE for t in st["tasks"].values()) and not any(
            t["status"] == "pending" and deps_met(st, t) for t in st["tasks"].values()):
        print("STUCK — nothing running and nothing ready; resolve paused/needs-answer/failed tasks with the developer")


def remove_worktrees(st):
    for n in st["workers"]:
        p = wt_path(n)
        if p.exists():
            if is_dirty(p):
                print(f"SKIP {p}: has uncommitted changes")
                continue
            git("worktree", "remove", str(p), cwd=ROOT)
            print(f"REMOVED {p}")
    git("worktree", "prune", cwd=ROOT)


def cmd_cleanup(args):
    st = load()
    if st["isolation"] != "worktree":
        print("nothing to clean (shared mode)")
        return
    remove_worktrees(st)


def github_compare_url(remote, base, branch):
    m = re.match(r"(?:git@github\.com:|https://(?:[^@/]+@)?github\.com/)([^/]+/[^/]+?)(?:\.git)?/?$", remote)
    return f"https://github.com/{m.group(1)}/compare/{base}...{branch}?expand=1" if m else None


def cmd_finish(args):
    """orch finish [--no-push] -> final check, drop hidden refs and worktrees, push the feature branch, open a PR."""
    st = load()
    left = [f"{k} ({v['status']})" for k, v in st["tasks"].items() if v["status"] not in ("merged", "skipped")]
    if left:
        die("not every milestone has landed: " + ", ".join(left))
    if git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip() != st["branch"] or is_dirty(ROOT):
        die(f"main tree must be clean and on {st['branch']}")
    base = st.get("base") or default_base(st)
    if st.get("check"):
        r = subprocess.run(st["check"], shell=True, cwd=ROOT, text=True, capture_output=True)
        if r.returncode != 0:
            die(f"the check fails on {st['branch']} — fix it before finishing:\n"
                + "\n".join((r.stdout + r.stderr).splitlines()[-30:]))
    title = st.get("title") or st["branch"]
    if st.get("commits") == "single":
        mb = git("merge-base", base, "HEAD", cwd=ROOT).stdout.strip()
        subjects = git("log", "--reverse", "--format=%s", f"{mb}..HEAD", cwd=ROOT).stdout.split("\n")
        subjects = [s for s in subjects if s]
        if len(subjects) > 1:
            landed = [k for k in st["order"] if st["tasks"][k]["status"] == "merged"]
            git("reset", "--soft", "-q", mb, cwd=ROOT)
            git("commit", "-q", "-m", f"{title}\n\n" + "\n".join(f"- {s}" for s in subjects)
                + f"\n\nMilestones: {', '.join(landed)}", cwd=ROOT)
            print(f"SQUASHED {len(subjects)} commits into one (Commits: single)")
    refs = git("for-each-ref", "--format=%(refname)", f"{REF_NS}/{st['branch'].replace('/', '-')}/",
               cwd=ROOT).stdout.split()
    if st["isolation"] == "worktree":
        remove_worktrees(st)
    for ref in refs:
        git("update-ref", "-d", ref, cwd=ROOT)
    for tid in st["order"]:                       # task branches left by orch < 4.5
        if branch_exists(f"{st['branch']}-{tid}"):
            git("branch", "-D", "-q", f"{st['branch']}-{tid}", cwd=ROOT, check=False)
    print(f"CLEAN {st['branch']} is the only branch this run made ({len(refs)} hidden ref(s) removed)")
    if "--no-push" in args:
        print(f"NOT PUSHED (--no-push): push {st['branch']} and open a PR into {base} when ready")
        return
    remote = git("remote", "get-url", "origin", cwd=ROOT, check=False)
    if remote.returncode != 0:
        print(f"NO REMOTE: no `origin` remote — merge {st['branch']} into {base} yourself")
        return
    url = remote.stdout.strip()
    git("push", "-q", "-u", "origin", st["branch"], cwd=ROOT)
    print(f"PUSHED {st['branch']} to origin")
    compare = github_compare_url(url, base, st["branch"])
    if compare and shutil.which("gh"):
        summary = ORCH / "summary.md"
        body = (["--body-file", str(summary)] if summary.exists() else
                ["--body", f"Built by herdr-orchestra from .orchestrate/plan.md ({len(st['order'])} milestones)."])
        try:
            r = subprocess.run(["gh", "pr", "create", "--base", base, "--head", st["branch"], "--title", title, *body],
                               cwd=ROOT, text=True, capture_output=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as e:
            r = subprocess.CompletedProcess([], 1, "", str(e))
        if r.returncode == 0:
            print(f"PR {r.stdout.strip().splitlines()[-1] if r.stdout.strip() else 'created'}")
            return
        print(f"NOTE gh pr create failed: {(r.stdout + r.stderr).strip()}")
    print(f"OPEN A PR from {st['branch']} into {base}" + (f": {compare}" if compare else ""))


# ---------------------------------------------------------------- v4: task files, nudge, autopilot
def plan_sections():
    """Return ({task_id: section_text}, global_instructions_text) straight from plan.md."""
    text = (ORCH / "plan.md").read_text()
    secs, glob, cur, buf = {}, "", None, []
    def flush():
        nonlocal glob
        if cur == "__global__":
            glob = "\n".join(buf).strip()
        elif cur:
            secs[cur] = "\n".join(buf).strip()
    for line in text.splitlines():
        m = HEAD_RE.match(line)
        if m or line.startswith("## "):
            flush()
            buf = [line]
            cur = m.group(2) if m else ("__global__" if line.lower().startswith("## global") else None)
            if cur == "__global__":
                buf = []
            continue
        buf.append(line)
    flush()
    return secs, glob


WORKER_RULES = """## Rules for you (the coder)
- You own the HOW: the approach, the design inside this milestone, the code, the tests and every fix. This file says what and why; it deliberately doesn't say how.
- Follow the repo's existing patterns (AGENTS.md / CLAUDE.md) and any Interfaces listed above exactly; other milestones rely on them.
- Change only what this task needs. No unrelated refactors.
- Do NOT commit, push, or switch branches. orch commits your work for you.
- Stay inside the files listed under Likely files (`files_allowed` in task.json) unless the task can't be done otherwise; say why in your report if you leave them. orch compares your diff with that list.
- Finish with a result file (the prompt names it) in the `result_format` shape from task.json: `status` done / question / blocked, `commit`, `files_changed`, the `check` you ran, one entry per acceptance criterion (`id`, `met`, `evidence`), and `usage` if your tool shows tokens or cost. orch reads it, so keep it valid JSON.
- The commit message (`commit` in the result, and the last report line `COMMIT: <commit message>`) says what changed, in the repo's commit style (for example `feat(api): add categories endpoint`). It becomes the commit message, so describe the change, not the milestone.
- If anything is ambiguous, do not guess: set status `question`, put the question in `questions` and on a report line starting `QUESTION:`, finish the files and the done file, and stop.
- Before finishing, run the check command below and record the result (pass/fail + the failing lines).
"""


def cmd_write_task(args):
    """orch write-task Mn  -> generate TASKDIR/task.md from the plan (+ dependency reports)."""
    need(args, 1, "write-task <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    d = task_dir(t, tid)
    secs, glob = plan_sections()
    if tid not in secs:
        die(f"{tid} not found in plan.md")
    parts = [f"# Task {tid}: {t['title']}", "", secs[tid].replace(f"## [x] {tid}:", "Title:", 1), ""]
    if glob and glob.lower() not in ("none", "<empty — user may fill in>"):
        parts += ["## Global instructions", glob, ""]
    ctx = []
    for dep in t["deps"]:
        dd = st["tasks"][dep].get("dir")
        reps = sorted((Path(dd) / TASK_DIR / dep).glob("report-*.md"),
                      key=lambda p: int(re.sub(r"\D", "", p.stem) or 0)) if dd else []
        lines = [l for p in reps for l in p.read_text().splitlines() if l.strip()]
        if lines:
            ctx += [f"### {dep}: {st['tasks'][dep]['title']} (already merged into your branch)",
                    "\n".join(lines[:25]), ""]
    if ctx:
        parts += ["## Context: what the tasks you depend on built", *ctx]
    contract = task_contract(st, tid)
    if contract["acceptance_criteria"]:
        parts += ["## Acceptance criteria ids (for your result file)",
                  *[f"- {c['id']}: {c['text']}" for c in contract["acceptance_criteria"]], ""]
    if contract["previous_work"]:
        parts += ["## Earlier work", f"An earlier attempt ({contract['previous_work']['by'] or 'another coder'}) left "
                  "work in this folder. Look at it first and continue from it unless it is wrong.", ""]
    parts += [f"## Check command\n`{st['check']}`", "", WORKER_RULES]
    out = d / TASK_DIR / tid / "task.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(parts))
    (out.parent / "task.json").write_text(json.dumps(contract, indent=2))
    print(f"WROTE {out}")
    print(f"WROTE {out.parent / 'task.json'}")


def task_contract(st, tid):
    """task.json: the milestone as data, generated from plan.md (plan.md stays the human-edited source)."""
    t = st["tasks"][tid]
    _, ptasks = parse_plan((ORCH / "plan.md").read_text())
    pt = next((x for x in ptasks if x["id"] == tid), {"fields": {}})

    def items(key):
        vals = [v.lstrip("- ").strip() for v in pt["fields"].get(key, [])]
        return [v for v in vals if v and v.lower() != "none"]
    deps = []
    for dep in t["deps"]:
        sha = git("log", "-1", "--format=%H", f"--grep=^Milestone: {dep}$", st["branch"], cwd=ROOT,
                  check=False).stdout.strip()
        deps.append({"task": dep, "title": st["tasks"][dep]["title"], "commit": sha or None})
    return {
        "schema": 1, "task_id": tid, "title": t["title"], "kind": "task",
        "goal": field(pt, "goal"), "why": field(pt, "why"),
        "acceptance_criteria": [{"id": f"AC{i}", "text": c} for i, c in enumerate(items("acceptance criteria"), 1)],
        "files_allowed": t.get("files") or [], "scope": st.get("scope", "warn"),
        "tier": t.get("tier"), "needs": t.get("needs") or [],
        "interfaces": items("interfaces"), "constraints": items("constraints"), "out_of_scope": items("out of scope"),
        "depends_on": deps, "check": st["check"], "attempt": t.get("attempt", 0) + 1, "lost_attempts": t.get("lost", 0),
        "previous_work": {"by": t.get("last_worker")} if work_ref(st, tid) else None,
        "result_format": RESULT_FORMAT,
    }


def start_manager():
    """The lead's dispatch or answer needs the event manager (`orch autopilot`) to carry it out: start one,
    detached from this shell, when none is running. Says what happened."""
    if driver_alive():
        return f"the event manager is running ({driver_line(driver_info())})"
    if os.environ.get("ORCH_NO_AUTOSTART") == "1":
        return "the event manager is NOT running — ask the developer to run `orch autopilot` in a terminal"
    with open(ORCH / "manager.out", "a") as out:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "autopilot"], cwd=ROOT, stdin=subprocess.DEVNULL,
                         stdout=out, stderr=subprocess.STDOUT, start_new_session=True,
                         env={k: v for k, v in os.environ.items() if not k.startswith("ORCH_DRIVER")})
    for _ in range(20):
        time.sleep(0.25)
        if driver_alive():
            return "started the event manager (`orch autopilot`, log: .orchestrate/autopilot.log)"
    return ("could NOT start the event manager from here (see .orchestrate/manager.out) — ask the developer to run "
            "`orch autopilot` in a terminal")


def cmd_dispatch(args):
    """orch dispatch Mn [Mn...] [--to <worker>] [--tier small|medium|high]
    The lead's request to start (or restart) milestones. The event manager sends them when a coder is free."""
    opts = {}
    for flag in ("--to", "--tier"):
        if flag in args:
            i = args.index(flag)
            opts[flag] = args[i + 1] if len(args) > i + 1 else die(f"{flag} needs a value")
            del args[i:i + 2]
    need(args, 1, "dispatch <Mn> [Mn...] [--to <worker>] [--tier small|medium|high]")
    with state_lock():
        st = load()
        if opts.get("--to") and opts["--to"] not in st["workers"]:
            die(f"unknown worker {opts['--to']!r} — workers: {', '.join(st['workers'])}")
        if opts.get("--tier") and opts["--tier"] not in TIERS:
            die("--tier must be small, medium or high")
        for tid in args:
            t = task(st, tid)
            if t["status"] not in ("pending", "paused", "failed"):
                die(f"{tid} is {t['status']} — only pending, paused or failed milestones can be dispatched"
                    + (" (answer its open questions in plan.md, then `orch sync`)" if t["status"] == "needs-answer" else ""))
        for tid in args:
            t = st["tasks"][tid]
            t["go"] = True
            t.pop("ready_ts", None)
            if opts.get("--to"):
                t["assign"] = opts["--to"]
            if opts.get("--tier"):
                t["min_tier"] = opts["--tier"]
            if t["status"] in ("paused", "failed"):         # a fresh round, decided by the lead
                t["fix_base"], t["review_base"] = t.get("fix", 0), t.get("review_round", 0)
                _park(st, tid, "pending", "dispatched again by the lead")
            who = [n for n in eligible_workers(st, t)]
            waits = [d for d in t["deps"] if st["tasks"][d]["status"] != "merged"]
            print(f"DISPATCH {tid} -> {' or '.join(who)}" + (f" (tier {TIERS[need_rank(t) - 1]})" if need_rank(t) else "")
                  + (f" — starts when {', '.join(waits)} merged" if waits else ""))
        save(st)
    print(start_manager())
    print("You will be woken with `orch events` when something needs you. Stop here; do not poll.")


NOTES_RE = re.compile(r"(?mi)^Notes from user:[ \t]*")


def cmd_answer(args):
    """orch answer Mn <the developer's answer> -> write it under the milestone's "Notes from user" in plan.md and
    send the milestone back to the SAME coder, which carries on from its saved work."""
    need(args, 2, "answer <Mn> <answer text>")
    tid, text = args[0], " ".join(args[1:]).strip()
    with state_lock():
        st = load()
        t = task(st, tid)
        if t["status"] != "paused":
            die(f"{tid} is {t['status']}, not paused" + (
                " — its questions are in plan.md: answer them under \"Notes from user\", set \"Open questions:\" to "
                "`- none`, then `orch sync`" if t["status"] == "needs-answer" else ""))
        plan = ORCH / "plan.md"
        lines, out, cur, done = plan.read_text().split("\n"), [], None, False
        note = f"- {text}"
        for i, line in enumerate(lines):
            m = HEAD_RE.match(line)
            if (m or line.startswith("## ")) and cur == tid and not done:       # section ended without a notes line
                while out and not out[-1].strip():
                    out.pop()
                out += ["Notes from user:", note, ""]
                done = True
            if m or line.startswith("## "):
                cur = m.group(2) if m else None
            out.append(line)
            if cur == tid and not done and NOTES_RE.match(line):
                out.append(note)
                done = True
        if not done:
            if cur != tid:
                die(f"{tid} not found in plan.md")
            while out and not out[-1].strip():
                out.pop()
            out += ["Notes from user:", note, ""]
        plan.write_text("\n".join(out))
        last = t.get("last_worker")
        t["go"] = True
        if last in st["workers"]:
            t["assign"] = last
        t.setdefault("answers", []).append({"ts": now(), "text": text})
        _park(st, tid, "pending", f"answered: {text[:200]}")
        print(f"ANSWERED {tid}: written to plan.md; it goes back to {last or 'the next free coder'} with its work so far")
    print(start_manager())
    print("You will be woken with `orch events` when something needs you. Stop here; do not poll.")


def cmd_fix(args):
    """orch fix Mn <what should change> [--to <worker>] -> a small follow-up milestone for something Mn built, sent
    straight to the coder who built Mn. No new planning round: the check, the review (when Mn had one) and the
    summary still apply. Works after ALL_DONE and while a run is going; the developer or the lead may run it."""
    to = None
    if "--to" in args:
        i = args.index("--to")
        to = args[i + 1] if len(args) > i + 1 else die("--to needs a value")
        del args[i:i + 2]
    need(args, 2, "fix <Mn> <what should change> [--to <worker>]")
    tid, text = args[0], " ".join(" ".join(args[1:]).split())
    if not text:
        die("say what should change: orch fix <Mn> \"<what should change>\"")
    with state_lock():
        st = load()
        t = task(st, tid)
        if t["status"] != "merged":
            die(f"{tid} is {t['status']}, not landed yet — `orch fix` is for work that already landed"
                + (f" (a paused milestone takes `orch answer {tid} \"<text>\"`)" if t["status"] == "paused" else ""))
        if to and to not in st["workers"]:
            die(f"unknown worker {to!r} — workers: {', '.join(st['workers'])}")
        plan = ORCH / "plan.md"
        _, ptasks = parse_plan(plan.read_text())
        src = next((x for x in ptasks if x["id"] == tid), None)
        if src is None:
            die(f"{tid} not found in plan.md")
        nums = [int(k[1:]) for k in list(st["tasks"]) + [x["id"] for x in ptasks]]
        new = f"M{max(nums) + 1}"
        built = [a.get("agent") for a in t.get("attempts") or [] if a.get("kind") == "coder" and a.get("agent")]
        who = to or next((w for w in (t.get("worker"), t.get("last_worker"), *reversed(built)) if w in st["workers"]), None)
        title = f"Fix for {tid}: {text[:60]}" + ("..." if len(text) > 60 else "")
        review = field(src, "review", "no")
        sec = [f"## [x] {new}: {title}", f"Depends on: {tid} (a fix to what {tid} built)",
               f"Why separate: a change the developer asked for after {tid} landed.", f"Review: {review}",
               "Estimate: none"]
        if field(src, "likely files"):
            sec.append(f"Likely files: {field(src, 'likely files')}")
        if t.get("tier"):
            sec += [f"Tier: {t['tier']}", f"Model why: a fix to {tid}, for the coder who built it."]
        sec += [f"Goal: {text}", f"Why: the developer asked for this after {tid} landed.", "Acceptance criteria:",
                f"- {text}", f"- nothing else that {tid} built changes, and the check command passes",
                "Open questions:", "- none", ""]
        body = plan.read_text()
        plan.write_text(body.rstrip("\n") + "\n\n" + "\n".join(sec))
        st["order"].append(new)
        st["tasks"][new] = {
            "title": title, "deps": [tid], "prefer": "any",
            "review": review.lower().startswith("y") and st.get("reviewer") is not None,
            "status": "pending", "reason": f"fix for {tid}", "worker": None, "dir": None, "attempt": 0, "fix": 0,
            "review_round": 0, "wait": None, "files": list(t.get("files") or []), "parallel": False,
            "tier": t.get("tier"), "needs": [], "model_why": f"a fix to {tid}, for the coder who built it." if t.get("tier") else "",
            "go": True, "fix_of": tid,
        }
        if who:
            st["tasks"][new]["assign"] = who
        save(st)
        print(f"FIX {new} \"{title}\" -> {who or 'the next free coder (nobody on the team built ' + tid + ')'}; "
              f"added to plan.md, the check" + (" and the review" if st["tasks"][new]["review"] else "") + " still run")
    print(start_manager())
    print(f"It lands like any milestone: `orch status` shows {new}, and the summary is written again when it is in.")


EVENT_HELP = {
    "paused": "a coder's question, or an agent that stopped. A question only the developer can settle: ask them, "
              "then `orch answer {t} \"<their answer>\"`. An agent problem: tell the developer what to look at, then "
              "`orch dispatch {t}`.",
    "failed": "still failing after its rounds. Read the last report and check or review output, add the missing "
              "FACT or constraint to the plan (never a how-to), then `orch dispatch {t}` (add `--tier high` or "
              "`--to <worker>` to give it a stronger model).",
    "held": "risky changes wait for the developer: show them the reasons; they run `orch approve {t}`. Never approve it yourself.",
    "needs-answer": "open questions in plan.md: ask the developer, write the answers under \"Notes from user\", set "
                    "\"Open questions:\" to `- none`, `orch sync`, then `orch dispatch {t}`.",
    "merged": "landed on the feature branch. Nothing to do unless it unlocked work listed under READY.",
    "ready": "milestones are ready for you: `orch dispatch <Mn>...`.",
    "escalated": "moved to a stronger model after its rounds ran out. Nothing to do.",
    "auto-dispatched": "started without you because you did not dispatch it in time. Nothing to do.",
    "reviewer-lost": "the reviewer can't be reached, so the milestone waits for review (its work is kept). Tell the "
                     "developer the fix in the event text (usually: rename the reviewer's new pane). Review resumes "
                     "by itself once herdr finds the reviewer again.",
    "all_done": "every milestone landed. Finish .orchestrate/summary.md (see `orch lead run`, section ALL_DONE).",
    "stopped": "the event manager stopped. Tell the developer why; they run `orch autopilot` again.",
}


def cmd_events(args):
    """orch events [--peek] -> what the lead was woken for. Reading the events acknowledges them (not with --peek)."""
    peek = "--peek" in args
    with state_lock():
        st = load()
        if not lead_on(st):
            print("This run has no lead events (plan header: `Lead: lead (<kind>)`, and not `Lead mode: off`).")
            return
        new = unread_events(st)
        old = [e for e in st["lead_events"] if e.get("read") and e["kind"] in LEAD_BLOCKING and event_open(st, e)]

        def show(e):
            tt = st["tasks"].get(e.get("task") or "", {})
            head = f"#{e['id']} {e['kind'].upper()}" + (f" {e['task']} \"{tt.get('title', '')}\"" if e.get("task") else "")
            print(head + (f": {e['text']}" if e.get("text") else ""))
            print("    -> " + EVENT_HELP.get(e["kind"], "").format(t=e.get("task") or "<Mn>"))
        print(f"EVENTS for the lead — run {st['branch']}: {len(new)} new, {len(old)} still open")
        for e in new:
            show(e)
        if old:
            print("STILL OPEN (you have seen these; they close when the milestone moves on):")
            for e in old:
                show(e)
        hold = undispatched(st)
        if hold:
            print("READY — waiting for your dispatch:")
            for tid in hold:
                t = st["tasks"][tid]
                print(f"  {tid} \"{t['title']}\"" + (f" tier {t['tier']}" if t.get("tier") else "")
                      + f" -> {' or '.join(eligible_workers(st, t))}:  orch dispatch {tid}")
        free = [n for n, w in st["workers"].items() if not w.get("task")]
        print("WORKERS: " + ", ".join(
            f"{n} ({w['kind']}" + (f": {w['model']}, {w.get('tier') or 'unrated'}" if w.get("model") else "") + ")"
            + (" free" if n in free else f" on {w['task']}") for n, w in st["workers"].items()))
        print("event manager: " + (driver_line(driver_info()) if driver_alive() else
                                   "NOT running — your next `orch dispatch` or `orch answer` starts it"))
        if not new and not old and not hold:
            print("Nothing needs you.")
        print("Handle each event above, then STOP: you are woken again when something else happens. Never prompt a "
              "coder yourself and never poll.")
        if not peek and new:
            for e in new:
                e["read"] = now()
            save(st)


def cmd_escalate(args):
    """orch escalate Mn [reason] -> a milestone out of rounds gets one more go on a stronger model, if the team has
    one (exit 3: nothing stronger, or it was escalated before)."""
    need(args, 1, "escalate <Mn> [reason]")
    tid, reason = args[0], " ".join(args[1:])
    st = load()
    t = task(st, tid)
    cur = rank(st["workers"].get(t.get("worker") or t.get("last_worker") or "", {}).get("tier"))
    above = sorted({rank(w.get("tier")) for w in st["workers"].values()} - set(range(0, max(cur, need_rank(t)) + 1)))
    if t.get("escalated") or not cur or not above:
        print(f"NO_ESCALATION {tid}")
        sys.exit(3)
    tier = TIERS[above[0] - 1]
    t.update(escalated=True, min_tier=tier, fix_base=t.get("fix", 0), review_base=t.get("review_round", 0))
    t.pop("assign", None)
    why = f"escalated to a {tier}-tier model: {reason}" if reason else f"escalated to a {tier}-tier model"
    _park(st, tid, "pending", why)
    lead_event(st, "escalated", tid, why)
    save(st)
    print(f"ESCALATED {tid} -> {tier}")


def cmd_nudge(args):
    """orch nudge Mn -> re-send the current prompt once; exit 3 if already nudged."""
    need(args, 1, "nudge <Mn>")
    tid = args[0]
    st = load()
    t = task(st, tid)
    w = t.get("wait") or die(f"{tid} is not waiting on anyone")
    if w.get("nudges", 0) >= 1:
        print(f"ALREADY_NUDGED {tid}")
        sys.exit(3)
    try:
        deliver(st, w["agent"], "You stopped before finishing. " + w["prompt"])
    except DeliveryError as e:
        die(f"could not nudge {w['agent']}: {e}")
    _delivered(st, w["agent"])
    w["nudges"] = w.get("nudges", 0) + 1
    w["since"] = now()
    save(st)
    print(f"NUDGED {tid} -> {w['agent']}")


RATE_RE = re.compile(r"usage limit|rate.?limit|quota|too many requests|\b429\b|limit reached|try again (in|at)|out of credits",
                     re.I)


def cmd_autopilot(args):
    """The event manager: a plain script that watches the agents, runs checks, sends fixes and reviews, merges, and
    wakes the lead when something needs a decision. It is the only driver of a run: it holds the driver lease, and
    other processes can't change the run meanwhile (the lead's `orch dispatch` / `orch answer` are requests it
    carries out). Without a lead (`Lead mode: off`) it dispatches by itself and stops (exit 3) when a human is needed."""
    me = [sys.executable, os.path.abspath(__file__)]
    log = ORCH / "autopilot.log"
    take_lease()

    def say(msg, important=False):
        line = f"[{time.strftime('%H:%M:%S')}] {msg}"
        print(line, flush=True)
        with log.open("a") as f:
            f.write(line + "\n")
        if important and shutil.which("notify-send"):
            subprocess.run(["notify-send", "orch autopilot", msg], capture_output=True)

    def run(*a, ok=(0,)):
        r = subprocess.run(me + [str(x) for x in a], text=True, capture_output=True)
        out = (r.stdout + r.stderr).strip()
        if r.returncode not in ok:
            raise RuntimeError(f"orch {' '.join(str(x) for x in a)} -> exit {r.returncode}: {out}")
        return r.returncode, out

    def patch_state(fn):
        with state_lock():
            s_ = load()
            fn(s_)
            save(s_)

    def check(cwd, tid=None, where="worktree"):
        ok, tail, secs = run_check(st, cwd)
        if tid:
            patch_state(lambda s_: s_["tasks"][tid].setdefault("checks", []).append(
                {"where": where, "ok": ok, "secs": secs, "ts": now()}))
        return ok, tail

    def park(tid, status, reason, important=True, lost=False):
        run("park", tid, status, *(["--lost"] if lost else []), reason)
        t_ = load()["tasks"][tid]
        if t_["status"] == "failed" and status != "failed":
            say(f"{tid} failed: {t_.get('reason')}", True)
        else:
            say(f"{tid} {status}: {reason}", important)

    def fail(tid, reason):
        """Out of rounds: one more go on a stronger model when the team has one, else failed (the lead hears of it)."""
        code, out = run("escalate", tid, reason, ok=(0, 3))
        if code == 0:
            say(f"{tid}: {reason} -> {out.split('->')[-1].strip()}-tier model gets one fresh round, with the work so far", True)
        else:
            park(tid, "failed", reason)

    def wake_lead(force=False):
        """Tell the lead it has unread events: only when it is idle, once per batch, again after LEAD_REWAKE_S if it
        never read them (up to LEAD_MAX_WAKES). The events themselves are already safe in state.json."""
        s_ = load()
        if not lead_on(s_):
            return
        un = unread_events(s_)
        if not un:
            return
        lead, newest = s_["lead"]["name"], max(e["id"] for e in un)
        lw = s_.get("lead_wake") or {}
        # a wake the lead has not acted on yet covers newer events too: it reads the whole queue when it comes
        same = any(e["id"] <= lw.get("upto", 0) for e in un)
        if same and (now() - lw.get("ts", 0) < LEAD_REWAKE_S or lw.get("n", 0) >= LEAD_MAX_WAKES):
            if lw.get("n", 0) >= LEAD_MAX_WAKES and now() - lw.get("ts", 0) >= LEAD_REWAKE_S and not lw.get("told"):
                patch_state(lambda s2: s2["lead_wake"].update(told=True))
                say(f"the lead ({lead}) has not read its events after {LEAD_MAX_WAKES} wake-ups — look at its pane, "
                    f"or run `orch events --peek` yourself", True)
            return
        if watched(s_, lead) and not force:
            hs = herdr_state(lead)
            if hs is None:
                if not lw.get("gone"):
                    patch_state(lambda s2: s2.update(lead_wake={**(s2.get("lead_wake") or {}), "gone": True}))
                    say(f"the lead ({lead}) is not in herdr — start it and name it `{lead}`; {len(un)} event(s) wait "
                        f"for it (`orch events --peek` shows them)", True)
                return
            if word(hs, "working", "blocked"):
                return                                # busy: the events wait in the queue, one wake when it is idle
        text = (f"orch: {len(un)} new event(s) in the run on {s_['branch']} need the lead. Run `orch events` and "
                f"handle what it prints, then stop.")
        try:
            deliver(s_, lead, text)
        except DeliveryError as e:
            say(f"could not wake the lead ({lead}): {e} — will retry; the events are kept")
            patch_state(lambda s2: s2.update(lead_wake={"upto": newest, "ts": now() - LEAD_REWAKE_S + SEND_RETRY_S,
                                                        "n": lw.get("n", 0) if same else 0}))
            return
        patch_state(lambda s2: s2.update(lead_wake={"upto": newest, "ts": now(), "n": (lw.get("n", 0) if same else 0) + 1}))
        say(f"woke the lead ({lead}): {len(un)} event(s) — " + ", ".join(
            f"{e['kind']}{' ' + e['task'] if e.get('task') else ''}" for e in un[:6]))

    def lead_ready():
        """Ready milestones the lead has not dispatched: tell it once per set; start them ourselves after LEAD_WAIT_S."""
        s_ = load()
        hold = undispatched(s_)
        if not hold:
            return
        late = [k for k in hold if now() - s_["tasks"][k].get("ready_ts", now()) > LEAD_WAIT_S]

        def upd(s2):
            for k in hold:
                s2["tasks"][k].setdefault("ready_ts", now())
            for k in late:
                s2["tasks"][k]["go"] = True
                lead_event(s2, "auto-dispatched", k, f"not dispatched by the lead within {LEAD_WAIT_S // 60} min")
            rest = [k for k in hold if k not in late]
            if rest and rest != s2.get("lead_ready_told"):       # once per set, not once per loop
                lead_event(s2, "ready", None, ", ".join(rest))
            s2["lead_ready_told"] = rest
        patch_state(upd)
        for k in late:
            say(f"{k}: the lead did not dispatch it within {LEAD_WAIT_S // 60} min -> started without it", True)

    def guarded(tid, fn):
        """One task's orch error never stops the run: that task is paused with the error, the rest carry on."""
        try:
            fn()
        except RuntimeError as e:
            first = next((l for l in str(e).splitlines() if l.strip().startswith("ERROR")), str(e).splitlines()[0])
            try:
                park(tid, "paused", f"orch error: {first.strip()[:300]}")
            except RuntimeError as e2:
                say(f"{tid}: could not park after an error — stopping.\n{e}\n{e2}", True)
                sys.exit(3)
            say(f"{tid} details:\n{e}")

    def sent(code, out, tid, who):
        if code == 5:
            t_ = load()["tasks"][tid]
            if t_["status"] == "failed":
                say(f"{tid} failed: {t_.get('reason')}\n{out}", True)
            else:
                say(f"{tid}: could not reach {who} — it is benched and the work is queued again\n{out}",
                    "BENCHED" in out)
            return False
        return True

    def write_and_send(tid, fname, body):
        d = Path(load()["tasks"][tid]["dir"]) / TASK_DIR / tid
        (d / fname).write_text(body)
        code, out = run("send", tid, fname, ok=(0, 5))
        sent(code, out, tid, "the coder")

    def fix_round(tid, fname_prefix, body, cap_reason):
        """Count a fix round (capped by MAX_FIX), then send the coder a problem-only job."""
        code, _ = run("bump", tid, "fix", ok=(0, 3))
        if code == 3:
            fail(tid, cap_reason)
            return
        n = load()["tasks"][tid]["fix"]
        write_and_send(tid, f"{fname_prefix}-{n}.md", body(n))

    def held(tid, out):
        say(f"{tid} is HELD for your approval: {out.splitlines()[0].split('—', 1)[-1].strip()}. "
            f"Look at it, then run `orch approve {tid}`; autopilot keeps going with the rest", True)

    def land(tid):
        st_ = load()
        code, out = run("commit", tid, ok=(0, 7))
        if code == 7:
            held(tid, out)
            return False
        if st_["isolation"] == "shared":
            say(f"{tid} landed on {st_['branch']}")
            return True
        code, out = run("merge", tid, ok=(0, 3, 4, 6, 7))
        if code == 7:
            held(tid, out)
            return False
        if code == 3:
            say(f"{tid} failed: {out.splitlines()[0]}", True)
            return False
        if code in (4, 6):
            s_ = load()
            if code == 4 and s_["tasks"][tid].get("conflicts", 0) > MAX_CONFLICT:
                park(tid, "failed", f"merge conflict still unresolved after {MAX_CONFLICT} attempts")
                return False
            what = "merge conflict" if code == 4 else f"passes alone but fails the check on {s_['branch']} (not committed)"
            if holds(s_, tid):
                say(f"{tid} {what} -> back to {s_['tasks'][tid]['worker']}")
                code, out = run("send-job", tid, ok=(0, 5))
                sent(code, out, tid, s_["tasks"][tid]["worker"])
            else:
                say(f"{tid} {what} -> queued for the next free coder")
            return False
        say(f"{tid} checked and merged into {st_['branch']}")
        return True

    def handle(tid, t):
        if t["status"] == "verifying":
            res, err = read_result(t.get("last_result"))
            if err and err != "missing":
                if t.get("result_fixes", 0) >= 1:
                    park(tid, "paused", f"result file still not usable ({err}): {t.get('last_result')}")
                    return
                patch_state(lambda s_: s_["tasks"][tid].update(result_fixes=s_["tasks"][tid].get("result_fixes", 0) + 1))
                say(f"{tid}: result file not usable ({err}) -> asked the coder once to rewrite it")
                write_and_send(tid, "result-fix-1.md",
                               f"# Your result file for {tid} can't be used\n\n`{t.get('last_result')}`: {err}.\n\n"
                               "Don't change any code for this. Write the result file the prompt names, in the "
                               "`result_format` shape from task.json (valid JSON), plus the report, then the done "
                               "file.\n")
                return
            rp = t.get("last_report")
            rtext = Path(rp).read_text() if rp and Path(rp).exists() else ""
            if res:
                if res["status"] in ("question", "blocked"):
                    qs = [str(q) for q in res.get("questions", []) if q] or ["the coder is " + res["status"]]
                    park(tid, "paused", "; ".join(qs)[:400])
                    return
            else:
                q = [l for l in rtext.splitlines() if l.strip().upper().startswith("QUESTION:")]
                if q:
                    park(tid, "paused", q[0].strip()[9:].strip() or "worker asked a question")
                    return
            # scope: the real diff against the milestone's Likely files
            s_ = load()
            allowed = s_["tasks"][tid].get("files") or []
            if allowed:
                out_ = [f for f in changed_files(s_, s_["tasks"][tid]) if not path_allowed(f, allowed)]
                new = sorted(set(out_) - set(s_["tasks"][tid].get("out_of_scope") or []))
                if out_:
                    patch_state(lambda s2: s2["tasks"][tid].update(out_of_scope=out_))
                if new and s_.get("scope") == "strict":
                    say(f"{tid} changed files outside its Likely files: {', '.join(new)} -> fix round")
                    fix_round(tid, "scope-fix", lambda n: (
                        f"# {tid} changed files outside its scope (round {n})\n\n"
                        f"This milestone may change only: {', '.join(allowed)}. It also changed: "
                        f"{', '.join(new)}.\nUndo those changes, or, if the task truly can't be done without them, "
                        f"leave them and explain why in your report. Then run `{st['check']}`.\n"),
                        f"still outside its scope after {MAX_FIX} fix rounds: {', '.join(new)}")
                    return
                if new:
                    hot = [f for f in new if HOTSPOT_RE.search(f)]
                    say(f"{tid} changed files outside its Likely files: {', '.join(new)}" +
                        (f" (shared hotspot files: {', '.join(hot)})" if hot else ""), bool(hot))
            unmet = [c for c in (res or {}).get("criteria", []) if c.get("met") is False]
            if unmet:
                say(f"{tid}: the coder reports {', '.join(str(c['id']) for c in unmet)} not met -> fix round")
                fix_round(tid, "criteria-fix", lambda n: (
                    f"# {tid}: acceptance criteria not met yet (round {n})\n\nYour result says these are not met:\n"
                    + "\n".join(f"- {c['id']}: {c.get('evidence', '')}" for c in unmet)
                    + f"\n\nFinish them (you decide how), run `{st['check']}`, and write a new result.\n"),
                    f"acceptance criteria still not met after {MAX_FIX} fix rounds")
                return
            ok, tail = check(t["dir"], tid)
            if ok:
                if t["review"] and not t.get("review_ok"):
                    _, hout = run("handoff", tid)
                    if hout.startswith("HANDED_OFF"):
                        say(f"{tid} saved for review; {t['worker']} is free for other work")
                    code, out = run("review", tid, ok=(0, 3, 5))
                    say(out.splitlines()[-1])
                else:
                    land(tid)
            else:
                code, out = run("bump", tid, "fix", ok=(0, 3))
                if code == 3:
                    fail(tid, f"checks still failing after {MAX_FIX} fix rounds")
                else:
                    n = load()["tasks"][tid]["fix"]
                    say(f"{tid} checks failed -> fix round {n}")
                    write_and_send(tid, f"fix-{n}.md",
                                   f"# Checks failing for {tid} (round {n})\n\nThe check command `{st['check']}` "
                                   f"failed. Diagnose the cause and fix it; you decide how. Don't change unrelated "
                                   f"code, and don't weaken or skip tests to make them pass.\n\n"
                                   f"```\n{tail}\n```\n")
        elif t["status"] == "awaiting-review":
            code, out = run("review", tid, ok=(0, 3, 5))
            if code == 0:
                say(out)
            elif code == 5:
                n = (load().get("reviewer_info") or {}).get("delivery_fails", 0)
                say(f"{tid}: could not reach the reviewer — retrying when herdr sees it again (or after "
                    f"{SEND_RETRY_S if n < UNREACHABLE_AFTER else UNREACHABLE_MIN * 60}s)\n{out}",
                    n in (1, UNREACHABLE_AFTER))
        elif t["status"] == "reviewed":
            k = t["review_round"]
            blockers, _, known = review_findings(tid, k)
            where = f".orchestrate/review/{tid}/review-{k}.json"
            if not known:
                park(tid, "paused", f"review output not usable (no valid {where}, no BLOCKER/SUGGESTION/NO FINDINGS "
                                    f"lines in review-{k}.md)")
            elif blockers:
                code, _ = run("bump", tid, "review", ok=(0, 3))
                if code == 3:
                    fail(tid, f"reviewer still has blockers after {MAX_REVIEW} rounds: {where}")
                else:
                    run("needs-fix", tid)
                    s_ = load()
                    if holds(s_, tid):
                        say(f"{tid} review: {len(blockers)} blocker(s) -> back to {s_['tasks'][tid]['worker']}")
                        code, out = run("send-job", tid, ok=(0, 5))
                        sent(code, out, tid, s_["tasks"][tid]["worker"])
                    else:
                        say(f"{tid} review: {len(blockers)} blocker(s) -> fix job queued (first free coder)")
            else:
                run("review-ok", tid)
                say(f"{tid} review passed")
                land(tid)
        elif t["status"] == "committed":
            land(tid)

    def dispatch(kind, tid, worker):
        _, prep = run("prepare", tid, worker)
        if "SETUP_NEEDED" in prep:
            d = load()["tasks"][tid]["dir"]
            say(f"installing dependencies in {d}" + (" (dependency files changed)" if "changed" in prep else ""))
            r = subprocess.run(st["setup"], shell=True, cwd=d, text=True, capture_output=True)
            if r.returncode != 0:
                park(tid, "pending", f"setup command failed in {d}")
                say(r.stdout[-2000:] + r.stderr[-2000:], True)
                sys.exit(3)
            run("setup-done", worker)
        run("write-task", tid)
        code, out = run("send-job" if kind == "FIX" else "send", tid, *([] if kind == "FIX" else ["task.md"]),
                        ok=(0, 5))
        if sent(code, out, tid, worker):
            say(f"{tid} fix job -> {worker}" if kind == "FIX" else f"{tid} -> {worker}")

    def on_event(ev):
        parts = ev.split()
        if len(parts) < 2:
            return
        kind, tid = parts[0], parts[1]
        agent = (re.search(r"agent=(\S+)", ev) or re.search(r"worker=(\S+)", ev) or [None, None])[1]
        s_ = load()
        t = s_["tasks"].get(tid, {})
        w = t.get("wait") or {}
        reviewer = w.get("kind") == "reviewer"
        if kind == "DONE":
            say(f"{tid} done by {agent} -> running checks")
        elif kind == "REVIEWED":
            say(f"{tid} reviewed")
        elif kind == "UNCONFIRMED":
            code, out = run("resend", tid, ok=(0, 5))
            say(f"{tid}: the prompt to {agent} was recorded but not confirmed (interrupted run?) -> sent again to "
                f"the same agent" if code == 0 else f"{tid}: could not re-send to {agent}\n{out}")
        elif kind == "ORPHAN":
            if t.get("status") == "reviewing":
                run("requeue-review", tid)
                say(f"{tid}: the review prompt never went out -> queued for review again")
            elif t.get("status") == "coding":
                park(tid, "pending", "its prompt never went out (interrupted run) — will be sent again",
                     important=False, lost=True)
            else:
                park(tid, "paused", f"{t.get('status')} with no job and no agent working on it — check it and "
                                    f"`orch set {tid} pending`")
        elif kind == "BLOCKED":
            key = f"{tid}:{t.get('attempt')}:{w.get('kind')}"
            if key not in s_.get("notified", []):          # kept in state: a restart doesn't alert twice
                patch_state(lambda s2: s2["notified"].append(key))
                say(f"{agent} is waiting for a PERMISSION/QUESTION in its pane (task {tid}). "
                    f"Answer it there; autopilot keeps going.", True)
            time.sleep(20)
        elif kind == "IDLE":
            if (w.get("report") and Path(w["report"]).exists()) or (w.get("result") and Path(w["result"]).exists()):
                Path(w["sentinel"]).touch()
                say(f"{tid}: {agent} wrote its report but no done file — accepting it")
                return
            try:
                r = subprocess.run([HERDR, "agent", "read", agent, "--source", "recent-unwrapped", "--lines", "40"],
                                   text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
                pane = r.stdout + r.stderr
            except (OSError, subprocess.TimeoutExpired):
                pane = ""
            if RATE_RE.search(pane) and not reviewer:
                park(tid, "pending", f"{agent} hit a usage/rate limit", important=False, lost=True)
                run("cooldown", agent, os.environ.get("ORCH_COOLDOWN_MIN", "60"), "rate-limit")
                say(f"{agent} benched; {tid} will move to another coder with its work so far", True)
            else:
                code, _ = run("nudge", tid, ok=(0, 3))
                if code == 3:
                    park(tid, "paused", f"{agent} stopped twice without finishing", lost=True)
                else:
                    say(f"{tid}: {agent} went idle early -> nudged once")
        elif kind == "TIMEOUT":
            park(tid, "paused", f"{agent} over its time budget ({ev.split('after')[-1].strip()})")
        elif kind == "GONE":
            if reviewer:
                run("requeue-review", tid)
                run("cooldown", agent, GONE_COOLDOWN_MIN, "gone")
                say(f"reviewer {agent} is gone — restart it; {tid} waits for review (the coder's work is kept)", True)
            else:
                park(tid, "pending", f"{agent} disappeared from herdr", important=False, lost=True)
                run("cooldown", agent, GONE_COOLDOWN_MIN, "gone")
                say(f"{agent} is gone — restart it in its folder; {tid} goes to the next free coder", True)

    run("sync")
    _, start_out = run("start")
    for line in start_out.splitlines():
        if line.startswith(("RECOVERED", "WARN agent")):
            say(line)
    stale = [l for l in start_out.splitlines() if "STALE pane" in l]
    if stale:
        say("A pane id in plan.md is stale. Stopping.\n" + "\n".join(stale), True)
        sys.exit(3)
    st = load()
    for name in [n for n in st["workers"] if not watched(st, n)] + (
            [st["reviewer"]] if st.get("reviewer") and not watched(st, st["reviewer"]) else []):
        say(f"can't watch {name} through herdr; relying on its done file (and its time budget)")
    if not (ORCH / "baseline.txt").exists():
        ok, tail = check(ROOT)
        (ORCH / "baseline.txt").write_text(tail)
        if not ok:
            (ORCH / "baseline.txt").unlink()
            say("Baseline check fails on the feature branch before any work. Autopilot needs a green check: fix "
                "the failures, or narrow the plan's `Check command` to what should pass (ask the lead: "
                "`orch lead run` helps with this), then run autopilot again. Stopping.\n" + tail, True)
            sys.exit(3)
    if st.get("integration_broken"):
        ok, tail = check(ROOT)
        if not ok:
            say(f"{st['branch']} still fails its check (broken since {st['integration_broken']}). "
                f"Fix it, then run autopilot again. Stopping.\n{tail}", True)
            sys.exit(3)
        patch_state(lambda s_: s_.update(integration_broken=None))
        say(f"{st['branch']} passes its check again — carrying on")
    patch_state(lambda s_: s_["run"].setdefault("started", now()))
    say(f"autopilot started: {st['isolation']} mode, max {st['max_parallel']} parallel, workers "
        + str([n + (f" ({w['model']})" if w.get("model") else "") for n, w in st["workers"].items()])
        + (f", budget {st['budget_s'] // 60} min" if st.get("budget_s") else "")
        + (f"; events go to the lead ({st['lead']['name']})" if lead_on(st) else ""))
    last_tick = time.time()
    waiting_since = None       # set while nothing runs and the run waits for the lead or the developer

    while True:
        st = load()
        # 0. budget: driving time adds up across restarts (time spent only waiting for an answer doesn't count)
        el, last_tick = time.time() - last_tick, time.time()
        if waiting_since:
            el = 0
        patch_state(lambda s_: s_["run"].update(driven_s=round(s_["run"].get("driven_s", 0) + el, 1)))
        st = load()
        if st.get("budget_s") and st["run"].get("driven_s", 0) > st["budget_s"]:
            say(f"STOPPED — the run's budget ({st['budget_s'] // 60} min of autopilot time) is used up. Raise "
                f"`Budget:` in plan.md (or remove it) and run autopilot again; work in progress is kept.", True)
            sys.exit(3)

        # 1. act on tasks waiting for us
        for tid in st["order"]:
            t = st["tasks"][tid]
            guarded(tid, lambda: handle(tid, t))

        # 2. dispatch: queued fix/conflict jobs first, then new milestones, to free coders
        st = load()
        _, out = run("ready")
        slots = int(re.search(r"SLOTS (\d+)", out).group(1))
        jobs = [l for l in out.splitlines() if l.startswith("FIX ")] + \
               [l for l in out.splitlines() if l.startswith("READY ")]
        for line in jobs:
            if slots <= 0:
                break
            kind, tid = line.split()[0], line.split()[1]
            code, worker = run("pick", tid, ok=(0, 3))
            if code == 3:
                continue          # nobody of its tier (or its assigned coder) is free; others may still start
            guarded(tid, lambda: dispatch(kind, tid, worker))
            slots -= 1
        lead_ready()
        wake_lead()

        # 3. finished or stuck?
        st = load()
        tasks = st["tasks"]
        if all(t["status"] in ("merged", "skipped") for t in tasks.values()):
            ok, tail = check(ROOT)
            if not ok:
                patch_state(lambda s_: s_.update(integration_broken="the final check"))
            patch_state(lambda s_: s_["run"].update(ended=now()))
            base = st.get("base") or "main"
            log_ = git("log", "--oneline", f"{base}..HEAD", cwd=ROOT, check=False).stdout
            stat = git("diff", "--stat", f"{base}..HEAD", cwd=ROOT, check=False).stdout
            sugg, scope = [], []
            for k, v in tasks.items():
                for rnd in range(1, v.get("review_round", 0) + 1):
                    sugg += [f"- {k}: {s}" for s in review_findings(k, rnd)[1]]
                if v.get("out_of_scope"):
                    scope.append(f"- {k}: {', '.join(v['out_of_scope'])}")
            _, report = run("report", "--no-time", ok=(0, 1, 2))
            timing = "\n".join(time_lines(time_account(load())))
            models = []
            for k, v in tasks.items():
                used = [a for a in v.get("attempts") or [] if a.get("kind") == "coder" and a.get("model")]
                if v.get("tier") or used:
                    ran = ", ".join(dict.fromkeys(f"{a['model']} ({a.get('tier') or 'unrated'})" for a in used)) or "-"
                    models.append(f"| {k} | {v.get('tier') or 'any'} | {ran} | "
                                  f"{'yes' if v.get('escalated') else 'no'} | {v.get('model_why') or '-'} |")
            lead_ = lead_on(st)
            prev = ORCH / "summary.md"
            if prev.exists():                      # a fix after ALL_DONE writes the summary again: keep the lead's notes
                shutil.copyfile(prev, ORCH / "summary.prev.md")
            (ORCH / "summary.md").write_text(
                f"# Summary: {st.get('title') or st['branch']}\n\nBranch `{st['branch']}` into `{base}`. "
                f"Final check on the branch: {'PASS' if ok else 'FAIL'}\n\n"
                "## Tasks\n" + "\n".join(f"- {k}: {v['title']} ({v['status']}, last coder {v.get('worker') or v.get('last_worker') or '-'})"
                                         for k, v in tasks.items()) +
                f"\n\n## Commits\n```\n{log_}```\n\n## Files changed\n```\n{stat}```\n\n"
                "## Changed outside Likely files\n" + ("\n".join(scope) or "none") + "\n\n"
                "## Reviewer suggestions not applied\n" + ("\n".join(sugg) or "none") + "\n\n"
                + ("## Models: planned and actual\n| Milestone | Planned tier | Ran on | Escalated | Why this tier |\n"
                   "|---|---|---|---|---|\n" + "\n".join(models) + "\n\n" if models else "") +
                f"## Time: estimate vs actual\n{timing}\n\n"
                f"## Run report\n```\n{report}\n```\n\n"
                + ("## Still to write (the lead was woken to write these)\n" if lead_ else
                   "## Still to write (ask the lead: 'use the orch-run skill' to finish the summary)\n") +
                "- Design decisions & study notes\n- Manual verification checklist\n"
                + ("\nThe summary before this one is in `.orchestrate/summary.prev.md`: carry its notes and checklist "
                   "over, and add what the new work changed.\n" if prev.exists() else ""))
            if lead_:
                patch_state(lambda s_: lead_event(s_, "all_done", None,
                                                  f"final check {'PASS' if ok else 'FAIL'} on {st['branch']}"))
                for _ in range(6):                    # give a busy lead a moment, then wake it anyway
                    hs = herdr_state(st["lead"]["name"]) if watched(st, st["lead"]["name"]) else ""
                    if hs is None or not word(hs, "working", "blocked"):
                        break
                    time.sleep(POLL_STEP_S)
                wake_lead(force=True)
            say(f"ALL_DONE on {st['branch']} — final check {'PASS' if ok else 'FAIL'}. See .orchestrate/summary.md, "
                f"then run `orch finish` to push {st['branch']} and open a PR into {base}", True)
            sys.exit(0 if ok else 3)
        active = [k for k, v in tasks.items() if v["status"] in ACTIVE and v["status"] != "held"]
        ready = [k for k, v in tasks.items() if v["status"] == "pending" and deps_met(st, v)]
        open_ev = ([e for e in st["lead_events"] if e["kind"] in LEAD_BLOCKING and event_open(st, e)]
                   if lead_on(st) else [])
        if not active and (undispatched(st) or (not ready and open_ev)):
            # nothing is running and the next move is the lead's (or the developer's, through the lead): stay up,
            # so the answer or dispatch is carried out the moment it comes. No AI runs while we wait.
            if waiting_since is None:
                waiting_since = time.time()
                say("waiting for the lead: " + ", ".join(dict.fromkeys(
                    [f"{e['kind']} {e['task']}" for e in open_ev if e.get("task")]
                    + [f"dispatch {k}" for k in undispatched(st)])), True)
            if time.time() - waiting_since > LEAD_IDLE_MAX_S:
                say(f"STOPPED — no answer for {LEAD_IDLE_MAX_S // 60} min. Everything is kept: run `orch autopilot` "
                    f"again when you are back (`orch events --peek` shows what is open).", True)
                sys.exit(3)
            run("poll", str(int(min(30, max(1, POLL_STEP_S * 3)))), ok=(0, 10))
            continue
        waiting_since = None
        if not active and not ready:
            waiting = [f"  {k} {v['status']}: {v.get('reason') or ''}" for k, v in tasks.items()
                       if v["status"] in ("paused", "failed", "needs-answer", "pending", "held")]
            say("STOPPED — needs you:\n" + "\n".join(waiting) +
                "\nAnswer in plan.md 'Notes from user' (set Open questions: - none), run `orch set <Mn> pending` "
                "for paused/failed tasks, `orch approve <Mn>` for held ones, then run `orch autopilot` again "
                "(or ask the lead: `orch lead run`).", True)
            sys.exit(3)

        # 4. wait for the next event
        code, out = run("poll", "30", ok=(0, 10))
        if code == 10:
            continue
        for ev in out.splitlines():
            evtid = ev.split()[1] if len(ev.split()) > 1 else None
            if evtid:
                guarded(evtid, lambda: on_event(ev))


def _fmt_secs(s):
    s = int(s or 0)
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def run_report(st):
    """Numbers for one run, from what orch recorded (attempts, checks, rounds). No guesses: unknown stays unknown."""
    rows, tot = [], {"tasks": 0, "merged": 0, "failed": 0, "first_pass": 0, "reviewed": 0, "re_reviewed": 0,
                     "conflicts": 0, "lost": 0, "fix_rounds": 0, "agent_s": 0, "wasted_s": 0, "check_s": 0,
                     "input_tokens": 0, "output_tokens": 0, "cost_usd": 0.0, "usage_known": 0}
    for tid in st["order"]:
        t = st["tasks"][tid]
        if t["status"] == "skipped":
            continue
        at = t.get("attempts") or []
        coder = [a for a in at if a.get("kind") == "coder"]
        agent_s = sum(a.get("secs", 0) for a in at)
        wasted = sum(a.get("secs", 0) for a in at if a.get("outcome") != "done")
        check_s = sum(c.get("secs", 0) for c in t.get("checks") or [])
        first = (t["status"] == "merged" and t.get("fix", 0) == 0 and t.get("review_round", 0) <= 1
                 and not t.get("conflicts") and len([a for a in coder if a.get("outcome") == "done"]) <= 1)
        for a in at:
            u = a.get("usage") or {}
            if u:
                tot["usage_known"] += 1
            for k in ("input_tokens", "output_tokens", "cost_usd"):
                if isinstance(u.get(k), (int, float)):
                    tot[k] += u[k]
        rows.append({"task": tid, "status": t["status"], "attempts": len(coder), "fix_rounds": t.get("fix", 0),
                     "review_rounds": t.get("review_round", 0), "conflicts": t.get("conflicts", 0),
                     "lost": t.get("lost", 0), "agent_s": agent_s, "wasted_s": wasted, "check_s": check_s,
                     "first_pass": first})
        tot["tasks"] += 1
        tot["merged"] += t["status"] == "merged"
        tot["failed"] += t["status"] == "failed"
        tot["first_pass"] += first
        tot["reviewed"] += t.get("review_round", 0) >= 1
        tot["re_reviewed"] += t.get("review_round", 0) >= 2
        for k in ("conflicts", "lost"):
            tot[k] += t.get(k, 0)
        tot["fix_rounds"] += t.get("fix", 0)
        tot["agent_s"] += agent_s
        tot["wasted_s"] += wasted
        tot["check_s"] += check_s
    tot["driven_s"] = (st.get("run") or {}).get("driven_s", 0)
    # how each model really did: the numbers to hold against its catalog ratings
    by_model = {}
    for tid in st["order"]:
        t = st["tasks"][tid]
        coder = [a for a in t.get("attempts") or [] if a.get("kind") == "coder" and a.get("model")]
        for a in coder:
            m = by_model.setdefault(a["model"], {"model": a["model"], "tier": a.get("tier"), "attempts": 0, "done": 0,
                                                 "agent_s": 0, "tasks": [], "merged": 0, "first_pass": 0,
                                                 "escalated_away": 0})
            m["attempts"] += 1
            m["done"] += a.get("outcome") == "done"
            m["agent_s"] += a.get("secs", 0)
            if tid not in m["tasks"]:
                m["tasks"].append(tid)
        if coder:
            last = by_model[coder[-1]["model"]]
            last["merged"] += t["status"] == "merged"
            last["first_pass"] += bool(next((r["first_pass"] for r in rows if r["task"] == tid), False))
            if t.get("escalated") and coder[0]["model"] != coder[-1]["model"]:
                by_model[coder[0]["model"]]["escalated_away"] += 1
    for r in rows:
        t = st["tasks"][r["task"]]
        r["tier"], r["escalated"] = t.get("tier"), bool(t.get("escalated"))
    return {"branch": st["branch"], "tasks": rows, "totals": tot, "models": list(by_model.values())}


# ---------------------------------------------------------------- estimate vs actual time
CODER_JOBS = [   # prompt file -> what the coder was doing (anything but task.md is extra work)
    ("review-fix", "fixing the reviewer's blockers"),
    ("integration-fix", "fixing the check that failed once merged onto the branch"),
    ("criteria-fix", "fix rounds: acceptance criteria not met"),
    ("scope-fix", "fix rounds: changed files outside Likely files"),
    ("result-fix", "rewriting a result file orch could not read"),
    ("conflict", "resolving merge conflicts"),
    ("fix", "fix rounds: the check command failed"),
]


def _transitions(st):
    """Every status change of every milestone in this run, oldest first: events.jsonl, or the history in
    state.json when the log is missing."""
    since = (st.get("run") or {}).get("started") or 0
    by = {tid: [] for tid in st["tasks"]}
    p = ORCH / "events.jsonl"
    if p.exists():
        for line in p.read_text().splitlines():
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("task") in by and ev.get("ts", 0) >= since:
                by[ev["task"]].append(ev)
    for tid, t in st["tasks"].items():
        if not by[tid]:
            by[tid] = [dict(h, task=tid) for h in t.get("history") or []]
        by[tid].sort(key=lambda e: e.get("ts", 0))
    return by


def _wait_part(st, status, why, agent):
    """A milestone sat in `status` after it had started: what it was waiting for and on whom. None = busy."""
    why = why or ""
    if status == "awaiting-review":
        return "waiting for the reviewer (busy with other work or unreachable)", st.get("reviewer") or "reviewer"
    if status == "needs-fix":
        return "waiting for a free coder to take its fix job", "the coders (all busy)"
    if status == "paused":
        return f"paused, waiting for the lead or the developer ({why[:80]})" if why else \
            "paused, waiting for the lead or the developer", "developer / lead"
    if status == "needs-answer":
        return "open questions waiting for the developer's answer", "developer"
    if status == "held":
        return "risky change waiting for the developer's `orch approve`", "developer"
    if status == "failed":
        return "failed, waiting for the lead to dispatch it again", "lead / developer"
    if status == "pending":
        if RATE_RE.search(why):
            return "agent hit a usage limit: benched, work waited for another coder", agent or "agent"
        if "disappeared" in why or "gone" in why:
            return "agent disappeared from herdr: work waited for another coder", agent or "agent"
        if why.startswith("escalated"):
            return "waiting for a stronger coder after escalation", "the coders (all busy)"
        if why.startswith("answered"):
            return "waiting for the coder to pick up the answer", agent or "coder"
        return "waiting for a free coder" + (f" ({why[:60]})" if why else ""), "the coders (all busy)"
    return None


def _who(a):
    return f"{a.get('agent') or '?'} ({a['model']})" if a.get("model") else (a.get("agent") or "?")


def time_account(st, at=None):
    """Estimated vs actual time per milestone and for the feature, from what orch recorded: status changes,
    attempts (who, which model, which job), check times and time agents sat at a prompt. Nothing is guessed:
    time orch can't place is shown as orch's own steps, and a missing estimate stays missing."""
    at = at or now()
    trans, rows = _transitions(st), []
    for tid in st["order"]:
        t = st["tasks"][tid]
        if t["status"] == "skipped":
            continue
        evs = trans.get(tid, [])
        first = next((i for i, e in enumerate(evs) if e.get("to") == "coding"), None)
        row = {"task": tid, "title": t.get("title", ""), "estimate_s": t.get("estimate_s"), "actual_s": None,
               "landed": t["status"] == "merged", "start": None, "end": None, "parts": [], "over_s": None}
        rows.append(row)
        if first is None:
            continue
        start = evs[first]["ts"]
        end = next((e["ts"] for e in evs[first:] if e.get("to") == "merged"), None)
        if end is None:
            end = at
        parts = {}

        def add(what, who, secs, extra):
            if secs <= 0:
                return
            p = parts.setdefault((what, who), {"what": what, "who": who, "secs": 0, "extra": extra})
            p["secs"] += secs
        # waiting: from the status changes
        for i in range(first, len(evs)):
            a_, b_ = max(evs[i]["ts"], start), min(evs[i + 1]["ts"] if i + 1 < len(evs) else end, end)
            w = _wait_part(st, evs[i].get("to"), evs[i].get("why"), evs[i].get("agent"))
            if w and b_ > a_:
                add(w[0], w[1], b_ - a_, True)
        # working: from the attempts
        esc = next((e["ts"] for e in evs[first:] if (e.get("why") or "").startswith("escalated")), None)
        built = reviewed = False
        for a in t.get("attempts") or []:
            if a.get("start", 0) < start or a.get("start", 0) >= end:
                continue
            secs, blocked = a.get("secs", 0), a.get("blocked_s", 0)
            if blocked:
                add("stopped at a permission prompt or question in its pane", a.get("agent") or "?", blocked, True)
            secs -= blocked
            if a.get("outcome") != "done":
                why = re.sub(r"^parked as \w[\w-]*:?\s*", "", a.get("outcome") or "")
                add(f"work cut short ({why[:60] or 'stopped'}); the next attempt carried on from it", _who(a), secs, True)
            elif a.get("kind") == "reviewer":
                add("review" if not reviewed else "review again after fixes", _who(a), secs, reviewed)
                reviewed = True
            else:
                f = a.get("file") or "task.md"
                job = next((d for k, d in CODER_JOBS if f.startswith(k + "-")), None)
                if job:
                    add(job, _who(a), secs, True)
                elif esc and a["start"] >= esc:
                    add("building again on a stronger model (escalated)", _who(a), secs, True)
                else:
                    add("building it", _who(a), secs, False)
                    built = True
        seen = set()
        for c in t.get("checks") or []:
            if start <= c.get("ts", 0) <= end:
                again = c.get("where") in seen
                seen.add(c.get("where"))
                add("checks run again after fixes" if again else "checks", "check command", c.get("secs", 0), again)
        total = end - start
        placed = sum(p["secs"] for p in parts.values())
        add("orch's own steps (setup, prompts, merge)", "orch", max(0, total - placed), False)
        row.update(start=start, end=end, actual_s=total,
                   parts=sorted(parts.values(), key=lambda p: (p["extra"], -p["secs"])))
        if row["estimate_s"]:
            row["over_s"] = total - row["estimate_s"]
    # the feature: from the first milestone starting to the last one landing; time after every milestone had
    # landed and before a fix asked with `orch fix` is not counted, time with nothing running is
    started = sorted((r for r in rows if r["start"]), key=lambda r: r["start"])
    feat = {"estimate_s": st.get("estimate_s"), "actual_s": None, "over_s": None, "idle_s": 0, "after_done_s": 0,
            "landed": bool(rows) and all(r["landed"] for r in rows), "why": []}
    if started:
        fstart = started[0]["start"]
        fend = max(r["end"] for r in started)
        reach, idle, after = started[0]["end"], 0, 0
        for r in started[1:]:
            if r["start"] > reach:
                gap = r["start"] - reach
                if st["tasks"][r["task"]].get("fix_of") and all(x["landed"] and x["end"] <= reach
                                                                for x in started if x["start"] < r["start"]):
                    after += gap
                else:
                    idle += gap
            reach = max(reach, r["end"])
        feat.update(actual_s=fend - fstart - after, idle_s=idle, after_done_s=after)
        if feat["estimate_s"]:
            feat["over_s"] = feat["actual_s"] - feat["estimate_s"]
        agg = {}
        for r in started:
            for p in r["parts"]:
                if p["extra"]:
                    k = (p["what"], p["who"])
                    g = agg.setdefault(k, {"what": p["what"], "who": p["who"], "secs": 0, "tasks": []})
                    g["secs"] += p["secs"]
                    g["tasks"].append(r["task"])
        if idle:
            agg[("idle", "")] = {"what": "no milestone was running (waiting for the lead's `orch dispatch`, or the "
                                         "event manager was stopped)", "who": "lead / event manager", "secs": idle,
                                 "tasks": []}
        feat["why"] = sorted(agg.values(), key=lambda g: -g["secs"])
    return {"feature": feat, "tasks": rows}


def _dur(s):
    """Short and readable: 45s, 40m, 1h05m."""
    if s is None:
        return "-"
    s = abs(int(s))
    if s < 60:
        return f"{s}s"
    h, m = divmod(round(s / 60), 60)
    return f"{h}h{m:02d}m" if h else f"{m}m"


def time_lines(acct):
    """Estimate vs actual as markdown: a table, then, for whatever took longer than planned, why and who."""
    f, out = acct["feature"], []
    est, act = f["estimate_s"], f["actual_s"]
    head = (f"Whole feature: estimated {_dur(est) if est else 'not given'}, actual "
            f"{_dur(act) if act is not None else 'not started'}" + ("" if f["landed"] else " so far (not all landed)"))
    if est and act is not None:
        head += (f", {_dur(f['over_s'])} longer than estimated" if f["over_s"] > 0 else
                 f", {_dur(f['over_s'])} quicker than estimated" if f["over_s"] < 0 else ", on time")
    out += [head, "", "| Milestone | Estimate | Actual | Difference | Built by |", "|---|---|---|---|---|"]
    for r in acct["tasks"]:
        diff = "-" if r["over_s"] is None else ("on time" if r["over_s"] == 0 else
                                                f"{'+' if r['over_s'] > 0 else '-'}{_dur(r['over_s'])}")
        who = ", ".join(dict.fromkeys(p["who"] for p in r["parts"] if p["what"] == "building it")) or "-"
        act_ = "not started" if r["actual_s"] is None else _dur(r["actual_s"]) + ("" if r["landed"] else " so far")
        out.append(f"| {r['task']} | {_dur(r['estimate_s']) if r['estimate_s'] else 'none'} | {act_} | {diff} | {who} |")
    late = [r for r in acct["tasks"] if r["over_s"] and r["over_s"] > 0]
    if est and f["over_s"] and f["over_s"] > 0 and f["why"]:
        out += ["", f"Why the feature took {_dur(f['over_s'])} longer (time added up per milestone; milestones that "
                    "ran side by side overlap, so this can add up to more):"]
        out += [f"- {_dur(g['secs'])} {g['who']}: {g['what']}"
                + (f" ({', '.join(dict.fromkeys(g['tasks']))})" if g["tasks"] else "") for g in f["why"]]
    for r in late:
        out += ["", f"Why {r['task']} took {_dur(r['over_s'])} longer than its {_dur(r['estimate_s'])} estimate:"]
        extra = [p for p in r["parts"] if p["extra"]]
        planned = sum(p["secs"] for p in r["parts"] if not p["extra"])
        out += [f"- {_dur(p['secs'])} {p['who']}: {p['what']}" for p in extra]
        if planned > r["estimate_s"]:
            out.append(f"- the planned work alone took {_dur(planned)}: " + ", ".join(
                f"{p['what']} {_dur(p['secs'])} ({p['who']})" for p in r["parts"] if not p["extra"])
                + " (the estimate itself was too low for this work)")
    if not est and not any(r["estimate_s"] for r in acct["tasks"]):
        out += ["", "No estimates in plan.md (`Estimate:` in the header and in each milestone), so only the actual "
                    "time is shown."]
    return out


def cmd_report(args):
    """orch report [--json] [--no-time] -> estimated vs actual time (and why it took longer), rounds, first-pass
    rate and wasted work for this run."""
    st = load()
    rep_ = run_report(st)
    if "--json" in args:
        rep_["time"] = time_account(st)
        print(json.dumps(rep_, indent=2))
        return
    if "--no-time" not in args:
        print("Estimate vs actual\n" + "\n".join(time_lines(time_account(st))) + "\n")
    tot = rep_["totals"]
    print(f"{'task':<5} {'status':<15} {'tries':>5} {'fix':>4} {'review':>6} {'confl':>5} {'lost':>4} "
          f"{'agent time':>10} {'wasted':>8} {'checks':>8}  first pass")
    for r in rep_["tasks"]:
        print(f"{r['task']:<5} {r['status']:<15} {r['attempts']:>5} {r['fix_rounds']:>4} {r['review_rounds']:>6} "
              f"{r['conflicts']:>5} {r['lost']:>4} {_fmt_secs(r['agent_s']):>10} {_fmt_secs(r['wasted_s']):>8} "
              f"{_fmt_secs(r['check_s']):>8}  {'yes' if r['first_pass'] else 'no'}")
    n = tot["tasks"] or 1
    print(f"\nmerged {tot['merged']}/{tot['tasks']}, failed {tot['failed']}; first pass {tot['first_pass']}/"
          f"{tot['tasks']} ({100 * tot['first_pass'] // n}%); needed a 2nd review round {tot['re_reviewed']}/"
          f"{tot['reviewed']}; conflicts {tot['conflicts']}; lost attempts {tot['lost']}; fix rounds {tot['fix_rounds']}")
    print(f"agent time {_fmt_secs(tot['agent_s'])}, of which wasted {_fmt_secs(tot['wasted_s'])} (attempts that "
          f"didn't finish); checks {_fmt_secs(tot['check_s'])}; autopilot time {_fmt_secs(tot['driven_s'])}")
    if rep_["models"]:
        print(f"\n{'model':<18} {'tier':<8} {'tasks':>5} {'tries':>5} {'merged':>6} {'first pass':>10} {'moved up':>8} {'agent time':>10}")
        for m in rep_["models"]:
            print(f"{m['model']:<18} {m['tier'] or 'unrated':<8} {len(m['tasks']):>5} {m['attempts']:>5} {m['merged']:>6} "
                  f"{m['first_pass']:>10} {m['escalated_away']:>8} {_fmt_secs(m['agent_s']):>10}")
        print("(moved up = milestones this model could not finish, escalated to a stronger one; compare with "
              "`orch models`)")
    if tot["usage_known"]:
        print(f"usage reported by agents on {tot['usage_known']} attempt(s): {tot['input_tokens']} input tokens, "
              f"{tot['output_tokens']} output tokens, ${tot['cost_usd']:.2f}")
    else:
        print("tokens/cost: unknown (no agent reported `usage` in its result file)")


def launch_cmd(kind, v, model=None, strict=True):
    """The shell command that starts agent `kind` in a pane, on `model` when given. With strict=False a kind
    without a model_flag starts on its default model instead of failing (the caller says so)."""
    cmd = v.get("launch") or v.get("binary", kind)
    if model:
        cat = models_catalog()
        why = model_denied(cat, model)
        if why:
            die(f"{model!r} is not allowed by the model policy (pattern {why!r}) — see `orch models`")
        if not v.get("model_flag"):
            if not strict:
                return cmd
            die(f"the registry has no `model_flag` for {kind}, so orch can't build the command — choose the "
                f"model inside {kind}, or set model_flag for it in {user_agents_file()}")
        kinds = ((cat or {}).get("models", {}).get(model.lower()) or {}).get("kinds")
        if kinds and kind not in kinds:
            print(f"WARN: the catalog lists {model} for {', '.join(kinds)}, not {kind}", file=sys.stderr)
        cmd += f" {v['model_flag']} {shlex.quote(model)}"
    return cmd


# ---------------------------------------------------------------- team: the whole team from one installed tool
TEAM_WAIT_S = float(os.environ.get("ORCH_TEAM_WAIT_S", "90"))


def team_models(cat, kind):
    """Catalog models this kind can run, allowed by policy and rated, weakest first: [(id, tier)]."""
    out = [(mid, model_tier(cat, mid)) for mid, m in ((cat or {}).get("models") or {}).items()
           if kind in (m.get("kinds") or []) and not model_denied(cat, mid)]
    return sorted(((mid, t) for mid, t in out if t), key=lambda x: (rank(x[1]), x[0]))


def team_pick(cands, n):
    """n coder models spread over the tiers on offer: always the strongest, then the weakest, then the middle."""
    if not cands:
        return [None] * n
    if n == 1:
        return [cands[-1][0]]
    idx = [round(i * (len(cands) - 1) / (n - 1)) for i in range(n)]
    return [cands[i][0] for i in idx]


def cmd_team(args):
    """orch team <kind> [--coders N] [--models a,b] [--no-reviewer] -> the plan's team built from one tool.
    orch team up [--dry-run] -> open a herdr pane for every agent in the plan that herdr cannot find."""
    if args and args[0] == "up":
        return team_up(args[1:])
    usage = "usage: orch team <kind> [--coders N] [--models a,b] [--no-reviewer]  |  orch team up [--dry-run]"
    rest, coders, models, reviewer = list(args), None, None, True
    if "--no-reviewer" in rest:
        rest.remove("--no-reviewer")
        reviewer = False
    for flag in ("--coders", "--models"):
        if flag in rest:
            i = rest.index(flag)
            val = rest[i + 1] if len(rest) > i + 1 else die(usage)
            del rest[i:i + 2]
            if flag == "--coders":
                coders = int(val) if val.isdigit() and int(val) >= 1 else die("--coders needs a number from 1")
            else:
                models = [m.strip().lower() for m in val.split(",") if m.strip()]
    if len(rest) != 1 or rest[0].startswith("-"):
        die(usage)
    kind = rest[0].lower()
    reg = registry()
    v = reg.get(kind) or die(f"unknown agent kind {kind!r} — known: {', '.join(reg)} (add it in {user_agents_file()})")
    if not shutil.which(v.get("binary", kind)):
        print(f"WARN: `{v.get('binary', kind)}` is not on PATH here, so {kind} panes would not start", file=sys.stderr)
    roles = v.get("roles", ["lead", "coder", "reviewer"])
    if "coder" not in roles:
        die(f"{kind} does not have the coder role in the agent registry")
    cat = models_catalog()
    cands = team_models(cat, kind)
    if models:
        for m in models:
            why = model_denied(cat, m)
            if why:
                die(f"{m!r} is not allowed by the model policy (pattern {why!r}) — see `orch models`")
        picked = models if coders is None else (models * coders)[:coders]
    else:
        picked = team_pick(cands, coders or 2)
    top = cands[-1][0] if cands else None
    no_flag = not v.get("model_flag")
    fmt = lambda name, m: f"{name} ({kind}: {m})" if m and not no_flag else f"{name} ({kind})"
    workers = [fmt(f"{kind}-{i + 1}", m) for i, m in enumerate(picked)]
    tier = {mid: t for mid, t in cands}
    print(f"TEAM from {kind}: {len(workers)} coder(s)" + (", 1 reviewer" if reviewer and "reviewer" in roles else ""))
    for i, m in enumerate(picked):
        print(f"  {kind + '-' + str(i + 1):<12} {m or 'its default model'}" + (f"  ({tier[m]} tier)" if m in tier else ""))
    if reviewer and "reviewer" in roles:
        print(f"  {'reviewer':<12} {top or 'its default model'}" + (f"  ({tier[top]} tier)" if top in tier else ""))
    print("\nPlan header lines:")
    print(f"Lead: lead ({kind}: <the model your own pane runs>)")
    print("Workers: " + ", ".join(workers))
    print("Reviewer: " + (fmt("reviewer", top) if reviewer and "reviewer" in roles else "none"))
    if not cands and not models:
        print(f"\nNOTE: the model catalog has no allowed model for {kind}, so every pane starts on its default model "
              f"(add models in {user_models_file()} to get tiers)")
    if no_flag:
        print(f"\nNOTE: {kind} has no model option in the registry: pick each pane's model inside {kind}")
    if top and tier.get(top) != "high":
        print(f"\nNOTE: the strongest allowed {kind} model is {top} ({tier.get(top)} tier): high-tier milestones go to "
              f"it, and `orch sync` will say so")
    print(f"\nCheck these are models your {kind} really reaches (`--models a,b` to choose others).")
    print("\nThese panes don't exist yet. After `orch sync` and `orch start`, `orch team up` opens each one in its "
          "own folder, on its model, and names it.")


def _herdr_json(cmd):
    """Run a herdr command; (ok, parsed JSON or None, text)."""
    try:
        r = subprocess.run(cmd, text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, None, str(e)
    out = (r.stdout + r.stderr).strip()
    try:
        data = json.loads(r.stdout)
    except ValueError:
        data = None
    return r.returncode == 0, data, out


def team_up(args):
    """Open a pane for every worker and the reviewer in the plan that herdr can't find: split from this pane, cd
    into the agent's folder (its worktree, or the repo), start it on its plan model, and give it its plan name."""
    dry = "--dry-run" in args
    st = load()
    reg = registry(required=False) or {}
    agents = [(n, w, w.get("dir")) for n, w in st["workers"].items()]
    if st.get("reviewer"):
        agents.append((st["reviewer"], st.get("reviewer_info") or {}, str(ROOT)))
    missing_dirs = [n for n, w, d in agents if n in st["workers"] and not d]
    if missing_dirs:
        die(f"run `orch start` first: it makes each coder's folder ({', '.join(missing_dirs)} have none yet)")
    todo = []
    for name, w, d in agents:
        if w.get("pane"):
            ok, _, _ = _herdr_json([HERDR, "pane", "get", w["pane"]])
            print(f"ok      {name}: pane {w['pane']}" if ok else
                  f"STALE   {name}: pane {w['pane']} is gone — remove `@pane:` from plan.md, `orch sync`, then "
                  f"`orch team up` again")
            continue
        if herdr_state(name) is not None:
            print(f"ok      {name}: already running")
            continue
        todo.append((name, w, d))
    if not todo:
        print("TEAM UP: every agent in the plan is running")
        return
    failed, last = 0, None
    for name, w, d in todo:
        kind, model = w.get("kind"), w.get("model")
        v = reg.get(kind)
        if not v:
            print(f"SKIP    {name}: kind {kind!r} is not in the agent registry — start it yourself in {d}")
            failed += 1
            continue
        cmd = launch_cmd(kind, v, model, strict=False)
        split = [HERDR, "pane", "split"] + ([last] if last else []) + \
                ["--direction", "down" if last else "right", "--cwd", d, "--no-focus"]
        if dry:
            print(f"WOULD   {name}: {' '.join(shlex.quote(x) for x in split)}  then  herdr pane run <new pane> "
                  f"{shlex.quote(cmd)}  then  herdr agent rename <new pane> {name}")
            continue
        ok, data, out = _herdr_json(split)
        pid = None
        try:
            pid = data["result"]["pane"]["pane_id"] if ok else None
        except (TypeError, KeyError):
            pid = (re.search(r'"pane_id"\s*:\s*"([\w:.-]+)"', out) or [None, None])[1]
        if not pid:
            print(f"FAILED  {name}: herdr could not open a pane ({out.splitlines()[-1] if out else 'no output'})")
            failed += 1
            continue
        last = pid
        ok, _, out = _herdr_json([HERDR, "pane", "run", pid, cmd])
        if not ok:
            print(f"FAILED  {name}: pane {pid} opened, but `herdr pane run` failed ({out[-120:]})")
            failed += 1
            continue
        if model and not v.get("model_flag"):
            print(f"NOTE    {name}: {kind} has no model option — switch pane {pid} to {model} inside {kind}")
        if not v.get("herdr_detect", True):
            _herdr_json([HERDR, "pane", "rename", pid, name])
            print(f"OPENED  {name}: pane {pid} in {short(d)} — herdr can't watch {kind}: write it as "
                  f"`{name} ({kind} @pane:{pid})` in plan.md, then `orch sync`")
            continue
        deadline, named = time.time() + TEAM_WAIT_S, False
        while True:          # herdr names an agent only once it has detected it in the pane
            ok, _, out = _herdr_json([HERDR, "agent", "rename", pid, name])
            if ok or time.time() >= deadline:
                named = ok
                break
            time.sleep(min(2.0, max(0.2, TEAM_WAIT_S / 30)))
        if named:
            print(f"OPENED  {name}: pane {pid} in {short(d)} running `{cmd}`")
        else:
            print(f"WAITING {name}: pane {pid} runs `{cmd}`, but herdr has not seen the agent start yet — if it "
                  f"shows a first-run question (trust this folder, sign in), answer it, then: herdr agent rename {pid} {name}")
            failed += 1
    if dry:
        return
    print("TEAM UP: done — run `orch start` again; every agent should show herdr=found" if not failed else
          f"TEAM UP: {failed} agent(s) not ready — see above, then `orch team up` again")
    if failed:
        sys.exit(3)


COMMANDS = {
    "sync": cmd_sync, "start": cmd_start, "ready": cmd_ready, "pick": cmd_pick, "prepare": cmd_prepare,
    "setup-done": cmd_setup_done, "send": cmd_send, "review": cmd_review, "poll": cmd_poll, "bump": cmd_bump,
    "commit": cmd_commit, "merge": cmd_merge, "park": cmd_park, "cooldown": cmd_cooldown, "set": cmd_set,
    "status": cmd_status, "cleanup": cmd_cleanup,
    "write-task": cmd_write_task, "nudge": cmd_nudge, "autopilot": cmd_autopilot,
    "send-job": cmd_send_job, "handoff": cmd_handoff, "needs-fix": cmd_needs_fix, "review-ok": cmd_review_ok,
    "requeue-review": cmd_requeue_review, "finish": cmd_finish, "resend": cmd_resend, "approve": cmd_approve,
    "report": cmd_report, "events": cmd_events, "dispatch": cmd_dispatch, "answer": cmd_answer,
    "escalate": cmd_escalate, "fix": cmd_fix, "team": cmd_team,
}
# they lock per step instead of for the whole command (long-running, or they start the event manager after)
UNLOCKED = {"autopilot", "poll", "events", "dispatch", "answer", "fix", "team"}

USAGE = """usage: orch <command> [args]
  version                  print the installed herdr-orchestra version
  lead plan|run            print the lead playbook (any agent can lead: "Run `orch lead plan` and follow it")
  lead check               preflight: is this agent in a Herdr pane / can it reach herdr?
  lead whoami              show the lead's own herdr pane and how to name it `lead`
  team <kind> [--coders N] [--models a,b] [--no-reviewer]
                           the plan's team built from one installed tool: coders + reviewer on its catalog models
  team up [--dry-run]      open a herdr pane for every agent in the plan herdr can't find, in its folder, and name it
  agents                   the agent registry: kinds, installed?, roles, herdr detection, launch commands
  agents launch <kind> [--model <id>]  print the command that starts <kind> in a pane (auto-approve edits)
  models                   the model catalog: tiers (small / medium / high), ratings, and what policy forbids
  models show|check <id>   one model's ratings and evidence / is it allowed?
  events [--peek]          (lead) what you were woken for; reading acknowledges it
  dispatch <Mn>... [--to <worker>] [--tier <tier>]   (lead) start or restart milestones; starts the event manager
  answer <Mn> <text>       (lead) the developer's answer: into plan.md, and back to the same coder
  fix <Mn> <text> [--to <worker>]   a change to something Mn already landed: a small follow-up milestone, sent
                           straight to the coder who built Mn (no new plan; check, review and summary still apply)
  agents sync [kind...]    install the orch-plan / orch-run skills for every installed agent (run it after adding a new agent)
  agents check             check the orch-plan / orch-run skills are installed for every installed agent
  doctor [kind...]         check installed agents against the real tool: version, launch flags, skills, herdr
  sync                     parse .orchestrate/plan.md -> state.json (validates deps, cycles, overlaps)
  start                    create/switch to the feature branch (plan `Branch:`); create worker worktrees (worktree mode)
  status                   table of workers + tasks; prints ALL_DONE or STUCK when relevant
  report [--json]          estimate vs actual time (why longer, who), rounds, first-pass rate, wasted work, tokens/cost
  ready                    free coder slots, FIX jobs (do these first), then READY milestones
  pick <Mn>                first available worker for the task (respects Tier, then Prefer), or NONE (exit 3)
  escalate <Mn> [reason]   out of rounds: one more go on a stronger model, if the team has one (exit 3 if not)
  prepare <Mn> <worker>    reserve worker, put its worktree on the milestone's saved work (detached), print TASKDIR
  setup-done <worker>      mark the worker's worktree as dependency-installed
  send <Mn> <file>         prompt the task's worker to execute TASKDIR/<file> (task.md, fix-1.md, ...)
  poll [secs]              wait for the next event: DONE / REVIEWED / BLOCKED / IDLE / TIMEOUT / GONE / ORPHAN
  bump <Mn> fix|review     count a fix/review round; exit 3 with CAP when the limit is hit
  review <Mn>              snapshot the diff and send it to the reviewer (BUSY exit 3 if reviewer occupied)
  commit <Mn>              save the task's work (shared mode: commit it on the feature branch, which lands it)
  merge <Mn>               squash the milestone, run the check on the result, commit it ONLY if green (CONFLICT 4, CHECK_FAILED 6, HELD 7)
  park <Mn> paused|failed|pending [--lost] [reason]   free the worker, keep its work in a hidden ref (refs/orch/...)
  cooldown <agent> <min> [reason]  bench a worker or the reviewer (reason `gone`: ends once herdr sees it again)
  set <Mn> <status> [reason] [--force]  manual override: pending/paused/failed/skipped (others need --force)
  approve <Mn>             let a milestone held for risky changes land (works while autopilot runs)
  cleanup                  remove clean worker worktrees
  finish [--no-push]       final check, drop hidden refs + worktrees, push the feature branch, open a PR into base
  write-task <Mn>          generate TASKDIR/task.md from plan.md (+ reports of merged dependencies)
  nudge <Mn>               re-send the current prompt once to an agent that stopped early
  autopilot                the event manager: watches agents, checks, merges, wakes the lead; exits 0 ALL_DONE, 3 when it needs you
  handoff <Mn>             (worktree) save the milestone for review and free its coder for other work
  needs-fix <Mn>           queue the latest review's BLOCKERs as a fix job for the next free coder
  send-job <Mn>            send a queued fix/conflict job to the task's coder (after pick + prepare)
  review-ok <Mn>           record that the reviewer approved Mn
  requeue-review <Mn>      the reviewer vanished mid-review: queue the same round again
  resend <Mn>              re-send a recorded but unconfirmed prompt to the same agent (after a crash)

Exit codes: 2 error · 3 needs you / busy / cap · 4 merge conflict · 5 prompt not delivered (retried later) ·
            6 check fails on the feature branch (nothing committed) · 7 held for approval · 10 poll wait
While `orch autopilot` runs it holds the driver lease: other commands that change the run are refused
(status, ready, pick, report, approve, fix and the lead's events / dispatch / answer still work).
"""

# Env vars a Herdr pane carries. Agents whose tools run in a separate background process (Hermes runs
# every session in one gateway) don't pass them on to their shell tool, so HERDR_ENV can be unset there
# even though the agent sits in a Herdr pane.
HERDR_PANE_ENV = ("HERDR_ENV", "HERDR_PANE_ID", "HERDR_SOCKET_PATH", "HERDR_BIN_PATH")


def lead_check():
    """Preflight: is this agent driving Herdr? HERDR_ENV=1 is the fast path; otherwise ask the herdr server."""
    if os.environ.get("HERDR_ENV") == "1":
        print(f"OK inside a Herdr pane (HERDR_ENV=1, pane {os.environ.get('HERDR_PANE_ID') or '?'})")
        return
    try:
        r = subprocess.run([HERDR, "pane", "current"], text=True, capture_output=True, timeout=20)
        reachable, detail = r.returncode == 0, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        reachable, detail = False, str(e)
    hermes_fix = ("If the agent is Hermes, its tools run in the Hermes gateway, which does not see the pane's env. "
                  "Add this to ~/.hermes/config.yaml, then restart Hermes:\n"
                  "    terminal:\n      client_env_passthrough: [" + ", ".join(HERDR_PANE_ENV) + "]")
    if reachable:
        print("OK herdr is reachable, but this shell has no HERDR_ENV, so herdr cannot tell which pane is yours.\n"
              "  Carry on; `orch lead whoami` will show the focused pane — confirm it is yours.\n  " + hermes_fix)
        return
    die("Herdr not detected: HERDR_ENV is not 1 and `herdr pane current` failed"
        + (f" ({detail.splitlines()[-1]})" if detail else "") + ".\n"
        "  Start this agent from a Herdr pane, and make sure `herdr` is on PATH (or set HERDR=/path/to/herdr).\n  "
        + hermes_fix)


def cmd_lead(args):
    """orch lead plan|run -> print the lead playbook; orch lead whoami -> this pane + how to name it `lead`."""
    sub = args[0] if args else ""
    if sub in ("plan", "run"):
        pb = asset(f"playbooks/{sub}.md") or die(f"playbooks/{sub}.md not found next to orch or in the install")
        print(f"herdr-orchestra {installed_version()} — lead playbook: {sub}\n")
        print(pb.read_text(), end="")
        return
    if sub == "check":
        lead_check()
        return
    if sub == "whoami":
        try:
            r = subprocess.run([HERDR, "pane", "current"], text=True, capture_output=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired) as e:
            die(f"herdr pane current failed: {e}")
        if r.returncode != 0:
            die("not inside a herdr pane (`herdr pane current` failed) — start this agent from a Herdr pane: "
                + (r.stdout + r.stderr).strip())
        if not os.environ.get("HERDR_PANE_ID"):
            print("NOTE: HERDR_PANE_ID is not set in this shell, so herdr reported the FOCUSED pane. "
                  "Check it is the pane you are running in before renaming it.")
        out = r.stdout.strip()
        try:
            pane = json.loads(out)["result"]["pane"]
            pid, status = pane.get("pane_id"), pane.get("agent_status", "unknown")
            print(f"PANE {pid} agent_status={status}")
        except (ValueError, KeyError, TypeError):
            pid = (re.search(r'"?pane_id"?\s*[:=]\s*"?([\w:.-]+)', out) or [None, None])[1]
            print(out)
        print(f"This pane is YOU (the lead). Name it:  herdr agent rename {pid or '<pane id>'} lead\n"
              f"Write `Lead: lead (<your kind>)` in the plan header, and never prompt this pane.")
        return
    die("usage: orch lead plan | run | check | whoami")


def manifest_path():
    return Path.home() / ".local/share/herdr-orchestra" / "manifest.txt"


def short(p):
    """~/path for display."""
    p = str(p)
    home = str(Path.home())
    return "~" + p[len(home):] if p.startswith(home) else p


def manifest_record(*paths):
    """Append paths to the installer's manifest so `install.sh --uninstall` removes them."""
    mf = manifest_path()
    mf.parent.mkdir(parents=True, exist_ok=True)
    lines = mf.read_text().splitlines() if mf.exists() else []
    for p in paths:
        if str(p) not in lines:
            lines.append(str(p))
    mf.write_text("".join(line + "\n" for line in lines))


def _copy_asset(src, dst):
    """Copy src -> dst, creating parents. True if dst was created or changed."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.exists() and dst.read_bytes() == src.read_bytes():
        return False
    shutil.copy2(src, dst)
    return True


def sync_skills(d):
    """Copy orch-plan / orch-run into <d>/<skill>/SKILL.md. Returns (changed, paths to record)."""
    src = asset("skills") or die("skills/ not found next to orch or in the install")
    changed, recs = False, []
    for s in ("orch-plan", "orch-run"):
        changed |= _copy_asset(src / s / "SKILL.md", d / s / "SKILL.md")
        recs.append(d / s)
    return changed, recs


def sync_commands(d, flavor):
    """Copy the orch-*.md slash commands into d. Returns (changed, paths to record)."""
    src = asset(flavor)
    if not src:
        return False, []
    changed, recs = False, []
    for f in sorted(src.glob("orch-*.md")):
        changed |= _copy_asset(f, d / f.name)
        recs.append(d / f.name)
    return changed, recs


def agent_assets(v):
    """[(path, installed?)] for every skill/slash-command the registry says an agent should have."""
    out = []
    for d in v.get("skills_dirs", []):
        for s in ("orch-plan", "orch-run"):
            p = expand(d) / s / "SKILL.md"
            out.append((p, p.exists()))
    for d in v.get("commands_dirs", []):
        for s in ("orch-plan", "orch-run"):
            p = expand(d) / f"{s}.md"
            out.append((p, p.exists()))
    return out


def agents_sync(reg, installed, want=None):
    """Copy the orch skills/commands into the shared dirs + every installed agent's folders.
    Idempotent; records each written path in the uninstall manifest. Prints a status table."""
    home = expand("~")
    targets = [("base", [("skills", home / ".agents/skills", None)] +
               [("commands", d, "opencode-commands")
                for d in (home / ".config/opencode/commands", home / ".config/opencode/command")], "")]
    for k, v in reg.items():
        if want is not None and k not in want:
            continue
        if not installed[k]:
            if want is not None:
                print(f"skip {k:<9} not installed")
            continue
        items = [("skills", expand(d), None) for d in v.get("skills_dirs", [])]
        items += [("commands", expand(d), v.get("commands_from", "claude-commands"))
                  for d in v.get("commands_dirs", [])]
        targets.append((k, items, v.get("invoke", "Run `orch lead plan` and follow it. Feature: <feature>")))
    new = same = 0
    for k, items, invoke in targets:
        changed, recs = False, []
        for what, d, flavor in items:
            c, r = sync_skills(d) if what == "skills" else sync_commands(d, flavor)
            changed, recs = changed or c, recs + r
        manifest_record(*recs)
        new += changed
        same += not changed
        status, whats = ("NEW" if changed else "ok  "), "  ".join(
            f"{what}: {short(d)}" for what, d, _ in items)
        print(f"  {status} {k:<8} {whats}" + (f"  {invoke}" if invoke else ""))
    print(f"synced {len(targets)} row(s): {new} new, {same} unchanged — "
          f"restart running agents so they pick up the skills")


def cmd_agents(args):
    """orch agents [launch <kind> | check | sync | dirs] -> the agent registry."""
    reg = registry()
    sub = args[0] if args else ""
    installed = {k: bool(shutil.which(v.get("binary", k))) for k, v in reg.items()}
    if sub == "launch":
        rest = args[1:]
        model = None
        if "--model" in rest:
            i = rest.index("--model")
            model = rest[i + 1] if len(rest) > i + 1 else die("usage: orch agents launch <kind> [--model <id>]")
            del rest[i:i + 2]
        kind = rest[0] if rest else die("usage: orch agents launch <kind> [--model <id>]")
        v = reg.get(kind) or die(f"unknown agent kind {kind!r} — known: {', '.join(reg)} "
                                 f"(add it in {user_agents_file()})")
        print(launch_cmd(kind, v, model))
        return
    if sub == "dirs":           # for install.sh: <kind>\t<skills|commands|invoke>\t<dir or text>[\t<commands_from>]
        for k, v in reg.items():
            if not installed[k]:
                continue
            print(f"{k}\tinvoke\t{v.get('invoke', 'Run `orch lead plan` and follow it. Feature: <feature>')}")
            for d in v.get("skills_dirs", []):
                print(f"{k}\tskills\t{expand(d)}")
            for d in v.get("commands_dirs", []):
                print(f"{k}\tcommands\t{expand(d)}\t{v.get('commands_from', 'claude-commands')}")
        return
    if sub == "check":
        bad = 0
        for k, v in reg.items():
            if not installed[k]:
                continue
            for p, ok in agent_assets(v):
                bad += not ok
                label = "skill   " if p.name == "SKILL.md" else "command "
                print(f"{'ok  ' if ok else 'MISSING'} {k:<9} {label}{p}")
        if bad:
            print(f"{bad} missing — run: orch agents sync")
            sys.exit(1)
        return
    if sub == "sync":
        want = {k.lower() for k in args[1:]} if len(args) > 1 else None
        if want:
            unknown = sorted(want - set(reg))
            if unknown:
                die(f"unknown agent kind {', '.join(unknown)} — known: {', '.join(reg)} "
                    f"(add it in {user_agents_file()})")
        agents_sync(reg, installed, want)
        return
    if sub:
        die("usage: orch agents [launch <kind> | check | sync | dirs]")
    print(f"{'kind':<9} {'installed':<9} {'detect':<6} {'verified':<8} {'roles':<22} launch")
    for k, v in reg.items():
        print(f"{k:<9} {'yes' if installed[k] else 'no':<9} {'yes' if v.get('herdr_detect', True) else 'no':<6} "
              f"{'yes' if v.get('verified') else 'no':<8} {','.join(v.get('roles', [])):<22} "
              f"{v.get('launch', v.get('binary', k))}")
    missing = [k for k, v in reg.items()
               if installed[k] and any(not ok for _, ok in agent_assets(v))]
    if missing:
        print(f"\n{', '.join(missing)}: orch-plan/orch-run missing — run: orch agents sync")
    print(f"\nOverride or add kinds in {user_agents_file()}")


def _probe(cmd, timeout=15):
    try:
        r = subprocess.run(cmd if isinstance(cmd, list) else shlex.split(cmd), text=True, capture_output=True,
                           timeout=timeout, stdin=subprocess.DEVNULL)
        return r.returncode, r.stdout + r.stderr
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        return None, str(e)


def doctor_kind(kind, v, full=True):
    """[(ok, message)] for one installed agent kind, or None if its binary isn't on PATH. Read-only."""
    binary = v.get("binary", kind)
    if not shutil.which(binary):
        return None
    out = []
    if full:
        vcmd = v.get("version_cmd") or f"{binary} --version"
        code, text = _probe(vcmd)
        first = next((l.strip() for l in text.splitlines() if l.strip()), "")
        out.append((True, f"version: {first}" if code == 0 and first else f"version: unknown (`{vcmd}` failed)"))
    hcmd = v.get("help_cmd") or f"{binary} --help"
    code, help_ = _probe(hcmd)
    try:
        launch = shlex.split(v.get("launch") or binary)
    except ValueError:
        launch = [binary]
    flags = [tok.split("=")[0] for tok in launch[1:] if tok.startswith("-")]
    for fl in flags:
        if code is None:
            out.append((False, f"launch flag {fl}: `{hcmd}` did not run ({help_.strip()[:80]})"))
        elif re.search(rf"(?<![\w-]){re.escape(fl)}(?![\w-])", help_):
            out.append((True, f"launch flag {fl} is listed in `{hcmd}`"))
        else:
            out.append((False, f"launch flag {fl} is NOT in `{hcmd}` — the launch command in the registry may be out "
                               f"of date (override it in {short(user_agents_file())})"))
    if full:
        for p, ok in agent_assets(v):
            out.append((ok, f"skill {short(p)}" + ("" if ok else " missing — run `orch agents sync`")))
        if v.get("herdr_detect", True):
            code, txt = _probe([HERDR, "agent"])
            if code == 0:
                ok = bool(re.search(rf"(?<![\w-]){re.escape(kind)}(?![\w-])", txt))
                out.append((ok, "herdr knows this kind" if ok else
                            "herdr does not list this kind (`herdr agent`): set herdr_detect = false for it"))
            else:
                out.append((True, "herdr not reachable here: detection not checked"))
    return out


def cmd_doctor(args):
    """orch doctor [kind...] -> check each installed agent against the real tool (version, launch flags, skills,
    herdr detection). Read-only. Exit 1 if anything is broken."""
    reg = registry()
    kinds = [k.lower() for k in args] or list(reg)
    broken = 0
    for k in kinds:
        if k not in reg:
            print(f"BROKEN  {k}: not in the agent registry (add it in {short(user_agents_file())})")
            broken += 1
            continue
        res = doctor_kind(k, reg[k])
        if res is None:
            print(f"skip    {k}: `{reg[k].get('binary', k)}` is not installed")
            continue
        bad = [m for ok, m in res if not ok]
        broken += bool(bad)
        print(f"{'BROKEN' if bad else 'ok':<7} {k}" + ("" if reg[k].get("verified") else "  (registry entry unverified)"))
        for ok, m in res:
            print(f"    {'ok ' if ok else 'BAD'} {m}")
    sys.exit(1 if broken else 0)


def installed_version():
    for p in (Path(__file__).resolve().parent.parent / "VERSION",
              Path.home() / ".local/share/herdr-orchestra/current/VERSION"):
        if p.exists():
            return p.read_text().strip()
    return "unknown"


if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] in ("version", "--version", "-v"):
        print(f"herdr-orchestra {installed_version()}")
        sys.exit(0)
    NO_REPO_COMMANDS = {"lead": cmd_lead, "agents": cmd_agents, "doctor": cmd_doctor, "models": cmd_models,
                        "team": cmd_team}
    if (len(sys.argv) >= 2 and sys.argv[1] in NO_REPO_COMMANDS      # work outside a git repo
            and sys.argv[2:3] != ["up"]):                           # (`orch team up` reads the run's state)
        NO_REPO_COMMANDS[sys.argv[1]](sys.argv[2:])
        sys.exit(0)
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(USAGE)
        sys.exit(0 if len(sys.argv) < 2 else 2)
    ROOT = main_root()
    ORCH = ROOT / ".orchestrate"
    ORCH.mkdir(exist_ok=True)
    STATE = ORCH / "state.json"
    if sys.argv[1] not in LEASE_FREE:
        require_driver()
    if sys.argv[1] in UNLOCKED:
        COMMANDS[sys.argv[1]](sys.argv[2:])
    else:
        with state_lock():
            COMMANDS[sys.argv[1]](sys.argv[2:])
