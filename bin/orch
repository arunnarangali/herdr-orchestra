# they lock per step instead of for the whole command (long-running, or they start the event manager after)
UNLOCKED = {"manual", "autopilot", "poll", "merge", "events", "dispatch", "answer", "defer", "fix", "team", "resume", "bench", "stop",
            "doctor", "check", "free", "view", "board"}

USAGE = """usage: orch <command> [args]
  version                  print the installed herdr-orchestra version
  update [--check] [--version vX.Y.Z]  install the latest release (or that one) and show what is new
  config [auto-update on|off]  this machine's settings: keep orch up to date by itself, or only be told
  config compact on|off    a coder or the reviewer gets /compact when its milestone is done (on by default for
                           Claude Code, Codex and AGY 1.2.15+; never the lead). ORCH_COMPACT=0|1 overrides it
  lead plan|run            print the lead playbook (any agent can lead: "Run `orch lead plan` and follow it")
  lead plan quick|full     the rest of the plan playbook: a quick run's rules, or steps 3-10 of the full process
  lead run --section <EVENT|ALL_DONE|rules>   one part of the run playbook (orch events prints these for you)
  lead check               preflight: is this agent in a Herdr pane / can it reach herdr?
  lead whoami              show the lead's own herdr pane and name it as the plan's `Lead:` (default `lead`)
  team <kind> [--coders N] [--models a,b] [--no-reviewer]
                           the plan's team built from one installed tool: coders + reviewer on its catalog models
  team up [--dry-run] [--mode panes|subagent]
                           open a herdr pane for every agent in the plan herdr can't find, in its folder, and name it
                           (subagent mode: no panes; sets up the Pi coder/reviewer subagents instead)
  mode [panes|subagent] [--agent <kind>]   this agent's mode, or save one: panes (herdr panes, the default for
                           every agent) or subagent (one Pi window; Pi only). Saved per agent in
                           ~/.config/herdr-orchestra/config.json ("modes": {"pi": "subagent"}); ORCH_MODE=panes|subagent
                           overrides it for one command. orch finds the agent by itself (ORCH_AGENT=<kind> to say it)
  setup [--mode panes|subagent] [--agent <kind>]  get this machine ready for a mode; subagent (saved for Pi): write
                           ~/.pi/agent/agents/coder.md and reviewer.md from the config and install pi-subagents
  agents                   the agent registry: kinds, installed?, roles, herdr detection, launch commands
  agents launch <kind> [--model <id>] [--role reviewer]  print the command that starts <kind> in a pane
                           (auto-approve edits; --role reviewer: its read-only reviewer command when it has one)
  models                   the model catalog: tiers (small / medium / high), ratings, and what policy forbids
  models show|check <id>   one model's ratings and evidence / is it allowed?
  resume                   after a restart (computer off, herdr closed): name the agents' panes again, save unsaved
                           work, re-send the tasks that were in progress and start the event manager
  story                    the run diary in plain words: each event and what the lead did (.orchestrate/story.md)
  manual                   the manual tests: what to try by hand, numbered, from the summary's Manual verification
                           checklist (`orch finish` prints them too, and the lead posts them in its chat)
  plan show                the plan for a person: each milestone in plain words, who builds it, how long, the order
  events [--peek]          (lead) what you were woken for; reading acknowledges it
  dispatch <Mn>... [--to <worker>] [--tier <tier>]   (lead) start or restart milestones; starts the event manager
  check [Mn]               run the plan's check command in the main folder: CHECK PASS, or CHECK FAIL (exit 1)
  sub next | sub done <Mn> (lead, subagent mode) the next milestone and its task file | save a finished milestone
  answer <Mn> [--defer AC2,AC3] <text>   (lead) the developer's answer: into plan.md, and back to the same coder;
                           --defer records that the developer approved leaving those criteria undone
  defer <Mn> <AC2,AC3> <reason>   (lead, only with the developer's yes) these criteria stay undone in Mn: no fix
                           rounds or escalation for them; the summary lists them as NOT done, with a follow-up
  fix <Mn> <text> [--to <worker>]   a change to something Mn already landed: a small follow-up milestone, sent
                           straight to the coder who built Mn (no new plan; check, review and summary still apply)
  agents sync [kind...]    install the orch-plan / orch-run / orch-explain skills so every installed agent sees each one exactly once,
                           and remove old copies (run it after adding a new agent; the installer runs it)
  agents check             check every installed agent sees each orch skill once (not missing, not twice)
  guard [status|--print]   install the pre-push guard: no agent ever pushes to main/master/the default branch
                           (orch start installs it too); status: report it and whether GitHub protects main
  doctor [kind...]         check installed agents against the real tool: version, launch flags, skills, herdr
  sync                     parse .orchestrate/plan.md -> state.json (validates deps, cycles, overlaps)
  start                    create/switch to the feature branch (plan `Branch:`); create worker worktrees (worktree mode)
  status [--json]          table of workers + tasks; prints ALL_DONE or STUCK when relevant. --json: the run summary
                           both views read (milestones with their plain description, agents, counts, time, cost)
  view [--lan] [--port N] [--no-open] [--bg]
                           the run as a live picture in your browser (view only): milestone graph, agents, details,
                           "needs you" alert, time and cost, replay. --lan: also from your phone, with a secret link
  view stop|status|herdr-config|plugin link|unlink
                           stop it / show its link / sidebar lines for herdr's config / the optional herdr plugin
  board [--once]           the run as text, redrawn when it changes: for a herdr pane or popup (any terminal)
  report [--json]          estimate vs actual time (why longer, who), rounds, first-pass rate, wasted work, tokens/cost
  ready                    free coder slots, FIX jobs (do these first), then READY milestones
  pick <Mn>                first available worker for the task (respects Tier, then Prefer), or NONE (exit 3)
  escalate <Mn> [reason]   out of rounds: one more go on a stronger model, if the team has one (exit 3 if not)
  prepare <Mn> <worker>    reserve worker, put its worktree on the milestone's saved work (detached), print TASKDIR
  setup-done <worker>      mark the worker's worktree as dependency-installed
  send <Mn> <file>         prompt the task's worker to execute TASKDIR/<file> (task.md, fix-1.md, ...)
  poll [secs]              wait for the next event: DONE / REVIEWED / BLOCKED / IDLE / TIMEOUT / GONE / ORPHAN
  bump <Mn> fix|review     count a fix/review round; exit 3 with CAP when the limit is hit
  review <Mn>              snapshot the diff and send it to the reviewer (BUSY exit 3 if reviewer occupied)
  commit <Mn>              save the task's work (shared mode: commit it on the feature branch, which lands it)
  merge <Mn>               squash the milestone, run the check on the result, commit it ONLY if green (CONFLICT 4, CHECK_FAILED 6, HELD 7)
  park <Mn> paused|failed|pending [--lost] [reason]   free the worker, keep its work in a hidden ref (refs/orch/...)
  cooldown <agent> <min> [reason]  bench a worker or the reviewer (reason `gone`: ends once herdr sees it again)
  bench <worker> off [reason] | on   keep a coder out of the run until you turn it back on (survives restarts)
  free <worker>            a coder told to stop (`orch status`: stopping) has stopped: you checked its pane; it
                           takes work again (orch otherwise waits until herdr shows it idle)
  stop [--now]             stop the event manager cleanly (it finishes its current step); `orch resume` starts it again
  doctor --crash           (in a repo) why the event manager last stopped, and the last crash / lost notes
  set <Mn> <status> [reason] [--force]  manual override: pending/paused/failed/skipped (others need --force);
                           a coder still working on a paused/failed Mn gets the interrupt key (Esc) and a STOP note,
                           and stays busy ("stopping") until herdr shows it idle
  approve <Mn>             let a milestone held for risky changes land (works while autopilot runs)
  cleanup                  remove clean worker worktrees
  finish [--no-push] [--recheck]  final check (reused if it passed on these exact files), remove the <repo>-wt
                           coder folders, push, open a PR
  write-task <Mn>          generate TASKDIR/task.md from plan.md (+ reports of merged dependencies)
  nudge <Mn>               re-send the current prompt once to an agent that stopped early
  autopilot                the event manager: watches agents, checks, merges, wakes the lead; exits 0 ALL_DONE, 3 when it needs you
  handoff <Mn>             (worktree) save the milestone for review and free its coder for other work
  needs-fix <Mn>           queue the latest review's BLOCKERs as a fix job for the next free coder
  send-job <Mn>            send a queued fix/conflict job to the task's coder (after pick + prepare)
  review-ok <Mn>           record that the reviewer approved Mn
  requeue-review <Mn>      the reviewer vanished mid-review: queue the same round again
  resend <Mn>              re-send a recorded but unconfirmed prompt to the same agent (after a crash)

Exit codes: 2 error · 3 needs you / busy / cap · 4 merge conflict · 5 prompt not delivered (retried later) ·
            6 check fails on the feature branch (nothing committed) · 7 held for approval · 10 poll wait
While `orch autopilot` runs it holds the driver lease: other commands that change the run are refused
(status, ready, pick, report, approve, fix, resume and the lead's events / dispatch / answer still work).
"""

# Env vars a Herdr pane carries. Agents whose tools run in a separate background process (Hermes runs
# every session in one gateway) don't pass them on to their shell tool, so HERDR_ENV can be unset there
# even though the agent sits in a Herdr pane.
HERDR_PANE_ENV = ("HERDR_ENV", "HERDR_PANE_ID", "HERDR_SOCKET_PATH", "HERDR_BIN_PATH")


def sandbox_warnings():
    """Lines warning that this agent's own sandbox blocks what the lead needs: herdr's socket (Codex sets
    CODEX_SANDBOX_NETWORK_DISABLED=1 when its sandbox has no network) or writing the repo's .git. [] when fine."""
    out, codex = [], any(k.startswith("CODEX_") for k in os.environ)
    if os.environ.get("CODEX_SANDBOX_NETWORK_DISABLED") == "1":
        out.append("WARN this pane runs in Codex's sandbox with the network off, so orch's herdr calls from here "
                   "(team up, sending work, waking you) are refused or wait for an approval each time.")
    gd = git_common_dir(Path.cwd())
    if gd:
        try:
            fd, probe = tempfile.mkstemp(dir=gd, prefix=".orch-probe-")
            os.close(fd)
            os.unlink(probe)
        except OSError:
            out.append(f"WARN the repo's .git folder ({short(gd)}) can't be written from this pane, so `orch start` "
                       f"(the branch and the coders' folders) fails here.")
    if out and codex:
        v = (registry(required=False) or {}).get("codex") or {}
        out.append("  Fix: quit this Codex and start it again with orch's command (it opens just those two):\n    "
                   + launch_cmd("codex", v, None, strict=False, role="lead", cwd=Path.cwd()) + "\n  (`orch agents launch codex "
                   "--role lead --model <id>` adds a model; `orch models` lists them)")
    return out


def lead_check():
    """Preflight: is this agent driving Herdr? HERDR_ENV=1 is the fast path; otherwise ask the herdr server."""
    for line in sandbox_warnings():
        print(line)
    if os.environ.get("HERDR_ENV") == "1":
        print(f"OK inside a Herdr pane (HERDR_ENV=1, pane {os.environ.get('HERDR_PANE_ID') or '?'})")
        return
    try:
        r = subprocess.run([HERDR, "pane", "current"], text=True, capture_output=True, timeout=20)
        reachable, detail = r.returncode == 0, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        reachable, detail = False, str(e)
    hermes_fix = ("If the agent is Hermes, its tools run in the Hermes gateway, which does not see the pane's env. "
                  "Add this to ~/.hermes/config.yaml, then restart Hermes:\n"
                  "    terminal:\n      client_env_passthrough: [" + ", ".join(HERDR_PANE_ENV) + "]")
    if reachable:
        print("OK herdr is reachable, but this shell has no HERDR_ENV, so herdr cannot tell which pane is yours.\n"
              "  Carry on; `orch lead whoami` will show the focused pane — confirm it is yours.\n  " + hermes_fix)
        return
    die("Herdr not detected: HERDR_ENV is not 1 and `herdr pane current` failed"
        + (f" ({detail.splitlines()[-1]})" if detail else "") + ".\n"
        "  Start this agent from a Herdr pane, and make sure `herdr` is on PATH (or set HERDR=/path/to/herdr).\n  "
        + hermes_fix)


def herdr_current_pane():
    """(pane id, sure): the pane this shell runs in. sure=False when HERDR_PANE_ID is unset, so the id herdr gave is
    the FOCUSED pane, which may be another one. (None, False) outside herdr."""
    pid = os.environ.get("HERDR_PANE_ID")
    if pid:
        return pid, True
    ok, data, out = _herdr_json([HERDR, "pane", "current"])
    if not ok:
        return None, False
    pid = _find_key(data, "pane_id") if data is not None else None
    if not pid:
        pid = (re.search(r'"?pane_id"?\s*[:=]\s*"?([\w:.-]+)', out) or [None, None])[1]
    return pid, False


def name_lead(name, st=None):
    """Give this pane (the lead's own: HERDR_PANE_ID) the lead's name, so the event manager can wake it. The lead
    runs `orch lead plan`, `orch lead run`, `orch start` and `orch dispatch` from its own pane, so the pane they run
    in is the lead's; nothing depends on the lead obeying a playbook line. Never takes the name from another pane
    that runs an agent, and never renames a worker's or the reviewer's pane. Returns (ok, one line to print)."""
    pid = os.environ.get("HERDR_PANE_ID")
    if not pid:
        return False, ("HERDR_PANE_ID is not set in this shell, so orch can't tell which pane is yours and did not "
                       "name it")
    ok, data, _ = _herdr_json([HERDR, "agent", "get", name])
    if ok and data is not None and not _shell_only(data):
        where = _find_key(data, "pane_id")
        if where == pid:
            return True, f"LEAD    this pane ({pid}) is `{name}`: the event manager can wake it"
        if where:
            return False, (f"pane {where} already has the name `{name}` and runs an agent, so this pane ({pid}) was "
                           f"not named. If that pane is not the lead: herdr agent rename {where} old-{name} && "
                           f"herdr agent rename {pid} {name}")
    for n in list((st or {}).get("workers", {})) + ([st["reviewer"]] if (st or {}).get("reviewer") else []):
        if agent_pane(n) == pid:
            return False, f"this pane ({pid}) is {n}, not the lead, so it was not named `{name}`"
    ok, _, out = _herdr_json([HERDR, "agent", "rename", pid, name])
    if ok:
        return True, f"NAMED   this pane ({pid}) is now `{name}`, so the event manager can wake it"
    return False, f"`herdr agent rename {pid} {name}` failed: {out.splitlines()[-1] if out else 'no answer'}"


def lead_missing(st):
    """Why the event manager can't wake this run's lead (herdr has no agent with its name), or None when it can, or
    when there is nothing to check (no lead, `Lead mode: off`, a lead herdr can't watch or reached by pane id)."""
    if not lead_on(st):
        return None
    lead = st["lead"]
    if lead.get("pane") or not lead.get("detect", True):
        return None
    where, _ = herdr_presence(lead["name"])
    return {"agent": None, "shell": "only a plain shell is left in its pane",
            "gone": "herdr has no agent with this name"}[where]


def require_lead(st, doing):
    """`orch start` / `orch dispatch`: a run with a lead must be able to wake it. Name this pane when it is the lead's
    (see name_lead); otherwise refuse, with the exact rename command, before anything changes. The event manager's
    own `orch start` is not checked here (its pane is not the lead's); it warns in its log instead."""
    if os.environ.get("ORCH_DRIVER"):
        return
    why = lead_missing(st)
    if not why:
        return
    name = st["lead"]["name"]
    ok, line = name_lead(name, st)
    if ok and not lead_missing(st):
        print(line)
        return
    pid, sure = herdr_current_pane()
    die(f"NO LEAD: the lead `{name}` can't be woken ({why}), so nobody would hear when work finishes or a coder asks "
        f"something. {doing} was refused; nothing changed.\n"
        f"  {line}.\n"
        f"  If you are the lead, name your own pane, then run it again:  herdr agent rename {pid or '<your pane id>'} "
        f"{name}" + ("" if sure or not pid else "   (that is the FOCUSED pane: check it is yours)") + "\n"
        f"  `orch lead whoami` shows your pane. To run with no lead, put `Lead mode: off` in plan.md and `orch sync`.")


PB_MARK_RE = re.compile(r"^<!-- (/?)(full|start|quick)(?::\s*(.*?))?\s*-->$")


def plan_playbook_part(text, part):
    """The plan playbook in parts, so a quick run doesn't read the whole full process:
    "" = the start (role, preflight, research, quick-or-full, plus the `<!-- start -->` blocks of the full part);
    "quick" = the `<!-- quick: title -->` blocks (rules a quick plan uses, word for word from the full process);
    "full" = steps 3 to 10. start + full is every line of the playbook exactly once."""
    lines = text.splitlines(keepends=True)
    cut = next((i for i, l in enumerate(lines) if l.strip() == "<!-- full -->"), len(lines))
    head, rest = lines[:cut], lines[cut + 1:]
    blocks, out, cur, title = {"start": [], "quick": []}, [], None, ""
    for l in rest:
        m = PB_MARK_RE.match(l.strip())
        if m and m.group(2) in ("start", "quick"):
            if not m.group(1):
                cur, title, buf = m.group(2), m.group(3) or "", []
                if cur == "start":
                    out.append(f"({title}: printed at the start of this playbook by `orch lead plan`; apply it "
                               f"here.)\n")
            else:
                blocks[cur].append((title, buf))
                cur = None
            continue
        if cur:
            buf.append(l)
        if cur != "start":
            out.append(l)
    if part == "full":
        return "".join(out)
    if part == "quick":
        return "".join(f"## {t}\n{''.join(b)}\n" for t, b in blocks["quick"])
    return "".join(head) + "".join(f"\n## {t} (from the full process)\n{''.join(b)}" for t, b in blocks["start"])


# which rows of the run playbook's event table belong to each lead event kind
EVENT_ROWS = {"ready": "READY", "merged": "MERGED", "paused": "PAUSED", "failed": "FAILED", "held": "HELD",
              "worker-lost": "WORKER-LOST", "herdr-restart": "HERDR-RESTART", "needs-answer": "NEEDS-ANSWER",
              "escalated": "ESCALATED", "auto-dispatched": "AUTO-DISPATCHED", "stopped": "STOPPED",
              "all_done": "ALL_DONE", "finished": "FINISHED"}


def run_playbook_part(text, name):
    """A piece of the run playbook: `rules` (the hard rules), `ALL_DONE` (section 3, whole) or an event kind (its
    rows of the event table, word for word). Lets the lead act on a wake-up without reading the whole playbook."""
    key = name.strip().lower()
    secs = re.split(r"(?m)^(?=## )", text)
    if key in ("rules", "hard rules"):
        return next((x for x in secs if x.startswith("## Hard rules")), "")
    if key in ("all_done", "all-done", "3"):
        return next((x for x in secs if x.startswith("## 3. ALL_DONE")), "")
    kind = EVENT_ROWS.get(key, key.upper())
    rows = [l for l in text.splitlines() if re.match(rf"^\| `{re.escape(kind)}\b", l)
            or (kind == "STOPPED" and l.startswith("| `STOPPED`"))]
    if kind == "STOPPED":
        rows += [l for l in text.splitlines() if l.startswith(("| `orch status` starts with", "**Red baseline.**",
                                                               "**Why did the event manager stop?**"))]
    return "\n".join(rows) + ("\n" if rows else "")


def lead_name_here():
    """(state or None, the lead's name) for the repo this runs in: plan.md's `Lead:` first (it is what the developer
    wrote, even before `orch sync`), then the run's state.json, else `lead`. Never fails."""
    st, name = None, None
    with contextlib.suppress(Exception):
        r = git("rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
        if r.returncode == 0:
            o = Path(r.stdout.strip()).parent / ".orchestrate"
            if (o / "state.json").exists():
                st = json.loads((o / "state.json").read_text())
            if (o / "plan.md").exists():
                m = re.search(r"(?mi)^Lead:[ \t]*([\w.-]+)", (o / "plan.md").read_text())
                if m and m.group(1).lower() != "none":
                    name = m.group(1)
            if not name and st:
                name = (st.get("lead") or {}).get("name")
    return st, name or "lead"


def lead_self_name():
    """`orch lead plan` / `orch lead run` (not a wake-up's --section): name the pane they run in as the lead. The
    name is the plan's `Lead:` (plan.md, else state.json), else `lead`. Prints one line; never fails."""
    st, name = lead_name_here()
    if not os.environ.get("HERDR_PANE_ID"):
        pid, _ = herdr_current_pane()
        if pid:
            print(f"LEAD    name your pane `{name}` (HERDR_PANE_ID is unset, so orch can't tell which pane is yours): "
                  f"`orch lead whoami`, then herdr agent rename <your pane id> {name}\n")
        return
    ok, line = name_lead(name, st)
    print(line + ("" if ok else f"\n  Name your pane `{name}` before `orch start`: `orch lead whoami` shows it.") + "\n")


def cmd_lead(args):
    """orch lead plan|run -> print the lead playbook; orch lead whoami -> this pane + how to name it `lead`."""
    args = list(args)
    agent_flag(args, "usage: orch lead plan|run [--agent <kind>]")    # which agent leads, when orch can't tell
    sub = args[0] if args else ""
    if sub in ("plan", "run"):
        pb = asset(f"playbooks/{sub}.md") or die(f"playbooks/{sub}.md not found next to orch or in the install")
        part = args[1] if len(args) > 1 else ""
        if sub == "plan" and part not in ("", "quick", "full"):
            die("usage: orch lead plan [quick | full]")
        if sub == "run" and part not in ("", "--section"):
            die("usage: orch lead run [--section <EVENT | ALL_DONE | rules>]")
        if sub == "plan" and not part:
            auto_update_at_plan()       # a new feature starts on the newest release (never during a run)
        if sub == "run" and part == "--section":
            print(run_playbook_part(pb.read_text(), args[2] if len(args) > 2 else ""), end="")
            return
        if sub == "run" and asked_before_plan():
            print(ASKED_NOTE, end="")
            return
        label = f"{sub} ({part})" if part else sub
        subagent = current_mode()[0] == "subagent"
        if subagent and sub == "run":
            pi_agents_refresh()
            pb = asset("playbooks/subagent.md") or die("playbooks/subagent.md not found next to orch or in the install")
            label = "run (subagent mode)"
        print(f"herdr-orchestra {installed_version()} — lead playbook: {label}\n")
        if not subagent:
            for line in sandbox_warnings():
                print(line)
        if not part and not subagent:
            lead_self_name()
        guard_ensure(say_changes=False)     # no agent pushes to main: the repo refuses it from the start
        if subagent and sub == "plan":
            print(SUBAGENT_PLAN_NOTE, end="")
        print(plan_playbook_part(pb.read_text(), part) if sub == "plan" else pb.read_text(), end="")
        return
    if sub == "check":
        lead_check()
        return
    if sub == "whoami":
        try:
            r = subprocess.run([HERDR, "pane", "current"], text=True, capture_output=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired) as e:
            die(f"herdr pane current failed: {e}")
        if r.returncode != 0:
            die("not inside a herdr pane (`herdr pane current` failed) — start this agent from a Herdr pane: "
                + (r.stdout + r.stderr).strip())
        if not os.environ.get("HERDR_PANE_ID"):
            print("NOTE: HERDR_PANE_ID is not set in this shell, so herdr reported the FOCUSED pane. "
                  "Check it is the pane you are running in before renaming it.")
        out = r.stdout.strip()
        try:
            pane = json.loads(out)["result"]["pane"]
            pid, status = pane.get("pane_id"), pane.get("agent_status", "unknown")
            print(f"PANE {pid} agent_status={status}")
        except (ValueError, KeyError, TypeError):
            pid = (re.search(r'"?pane_id"?\s*[:=]\s*"?([\w:.-]+)', out) or [None, None])[1]
            print(out)
        named = False
        st, name = lead_name_here()
        if os.environ.get("HERDR_PANE_ID"):
            named, line = name_lead(name, st)
            print(line)
        if not named:
            print(f"This pane is YOU (the lead). Name it:  herdr agent rename {pid or '<pane id>'} {name}")
        print(f"Write `Lead: {name} (<your kind>)` in the plan header, and never prompt this pane.")
        return
    die("usage: orch lead plan | run | check | whoami")


def manifest_path():
    return Path.home() / ".local/share/herdr-orchestra" / "manifest.txt"


def short(p):
    """~/path for display."""
    p = str(p)
    home = str(Path.home())
    return "~" + p[len(home):] if p.startswith(home) else p


def manifest_lines():
    mf = manifest_path()
    return mf.read_text().splitlines() if mf.exists() else []


def manifest_write(lines):
    mf = manifest_path()
    mf.parent.mkdir(parents=True, exist_ok=True)
    seen, out = set(), []
    for line in lines:
        if line and line not in seen:
            seen.add(line)
            out.append(line)
    mf.write_text("".join(line + "\n" for line in out))


def manifest_record(*paths):
    """Append paths to the installer's manifest so `install.sh --uninstall` removes them."""
    manifest_write(manifest_lines() + [str(p) for p in paths])


def _copy_asset(src, dst):
    """Copy src -> dst, creating parents. True if dst was created or changed."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.exists() and dst.read_bytes() == src.read_bytes():
        return False
    shutil.copy2(src, dst)
    return True


SHARED_SKILLS = "~/.agents/skills"   # read by several tools; used when it doesn't make a second copy
SHARED_COMMANDS = ("~/.config/opencode/commands", "opencode-commands")   # written even before OpenCode is installed


def shipped_skills():
    src = asset("skills") or die("skills/ not found next to orch or in the install")
    return sorted(p.name for p in src.iterdir() if (p / "SKILL.md").exists() and p.name.startswith("orch-"))


def shipped_commands(flavor):
    src = asset(flavor)
    return sorted(f.name for f in src.glob("orch-*.md")) if src else []


def _dirs(v, key):
    return [expand(d) for d in v.get(key, []) or []]


def _same(d):
    """A folder's identity: two paths that are one folder (a symlinked skills folder) count once."""
    return os.path.realpath(d)


def agent_reads(v, what):
    """Every global folder the tool reads skills (or slash commands) from: `skills_reads` / `commands_reads`
    plus the folders the registry installs into. Order kept, no repeats (a symlink to a listed folder is the
    same folder)."""
    out, seen = [], set()
    for d in _dirs(v, f"{what}_reads") + _dirs(v, f"{what}_dirs"):
        if _same(d) not in seen:
            seen.add(_same(d))
            out.append(d)
    return out


def pick_dirs(agents, shared=None):
    """agents: [(kind, reads, candidates, one_wins)]. Pick the fewest folders to write so every agent reads exactly
    one copy (an agent with one_wins shows a skill once even when two folders have it, so two copies are fine).
    Returns (chosen folders, {kind: [folders it reads a copy from]}). Prefers the shared folder, then the folders
    each agent lists first. When no exact choice exists, the fewest agents with two copies."""
    import itertools
    pool = []
    for _, reads, cands, _ in agents:
        for d in cands:
            if _same(d) not in {_same(p) for p in pool}:
                pool.append(d)
    if shared is not None and _same(shared) not in {_same(p) for p in pool}:
        pool.append(shared)
    if not agents:
        return ([shared] if shared is not None else []), {}

    def rank(d):
        return min((c.index(d) for _, _, c, _ in agents if d in c), default=9)

    best = None
    for n in range(1, len(pool) + 1):
        for combo in itertools.combinations(pool, n):
            s = {_same(d) for d in combo}
            seen = [(len(s & {_same(d) for d in reads}), ow) for _, reads, _, ow in agents]
            cost = (sum(c == 0 for c, _ in seen), sum(c > 1 and not ow for c, ow in seen), n,
                    0 if shared is not None and _same(shared) in s else 1, sum(rank(d) for d in combo))
            if best is None or cost < best[0]:
                best = (cost, combo)
        if best and best[0][:2] == (0, 0):
            break                                   # bigger sets only cost more
    chosen = list(best[1])
    ids = {_same(d) for d in chosen}
    return chosen, {k: [d for d in reads if _same(d) in ids] for k, reads, _, _ in agents}


def _ours(p):
    """Is this skill folder / command file one of orch's thin wrappers (so safe to remove)?"""
    f = p / "SKILL.md" if p.is_dir() else p
    try:
        text = f.read_text(errors="replace") if f.is_file() else ""
    except OSError:
        return False
    # every version's skills and commands: thin wrappers say "orch lead", the first (4.0) skills "Orchestrator step",
    # orch-explain (6.9) carries its playbook, whose heading is "Simple & Visual Explanation Playbook"
    return "orch lead" in text or "Orchestrator step" in text or "Simple & Visual Explanation Playbook" in text


def _remove(p):
    if p.is_dir() and not p.is_symlink():
        shutil.rmtree(p)
    else:
        p.unlink()


def sync_plan(reg, installed):
    """What `orch agents sync` writes: {(kind of item, folder): flavor}, plus the per-agent view."""
    agents = [(k, agent_reads(v, "skills"), _dirs(v, "skills_dirs") or agent_reads(v, "skills"),
               bool(v.get("skills_one_wins")))
              for k, v in reg.items() if installed[k]]
    agents = [a for a in agents if a[1]]
    sdirs, sview = pick_dirs(agents, expand(SHARED_SKILLS))
    flavor, cagents = {}, []
    for k, v in reg.items():
        if not installed[k] or not agent_reads(v, "commands"):
            continue
        cands = _dirs(v, "commands_dirs") or agent_reads(v, "commands")
        for d in cands:
            flavor.setdefault(d, v.get("commands_from", "claude-commands"))
        cagents.append((k, agent_reads(v, "commands"), cands, False))
    shared = expand(SHARED_COMMANDS[0])
    flavor.setdefault(shared, SHARED_COMMANDS[1])
    cdirs, cview = pick_dirs(cagents, shared)
    return sdirs, sview, [(d, flavor[d]) for d in cdirs], cview


def agents_sync(reg, installed, want=None):
    """Copy the orch skills/commands so that every installed agent reads exactly one copy, and remove orch's
    copies from every other folder (old folders, renamed or dropped skills). Idempotent; keeps the uninstall
    manifest in step. Prints a status table."""
    if want is not None:
        for k in sorted(want):
            if not installed.get(k):
                print(f"skip {k:<9} not installed")
    was_ok = {k: all(st == "ok" for _, st in agent_assets(v)) for k, v in reg.items() if installed[k]}
    sdirs, sview, cdirs, cview = sync_plan(reg, installed)
    skills = shipped_skills()
    keep, changed_dirs = set(), set()
    for d in sdirs:
        src = asset("skills")
        for s in skills:
            if _copy_asset(src / s / "SKILL.md", d / s / "SKILL.md"):
                changed_dirs.add(d)
            keep.add(d / s)
    for d, fl in cdirs:
        src = asset(fl)
        for name in shipped_commands(fl):
            if _copy_asset(src / name, d / name):
                changed_dirs.add(d)
            keep.add(d / name)

    # Remove the copies that make a tool list a skill twice: orch's copies in any folder an installed agent
    # reads (or used to read: old_dirs) that is not a chosen one, and skills orch no longer ships (renamed or
    # dropped) wherever an earlier install put them. A copy in a folder no installed agent reads is left: it
    # shows up nowhere, and it may belong to an agent that is only missing from PATH right now.
    removed = []
    lines = manifest_lines()
    keep_ids = {_same(p) for p in keep}
    read_ids = {_same(d) for k, v in reg.items() if installed[k]
                for d in agent_reads(v, "skills") + agent_reads(v, "commands") + _dirs(v, "old_dirs")}
    current = set(skills) | {n for fl in ("claude-commands", "opencode-commands") for n in shipped_commands(fl)}
    candidates = [Path(p) for p in lines if Path(p).name.startswith("orch-")]
    for k, v in reg.items():
        if installed[k]:
            for d in agent_reads(v, "skills") + agent_reads(v, "commands") + _dirs(v, "old_dirs"):
                if d.is_dir():
                    candidates += [p for p in sorted(d.iterdir()) if p.name.startswith("orch-")]
    for p in candidates:
        if not (p.exists() or p.is_symlink()) or _same(p) in keep_ids or p in removed:
            continue
        if not (str(p) in lines or _ours(p)):
            continue                                # the developer's own orch-... skill
        if p.name in current and _same(p.parent) not in read_ids:
            continue
        _remove(p)
        removed.append(p)
    manifest_write([p for p in lines if Path(p) not in removed] + [str(p) for p in sorted(keep)])

    new = same = 0
    for k, v in reg.items():
        if not installed[k] or (want is not None and k not in want):
            continue
        mine = sview.get(k, []) + [d for d in cview.get(k, [])]
        changed = not was_ok[k] or any(d in changed_dirs for d in mine)
        new += changed
        same += not changed
        parts = []
        if k in sview:
            parts.append("skills: " + (", ".join(short(d) for d in sview[k]) or "NONE"))
        if k in cview:
            parts.append("commands: " + (", ".join(short(d) for d in cview[k]) or "NONE"))
        dup = len(cview.get(k, [])) > 1 or (len(sview.get(k, [])) > 1 and not v.get("skills_one_wins"))
        status = "DUP " if dup else ("NEW " if changed else "ok  ")
        print(f"  {status} {k:<8} {'  '.join(parts)}  {v.get('invoke', 'Run `orch lead plan` and follow it. Feature: <feature>')}")
    for d, what, view in ((expand(SHARED_SKILLS), "skills", sview), (expand(SHARED_COMMANDS[0]), "commands", cview)):
        if d in (sdirs if what == "skills" else [c for c, _ in cdirs]) and not any(d in x for x in view.values()):
            print(f"  {'NEW ' if d in changed_dirs else 'ok  '} {'shared':<8} {what}: {short(d)}")
    for p in removed:
        print(f"  removed  old copy {short(p)}")
    print(f"synced {new + same} agent(s): {new} new, {same} unchanged, {len(removed)} old cop"
          f"{'y' if len(removed) == 1 else 'ies'} removed — every agent sees each skill once. "
          f"Restart running agents so they pick up the skills")


def agent_assets(v):
    """[(text, state)] per skill / slash command an installed agent should see once: state is ok, missing or
    duplicate (the same skill in two folders the tool reads, so it is listed twice)."""
    out = []
    reads = agent_reads(v, "skills")
    for s in shipped_skills() if reads else []:
        copies = [d for d in reads if (d / s / "SKILL.md").exists()]
        out.append(_asset_state(f"skill    {s}", copies[:1] if v.get("skills_one_wins") else copies, reads))
    reads = agent_reads(v, "commands")
    for name in shipped_commands(v.get("commands_from", "claude-commands")) if reads else []:
        copies = [d for d in reads if (d / name).exists()]
        out.append(_asset_state(f"command  {name}", copies, reads))
    return out


def _asset_state(label, copies, reads):
    if not copies:
        return f"{label}  not in {', '.join(short(d) for d in reads)}", "missing"
    if len(copies) > 1:
        return f"{label}  twice: {' and '.join(short(d) for d in copies)}", "duplicate"
    return f"{label}  {short(copies[0])}", "ok"


def cmd_agents(args):
    """orch agents [launch <kind> | check | sync | dirs] -> the agent registry."""
    reg = registry()
    sub = args[0] if args else ""
    installed = {k: bool(shutil.which(v.get("binary", k))) for k, v in reg.items()}
    if sub == "launch":
        rest = args[1:]
        model, role = None, None
        use = "usage: orch agents launch <kind> [--model <id>] [--role coder|reviewer|lead]"
        if "--model" in rest:
            i = rest.index("--model")
            model = rest[i + 1] if len(rest) > i + 1 else die(use)
            del rest[i:i + 2]
        if "--role" in rest:
            i = rest.index("--role")
            role = rest[i + 1] if len(rest) > i + 1 else die(use)
            if role not in ("coder", "reviewer", "lead"):
                die(f"--role must be coder, reviewer or lead, got {role!r} — {use}")
            del rest[i:i + 2]
        kind = rest[0] if rest else die(use)
        v = reg.get(kind) or die(f"unknown agent kind {kind!r} — known: {', '.join(reg)} "
                                 f"(add it in {user_agents_file()})")
        print(launch_cmd(kind, v, model, role=role))
        return
    if sub == "dirs":           # the folders `orch agents sync` writes: <skills|commands>\t<dir>[\t<commands_from>]
        sdirs, _, cdirs, _ = sync_plan(reg, installed)
        for d in sdirs:
            print(f"skills\t{d}")
        for d, fl in cdirs:
            print(f"commands\t{d}\t{fl}")
        return
    if sub == "check":
        bad = {"missing": 0, "duplicate": 0}
        for k, v in reg.items():
            if not installed[k]:
                continue
            for text, state in agent_assets(v):
                if state != "ok":
                    bad[state] += 1
                print(f"{ {'ok': 'ok       ', 'missing': 'MISSING  ', 'duplicate': 'DUPLICATE'}[state]} {k:<9} {text}")
        if bad["missing"] or bad["duplicate"]:
            print(", ".join(f"{n} {w}" for w, n in bad.items() if n) + " — run: orch agents sync"
                  + (" (a duplicate means the tool lists that skill twice)" if bad["duplicate"] else ""))
            sys.exit(1)
        return
    if sub == "sync":
        want = {k.lower() for k in args[1:]} if len(args) > 1 else None
        if want:
            unknown = sorted(want - set(reg))
            if unknown:
                die(f"unknown agent kind {', '.join(unknown)} — known: {', '.join(reg)} "
                    f"(add it in {user_agents_file()})")
        agents_sync(reg, installed, want)
        return
    if sub:
        die("usage: orch agents [launch <kind> | check | sync | dirs]")
    print(f"{'kind':<9} {'installed':<9} {'detect':<6} {'verified':<8} {'roles':<22} launch")
    for k, v in reg.items():
        print(f"{k:<9} {'yes' if installed[k] else 'no':<9} {'yes' if v.get('herdr_detect', True) else 'no':<6} "
              f"{'yes' if v.get('verified') else 'no':<8} {','.join(v.get('roles', [])):<22} "
              f"{v.get('launch', v.get('binary', k))}")
    missing = [k for k, v in reg.items()
               if installed[k] and any(st != "ok" for _, st in agent_assets(v))]
    if missing:
        print(f"\n{', '.join(missing)}: orch skills (orch-plan/orch-run/orch-explain) missing or listed twice — run: orch agents sync")
    print(f"\nOverride or add kinds in {user_agents_file()}")


def _probe(cmd, timeout=15):
    try:
        r = subprocess.run(cmd if isinstance(cmd, list) else shlex.split(cmd), text=True, capture_output=True,
                           timeout=timeout, stdin=subprocess.DEVNULL)
        return r.returncode, r.stdout + r.stderr
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        return None, str(e)


def doctor_kind(kind, v, full=True):
    """[(ok, message)] for one installed agent kind, or None if its binary isn't on PATH. Read-only."""
    binary = v.get("binary", kind)
    if not shutil.which(binary):
        return None
    out = []
    if full:
        vcmd = v.get("version_cmd") or f"{binary} --version"
        code, text = _probe(vcmd)
        first = next((l.strip() for l in text.splitlines() if l.strip()), "")
        out.append((True, f"version: {first}" if code == 0 and first else f"version: unknown (`{vcmd}` failed)"))
    hcmd = v.get("help_cmd") or f"{binary} --help"
    code, help_ = _probe(hcmd)
    flags = []
    for key in ("launch", "review_launch", "lead_flags"):
        try:
            launch = shlex.split(v.get(key) or binary) if key != "lead_flags" else [binary] + shlex.split(v.get(key) or "")
        except ValueError:
            launch = [binary]
        for f in (tok.split("=")[0] for tok in launch[1:] if tok.startswith("-")):
            if f not in flags:              # one line per flag, even when a command repeats it (codex -c ... -c ...)
                flags.append(f)
    for key in ("launch", "review_launch"):
        for part in v.get("launch_needs") or [] if v.get(key) else []:
            if part not in v[key]:
                out.append((False, f"{key} has no `{part}`: without it orch's commands fail inside {kind} (its sandbox "
                                   f"blocks them) — keep it in your own launch in {short(user_agents_file())}"))
    for fl in flags:
        if code is None:
            out.append((False, f"launch flag {fl}: `{hcmd}` did not run ({help_.strip()[:80]})"))
        elif re.search(rf"(?<![\w-]){re.escape(fl)}(?![\w-])", help_):
            out.append((True, f"launch flag {fl} is listed in `{hcmd}`"))
        else:
            out.append((False, f"launch flag {fl} is NOT in `{hcmd}` — the launch command in the registry may be out "
                               f"of date (override it in {short(user_agents_file())})"))
    if full:
        for text, st in agent_assets(v):
            out.append((st == "ok", " ".join(text.split()) + ("" if st == "ok" else
                                                               f" ({st}) — run `orch agents sync`")))
        if v.get("herdr_detect", True):
            code, txt = _probe([HERDR, "agent"])
            if code == 0:
                ok = bool(re.search(rf"(?<![\w-]){re.escape(kind)}(?![\w-])", txt))
                out.append((ok, "herdr knows this kind" if ok else
                            "herdr does not list this kind (`herdr agent`): set herdr_detect = false for it"))
            else:
                out.append((True, "herdr not reachable here: detection not checked"))
    return out


def cmd_doctor_crash(args):
    """orch doctor --crash -> the last crash, stop and lost notes of this run, and, when the event manager is not
    running, why it stopped (looked up in the computer's own log, for this run's processes only)."""
    with state_lock():
        st = load()
        dead = None if driver_alive() else note_dead_manager(st)
    m = (st.get("run") or {}).get("manager") or {}
    print(f"{run_tag(st)} event manager: " + (f"running ({driver_line(driver_info())})" if driver_alive() else
          "not running" + (f"; last one ended {_clock(m['ended']['ts'])}: {m['ended'].get('how')}"
                           + (f" — {m['ended']['reason']}" if m['ended'].get('reason') else "")
                           if m.get("ended") else "")))
    if dead:
        print(dead)
    lines = last_crash_lines()
    print("Last notes in .orchestrate/autopilot.log:" if lines else "No crash, stop or lost notes in autopilot.log yet.")
    for l in lines:
        print("  " + l)
    shots = sorted((ORCH / "crash").glob("*.txt"), key=lambda p: p.stat().st_mtime)[-5:] if (ORCH / "crash").is_dir() else []
    if shots:
        print("Saved agent screens (.orchestrate/crash/):")
        for p in shots:
            print(f"  {p.name}")


def cmd_doctor(args):
    """orch doctor [kind...] -> check each installed agent against the real tool (version, launch flags, skills,
    herdr detection). Read-only. Exit 1 if anything is broken."""
    reg = registry()
    kinds = [k.lower() for k in args] or list(reg)
    broken = 0
    for k in kinds:
        if k not in reg:
            print(f"BROKEN  {k}: not in the agent registry (add it in {short(user_agents_file())})")
            broken += 1
            continue
        res = doctor_kind(k, reg[k])
        if res is None:
            print(f"skip    {k}: `{reg[k].get('binary', k)}` is not installed")
            continue
        bad = [m for ok, m in res if not ok]
        broken += bool(bad)
        if str(reg[k].get("compact") or "").strip():      # information only: no compacting is never "broken"
            cmd, why = compact_command({}, k)
            res.append((True, f"compact: {cmd} between milestones (coders and the reviewer)" if cmd else
                        f"compact: not sent — {why}"))
        print(f"{'BROKEN' if bad else 'ok':<7} {k}" + ("" if reg[k].get("verified") else "  (registry entry unverified)"))
        for ok, m in res:
            print(f"    {'ok ' if ok else 'BAD'} {m}")
    if guard_root():
        rep = guard_report()
        bad = [m for ok, m in rep if not ok]
        broken += bool(bad) and not args    # `orch doctor <kind>` checks agents only; plain `orch doctor` checks all
        print(f"{'BROKEN' if bad else 'ok':<7} main guard (no agent pushes to main)")
        for ok, m in rep:
            print(f"    {'ok ' if ok else 'BAD'} {m}")
    if not args:
        print(doctor_views_line())
    sys.exit(1 if broken else 0)


def doctor_views_line():
    """Which run views this herdr supports: sidebar names 0.6.3, sidebar rows and the plugin popup 0.7.4."""
    try:
        r = subprocess.run([HERDR, "--version"], text=True, capture_output=True, timeout=HERDR_TIMEOUT_S)
        m = re.search(r"(\d+)\.(\d+)\.(\d+)", r.stdout + r.stderr)
    except (OSError, subprocess.TimeoutExpired):
        m = None
    v = tuple(int(x) for x in m.groups()) if m else None
    if v is None:
        return ("views   herdr not found: `orch view` (browser) and `orch board` work; agent names in herdr's "
                "sidebar need herdr 0.6.3+")
    hv = ".".join(map(str, v))
    if v >= (0, 7, 4):
        return (f"views   ok  herdr {hv}: sidebar names, sidebar rows (`orch view herdr-config`), board popup plugin "
                f"(`orch view plugin link`); `orch view` and `orch board` always work")
    if v >= (0, 6, 3):
        return (f"views   ok  herdr {hv}: sidebar names; the extra sidebar rows and the board popup need herdr 0.7.4+ "
                f"(`orch view` and `orch board` work)")
    return f"views   herdr {hv} is too old for sidebar names (0.6.3+); `orch view` and `orch board` work"


def installed_version():
    for p in (Path(__file__).resolve().parent.parent / "VERSION",
              Path.home() / ".local/share/herdr-orchestra/current/VERSION"):
        if p.exists():
            return p.read_text().strip()
    return "unknown"


# ---------------------------------------------------------------- updates: notice, `orch update`, auto-update
UPDATE_REPO = os.environ.get("ORCH_REPO") or "arunnarangali/herdr-orchestra"
UPDATE_CHECK_S = 24 * 3600      # ask for the latest release at most once a day
UPDATE_NET_S = 3                # ...and never wait longer than this for the answer


def share_dir():
    return Path(os.environ.get("ORCH_SHARE") or Path.home() / ".local/share/herdr-orchestra")


def settings_load():
    try:
        data = json.loads((share_dir() / "settings.json").read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def settings_save(data):
    with contextlib.suppress(OSError):
        share_dir().mkdir(parents=True, exist_ok=True)
        tmp = share_dir() / "settings.json.tmp"
        tmp.write_text(json.dumps(data, indent=1))
        os.replace(tmp, share_dir() / "settings.json")


def auto_update_on():
    env = os.environ.get("ORCH_AUTO_UPDATE", "").lower()
    if env in ("0", "off", "false", "no"):
        return False
    if env in ("1", "on", "true", "yes"):
        return True
    return settings_load().get("auto_update") is True


def ver_tuple(v):
    m = re.match(r"v?(\d+)\.(\d+)\.(\d+)$", (v or "").strip())
    return tuple(int(x) for x in m.groups()) if m else None


def release_install():
    """True when this orch is an installed release (~/.local/share/herdr-orchestra/vX.Y.Z), not a git checkout or
    a -dev install: only a release looks for, and moves to, a newer release."""
    here = Path(__file__).resolve().parent.parent
    return here.parent == share_dir().resolve() and here.name == f"v{installed_version()}"


def update_source():
    """Tests: ORCH_UPDATE_SOURCE is a folder with `latest` (a tag) and one release tree per tag (<tag>/install.sh)."""
    src = os.environ.get("ORCH_UPDATE_SOURCE")
    return Path(src) if src else None


def fetch_latest(thorough=False):
    """The newest released version as 'X.Y.Z', or None when it can't be reached within UPDATE_NET_S. The daily
    check asks GitHub's API once; `orch update` (thorough) also tries the tag list when the API says no."""
    src = update_source()
    if src:
        try:
            tag = (src / "latest").read_text().strip()
        except OSError:
            return None
        return tag.lstrip("v") if ver_tuple(tag) else None
    import urllib.request
    try:
        req = urllib.request.Request(f"https://api.github.com/repos/{UPDATE_REPO}/releases/latest",
                                     headers={"Accept": "application/vnd.github+json", "User-Agent": "herdr-orchestra"})
        with urllib.request.urlopen(req, timeout=UPDATE_NET_S) as r:
            tag = json.loads(r.read().decode()).get("tag_name", "")
        if ver_tuple(tag):
            return tag.lstrip("v")
    except Exception:
        pass
    if not thorough:
        return None
    try:
        r = subprocess.run(["git", "ls-remote", "--tags", "--refs", f"https://github.com/{UPDATE_REPO}.git"],
                           text=True, capture_output=True, timeout=20,
                           env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
        tags = [t for t in (x.rsplit("/", 1)[-1] for x in r.stdout.split()) if ver_tuple(t)]
        return max(tags, key=ver_tuple).lstrip("v") if r.returncode == 0 and tags else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def latest_known(force=False):
    """The newest release orch knows of. Asks the network at most once a day (always with force); with no answer
    it stays quiet and asks again a day later. ORCH_NO_UPDATE_CHECK=1: never asks."""
    if os.environ.get("ORCH_NO_UPDATE_CHECK") == "1":
        return None
    s = settings_load()
    if not force and now() - int(s.get("last_check") or 0) < UPDATE_CHECK_S:
        return s.get("latest_seen")
    latest = fetch_latest(thorough=force)
    s = settings_load()
    s["last_check"] = now()
    if latest:
        s["latest_seen"] = latest
    settings_save(s)
    return latest or (None if force else s.get("latest_seen"))


def newer(latest):
    a, b = ver_tuple(latest), ver_tuple(installed_version())
    return bool(a and b and a > b)


def update_notice(network=True):
    """One line when a newer release is out (installed releases only). Never raises, never waits long."""
    try:
        if not release_install() or os.environ.get("ORCH_NO_UPDATE_CHECK") == "1":
            return
        latest = latest_known() if network else settings_load().get("latest_seen")
        if newer(latest):
            print(f"herdr-orchestra {latest} is out (you have {installed_version()}). Run `orch update`.")
    except Exception:
        pass


def active_runs():
    """Repos whose event manager is running on this machine right now (each manager signs in under active/)."""
    live = []
    d = share_dir() / "active"
    for f in (sorted(d.glob("*.json")) if d.is_dir() else []):
        try:
            root = json.loads(f.read_text()).get("root") or ""
            lock = Path(root) / ".orchestrate" / "driver.lock"
            held = False
            if root and lock.exists():
                with open(lock, "a") as fh:
                    try:
                        fcntl.flock(fh, fcntl.LOCK_SH | fcntl.LOCK_NB)
                        fcntl.flock(fh, fcntl.LOCK_UN)
                    except OSError:
                        held = True
            if held:
                live.append(root)
            else:
                f.unlink(missing_ok=True)          # that manager is gone
        except (OSError, ValueError):
            continue
    return live


def sign_in_manager():
    """The event manager tells the machine it is running, so no auto-update happens under a run."""
    with contextlib.suppress(OSError):
        d = share_dir() / "active"
        d.mkdir(parents=True, exist_ok=True)
        f = d / f"{os.getpid()}.json"
        f.write_text(json.dumps({"pid": os.getpid(), "root": str(ROOT), "started": now()}))
        import atexit
        atexit.register(lambda: f.unlink(missing_ok=True))


def changelog_lines(version, limit=8):
    """The headline of each changelog entry for a version, from the installed CHANGELOG.md."""
    p = share_dir() / "current" / "CHANGELOG.md"
    if not p.exists():
        return []
    out, on, tests = [], False, False
    for line in p.read_text(errors="replace").splitlines():
        if line.startswith("## "):
            if on:
                break
            on = line.startswith(f"## [{version}]")
            continue
        if line.startswith("### "):
            tests = line.strip().lower() == "### tests"
            continue
        if on and not tests and line.startswith("- "):
            m = re.match(r"- \*\*(.+?)\*\*", line)
            out.append((m.group(1) if m else line[2:]).rstrip(".")[:110])
    return out[:limit] + ([f"... ({len(out) - limit} more: CHANGELOG.md)"] if len(out) > limit else [])


def update_log(msg):
    with contextlib.suppress(OSError):
        with open(share_dir() / "update.log", "a") as f:
            f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")


def install_version(version, quiet=False):
    """Install release `version` ('X.Y.Z') with that release's own install.sh. Returns (ok, message). The installer
    switches the `current` link only at its end, so a failed install leaves the old version active."""
    tag = f"v{version}"
    before = installed_version()
    env = {k: v for k, v in os.environ.items() if k not in ("ORCH_VERSION", "ORCH_AUTO_UPDATE")}
    env["ORCH_TTY"] = "/dev/null"             # an update never stops to ask a question
    s = settings_load()
    if "auto_update" not in s:                # ...so the installer's question is answered here, as it stands now
        s["auto_update"] = auto_update_on()
        settings_save(s)
    tmp = None
    try:
        src = update_source()
        if src:
            script = src / tag / "install.sh"
            if not script.exists():
                return False, f"version {tag} not found"
            cmd, env = ["bash", str(script), "--no-herdr-skill"], {**env, "ORCH_PACKAGE": "1"}
        else:
            if not shutil.which("curl"):
                return False, "curl is needed to download a release — or run: npx herdr-orchestra@latest"
            import urllib.request
            tmp = Path(tempfile.mkdtemp(prefix="orch-update-"))
            script = tmp / "install.sh"
            try:
                with urllib.request.urlopen(f"https://github.com/{UPDATE_REPO}/releases/download/{tag}/install.sh",
                                            timeout=30) as r:
                    script.write_bytes(r.read())
            except Exception as e:
                return False, f"could not download {tag} ({e})"
            cmd = ["bash", str(script), "--version", tag, "--no-herdr-skill"]
        try:
            r = subprocess.run(cmd, text=True, capture_output=True, timeout=600, env=env, cwd=str(Path.home()),
                               stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as e:
            return False, f"the installer did not finish ({e})"
        if r.returncode != 0:
            tail = " | ".join((r.stdout + r.stderr).strip().splitlines()[-3:])
            return False, f"the installer failed (exit {r.returncode}): {tail}"
        cur = share_dir() / "current" / "VERSION"
        got = cur.read_text().strip() if cur.exists() else "?"
        if got != version:
            return False, f"the installer ran but {got} is active, not {version}"
        if not quiet:
            print((r.stdout + r.stderr).strip())
        return True, f"herdr-orchestra {before} -> {version}"
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)


def cmd_update(args):
    """orch update [--check] [--version vX.Y.Z] -> install the latest release (or that one) and say what is new."""
    want = None
    if "--version" in args:
        i = args.index("--version")
        want = args[i + 1] if len(args) > i + 1 else die("--version needs a value, e.g. --version v5.8.0")
        if not ver_tuple(want):
            die(f"{want!r} is not a version — use the form v5.8.0")
        want = want.lstrip("v")
    cur = installed_version()
    if not want:
        latest = latest_known(force=True)
        if not latest:
            die("could not reach GitHub to look for a new version" + (" (ORCH_NO_UPDATE_CHECK=1 is set)"
                if os.environ.get("ORCH_NO_UPDATE_CHECK") == "1" else "") + " — try again later, or run: "
                "npx herdr-orchestra@latest")
        if "--check" in args:
            print(f"herdr-orchestra {latest} is out (you have {cur}). Run `orch update`." if newer(latest)
                  else f"herdr-orchestra {cur} is the latest version.")
            return
        if not newer(latest):
            print(f"herdr-orchestra {cur} is the latest version. Nothing to do.")
            return
        want = latest
    elif "--check" in args:
        die("--check looks for the latest version: leave out --version")
    live = active_runs()
    if live:
        print(f"NOTE a run is going ({', '.join(live)}). It keeps working, but its next steps use the new version.")
    ok, msg = install_version(want)
    if not ok:
        update_log(f"orch update {cur} -> {want} FAILED: {msg}")
        die(f"update failed, herdr-orchestra {cur} is still active: {msg}")
    update_log(f"orch update: {msg}")
    print(f"UPDATED {msg}")
    lines = changelog_lines(want)
    if lines:
        print(f"New in {want}:")
        for x in lines:
            print(f"  - {x}")
    if ver_tuple(cur):
        print(f"Go back any time: orch update --version v{cur}")


# ---------------------------------------------------------------- run modes: panes (herdr) or subagent (one Pi window)
# `panes` is today's workflow and the default: coders and the reviewer are agents in herdr panes, the event manager
# drives them. `subagent` is for Pi (https://pi.dev) with the @tintinweb/pi-subagents extension: the lead stays in one
# window and starts the coder and the reviewer as Pi subagents, one milestone at a time. Nothing about panes mode
# changes when nobody picks subagent.
ORCH_MODES = ("panes", "subagent")
PI_SUBAGENTS = "npm:@tintinweb/pi-subagents"
PI_AGENT_MARK = "<!-- written by `orch setup` (herdr-orchestra). orch rewrites this file; delete this line to keep your own edits. -->"


def user_config_file():
    return Path(os.environ.get("ORCH_CONFIG_FILE") or Path.home() / ".config/herdr-orchestra/config.json")


def config_load():
    try:
        data = json.loads(user_config_file().read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def config_save(data):
    p = user_config_file()
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, p)


# The mode is saved per agent (`modes` in the config, e.g. {"modes": {"pi": "subagent"}}): an agent not listed
# runs in panes mode. Subagent mode exists only for Pi today (it needs @tintinweb/pi-subagents), so orch never gives
# another agent (Claude Code, Codex, Antigravity, ...) subagent instructions, whatever the config says.
# Before 6.23.0 the config had one machine-wide `"mode"`; a saved `"mode": "subagent"` is read as Pi's, and the next
# save moves it to `modes.pi`.
SUBAGENT_AGENTS = ("pi",)
AGENT_RE_KIND = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
AGENT_OVERRIDE = None       # set by `--agent <kind>`


def config_modes(conf=None):
    """{agent: mode} from the config, with the old machine-wide `mode: subagent` read as Pi's."""
    conf = config_load() if conf is None else conf
    raw = conf.get("modes") if isinstance(conf.get("modes"), dict) else {}
    out = {str(k).lower(): str(v).lower() for k, v in raw.items() if str(v).lower() in ORCH_MODES}
    if str(conf.get("mode") or "").lower() == "subagent":
        out.setdefault("pi", "subagent")
    return out


def config_mode(agent="pi"):
    """The mode saved for this agent; panes when none is saved, or when the agent has no subagent mode."""
    m = config_modes().get(agent or "", "panes")
    return m if m == "panes" or agent in SUBAGENT_AGENTS else "panes"


def calling_agent():
    """Which agent runs this orch command (its kind, as in agents.toml), or None when orch can't tell.
    `--agent` or ORCH_AGENT win; then AI_AGENT, which the innermost agent sets (Pi: "pi", Claude Code:
    "claude-code_..."); then the marks agents leave in their shell (PI_CODING_AGENT, CLAUDECODE, CODEX_*, OPENCODE)."""
    e = os.environ
    v = (AGENT_OVERRIDE or e.get("ORCH_AGENT") or "").strip().lower()
    if v:
        return v
    names = {"pi": "pi", "claude": "claude", "codex": "codex", "opencode": "opencode", "amp": "amp",
             "hermes": "hermes", "agy": "agy", "antigravity": "agy", "gemini": "agy"}
    first = (re.split(r"[^a-z0-9]+", (e.get("AI_AGENT") or "").strip().lower()) or [""])[0]
    if first:
        return names.get(first, first if AGENT_RE_KIND.match(first) else None)
    if e.get("PI_CODING_AGENT") == "true":
        return "pi"
    if e.get("CLAUDECODE") == "1":
        return "claude"
    if any(k.startswith("CODEX_") for k in e):
        return "codex"
    if e.get("OPENCODE"):
        return "opencode"
    return None


def agent_flag(args, usage):
    """Take `--agent <kind>` (or `--agent=<kind>`) out of args and use it as the calling agent; returns it or None."""
    global AGENT_OVERRIDE
    for i, a in enumerate(list(args)):
        if a == "--agent" or a.startswith("--agent="):
            val = (a.split("=", 1)[1] if "=" in a else (args[i + 1] if len(args) > i + 1 else "")).strip().lower()
            del args[i:i + (1 if "=" in a else 2)]
            if not AGENT_RE_KIND.match(val):
                die(f"--agent needs an agent kind such as pi, claude, codex or agy, got {val!r} — {usage}")
            AGENT_OVERRIDE = val
            return val
    return None


def mode_env():
    """ORCH_MODE=panes|subagent: a one-command override (e.g. `ORCH_MODE=panes orch lead plan`); None when unset."""
    v = (os.environ.get("ORCH_MODE") or "").strip().lower()
    if not v:
        return None
    if v not in ORCH_MODES:
        die(f"ORCH_MODE must be panes or subagent, got {v!r}")
    return v


def no_subagent_for(agent):
    return (f"subagent mode is only for Pi today (it uses Pi's pi-subagents); "
            f"{'this agent (' + agent + ')' if agent else 'orch cannot tell which agent this is, so it'} "
            f"uses panes mode. In Pi orch finds it by itself; elsewhere add `--agent pi` or set ORCH_AGENT=pi")


def run_mode(st):
    """A run keeps the mode it was planned in. Runs from before 6.2.0 have no `orch_mode`: they are panes runs."""
    m = (st or {}).get("orch_mode") or "panes"
    return m if m in ORCH_MODES else "panes"


ASKED_NOTE = """PLANNING, NOT A RUN. The lead asked the developer questions before writing the plan
(.orchestrate/questions.md), and no plan was written after them. If the developer just answered them, this is not
a go: carry on with planning from step 2b of the plan playbook (`orch lead plan` prints it again), with their
answers written into the plan where they apply. Show the plan and wait for **go**. Nothing starts before that.
"""


def asked_before_plan():
    """True when .orchestrate/questions.md (the lead's questions before planning) is newer than plan.md: the
    developer's answer is part of planning, so `orch lead run` must not start a run from an old plan."""
    r = git("rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
    if r.returncode != 0:
        return False
    d = Path(r.stdout.strip()).parent / ".orchestrate"
    q, p = d / "questions.md", d / "plan.md"
    try:
        return q.exists() and (not p.exists() or q.stat().st_mtime > p.stat().st_mtime)
    except OSError:
        return False


def _repo_state_path():
    """.orchestrate/state.json of the repo this shell is in, or None (outside a repo, or no run yet)."""
    r = git("rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
    if r.returncode != 0:
        return None
    p = Path(r.stdout.strip()).parent / ".orchestrate" / "state.json"
    return p if p.exists() else None


def current_mode(agent=...):
    """(mode, where it comes from) for the agent running orch: a one-command ORCH_MODE, else this repo's run, else
    the mode saved for this agent, else panes. Only Pi has a subagent mode, so any other agent gets panes even when
    this repo's last run or the config says subagent (that is Pi's)."""
    agent = calling_agent() if agent is ... else agent
    env = mode_env()
    if env == "subagent" and agent not in SUBAGENT_AGENTS:
        die("ORCH_MODE=subagent: " + no_subagent_for(agent))
    if env:
        return env, "ORCH_MODE"
    run = None
    with contextlib.suppress(Exception):
        p = _repo_state_path()
        if p:
            run = run_mode(json.loads(p.read_text()))
    if agent not in SUBAGENT_AGENTS:
        if run == "panes":
            return "panes", "this repo's run"
        if run == "subagent" or "subagent" in config_modes().values():
            return "panes", f"{agent or 'this agent'}: subagent mode is only for Pi"
        return "panes", "default"
    if run:
        return run, "this repo's run"
    if agent in config_modes():
        return config_mode(agent), f"{agent}, in {short(user_config_file())}"
    return "panes", "default"


def plan_orch_mode(old, branch, lead_kind):
    """The mode a run synced from the plan gets: subagent only when its lead is Pi and Pi's saved mode (or the run
    this plan already had, on the same branch) is subagent; every other lead runs in panes."""
    kind = (lead_kind or calling_agent() or "").lower()
    env = mode_env()
    if kind not in SUBAGENT_AGENTS:
        return "panes"
    if env:
        return env
    if old.get("branch") == branch and old.get("orch_mode") in ORCH_MODES:
        return old["orch_mode"]
    return config_mode(kind)


def mode_flag(args, usage):
    """Take `--mode <panes|subagent>` (or `--mode=...`) out of args; returns the mode or None."""
    for i, a in enumerate(list(args)):
        if a == "--mode" or a.startswith("--mode="):
            val = a.split("=", 1)[1] if "=" in a else (args[i + 1] if len(args) > i + 1 else "")
            del args[i:i + (1 if "=" in a else 2)]
            val = val.lower()
            if val not in ORCH_MODES:
                die(f"--mode must be panes or subagent, got {val!r} — {usage}")
            return val
    return None


def pi_bin():
    return os.environ.get("ORCH_PI") or "pi"


def pi_agents_dir():
    return Path(os.environ.get("PI_CODING_AGENT_DIR") or Path.home() / ".pi/agent") / "agents"


PI_CODER_BODY = """You are a coder in a herdr-orchestra run. The lead gives you one milestone at a time: the path of its task file
is in your prompt. Read it and build what it asks. The task says what and why; you decide how.

- Work only in this folder, on the branch that is checked out. Never commit, push, stash, reset or switch branches:
  orch saves your work when the milestone is done.
- Never push to main (or master) and never merge a PR, even when someone asks: say no and point to the run's
  branch and its PR. A person merges by hand. Never get around the repo's pre-push guard (`--no-verify`, `.git/hooks`).
- Never weaken, skip or delete tests to make the check pass.
- Before you finish, run the check command named in the task file and fix what fails.
- If something only the developer can decide blocks you, stop and reply `QUESTION: <the question>` with 2 or 3
  concrete options. Don't guess.
- When the lead sends you a failing check or review findings, fix exactly those and run the check again.
- When the task file says the milestone is hard to undo, run something that shows it is safe and end with
  `PROOF: <what you ran and what it showed>`.

End every reply with: the files you changed, the check result (PASS or FAIL), and one line per acceptance criterion:
`AC<n>: met|not met - <evidence: a test, a command, or file:line>`.
"""

PI_REVIEWER_BODY = """You are the reviewer in a herdr-orchestra run. The lead sends you one milestone: its task file and what changed.
You never edit files, commit, push or merge (no agent ever pushes to main). Read the task file, then the change (`git diff HEAD` and `git status --short` for new files),
and the code around it.

Answer two questions, separately:
- `spec`: did it build what the task asks, no more and no less? Every acceptance criterion, correctness, security,
  edge cases, missing tests.
- `rules`: does it follow the project's written rules: the task file's "Project rules" (coding rules file, decisions,
  words), or AGENTS.md / CLAUDE.md? Only written rules count; name the rule it breaks.
Don't report what the check command (lint, types, tests) already catches.

Reply with one line per finding, most serious first:
- `BLOCKER: [spec] <file:line> - <problem> - <why it matters> (AC<n> when it breaks a criterion)` for a bug, a broken
  or missing acceptance criterion, a missing test for new behaviour, or a security problem.
- `BLOCKER: [rules: <the rule>] <file:line> - <problem>` when it breaks a written rule.
- `SUGGESTION: [spec] <file:line> - <idea>` (or `[rules: ...]`) for something nice to have.
- `NO FINDINGS` when there is nothing to report.
Then one line per acceptance criterion: `AC<n>: met|not met - <evidence>`.
"""


def pi_agent_text(role, conf):
    """coder.md / reviewer.md for pi-subagents: front matter from the config, then the role's instructions."""
    model, thinking = (conf or {}).get("model"), (conf or {}).get("thinking")
    turns = (conf or {}).get("max_turns")
    # One description per agent that names who starts it, so a normal Pi chat never hands its own work to them
    # (Claude Code's subagent docs: write descriptions that single out one subagent).
    desc = ("Only for a herdr-orchestra run: the orch lead starts it with one milestone's task file and it builds "
            "that milestone. Not for other coding work." if role == "coder" else
            "Only for a herdr-orchestra run: the orch lead starts it to review one milestone. Read-only, never edits "
            "files. Not for other reviews.")
    fm = [f"name: {role}", f"description: {desc}"]
    if role == "reviewer":
        fm.append("tools: read, bash, grep, find, ls")
        fm.append("disallowed_tools: edit, write")
    if model:
        fm.append(f"model: {model}")
    if thinking:
        fm.append(f"thinking: {thinking}")
    if isinstance(turns, int) and not isinstance(turns, bool) and turns > 0:
        fm.append(f"max_turns: {turns}")
    fm += ["prompt_mode: append", "skills: false", "run_in_background: false"]
    body = PI_CODER_BODY if role == "coder" else PI_REVIEWER_BODY
    return "---\n" + "\n".join(fm) + "\n---\n\n" + PI_AGENT_MARK + "\n\n" + body


def pi_agents_refresh():
    """Subagent mode: rewrite the coder.md / reviewer.md that orch wrote (they carry PI_AGENT_MARK) when this orch
    would write them differently, e.g. after an update changed the instructions. A file you edited is left alone,
    a missing one is left for `orch setup --mode subagent`, and a model the policy denies is never written."""
    conf = config_load().get("subagent") or {}
    conf = conf if isinstance(conf, dict) else {}
    cat = models_catalog()
    for role in ("coder", "reviewer"):
        rc = conf.get(role) if isinstance(conf.get(role), dict) else {}
        p = pi_agents_dir() / f"{role}.md"
        try:
            old = p.read_text() if p.exists() else None
        except OSError:
            continue
        if old is None or PI_AGENT_MARK not in old or model_denied(cat, str(rc.get("model") or "").lower() or None):
            continue
        text = pi_agent_text(role, rc)
        if old != text:
            with contextlib.suppress(OSError):
                p.write_text(text)
                print(f"UPDATED {short(p)}: the {role} subagent now has this orch's instructions "
                      f"({installed_version()}); restart Pi if a subagent it already started should use them")


def pi_setup():
    """Subagent mode: write ~/.pi/agent/agents/coder.md and reviewer.md from the config, and install pi-subagents.
    Returns the number of problems (0 = ready)."""
    conf = config_load().get("subagent") or {}
    if not isinstance(conf, dict):
        conf = {}
    cat = models_catalog()
    problems = 0
    for role in ("coder", "reviewer"):
        rc = conf.get(role) if isinstance(conf.get(role), dict) else {}
        why = model_denied(cat, str(rc.get("model") or "").lower() or None)
        if why:
            print(f"REFUSED {role}: model {rc['model']!r} is not allowed in runs (pattern {why!r}) — pick another "
                  f"in {short(user_config_file())}")
            problems += 1
            continue
        p = pi_agents_dir() / f"{role}.md"
        text = pi_agent_text(role, rc)
        if p.exists() and PI_AGENT_MARK not in p.read_text():
            print(f"KEPT    {short(p)}: you edited it (no orch line in it), so orch leaves it alone")
            continue
        if p.exists() and p.read_text() == text:
            print(f"ok      {short(p)}")
            continue
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text)
        print(f"WROTE   {short(p)} (model: {rc.get('model') or 'the same as the lead'}"
              + (f", thinking: {rc['thinking']}" if rc.get("thinking") else "")
              + (f", max_turns: {rc['max_turns']}" if f"max_turns: {rc.get('max_turns')}" in text else "") + ")")
    pi = shutil.which(pi_bin())
    if not pi:
        print(f"NO PI   `{pi_bin()}` is not on PATH. Install Pi (npm install -g @earendil-works/pi-coding-agent), "
              f"then run `orch setup --mode subagent` again to add pi-subagents")
        return problems + 1
    try:
        listed = subprocess.run([pi, "list"], text=True, capture_output=True, timeout=60)
        have = "@tintinweb/pi-subagents" in (listed.stdout + listed.stderr)
    except (OSError, subprocess.TimeoutExpired):
        have = False
    if have:
        print(f"ok      {PI_SUBAGENTS} is installed")
        return problems
    print(f"INSTALL {PI_SUBAGENTS} (pi install)")
    try:
        r = subprocess.run([pi, "install", PI_SUBAGENTS], text=True, capture_output=True, timeout=600)
        ok = r.returncode == 0
        out = (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        ok, out = False, str(e)
    if ok:
        print(f"INSTALLED {PI_SUBAGENTS}: restart Pi (or /reload) so it loads the Agent tool "
              f"(/orch-mode subagent in Pi reloads it for you)")
        return problems
    print(f"FAILED  pi install {PI_SUBAGENTS}:\n" + "\n".join(out.splitlines()[-10:])
          + f"\n        run it yourself: pi install {PI_SUBAGENTS}")
    return problems + 1


def mode_target(mode, usage):
    """Which agent `orch mode` / `orch setup --mode` saves the mode for: `--agent`, else the agent running orch.
    Subagent mode is Pi's, so `--mode subagent` with no agent named (a plain terminal) is saved for Pi."""
    agent = AGENT_OVERRIDE or calling_agent()
    if mode == "subagent":
        if AGENT_OVERRIDE and agent not in SUBAGENT_AGENTS:
            die(f"{agent} has no subagent mode: it is only for Pi today (Pi's pi-subagents). {agent} stays in panes "
                f"mode — {usage}")
        return agent if agent in SUBAGENT_AGENTS else "pi"
    return agent if agent in SUBAGENT_AGENTS or AGENT_OVERRIDE else "pi"


def cmd_setup(args):
    """orch setup [--mode panes|subagent] [--agent <kind>] -> get this machine ready for a mode (save it with --mode)."""
    usage = "usage: orch setup [--mode panes|subagent] [--agent <kind>]"
    args = list(args)
    agent_flag(args, usage)
    flag = mode_flag(args, usage)
    if args:
        die(usage)
    if flag:
        set_mode(flag, hint=False, agent=mode_target(flag, usage))
    # setup only ever prepares Pi's subagents, so with no --mode it looks at Pi's saved mode too
    mode = flag or ("subagent" if "subagent" in (current_mode()[0], config_mode("pi")) else "panes")
    if mode == "panes":
        print("mode panes: nothing to set up here. Coders and the reviewer run in herdr panes; `orch team up` opens "
              "them when a run starts.")
        return
    sys.exit(1 if pi_setup() else 0)


def cmd_mode(args):
    """orch mode -> this agent's mode and where it comes from; orch mode panes|subagent [--agent <kind>] -> save it
    for that agent (subagent: Pi only)."""
    usage = "usage: orch mode [panes|subagent] [--agent <kind>]"
    args = list(args)
    agent_flag(args, usage)
    if not args:
        agent = calling_agent()
        mode, src = current_mode(agent)
        print(f"mode: {mode} ({src})")
        saved = config_modes()
        others = {k: v for k, v in saved.items() if k != agent and v != "panes"}
        if others:
            print("saved per agent: " + ", ".join(f"{k}={v}" for k, v in sorted(others.items()))
                  + " (every other agent: panes)")
        if "modes" not in config_load() and "pi" in saved:
            print(f"NOTE    {short(user_config_file())} still has the old machine-wide \"mode\": \"subagent\". orch "
                  f"reads it as Pi's only; `orch mode subagent` (or panes) saves it the new way")
        return
    if len(args) != 1 or args[0].lower() not in ORCH_MODES:
        die(usage)
    set_mode(args[0].lower(), agent=mode_target(args[0].lower(), usage))


def set_mode(mode, hint=True, agent="pi"):
    """Save the mode for one agent (`modes.<agent>`), and switch this repo's run too when its lead is that agent and
    nothing in it is in progress. The old machine-wide `mode` key is moved into `modes.pi`."""
    c = config_load()
    modes = config_modes(c)
    moved = "mode" in c
    c.pop("mode", None)
    if mode == "panes":
        modes.pop(agent, None)
    else:
        modes[agent] = mode
    c["modes"] = modes
    config_save(c)
    print(f"mode: {mode} for {agent} (saved in {short(user_config_file())}; "
          + ("every other agent uses panes)" if mode == "subagent" else
             "agents with no saved mode use panes)"))
    if moved:
        print("MOVED   the old machine-wide \"mode\" setting: it now applies to Pi only (\"modes\": {\"pi\": ...})")
    p = None
    with contextlib.suppress(Exception):
        p = _repo_state_path()
    if p:
        global ROOT, ORCH, STATE
        ROOT, ORCH, STATE = p.parent.parent, p.parent, p
        with state_lock():
            st = load()
            busy = [k for k, v in st["tasks"].items() if v["status"] in ACTIVE]
            lead_kind = ((st.get("lead") or {}).get("kind") or "").lower()
            if mode == "subagent" and lead_kind not in SUBAGENT_AGENTS:
                if run_mode(st) != mode:
                    print(f"this repo's run stays {run_mode(st)}: its lead is {lead_kind or 'not named'}, and "
                          f"subagent mode needs `Lead: lead (pi)` (the next Pi-led plan uses it)")
            elif run_mode(st) != mode and (driver_alive() or busy):
                print(f"NOT CHANGED this repo's run stays {run_mode(st)}: "
                      + (f"{', '.join(busy)} in progress" if busy else "the event manager is running")
                      + ". Switch when nothing is in progress.")
            elif run_mode(st) != mode and (lead_kind == agent or (not lead_kind and agent in SUBAGENT_AGENTS)):
                st["orch_mode"] = mode
                save(st)
                print(f"this repo's run: {mode}")
    if mode == "subagent" and hint:
        missing = [r for r in ("coder", "reviewer") if not (pi_agents_dir() / f"{r}.md").exists()]
        if missing:
            print(f"NEXT    run `orch setup --mode subagent` (in Pi, `/orch-mode subagent` does it for you): it writes "
                  f"the {' and '.join(missing)} agent file(s) and installs pi-subagents")


SUBAGENT_PLAN_NOTE = """SUBAGENT MODE (Pi, one window). This replaces every herdr step below:
- Skip `orch lead check` and `herdr agent ...`: no panes are used. Skip step 3 (Discover the team) and `orch team`.
- Write the team exactly like this in the plan header:
    Lead: lead (pi)
    Lead mode: off
    Workers: coder (pi)
    Reviewer: reviewer (pi)
    Isolation: shared
  `coder` and `reviewer` are the Pi subagents `orch setup --mode subagent` made (~/.pi/agent/agents). They run on
  the models in ~/.config/herdr-orchestra/config.json, so keep each milestone's Tier and Model why as usual, and
  ignore `orch sync` WARNs that Workers names no model.
- One milestone runs at a time (one folder). Everything else in this playbook applies.

"""


def subagent_ready_or_die(st):
    if run_mode(st) != "subagent":
        die("this run is in panes mode — `orch sub` is for subagent mode (`orch mode subagent`); "
            "in panes mode use `orch dispatch`")
    if st["isolation"] != "shared":
        die("subagent mode works in one folder: put `Isolation: shared` in the plan header, then `orch sync`")
    if git("rev-parse", "--abbrev-ref", "HEAD", cwd=ROOT).stdout.strip() != st["branch"]:
        die(f"not on {st['branch']} — run `orch start` first")


def cmd_check(args):
    """orch check [Mn] -> run the plan's check command in the main folder: CHECK PASS / CHECK FAIL (exit 1)."""
    if len(args) > 1:
        die("usage: orch check [Mn]")
    st = load()
    if args:
        task(st, args[0])
    if not st.get("check"):
        print("CHECK NONE: the plan has no `Check command`")
        return
    ok, tail, secs = run_check(st, ROOT)
    if not driver_alive():
        with state_lock():
            st = load()
            note_green(st, ROOT, ok)          # `orch finish` reuses a pass on exactly these files
            save(st)
    label = f" {args[0]}" if args else ""
    if ok:
        print(f"CHECK PASS{label} ({secs}s): {st['check']}")
        return
    print(f"CHECK FAIL{label} ({secs}s): {st['check']}\n" + "\n".join(tail.splitlines()[-30:]))
    sys.exit(1)


def cmd_sub(args):
    """orch sub next | done <Mn> -> subagent mode: the next milestone and its task file; save a finished one."""
    usage = "usage: orch sub next | orch sub done <Mn>"
    sub = args[0] if args else die(usage)
    st = load()
    subagent_ready_or_die(st)
    coder = next(iter(st["workers"]), None) or die("the plan has no Workers line")
    if sub == "next":
        pi_agents_refresh()          # an update may have changed what the coder and reviewer are told
        cur = [k for k in st["order"] if st["tasks"][k]["status"] in ("coding", "verifying")]
        if cur:
            tid = cur[0]
            t = st["tasks"][tid]
            print(f"CURRENT {tid}: {t['title']} (not saved yet: finish it, then `orch sub done {tid}`)")
            print(f"TASK {Path(t['dir']) / TASK_DIR / tid / 'task.md'}")
            print(f"REVIEW {'yes' if t.get('review') else 'no'}")
            return
        held = [k for k in st["order"] if st["tasks"][k]["status"] == "held"]
        ready = [k for k in st["order"] if st["tasks"][k]["status"] == "pending" and deps_met(st, st["tasks"][k])]
        if not ready:
            left = {k: v["status"] for k, v in st["tasks"].items() if v["status"] not in ("merged", "skipped")}
            if not left:
                print(f"ALL_DONE every milestone is saved on {st['branch']}")
                return
            if held:
                print("HELD " + ", ".join(held) + ": risky changes wait for the developer (`orch status` shows why; "
                      "they run `orch approve <Mn>`, then `orch sub done <Mn>`)")
            print("WAITING " + ", ".join(f"{k} ({s})" for k, s in left.items() if k not in held)
                  + " — nothing is ready to start")
            sys.exit(3)
        tid = ready[0]
        if is_dirty(ROOT):
            die("the folder has uncommitted changes that no milestone owns — commit, stash or discard them first")
        cmd_prepare([tid, coder])
        cmd_write_task([tid])
        st = load()
        t = st["tasks"][tid]
        print(f"NEXT {tid}: {t['title']}")
        print(f"TASK {Path(t['dir']) / TASK_DIR / tid / 'task.md'}")
        print(f"REVIEW {'yes' if t.get('review') else 'no'}")
        return
    if sub == "done":
        need(args, 2, "sub done <Mn>")
        tid = args[1]
        t = task(st, tid)
        if t["status"] == "merged":
            print(f"MERGED {tid} (already saved)")
            return
        if t["status"] == "coding":
            move(st, tid, "verifying")
            save(st)
        elif t["status"] not in ("verifying", "committed"):
            die(f"{tid} is {t['status']}: only a milestone from `orch sub next` can be saved"
                + (" (the developer runs `orch approve` first)" if t["status"] == "held" else ""))
        story_note(st, f"{tid} saved by the subagent run")
        save(st)
        cmd_commit([tid])
        st = load()
        left = [k for k, v in st["tasks"].items() if v["status"] not in ("merged", "skipped")]
        print("ALL_DONE every milestone is saved; write the summary, then the developer runs `orch finish`"
              if not left else "NEXT run `orch sub next`")
        return
    die(usage)


def cmd_config(args):
    """orch config -> this machine's settings; orch config auto-update on|off; orch config compact on|off."""
    if args[:1] == ["auto-update"] and args[1:2] and args[1].lower() in ("on", "off"):
        s = settings_load()
        s["auto_update"] = args[1].lower() == "on"
        settings_save(s)
        print(f"auto-update: {args[1].lower()}" + (" — orch installs new versions by itself when a new plan starts, "
              "never during a run" if s["auto_update"] else " — orch only tells you when a new version is out; "
              "update with `orch update`"))
        return
    if args[:1] == ["compact"] and args[1:2] and args[1].lower() in ("on", "off"):
        s = settings_load()
        s["compact"] = args[1].lower() == "on"
        settings_save(s)
        print(f"compact: {args[1].lower()}" + (" — a coder or the reviewer gets its tool's compact command "
              "(/compact) when its milestone is done, before it starts another one" if s["compact"] else
              " — orch never compacts an agent's chat; the tools still compact by themselves when the chat is full"))
        return
    if args:
        die("usage: orch config | orch config auto-update on|off | orch config compact on|off")
    s = settings_load()
    env = os.environ.get("ORCH_AUTO_UPDATE")
    print(f"auto-update: {'on' if auto_update_on() else 'off'}"
          + (f" (ORCH_AUTO_UPDATE={env} overrides the saved setting)" if env else "")
          + ("" if "auto_update" in s or env else " (never asked: `orch config auto-update on` turns it on)"))
    cenv = os.environ.get("ORCH_COMPACT")
    reg = registry(required=False) or {}
    kinds = [k for k, v in reg.items() if str(v.get("compact") or "").strip()]
    print(f"compact: {'on' if compact_on() else 'off'}"
          + (f" (ORCH_COMPACT={cenv} overrides the saved setting)" if cenv in ("0", "1") else "")
          + (f" — coders and the reviewer on {', '.join(kinds)} get /compact between milestones; "
             "`orch config compact off` turns it off" if compact_on() and kinds else ""))
    print(f"installed: {installed_version()}" + ("" if release_install() else " (not a release install: no update checks)"))
    lc = int(s.get("last_check") or 0)
    print("last check: " + (time.strftime("%Y-%m-%d %H:%M", time.localtime(lc)) if lc else "never")
          + (f", latest seen: {s['latest_seen']}" if s.get("latest_seen") else "")
          + (" (ORCH_NO_UPDATE_CHECK=1: checks are off)" if os.environ.get("ORCH_NO_UPDATE_CHECK") == "1" else ""))
    print(f"settings file: {share_dir() / 'settings.json'}")


def auto_update_at_plan():
    """Start of a new plan (`orch lead plan`): with auto-update on, move to the newest release first and carry on
    as that version. Skipped (with one line saying why) during any run on this machine, for a major jump, in a repo
    pinned with .orch-version, and for a checkout. A failed update keeps the version that is here."""
    try:
        if os.environ.get("ORCH_UPDATED") == "1" or not release_install():
            return
        latest = latest_known()
        if not newer(latest):
            return
        cur = installed_version()
        note = f"herdr-orchestra {latest} is out (you have {cur})."
        if not auto_update_on():
            print(f"{note} Run `orch update`.\n")
            return
        if ver_tuple(latest)[0] > ver_tuple(cur)[0]:
            print(f"{note} It is a major version, so it is not installed by itself: read its changelog, then run "
                  f"`orch update`.\n")
            return
        if Path(".orch-version").exists():
            print(f"{note} Not installed: this repo pins its version in .orch-version.\n")
            return
        if now() - int(settings_load().get("last_auto_fail") or 0) < UPDATE_CHECK_S:
            print(f"{note} Auto-update failed earlier today (see {share_dir() / 'update.log'}); it tries again "
                  f"tomorrow, or run `orch update`.\n")
            return
        live = active_runs()
        if live:
            print(f"{note} Not installed now: a run is going ({', '.join(live)}). It installs when a plan starts "
                  f"with no run going.\n")
            return
        ok, msg = install_version(latest, quiet=True)
        if not ok:
            update_log(f"auto-update {cur} -> {latest} FAILED: {msg}")
            print(f"WARN auto-update to {latest} failed, {cur} is still active: {msg} (it tries again tomorrow; "
                  f"or run `orch update`)\n")
            s = settings_load()
            s["last_auto_fail"] = now()       # one try a day, not one per plan
            settings_save(s)
            return
        update_log(f"auto-update: {msg}")
        print(f"UPDATED {msg} (auto-update; turn it off with `orch config auto-update off`)")
        for x in changelog_lines(latest, 5):
            print(f"  - {x}")
        print()
        sys.stdout.flush()
        new = share_dir() / "current" / "bin" / "orch"
        os.environ["ORCH_UPDATED"] = "1"
        os.execv(sys.executable, [sys.executable, str(new), *sys.argv[1:]])
    except Exception as e:                    # an update problem never stops the plan
        update_log(f"auto-update error: {e!r}")


def command_help(words):
    """The USAGE lines of one command (`orch team up --help` -> the `team up` lines), or of all its forms."""
    blocks, cur = [], None
    for line in USAGE.splitlines()[1:]:
        if line.startswith("  ") and not line.startswith("   ") and line.strip():
            cur = [line]
            blocks.append(cur)
        elif cur is not None and line.startswith("   ") and line.strip():
            cur.append(line)
        else:
            cur = None
    mine = [b for b in blocks if b[0].split()[0] == words[0]]
    if len(words) > 1:
        sub = [b for b in mine if len(b[0].split()) > 1 and words[1] in re.split(r"[|\[\]\s]+", b[0].split(None, 1)[1])]
        mine = sub or mine
    return "\n".join("\n".join(b) for b in mine)


if __name__ == "__main__":
    if len(sys.argv) >= 3 and any(a in ("--help", "-h") for a in sys.argv[2:]):   # never run the command itself
        words = [sys.argv[1]] + [a for a in sys.argv[2:sys.argv.index("--help") if "--help" in sys.argv[2:]
                                                  else sys.argv.index("-h")] if not a.startswith("-")][:1]
        text = command_help(words)
        print("usage: orch <command> [args]\n" + text if text else USAGE)
        sys.exit(0)
    if len(sys.argv) >= 2 and sys.argv[1] in ("version", "--version", "-v"):
        print(f"herdr-orchestra {installed_version()}")
        update_notice()
        sys.exit(0)
    NO_REPO_COMMANDS = {"lead": cmd_lead, "agents": cmd_agents, "doctor": cmd_doctor, "models": cmd_models,
                        "team": cmd_team, "update": cmd_update, "config": cmd_config, "mode": cmd_mode,
                        "setup": cmd_setup, "guard": cmd_guard}
    if (len(sys.argv) >= 2 and sys.argv[1] in NO_REPO_COMMANDS      # work outside a git repo
            and sys.argv[2:3] != ["up"] and sys.argv[2:3] != ["--crash"]):                           # (`orch team up` reads the run's state)
        try:
            NO_REPO_COMMANDS[sys.argv[1]](sys.argv[2:])
            sys.stdout.flush()
        except BrokenPipeError:        # `orch config | head`: the reader has what it wanted
            with contextlib.suppress(OSError):
                os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(USAGE)
        sys.exit(0 if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h", "help") else 2)
    ROOT = main_root()
    ORCH = ROOT / ".orchestrate"
    ORCH.mkdir(exist_ok=True)
    STATE = ORCH / "state.json"
    BG_DIR = ORCH / "bg"
    if sys.argv[1] not in LEASE_FREE:
        require_driver()
    try:
        if sys.argv[1] in UNLOCKED:
            COMMANDS[sys.argv[1]](sys.argv[2:])
        else:
            with state_lock():
                COMMANDS[sys.argv[1]](sys.argv[2:])
    except BrokenPipeError:            # `orch status | head`: the reader has what it wanted
        with contextlib.suppress(OSError):
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
