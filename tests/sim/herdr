#!/usr/bin/env bash
# Fake herdr for tests: agents are background scripts (behave.sh); state lives in $FH.
FH=${FH:?}
case "$1 $2" in
  "agent get")  [ -f "$FH/$3.gone" ] && { echo "no such agent $3" >&2; exit 1; }
                echo "{\"name\":\"$3\",\"status\":\"$(cat "$FH/$3.status" 2>/dev/null || echo idle)\"}";;
  "agent prompt") echo "$3 <- $4" >> "$FH/prompts.log"; echo working > "$FH/$3.status"
                  nohup "$(dirname "$0")/behave.sh" "$3" "$(cat "$FH/$3.dir")" "$4" >> "$FH/behave.log" 2>&1 &;;
  "agent read") cat "$FH/$3.pane" 2>/dev/null;;
esac
